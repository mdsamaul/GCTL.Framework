<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF/report generation - modern, no RDLC / AspNetCore.Reporting dependency -->
    <PackageReference Include="QuestPDF" Version="2025.7.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="NetBarcode" Version="1.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <!-- NOTE: PXLibrary / PXLib references intentionally removed.
       If any of your old business logic depended on PXLibrary,
       re-implement the needed pieces here as plain C# classes. -->

</Project>
