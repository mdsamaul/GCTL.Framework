@model List<GCTL.Core.ViewModels.BreadcrumbItem>
@{
    var trail = Model ?? new List<GCTL.Core.ViewModels.BreadcrumbItem>();
    var currentPageTitle = trail.LastOrDefault()?.Title?.Trim();
    if (string.IsNullOrWhiteSpace(currentPageTitle) || currentPageTitle.Equals("Home", StringComparison.OrdinalIgnoreCase))
    {
        currentPageTitle = ViewData["Title"] as string;
    }
}
<section class="container-fluid">
    <div class="row mb-1 align-items-center">
        <div class="col-md-5 col-sm-6">
            @if (!string.IsNullOrWhiteSpace(currentPageTitle) && !currentPageTitle.Equals("Home", StringComparison.OrdinalIgnoreCase))
            {
                <h5 class="mb-0 fw-bold text-dark page-breadcrumb-title my-1" style="font-size: 1.25rem; font-weight: 700 !important; letter-spacing: -0.2px;">@currentPageTitle</h5>
            }
        </div>
        <div class="col-md-7 col-sm-6">
            <ol class="breadcrumb float-sm-end mb-0">
                @for (int i = 0; i < trail.Count; i++)
                {
                    var crumb = trail[i];
                    var isLast = i == trail.Count - 1;
                    <li class="breadcrumb-item @(isLast ? "active" : "")" @(isLast ? "aria-current=\"page\"" : "")>
                        @if (!string.IsNullOrWhiteSpace(crumb.Url))
                        {
                            <a href="@crumb.Url">@crumb.Title?.Trim()</a>
                        }
                        else
                        {
                            @crumb.Title?.Trim()
                        }
                    </li>
                }
            </ol>
        </div>
    </div>
</section>
<style>
    .breadcrumb-item + .breadcrumb-item::before {
        padding-right: 0;
        padding-left: 0;
    }

    .breadcrumb-item {
        padding-left: 0 !important;
    }

    .breadcrumb {
        font-size: 13px; /* ~13px */
    }
</style>