<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index:99999!important">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden; max-width: 420px; margin: 0 auto;">
            <div class="modal-header border-0 pb-0 pt-3 px-3 position-relative">
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" data-coreui-dismiss="modal" data-dismiss="modal" aria-label="Close" style="position: absolute; right: 16px; top: 16px;"></button>
            </div>
            <div class="modal-body text-center px-4 pt-1 pb-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; background-color: #fee2e2; color: #dc2626;">
                    <i class="fas fa-trash-alt fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">@Html.SmartLocalize("Delete Confirmation")</h5>
                <p class="title text-secondary mb-0" id="confirmDeleteMessage" style="font-size: 13px;">@Html.SmartLocalize("Are you sure you want to delete this ledger? This process cannot be undone.")</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0 pb-4 px-4">
                <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-semibold me-2" data-bs-dismiss="modal" data-coreui-dismiss="modal" data-dismiss="modal" style="border-radius: 10px; min-width: 100px;">@Html.SmartLocalize("No, Cancel")</button>
                <button type="button" class="btn btn-danger px-4 py-2 fw-semibold" id="confirmDeleteBtn" style="border-radius: 10px; min-width: 100px; background-color: #dc2626; border: none;">@Html.SmartLocalize("Yes, Delete")</button>
            </div>
        </div>
    </div>
</div>
