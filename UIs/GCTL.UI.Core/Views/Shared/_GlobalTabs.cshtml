@model GCTL.Core.ViewModels.Common.TabGroupModel

<style>
    /* Tab Container */
    .custom-tabs {
        display: flex;
        align-items: flex-end;
        border-bottom: 1px solid #d8dce3;
    }

        /* Default Tab */
        .custom-tabs .tab-btn {
            padding: 5px 15px;
            margin-right: 4px;
            border: 1px solid #cfd6df;
            border-bottom: none;
            border-radius: 10px 10px 0 0;
            background: linear-gradient(to bottom, #ffffff 0%, #f7f9fb 50%, #edf2f7 100%);
            color: #495057;
            font-size: 14px;
            font-weight: 600;
            transition: all .25s ease;
            cursor: pointer;
        }

            /* Hover */
            .custom-tabs .tab-btn:hover {
                background: linear-gradient(to bottom, #ffffff, #f1f5f9);
                color: #0d6efd;
            }

            /* Active Tab */
            .custom-tabs .tab-btn.active {
                background: linear-gradient(to bottom, #ffffff 0%, #f8fbff 60%, #eef5fc 100%);
                color: #0d6efd;
                font-weight: 700;
                border-color: #bcd4f1;
                box-shadow: 0 -1px 8px rgba(13,110,253,.08);
                position: relative;
                top: 1px;
            }

                /* Hide bottom border */
                .custom-tabs .tab-btn.active::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: -2px;
                    width: 100%;
                    height: 3px;
                    background: #fff;
                }

            .custom-tabs .tab-btn:focus {
                outline: none;
                box-shadow: none;
            }
</style>

@if (Model != null && Model.Tabs != null && Model.Tabs.Any())
{
    <div class="custom-tabs" id="@Model.GroupId">
        @foreach (var tab in Model.Tabs)
        {
            <button type="button"
                    id="@tab.BtnId"
                    class="tab-btn @tab.BtnClass @(tab.IsActive ? "active" : "")"
                    onclick="window.location.href='@Url.Action(tab.ActionName, tab.ControllerName, tab.RouteValues)'">
                @if (!string.IsNullOrEmpty(tab.IconClass))
                {
                    <i class="@tab.IconClass me-1"></i>
                }
                @tab.TabTitle
            </button>
        }
    </div>
}

