                                       id="@(Model.InputId + "_" + opt.Value)"
                                       value="@opt.Value"
                                       checked="@opt.Selected"
                                       disabled="@Model.IsDisabled"
                                       style="@Model.InputStyle" />
                                <label class="form-check-label" for="@(Model.InputId + "_" + opt.Value)" style="@Model.LabelStyle">@opt.Text</label>
