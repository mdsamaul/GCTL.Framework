@model GCTL.UI.Core.ViewModels.GridModel

<link rel="stylesheet" href="~/css/custom/custom-datatable.css" asp-append-version="true" />

@{
    var tableClasses = string.Join(" ", new[]
    {
        "table", "table-bordered", "align-middle", "table-common", "custom-grid-table",
        Model.Compact ? "table-sm custom-grid-compact" : "",
        Model.Striped ? "table-striped" : "",
        Model.Bordered ? "table-bordered" : "",
        Model.Hover ? "table-hover" : "",
        Model.SelectRowHighlight ? "enable-select-highlight" : ""
    }.Where(c => !string.IsNullOrEmpty(c)));

    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };

    var collapseId = $"collapse_{Model.GridId}";

    // Determine whether to show the header Check All checkbox (default true for all grids)
    bool showCheckAll = true;
    var showCheckAllProp = Model.GetType().GetProperty("ShowCheckAll");
    if (showCheckAllProp != null && showCheckAllProp.PropertyType == typeof(bool))
    {
        showCheckAll = (bool)(showCheckAllProp.GetValue(Model) ?? true);
    }
    else if (string.IsNullOrEmpty(Model.CheckAllId) ||
             Model.CheckAllId.Equals("none", StringComparison.OrdinalIgnoreCase) ||
             Model.CheckAllId.Equals("false", StringComparison.OrdinalIgnoreCase))
    {
        showCheckAll = false;
    }

    if (ViewData["ShowCheckAll"] is bool vShowCheckAll)
    {
        showCheckAll = vShowCheckAll;
    }
    else if (ViewData["HideCheckAll"] is bool vHideCheckAll)
    {
        showCheckAll = !vHideCheckAll;
    }
}

@if (Model.CardWrapper || Model.IsCollapsible || !string.IsNullOrEmpty(Model.CardTitle))
{
    <div class="card custom-grid-card shadow-sm mb-3">
        @if (!string.IsNullOrEmpty(Model.CardTitle) || Model.IsCollapsible)
        {
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 px-3 border-bottom">
                <span class="fw-bold text-secondary small d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(Model.IconClass))
                    {
                        <i class="@Model.IconClass text-primary"></i>
                    }
                    @Model.CardTitle
                </span>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(Model.AddButtonUrl))
                    {
                        <a href="@Model.AddButtonUrl" id="@Model.AddButtonId" class="btn btn-sm btn-primary px-3 shadow-none fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 13px;">
                            <i class="fa-solid fa-plus"></i> @Model.AddButtonText
                        </a>
                    }
                    @if (Model.IsCollapsible)
                    {
                        <button class="btn btn-sm btn-icon-clean shadow-none text-secondary p-0"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId"
                                aria-expanded="@(Model.IsCollapsedDefault ? "false" : "true")"
                                aria-controls="@collapseId"
                                title="Toggle Grid">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    }
                </div>
            </div>
        }
        <div class="@(Model.IsCollapsible ? "collapse" + (Model.IsCollapsedDefault ? "" : " show") : "")" id="@collapseId">
            <div class="card-body p-2">
                <div class="table-responsive @(Model.Compact ? "custom-grid-compact-container" : "") @Model.ContainerCssClass">
                    <table id="@Model.GridId"
                           class="@tableClasses mb-0"
                           style="width:100%;"
                           data-grid-config="@System.Text.Json.JsonSerializer.Serialize(Model, jsonOptions)">
                        <thead>
                            @if (!string.IsNullOrEmpty(Model.CustomHeaderHtml))
                            {
                                @Html.Raw(Model.CustomHeaderHtml)
                            }
                            else
                            {
                                <tr class="text-center align-middle small">
                                    @if (Model.HasSubRow)
                                    {
                                        <th style="width:24px; min-width:24px;" class="col-subrow no-sort"></th>
                                    }
                                    @if (Model.ShowRowNumbers)
                                    {
                                        <th style="width:32px; min-width:32px;" class="col-sl-no no-sort">#</th>
                                    }
                                    @if (Model.ShowCheckbox)
                                    {
                                        <th class="text-center align-middle no-sort col-select-cell" style="width: 45px; min-width: 45px;">
                                            <span class="user-select-none">Sel.</span>
                                            @if (showCheckAll)
                                            {
                                                <br />
                                                <input type="checkbox" class="form-check-input m-0 shadow-none" id="@Model.CheckAllId"
                                                       disabled="@(Model.DisableCheckAll ? "disabled" : null)" />
                                            }
                                        </th>
                                    }
                                    else if (Model.UseRadio)
                                    {
                                        <th class="text-center align-middle no-sort col-select-cell" style="width: 45px; min-width: 45px;">
                                            <span class="user-select-none">Sel.</span>
                                        </th>
                                    }
                                    @foreach (var col in Model.Columns.Where(c => c.Visible))
                                    {
                                        <th class="align-middle text-center" style="@(col.Width != null ? $"width:{col.Width};" : "")">
                                            @if (!string.IsNullOrEmpty(col.ShortHeader))
                                            {
                                                <span class="th-full">@Html.Raw(col.Header)</span>
                                                <span class="th-compact" title="@col.CleanHeader" data-bs-toggle="tooltip" data-bs-placement="top">@Html.Raw(col.ShortHeader)</span>
                                            }
                                            else
                                            {
                                                @Html.Raw(col.Header)
                                            }
                                            @if (!string.IsNullOrEmpty(col.HeaderBangla))
                                            {
                                                <br /><small class="text-muted">@col.HeaderBangla</small>
                                            }
                                        </th>
                                    }
                                    @if (Model.ShowActionMenu)
                                    {
                                        <th class="align-middle text-center col-actions no-sort" style="width:6%;">Action</th>
                                    }
                                </tr>
                            }
                        </thead>
                        <tbody></tbody>
                        @if (!string.IsNullOrEmpty(Model.FooterHtml))
                        {
                            @Html.Raw(Model.FooterHtml)
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="table-responsive @(Model.CustomGridWrapper ? "custom-grid-wrapper p-1" : "") @(Model.Compact ? "custom-grid-compact-container" : "") @Model.ContainerCssClass">
        <table id="@Model.GridId"
               class="@tableClasses mb-0"
               style="width:100%;"
               data-grid-config="@System.Text.Json.JsonSerializer.Serialize(Model, jsonOptions)">
            <thead>
                @if (!string.IsNullOrEmpty(Model.CustomHeaderHtml))
                {
                    @Html.Raw(Model.CustomHeaderHtml)
                }
                else
                {
                    <tr class="text-center align-middle small">
                        @if (Model.HasSubRow)
                        {
                            <th style="width:24px; min-width:24px;" class="col-subrow no-sort"></th>
                        }
                        @if (Model.ShowRowNumbers)
                        {
                            <th style="width:32px; min-width:32px;" class="col-sl-no no-sort">#</th>
                        }
                        @if (Model.ShowCheckbox)
                        {
                            <th class="text-center align-middle no-sort col-select-cell" style="width: 45px; min-width: 45px;">
                                <span class="user-select-none">Sel.</span>
                                @if (showCheckAll)
                                {
                                    <br />
                                    <input type="checkbox" class="form-check-input m-0 shadow-none" id="@Model.CheckAllId"
                                           disabled="@(Model.DisableCheckAll ? "disabled" : null)" />
                                }
                            </th>
                        }
                        else if (Model.UseRadio)
                        {
                            <th class="text-center align-middle no-sort col-select-cell" style="width: 45px; min-width: 45px;">
                                <span class="user-select-none">Sel.</span>
                            </th>
                        }
                        @foreach (var col in Model.Columns.Where(c => c.Visible))
                        {
                            <th class="align-middle text-center" style="@(col.Width != null ? $"width:{col.Width};" : "")">
                                @if (!string.IsNullOrEmpty(col.ShortHeader))
                                {
                                    <span class="th-full">@Html.Raw(col.Header)</span>
                                    <span class="th-compact" title="@col.CleanHeader" data-bs-toggle="tooltip" data-bs-placement="top">@Html.Raw(col.ShortHeader)</span>
                                }
                                else
                                {
                                    @Html.Raw(col.Header)
                                }
                                @if (!string.IsNullOrEmpty(col.HeaderBangla))
                                {
                                    <br /><small class="text-muted">@col.HeaderBangla</small>
                                }
                            </th>
                        }
                        @if (Model.ShowActionMenu)
                        {
                            <th class="align-middle text-center col-actions no-sort" style="width:6%;">Action</th>
                        }
                    </tr>
                }
            </thead>
            <tbody></tbody>
            @if (!string.IsNullOrEmpty(Model.FooterHtml))
            {
                @Html.Raw(Model.FooterHtml)
            }
        </table>
    </div>
}

<script>
    (function () {
        function initGridTooltips() {
            var grid = document.getElementById('@Model.GridId');
            if (grid && window.bootstrap && typeof window.bootstrap.Tooltip === 'function') {
                var tooltips = grid.querySelectorAll('thead [data-bs-toggle="tooltip"]');
                for (var i = 0; i < tooltips.length; i++) {
                    if (!bootstrap.Tooltip.getInstance(tooltips[i])) {
                        new bootstrap.Tooltip(tooltips[i]);
                    }
                }
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initGridTooltips);
        } else {
            setTimeout(initGridTooltips, 100);
        }
    })();
</script>