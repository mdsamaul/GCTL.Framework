                <span>Delete</span>
            </button>
        }
        @if (Model.ShowClear)
        {
            <button type="button" class="btn toolbar-btn toolbar-btn-clear @Model.ClearBtnClass" id="@Model.ClearBtnId" disabled="@(!Model.EnableClear)">
                <i class="fas fa-sync"></i>
                <span>Clear</span>
            </button>
        }
        @if (Model.ShowPrint)
        {
            <div class="dropdown">
                <button type="button" class="btn toolbar-btn toolbar-btn-print @Model.PrintBtnClass dropdown-toggle" id="@Model.PrintBtnId" data-bs-toggle="dropdown" aria-expanded="false" disabled="@(!Model.EnablePrint)">
