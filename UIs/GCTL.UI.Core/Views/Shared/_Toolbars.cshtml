    </div>
    <div class="d-flex flex-wrap align-items-center gap-2 pe-1 toolbar-btn-group">
        @if (Model.ShowSave)
        {
            <button type="button" class="btn toolbar-btn toolbar-btn-save @Model.SaveBtnClass" id="@Model.SaveBtnId" disabled="@(!Model.EnableSave)">
                <i class="fas fa-save"></i>
