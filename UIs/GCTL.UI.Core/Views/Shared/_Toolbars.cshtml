@model ToobarModel
<div class="d-flex flex-wrap justify-content-between align-items-center p-2 mb-3 sticky-bar @(Model.IsPlain ? "" : "bg-white rounded shadow-sm border")">
    <div class="d-flex align-items-center py-1 ps-2">
        <h1 class="fw-bold text-dark m-0" style="font-size: 0.95rem; letter-spacing: 0.5px;">
            @Model.Title
        </h1>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2 pe-1 toolbar-btn-group">
        @if (Model.ShowSave)
        {
            <button type="button" class="btn toolbar-btn toolbar-btn-save @Model.SaveBtnClass" id="@Model.SaveBtnId" disabled="@(!Model.EnableSave)">
                <i class="fas fa-save"></i>
                <span>Save</span>
            </button>
        }
        @if (Model.ShowDelete)
        {
            <button type="button" class="btn toolbar-btn toolbar-btn-delete @Model.DeleteBtnClass" id="@Model.DeleteBtnId" disabled="@(!Model.EnableDelete)">
                <i class="fas fa-trash"></i>
                <span>Delete</span>
            </button>
        }
        @if (Model.ShowClear)
        {
            <button type="button" class="btn toolbar-btn toolbar-btn-clear @Model.ClearBtnClass" id="@Model.ClearBtnId" disabled="@(!Model.EnableClear)">
                <i class="fas fa-sync"></i>
                <span>Clear</span>
            </button>
        }
        @if (Model.ShowPrint)
        {
            <div class="dropdown">
                <button type="button" class="btn toolbar-btn toolbar-btn-print @Model.PrintBtnClass dropdown-toggle" id="@Model.PrintBtnId" data-bs-toggle="dropdown" aria-expanded="false" disabled="@(!Model.EnablePrint)">
                    <i class="fas fa-print"></i>
                    <span>Print</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm toolbar-print-menu">
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="#" id="@(Model.PrintBtnId)PdfBtn">
                            <i class="fas fa-file-pdf text-danger"></i> PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="#" id="@(Model.PrintBtnId)ExcelBtn">
                            <i class="fas fa-file-excel text-success"></i> Excel
                        </a>
                    </li>
                </ul>
            </div>
        }
        @if (Model.ShowFavorite)
        {
            <button type="button" class="btn toolbar-btn toolbar-btn-fav @Model.FavtBtnClass" id="@Model.FavtBtnId" disabled="@(!Model.EnableFavorite)">
                <i class="fas fa-star"></i>
                <span>Fav</span>
            </button>
        }
    </div>
</div> *@

@model ToobarModel
@{
    var containerPadding = Model.IsPlain ? "pe-0" : "";
    var buttonGroupPadding = Model.IsPlain ? "pe-0" : "pe-0";
}
<div class="d-flex justify-content-between align-items-center px-1 py-1 @containerPadding mb-3 sticky-bar @(Model.IsPlain ? "" : "bg-white rounded shadow-sm border") flex-nowrap toolbar-container">

    <div class="d-flex align-items-center py-1 ps-2 toolbar-title-wrap">
        <h1 class="fw-bold text-dark m-0 toolbar-title">
            @Model.Title
        </h1>
    </div>

    <div class="d-flex align-items-center gap-1 @buttonGroupPadding toolbar-btn-group flex-nowrap">

        @if (Model.ShowSave)
        {
            <button type="button"
                    id="@Model.SaveBtnId"
                    class="btn toolbar-btn toolbar-btn-save @Model.SaveBtnClass"
                    disabled="@(!Model.EnableSave)">
                <i class="fas fa-save"></i>
                <span>Save</span>
            </button>
        }

        @if (Model.ShowDelete)
        {
            <button type="button"
                    id="@Model.DeleteBtnId"
                    class="btn toolbar-btn toolbar-btn-delete @Model.DeleteBtnClass"
                    disabled="@(!Model.EnableDelete)">
                <i class="fas fa-trash-alt"></i>
                <span>Delete</span>
            </button>
        }

        @if (Model.ShowClear)
        {
            <button type="button"
                    id="@Model.ClearBtnId"
                    class="btn toolbar-btn toolbar-btn-clear @Model.ClearBtnClass"
                    disabled="@(!Model.EnableClear)">
                <i class="fas fa-redo"></i>
                <span>Clear</span>
            </button>
        }

        @if (Model.ShowPrint)
        {
            <div class="dropdown">

                <button type="button"
                        id="@Model.PrintBtnId"
                        class="btn toolbar-btn toolbar-btn-print dropdown-toggle @Model.PrintBtnClass"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        disabled="@(!Model.EnablePrint)">
                    <i class="fas fa-download"></i>
                    <span>Export</span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                    <li>
                        <a class="dropdown-item d-flex align-items-center @Model.ExcelBtnClass"
                           href="#"
                           id="@(Model.PrintBtnId)ExcelBtn">

                            <i class="fas fa-file-excel text-success me-2"></i>
                            Excel
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item d-flex align-items-center @Model.PdfBtnClass"
                           href="#"
                           id="@(Model.PrintBtnId)PdfBtn">

                            <i class="fas fa-file-pdf text-danger me-2"></i>
                            PDF
                        </a>
                    </li>

                </ul>

            </div>
        }

        @if (Model.ShowFavorite)
        {
            <button type="button"
                    id="@Model.FavtBtnId"
                    class="btn toolbar-btn toolbar-btn-fav @Model.FavtBtnClass"
                    disabled="@(!Model.EnableFavorite)">
                <i class="fas fa-star"></i>
                <span>Favorite</span>
            </button>
        }

    </div>

</div>