@using GCTL.Core.Configurations
@inject ApplicationSettings applicationSettings

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Formosa</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" /> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css">
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/toastr/css/toastr.min.css" rel="stylesheet" />
    <link href="~/lib/custom-inline-timepicker/custom-inline-timepicker.css" rel="stylesheet" />
   

    <!-- Flatpickr base CSS first -->
    @* <link href="~/js/layout/flatpickr/flatpickr.min.css" rel="stylesheet" /> *@
    <!-- Custom datepicker CSS AFTER flatpickr, so overrides apply -->
    <link href="~/lib/custom-datepicker/custom-datepicker.css" rel="stylesheet" />

    <link href="~/css/layout.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/toolbars.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/dynamic-grid.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/custom/custom-datatable.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/custom-select-2/custom-select-2.css" rel="stylesheet" />
    <link href="~/lib/custom-table-dropdown/custom-table-dropdown.css" rel="stylesheet" />
</head>
<body>
    <div id="app-wrapper">
        <aside class="app-sidebar" id="app-sidebar">
            <div class="sidebar-header">
                <a class="sidebar-logo" asp-controller="Dashboard" asp-action="Index">
                    <img src="~/images/fermosa-wX200.png" alt="Formosa Logo" class="sidebar-logo-img" />
                    <span class="sidebar-brand-text">Formosa Logistics Limited</span>
                </a>
            </div>

            @await Component.InvokeAsync("Menu")
        </aside>

        <div class="app-content-wrapper">
            @{
                var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var isDashboard = string.Equals(currentCtrl, "Dashboard", StringComparison.OrdinalIgnoreCase);
            }
            <header class="app-topnav">
                <div class="topnav-left">
                    <button id="sidebar-toggle" class="sidebar-toggle-btn" aria-label="Toggle Sidebar" title="Toggle Menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topnav-search">
                        <input type="text" placeholder="Search..." />
                        <i class="bi bi-search"></i>
                    </div>
                </div>

                <div class="topnav-center">
                    @if (!isDashboard)
                    {
                        <div class="topnav-date-pill" id="topnav-clock-pill">
                            <span id="topnav-clock">Sun, Sep 6, 2026, 09:35:52 AM</span>
                        </div>
                    }
                </div>

                <div class="topnav-right">
                    <div class="user-profile-nav">
                        <img src="@(ViewBag.LoginUserPhoto ?? "/images/user-avatar.svg")" alt="User Photo" class="user-nav-avatar" onerror="this.onerror=null;this.src='/images/user-avatar.svg';" />
                        <span class="user-nav-welcome">Welcome @(ViewBag.LoginUser ?? User.Identity?.Name ?? "frabbi")</span>
                    </div>

                    <span class="topnav-nav-divider">|</span>

                    <a href="javascript:void(0);" id="btnChangePassword" class="topnav-nav-link" title="Change Password">
                        <i class="bi bi-key-fill"></i>
                        <span>Change Password</span>
                    </a>

                    <span class="topnav-nav-divider">|</span>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-topnav-logout" title="Logout">
                            <i class="bi bi-power"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </header>

            <main class="app-main-content">
                @if(ViewData["HideBreadcrumb"] as bool? != true){
                    @await Component.InvokeAsync("Breadcrumb")
                }
                @RenderBody()
            </main>
            <div id="gcModalStack"></div>

            <!-- Change Password Modal -->
            <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow border-0">
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title d-flex align-items-center gap-2" id="changePasswordModalLabel">
                                <i class="bi bi-key-fill"></i> Change Password
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <form id="changePasswordForm">
                                <div class="mb-3">
                                    <label for="currentPassword" class="form-label fw-semibold">Current Password</label>
                                    <input type="password" class="form-control" id="currentPassword" required placeholder="Enter current password" />
                                </div>
                                <div class="mb-3">
                                    <label for="newPassword" class="form-label fw-semibold">New Password</label>
                                    <input type="password" class="form-control" id="newPassword" required placeholder="Enter new password" />
                                </div>
                                <div class="mb-3">
                                    <label for="confirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                                    <input type="password" class="form-control" id="confirmPassword" required placeholder="Confirm new password" />
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary btn-sm px-3" id="btnSavePassword">Save Password</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery first -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Flatpickr core JS -->
    <script src="~/js/layout/flatpickr/flatpickr.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/layout/flatpickerauto.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>

    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/toastr/js/toastr.min.js"></script>

    <script src="~/js/pages/app.input.validation.js"></script>

    <script src="~/js/theme-toggle.js"></script>
    <script src="~/lib/custom-select-2/custom-select-2.js" asp-append-version="true"></script>
    <script src="~/js/layout/select2/js/custom-select-2.js" asp-append-version="true"></script>
    <script src="~/lib/custom-inline-timepicker/custom-inline-timepicker.js"></script>
    <script src="~/lib/custom-table-dropdown/custom-table-dropdown.js"></script>
    <script src="~/js/pages/getholidayslist.js"></script>
    <script src="~/js/modal/gc-modal.js"></script>
    <script src="~/js/modal/gc-delete.js"></script>
    <script src="~/js/datatable/custom-datatable.js"></script>
    <script src="~/ajax/gc-ajax.js"></script>
    <script>
        window.config = {
        config: {
        phoenixIsRTL: false,
        phoenixNavbarTopStyle: "default",
        phoenixNavbarVerticalStyle: "default"
        }
        };
    </script>

    <!-- custom-datepicker.js depends on flatpickr being loaded, so it goes AFTER -->
    <script src="~/lib/custom-datepicker/custom-datepicker.js" asp-append-version="true"></script>
    @* <script src="~/js/layout/ChoiceManager.js"></script> *@

    <script src="~/js/layout/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(function () {
        customHolidayService.init({
        year: new Date().getFullYear()
        });
        });
    </script>

    @if (TempData["PermissionDeniedMessage"] != null)
    {
        <script>
            $(function () {
            toastr.error('@TempData["PermissionDeniedMessage"]');
            });
        </script>
    }
    <partial name="_DeleteModal" />
@* <script src="~/js/tabs/gc-tabs.js"></script> *@
</body>
</html>