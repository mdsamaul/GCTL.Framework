@using GCTL.Core.Configurations
@inject ApplicationSettings applicationSettings

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Formosa</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" /> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css">
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/toastr/css/toastr.min.css" rel="stylesheet" />
    <link href="~/lib/custom-inline-timepicker/custom-inline-timepicker.css" rel="stylesheet" />
   

    <!-- Flatpickr base CSS first -->
    @* <link href="~/js/layout/flatpickr/flatpickr.min.css" rel="stylesheet" /> *@
    <!-- Custom datepicker CSS AFTER flatpickr, so overrides apply -->
    <link href="~/lib/custom-datepicker/custom-datepicker.css" rel="stylesheet" />

    <link href="~/css/layout.css" rel="stylesheet" />
    <link href="~/css/toolbars.css" rel="stylesheet" />
    <link href="~/css/dynamic-grid.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/custom-select-2/custom-select-2.css" rel="stylesheet" />
</head>
<body>
    <div id="app-wrapper">
        <aside class="app-sidebar" id="app-sidebar">
            <div class="sidebar-header">
                <a class="sidebar-logo" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-box-fill text-primary"></i>
                    <span class="sidebar-brand-text">GCTL Framework</span>
                </a>
            </div>

            @await Component.InvokeAsync("Menu")
        </aside>

        <div class="app-content-wrapper">
            <header class="app-topnav">
                <div class="topnav-left">
                    <button id="sidebar-toggle" class="sidebar-toggle-btn" aria-label="Toggle Sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topnav-search">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search anything..." />
                    </div>
                </div>

                <div class="topnav-center">
                    <div class="topnav-clock-wrapper">
                        <i class="bi bi-clock-fill"></i>
                        <span id="topnav-clock">Loading clock...</span>
                    </div>
                </div>

                <div class="topnav-right">
                    @* Theme Dropdown Commented Out - Forced to Light Mode *@
                    @*
                    <div class="dropdown theme-dropdown">
                        <button class="btn btn-link nav-link dropdown-toggle text-decoration-none text-body p-2" id="bd-theme" type="button" aria-expanded="false" data-bs-toggle="dropdown" aria-label="Toggle theme (auto)">
                            <i id="active-theme-icon" class="bi bi-laptop-fill"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="bd-theme">
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-theme-value="light" aria-pressed="false">
                                    <i class="bi bi-sun-fill me-2 opacity-50"></i>
                                    Light
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-theme-value="dark" aria-pressed="false">
                                    <i class="bi bi-moon-stars-fill me-2 opacity-50"></i>
                                    Dark
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-theme-value="system" aria-pressed="true">
                                    <i class="bi bi-laptop-fill me-2 opacity-50"></i>
                                    System
                                </button>
                            </li>
                        </ul>
                    </div>
                    *@

                    <div class="dropdown">
                        <div class="profile-dropdown-trigger" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="@(ViewBag.LoginUserPhoto ?? "/images/UserIcon.png")" alt="User Photo" class="profile-avatar" />
                            <div class="profile-info d-none d-md-flex">
                                <span class="profile-name">@(ViewBag.LoginUser ?? User.Identity?.Name)</span>
                                <span class="profile-role">Executive</span>
                            </div>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <div class="dropdown-header">
                                    <strong>@(ViewBag.LoginUser ?? User.Identity?.Name)</strong>
                                    <div class="text-muted small">@(User.Identity?.Name)</div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" href="#">
                                    <i class="bi bi-person-fill me-2"></i> My Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" href="#">
                                    <i class="bi bi-gear me-2"></i> Settings
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                                        <i class="bi bi-box-arrow-right me-2"></i> Log out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-main-content">
                @if(ViewData["HideBreadcrumb"] as bool? != true){
                    @await Component.InvokeAsync("Breadcrumb")
                }
                @RenderBody()
            </main>
            <div id="gcModalStack"></div>
        </div>
    </div>

    <!-- jQuery first -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Flatpickr core JS -->
    <script src="~/js/layout/flatpickr/flatpickr.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/layout/flatpickerauto.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>

    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/toastr/js/toastr.min.js"></script>

    <script src="~/js/pages/app.input.validation.js"></script>

    <script src="~/js/theme-toggle.js"></script>
    <script src="~/js/layout/select2/js/custom-select-2.js"></script>
    <script src="~/lib/custom-inline-timepicker/custom-inline-timepicker.js"></script>
    <script src="~/lib/custom-select-2/custom-select-2.js"></script>
    <script src="~/js/pages/getholidayslist.js"></script>
    <script src="~/js/modal/gc-modal.js"></script>
    <script src="~/js/modal/gc-delete.js"></script>
    <script src="~/js/datatable/custom-datatable.js"></script>
    <script src="~/ajax/gc-ajax.js"></script>
    <script>
        window.config = {
        config: {
        phoenixIsRTL: false,
        phoenixNavbarTopStyle: "default",
        phoenixNavbarVerticalStyle: "default"
        }
        };
    </script>

    <!-- custom-datepicker.js depends on flatpickr being loaded, so it goes AFTER -->
    <script src="~/lib/custom-datepicker/custom-datepicker.js"></script>
    @* <script src="~/js/layout/ChoiceManager.js"></script> *@

    <script src="~/js/layout/layout.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(function () {
        customHolidayService.init({
        year: new Date().getFullYear()
        });
        });
    </script>

    @if (TempData["PermissionDeniedMessage"] != null)
    {
        <script>
            $(function () {
            toastr.error('@TempData["PermissionDeniedMessage"]');
            });
        </script>
    }
    <partial name="_DeleteModal" />
@* <script src="~/js/tabs/gc-tabs.js"></script> *@
</body>
</html>