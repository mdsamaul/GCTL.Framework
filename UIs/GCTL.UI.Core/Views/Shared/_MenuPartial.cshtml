@model IEnumerable<GCTL.Core.ViewModels.Menu.MenuDto>
@using System
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsItemActive(GCTL.Core.ViewModels.Menu.MenuDto item)
    {
        if (item == null) return false;

        if (!string.IsNullOrWhiteSpace(item.ControllerName) &&
            string.Equals(item.ControllerName, currentController, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (item.Children != null && item.Children.Any())
        {
            foreach (var child in item.Children)
            {
                if (IsItemActive(child))
                {
                    return true;
                }
            }
        }

        return false;
    }

    bool IsDirectActive(GCTL.Core.ViewModels.Menu.MenuDto item)
    {
        if (item == null) return false;

        if (!string.IsNullOrWhiteSpace(item.ControllerName) &&
            string.Equals(item.ControllerName, currentController, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return false;
    }
}
<ul class="sidebar-menu sidebar-rail-menu ssms-tree-list">
@foreach (var item in Model)
{
    var hasChildren = item.Children != null && item.Children.Any();
    var itemActive = IsItemActive(item);
    var directActive = IsDirectActive(item);

    <li class="menu-item rail-item tree-node @(hasChildren ? "has-children has-flyout" : "is-leaf") @(itemActive ? "active" : "") @(directActive ? "direct-active" : "")" data-menu-id="@item.MenuId">
        @if (hasChildren)
        {
            <button class="menu-link rail-link tree-link d-flex align-items-center w-100 @(directActive ? "active" : "")" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#children-@item.AutoId"
                    aria-expanded="@(itemActive ? "true" : "false")"
                    aria-controls="children-@item.AutoId">
                <span class="tree-expander" aria-hidden="true"></span>
                <span class="menu-text rail-text tree-text">@item.Title</span>
            </button>

            <!-- Downward tree branch children -->
            <div class="collapse @(itemActive ? "show" : "") accordion-submenu tree-submenu" id="children-@item.AutoId">
                @await Html.PartialAsync("_MenuPartial", item.Children)
            </div>

            <!-- Flyout popup submenus (visible when 3-bar is clicked into collapsed rail mode) -->
            <div class="rail-flyout shadow">
                <ul class="flyout-list">
                    @foreach (var child in item.Children)
                    {
                        var childHasChildren = child.Children != null && child.Children.Any();
                        var childActive = IsItemActive(child);
                        var childDirectActive = IsDirectActive(child);

                        <li class="flyout-item @(childHasChildren ? "has-nested" : "") @(childActive ? "active" : "")">
                            @if (childHasChildren)
                            {
                                <div class="flyout-link @(childDirectActive ? "active" : "")" role="button" tabindex="0">
                                    <span class="flyout-text">@child.Title</span>
                                    <i class="bi bi-chevron-right flyout-arrow ms-auto"></i>
                                </div>
                                <div class="rail-flyout-nested shadow">
                                    <ul class="flyout-list">
                                        @foreach (var subChild in child.Children)
                                        {
                                            var subChildHasChildren = subChild.Children != null && subChild.Children.Any();
                                            var subActive = IsItemActive(subChild);
                                            var subDirectActive = IsDirectActive(subChild);

                                            <li class="flyout-item @(subChildHasChildren ? "has-nested" : "") @(subActive ? "active" : "")">
                                                @if (subChildHasChildren)
                                                {
                                                    <div class="flyout-link @(subDirectActive ? "active" : "")" role="button" tabindex="0">
                                                        <span class="flyout-text">@subChild.Title</span>
                                                        <i class="bi bi-chevron-right flyout-arrow ms-auto"></i>
                                                    </div>
                                                    <div class="rail-flyout-nested shadow">
                                                        <ul class="flyout-list">
                                                            @foreach (var leaf in subChild.Children)
                                                            {
                                                                var leafActive = IsDirectActive(leaf);
                                                                <li class="flyout-item @(leafActive ? "active" : "")">
                                                                    <a class="flyout-link @(leafActive ? "active" : "")" asp-controller="@leaf.ControllerName" asp-action="@leaf.ViewName">
                                                                        <span class="flyout-text">@leaf.Title</span>
                                                                    </a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <a class="flyout-link @(subDirectActive ? "active" : "")" asp-controller="@subChild.ControllerName" asp-action="@subChild.ViewName">
                                                        <span class="flyout-text">@subChild.Title</span>
                                                    </a>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a class="flyout-link @(childDirectActive ? "active" : "")" asp-controller="@child.ControllerName" asp-action="@child.ViewName">
                                    <span class="flyout-text">@child.Title</span>
                                </a>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <a class="menu-link rail-link tree-link d-flex align-items-center w-100 @(directActive ? "active" : "")" asp-controller="@item.ControllerName" asp-action="@item.ViewName">
                <span class="menu-text rail-text tree-text">@item.Title</span>
            </a>
        }
    </li>
}
</ul>

