@model string
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentPath = (Context.Request.Path.Value ?? "").ToLowerInvariant();

    string activeTab = Model ?? "";
    if (string.IsNullOrWhiteSpace(activeTab))
    {
        if (currentCtrl.Equals("ChartOfAccountsReports", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("/chartofaccountsreports"))
        {
            activeTab = "ChartOfAccounts";
        }
        else if (currentCtrl.Equals("GeneralLedgerReport", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("/generalledgerreport"))
        {
            activeTab = "GeneralLedger";
        }
        else if (currentCtrl.Equals("TrialBalance", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("/trialbalance"))
        {
            activeTab = "TrialBalance";
        }
        else if (currentCtrl.Equals("IncomeStatement", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("/incomestatement"))
        {
            activeTab = "IncomeStatement";
        }
        else if (currentCtrl.Equals("BalanceSheet", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("/balancesheet"))
        {
            activeTab = "BalanceSheet";
        }
        else if (currentCtrl.Equals("CashFlow", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("/cashflow"))
        {
            activeTab = "CashFlow";
        }
    }
}

<style>
    .coar-tabs-bar {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 8px 4px 0 4px;
        margin-top: 6px;
        margin-bottom: 14px;
        border-bottom: 1px solid #d4dcd7;
        overflow-x: auto;
        overflow-y: hidden !important;
        white-space: nowrap;
        background: transparent;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .coar-tabs-bar::-webkit-scrollbar {
        display: none;
    }
    .coar-nav-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 4px 10px 4px;
        font-size: 13.5px;
        font-weight: 500;
        color: #334155;
        text-decoration: none;
        position: relative;
        transition: color 0.15s ease, font-weight 0.15s ease;
        cursor: pointer;
    }
    .coar-nav-tab i {
        font-size: 14px;
        transition: color 0.15s ease;
    }
    .coar-nav-tab::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 3px;
        background-color: #0e5a4a;
        border-radius: 2px 2px 0 0;
        opacity: 0;
        transform: scaleX(0);
        transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .coar-nav-tab:hover {
        color: #0e5a4a;
        font-weight: 700;
        text-decoration: none;
    }
    .coar-nav-tab:hover::after,
    .coar-nav-tab.active::after {
        opacity: 1;
        transform: scaleX(1);
    }
    .coar-nav-tab.active {
        color: #0e5a4a;
        font-weight: 700;
    }
</style>

<div class="coar-tabs-bar nox no-print">
    <a href="/ChartOfAccountsReports/Index" class="coar-nav-tab @(activeTab.Equals("ChartOfAccounts", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fas fa-sitemap me-1"></i>@Html.SmartLocalize("Chart of Accounts")
    </a>
    <a href="/GeneralLedgerReport/Index" class="coar-nav-tab @(activeTab.Equals("GeneralLedger", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fas fa-book me-1"></i>@Html.SmartLocalize("General Ledger")
    </a>
    <a href="/TrialBalance/Index" class="coar-nav-tab @(activeTab.Equals("TrialBalance", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fas fa-balance-scale me-1"></i>@Html.SmartLocalize("Trial Balance")
    </a>
    <a href="/IncomeStatement/Index" class="coar-nav-tab @(activeTab.Equals("IncomeStatement", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fas fa-file-invoice-dollar me-1"></i>@Html.SmartLocalize("Income Statement")
    </a>
    <a href="/BalanceSheet/Index" class="coar-nav-tab @(activeTab.Equals("BalanceSheet", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fas fa-balance-scale-right me-1"></i>@Html.SmartLocalize("Balance Sheet")
    </a>
    <a href="/CashFlow/Index" class="coar-nav-tab @(activeTab.Equals("CashFlow", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fas fa-money-bill-wave me-1"></i>@Html.SmartLocalize("Cash Flow")
    </a>
</div>
