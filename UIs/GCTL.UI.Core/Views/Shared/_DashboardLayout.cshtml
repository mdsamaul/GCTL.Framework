<!DOCTYPE html>
<html lang="en" data-theme="">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GCTL HRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
    (function(){
        document.documentElement.setAttribute('data-theme', 'light');
    })();
    </script>
</head>
<body>

    <div id="app-wrapper">
        <!-- Collapsible Sidebar -->
        <aside class="app-sidebar" id="app-sidebar">
            <div class="sidebar-header">
                <a class="sidebar-logo" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-box-fill text-primary"></i>
                    <span class="sidebar-brand-text">Formosa Logistics Ltd</span>
                </a>
            </div>

            @await Component.InvokeAsync("Menu")
        </aside>

        <!-- Content Area -->
        <div class="app-content-wrapper">
            @{
                var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var isDashboard = string.Equals(currentCtrl, "Dashboard", StringComparison.OrdinalIgnoreCase);
            }
            <!-- Topnav Navigation -->
            <header class="app-topnav">
                <div class="topnav-left">
                    <a class="topnav-brand" asp-controller="Dashboard" asp-action="Index">
                        <span class="brand-title">datapath</span>
                        <span class="brand-subtitle">ERP HRM &amp; Finance System</span>
                    </a>
                    <button id="sidebar-toggle" class="sidebar-toggle-btn" aria-label="Toggle Sidebar" title="Toggle Menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topnav-search">
                        <input type="text" placeholder="Search..." />
                        <i class="bi bi-search"></i>
                    </div>
                </div>

                <div class="topnav-center">
                    @if (!isDashboard)
                    {
                        <div class="topnav-date-pill" id="topnav-clock-pill">
                            <span id="topnav-clock">Sun, Sep 6, 2026, 09:35:52 AM</span>
                        </div>
                    }
                </div>

                <div class="topnav-right">
                    <div class="user-profile-nav">
                        <img src="@(ViewBag.LoginUserPhoto ?? "/images/UserIcon.png")" alt="User Photo" class="user-nav-avatar" />
                        <span class="user-nav-welcome">Welcome @(ViewBag.LoginUser ?? User.Identity?.Name ?? "frabbi")</span>
                    </div>

                    <span class="topnav-nav-divider">|</span>

                    <a href="javascript:void(0);" id="btnChangePassword" class="topnav-nav-link" title="Change Password">
                        <i class="bi bi-key-fill"></i>
                        <span>Change Password</span>
                    </a>

                    <span class="topnav-nav-divider">|</span>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-topnav-logout" title="Logout">
                            <i class="bi bi-power"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </header>

            <!-- Main Page View Content -->
            <main class="app-main-content">
                @RenderBody()
            </main>

            <!-- Change Password Modal -->
            <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow border-0">
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title d-flex align-items-center gap-2" id="changePasswordModalLabel">
                                <i class="bi bi-key-fill"></i> Change Password
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <form id="changePasswordForm">
                                <div class="mb-3">
                                    <label for="currentPassword" class="form-label fw-semibold">Current Password</label>
                                    <input type="password" class="form-control" id="currentPassword" required placeholder="Enter current password" />
                                </div>
                                <div class="mb-3">
                                    <label for="newPassword" class="form-label fw-semibold">New Password</label>
                                    <input type="password" class="form-control" id="newPassword" required placeholder="Enter new password" />
                                </div>
                                <div class="mb-3">
                                    <label for="confirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                                    <input type="password" class="form-control" id="confirmPassword" required placeholder="Confirm new password" />
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary btn-sm px-3" id="btnSavePassword">Save Password</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
