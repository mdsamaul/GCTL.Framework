@model GCTL.UI.Core.ViewModels.GridModel

@{
    ViewData["Title"] = "Customer Top Sheet Report";
    ViewData["ShowPageTitle"] = true;
    Layout = "_Layout";
}

<style>
    :root {
        --primary: #0056b3;
        --secondary: #003366;
        --bg-frost: #f4f7f9;
        --white: #ffffff;
        --pending: #ff9800;
        --delivered: #4caf50;
        --transit: #9c27b0;
        --border: #e0e6ed;
        --text-main: #334155;
    }

    .top-sheet-dashboard {
        color: var(--text-main);
        font-family: 'Segoe UI', Roboto, sans-serif;
    }

    /* Main Container */
    .dashboard-container {
        padding: 6px 0 25px 0;
        max-width: 100%;
        margin: 0 auto;
    }

    /* Stats Grid (5 Cards matching OFRReport / GPAnalysisReport) */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 14px;
    }

    .stat-card {
        background: white;
        padding: 10px 14px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border-bottom: 3px solid var(--primary);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        user-select: none;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.06);
        }

    .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 1.1rem;
        color: white;
        flex-shrink: 0;
    }

        .stat-icon svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            flex-shrink: 0;
        }

    .stat-info h3 {
        font-size: 0.72rem;
        color: #64748b;
        text-transform: uppercase;
        margin: 0 0 2px 0;
        font-weight: 600;
        letter-spacing: 0.4px;
    }

    .stat-info p {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--secondary);
        margin: 0;
        line-height: 1.1;
    }

    /* Filter Section - One Line Design with responsive support (OFRReport style) */
    .filter-section {
        background: white;
        padding: 8px 14px;
        border-radius: 10px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        border: 1px solid var(--border);
        flex-wrap: wrap;
    }

    .filter-label {
        font-weight: 700;
        color: var(--secondary);
        font-size: 0.82rem;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 5px;
        flex: 1 1 0;
        min-width: 0 !important;
    }

    .filter-group.filter-group-export {
        min-width: 140px;
        margin-left: auto;
    }

        .filter-group label {
            font-size: 0.76rem;
            font-weight: 600;
            white-space: nowrap;
            color: #475569;
            margin: 0;
            flex-shrink: 0;
        }

        .filter-group input.form-control,
        .filter-group select.form-select,
        .filter-group input.flatpickr-alt-input {
            width: 100% !important;
            min-width: 0 !important;
            padding: 4px 22px 4px 7px !important;
            border: 1px solid var(--border) !important;
            border-radius: 6px !important;
            font-size: 0.78rem !important;
            outline: none;
            background-color: #ffffff;
            color: var(--text-main);
            height: 31px !important;
            min-height: 31px !important;
            line-height: 1.2 !important;
            background-position: right 6px center !important;
            background-size: 13px 13px !important;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .filter-group input.custom-datepicker,
        .filter-group input.flatpickr-alt-input,
        .filter-group input.caiCon,
        .filter-group input[type="date"] {
            background-image: url('/images/icons/calender.svg') !important;
            background-repeat: no-repeat !important;
            background-position: right 8px center !important;
            background-size: 15px 15px !important;
            padding-right: 28px !important;
            cursor: pointer;
        }

        /* Custom-dd-wrapper styling */
        .filter-group .custom-dd-wrapper {
            width: 100% !important;
            min-width: 0 !important;
            flex: 1 1 auto;
        }

        .filter-group .custom-dd-input {
            min-height: 31px !important;
            height: 31px !important;
            padding: 2px 6px !important;
            font-size: 0.78rem !important;
            border-radius: 6px !important;
            width: 100% !important;
            min-width: 0 !important;
        }

        .filter-section .custom-dd-panel {
            min-width: 100% !important;
            width: max-content !important;
            max-width: 480px !important;
            right: auto !important;
            box-shadow: 0 6px 18px rgba(0,0,0,0.14) !important;
        }

        .filter-section .custom-dd-option,
        .filter-section .custom-dd-item,
        .filter-section .custom-dd-panel span {
            white-space: nowrap !important;
            word-break: keep-all !important;
        }

        .filter-group.filter-group-customer {
            min-width: 180px !important;
            flex: 1.2 1 0;
        }

        .filter-group.filter-group-bill {
            min-width: 170px !important;
            flex: 1.1 1 0;
        }

    .job-grid-card {
        background: white;
        border-radius: 10px;
        padding: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        border: 1px solid var(--border);
    }

    /* PDF Modal Styling */
    .pdf-modal-dialog {
        max-width: 95vw !important;
        width: 95vw !important;
        height: 94vh !important;
        margin: 2vh auto !important;
    }

    .pdf-modal-content {
        height: 94vh !important;
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .pdf-modal-body {
        flex: 1 1 auto;
        padding: 0 !important;
        position: relative;
        background: #525659;
    }

    .pdf-modal-iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
        .filter-section {
            flex-direction: column;
            align-items: stretch;
        }
        .filter-group {
            width: 100% !important;
        }
    }
</style>

<div class="top-sheet-dashboard">
    <div class="dashboard-container">

        <!-- Top 5 KPI Cards (Matching OFRReport / GPAnalysisReport) -->
        <div class="stats-grid">
            <!-- 1. Total Customers -->
            <div class="stat-card" style="border-color: #0056b3;">
                <div class="stat-icon" style="background: #0056b3;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <div class="stat-info">
                    <h3>Total Customers</h3>
                    <p id="statTotalCustomers">0</p>
                </div>
            </div>

            <!-- 2. Total Bills -->
            <div class="stat-card" style="border-color: #2e7d32;">
                <div class="stat-icon" style="background: #2e7d32;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
                <div class="stat-info">
                    <h3>Total Bills</h3>
                    <p id="statTotalBills">0</p>
                </div>
            </div>

            <!-- 3. Total Bill Value -->
            <div class="stat-card" style="border-color: #ed6c02;">
                <div class="stat-icon" style="background: #ed6c02;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                </div>
                <div class="stat-info">
                    <h3>Total Bill Value</h3>
                    <p id="statTotalBillAmount">0.00</p>
                </div>
            </div>

            <!-- 4. Transport & Labour -->
            <div class="stat-card" style="border-color: #9c27b0;">
                <div class="stat-icon" style="background: #9c27b0;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                </div>
                <div class="stat-info">
                    <h3>Transport & Labour</h3>
                    <p id="statTotalTransportLabour">0.00</p>
                </div>
            </div>

            <!-- 5. Commission -->
            <div class="stat-card" style="border-color: #0288d1;">
                <div class="stat-icon" style="background: #0288d1;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path>
                        <line x1="12" y1="6" x2="12" y2="8"></line>
                        <line x1="12" y1="16" x2="12" y2="18"></line>
                    </svg>
                </div>
                <div class="stat-info">
                    <h3>Commission</h3>
                    <p id="statTotalCommission">0.00</p>
                </div>
            </div>
        </div>

        <!-- Filter Bar (One Line Design, Auto-Filter on Change matching OFRReport) -->
        <div class="filter-section">
            <span class="filter-label"><i class="fas fa-filter"></i> Filter By:</span>

            <!-- From Date -->
            <div class="filter-group">
                <label for="filterFromDate">From</label>
                <input type="text" id="filterFromDate" class="form-control form-control-sm custom-datepicker caiCon" placeholder="DD/MM/YYYY" autocomplete="off" value="@DateTime.Now.ToString("01/MM/yyyy")" data-default-date="@DateTime.Now.ToString("01/MM/yyyy")" data-max-date="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>

            <!-- To Date -->
            <div class="filter-group">
                <label for="filterToDate">To</label>
                <input type="text" id="filterToDate" class="form-control form-control-sm custom-datepicker caiCon" placeholder="DD/MM/YYYY" autocomplete="off" value="@DateTime.Now.ToString("dd/MM/yyyy")" data-default-date="@DateTime.Now.ToString("dd/MM/yyyy")" data-min-date="@DateTime.Now.ToString("yyyy-MM-01")" />
            </div>

            <!-- Shipment Mode -->
            <div class="filter-group">
                <select id="filterShipmentMode" class="form-select form-select-sm custom-select-single" data-placeholder="-- Shipment Mode --">
                    <option value="">-- Shipment Mode --</option>
                    @if (ViewBag.ShipmentModes != null)
                    {
                        foreach (SelectListItem item in (SelectList)ViewBag.ShipmentModes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Customer (Multi-Select with checkboxes) -->
            <div class="filter-group filter-group-customer">
                <select id="filterCustomerId" class="form-select form-select-sm custom-select-multi" multiple="multiple" data-placeholder="-- Select Customer(s) --">
                    @if (ViewBag.Customers != null)
                    {
                        foreach (SelectListItem item in (SelectList)ViewBag.Customers)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Bill No (Multi-Select with checkboxes) -->
            <div class="filter-group filter-group-bill">
                <select id="filterBillNo" class="form-select form-select-sm custom-select-multi" multiple="multiple" data-placeholder="-- Select Bill No(s) --">
                    @if (ViewBag.BillNos != null)
                    {
                        foreach (SelectListItem item in (SelectList)ViewBag.BillNos)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Export Format & Actions Dropdown -->
            <div class="filter-group filter-group-export">
                <select id="filterExportFormat" class="form-select form-select-sm custom-select-single" data-placeholder="Select Exp. Format">
                    <option value="">Select Exp. Format</option>
                    <option value="Preview">Preview</option>
                    <option value="PDF">PDF</option>
                    <option value="Excel">Excel (Tabs)</option>
                    <option value="CSV">CSV</option>
                </select>
            </div>
        </div>

        <!-- CustomGrid Table Container -->
        <div class="job-grid-card">
            @await Html.PartialAsync("_CustomGrid", Model)
        </div>

    </div>
</div>

<!-- Live PDF Preview Modal (Matching OFRReport) -->
<div class="modal fade" id="customerTopSheetPreviewModal" tabindex="-1" aria-labelledby="customerTopSheetPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog pdf-modal-dialog">
        <div class="modal-content pdf-modal-content">
            <div class="modal-header py-2 px-3 bg-light">
                <h6 class="modal-title fw-bold text-primary" id="customerTopSheetPreviewModalLabel">
                    <i class="fas fa-file-invoice text-primary me-2"></i>Customer Top Sheet Report Preview
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnModalDownloadPdf" title="Download PDF">
                        <i class="fas fa-download"></i> PDF
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success" id="btnModalDownloadExcel" title="Download Excel in Tabs">
                        <i class="fas fa-file-excel"></i> Excel (Tabs)
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body pdf-modal-body">
                <iframe id="topSheetModalPdfFrame" class="pdf-modal-iframe" title="PDF Preview"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/customerTopSheetReport.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('#customerTopSheetReportTable').on('draw.dt', function () {
                $('#customerTopSheetReportTable tbody td').each(function () {
                    var text = $(this).text().trim();
                    if (text && text !== '-' && !$(this).attr('title')) {
                        $(this).attr('title', text);
                    }
                });
            });
        });
    </script>
}
