@model GCTL.UI.Core.ViewModels.CurrencyType.CurrencyTypePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Currency Type";
    Model.Breadcrumb = "Currency Type";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Currency Type",
                            SaveBtnClass = "js-currencytype-save",
                            DeleteBtnClass = "js-currencytype-delete-confirm",
                            ClearBtnClass = "js-currencytype-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="currencytype-form" asp-controller="CurrencyType">
                            <div class="js-currencytype-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Dynamic Grid Column -->
            <div class="col-md-6">
                <div class="js-currencytype-grid-container" id="currencyTypeGridContainer">
                    @if (Model.DynamicGrid != null)
                    {
                        @await Html.PartialAsync("_DynamicGrid", Model.DynamicGrid)
                    }
                </div>
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/grid-manager.js" asp-append-version="true"></script>
    <script src="~/js/pages/CurrencyType.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "CurrencyType")'
        };
        options.load = () => {
            loadGridPage('currencyTypeGridContainer', '/CurrencyType/GetTableData', 1, 10);
        };

        $.currencyType(options);
    </script>
}