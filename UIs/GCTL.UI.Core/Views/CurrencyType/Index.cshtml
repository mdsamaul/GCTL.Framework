@model GCTL.UI.Core.ViewModels.CurrencyType.CurrencyTypePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Currency Type";
    Model.Breadcrumb = "Currency Type";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Currency Type",
                            SaveBtnClass = "js-currencytype-save",
                            DeleteBtnClass = "js-currencytype-delete-confirm",
                            ClearBtnClass = "js-currencytype-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="currencytype-form" asp-controller="CurrencyType">
                            <div class="js-currencytype-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "currencyTypeTable",
                    AjaxUrl = "/CurrencyType/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "currencyId",
                    CheckAllId = "currencytype-check-all",
                    DefaultSortColumn = "currencyId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "currencyId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-currencytype-edit" },
                        new() { Data = "currencyName", Header = "Currency Name", Width = "35%"},
                        new() { Data = "shortName", Header = "Short Name", Width = "20%"},
                        new() { Data = "symbol", Header = "Symbol", Width = "15%", Align = "center" },
                        new() { Data = "decimalPlaces", Header = "Decimals", Width = "20%", Align = "center" }
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/CurrencyType.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "CurrencyType")'
        };

        $.currencyType(options);
    </script>
}
