@model GCTL.UI.Core.ViewModels.SupplierCategory.SupplierCategoryPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Supplier Category";
    Model.Breadcrumb = "Supplier Category";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Supplier Category",
                            SaveBtnClass = "js-SupplierCategory-save",
                            DeleteBtnClass = "js-SupplierCategory-delete-confirm",
                            ClearBtnClass = "js-SupplierCategory-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="SupplierCategory-form" asp-controller="SupplierCategory">
                            <div class="js-SupplierCategory-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "supplierCategoryTable",
                    AjaxUrl = "/SupplierCategory/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "supplierCategoryId",
                    CheckAllId = "SupplierCategory-check-all",
                    DefaultSortColumn = "supplierCategoryId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "supplierCategoryId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-SupplierCategory-edit" },
                        new() { Data = "supplierCategory", Header = "Supplier Category", Width = "90%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts{
    <script src="~/js/app.input.validation.js" defer></script>
    <script src="~/js/pages/supplierCategory.js" defer></script>
    <script type="text/javascript">
        (function waitForJQuery() {
            if (window.jQuery && typeof $.supplierCategory === "function") {
                var options = { baseUrl: '@Url.Action("", "SupplierCategory")' };
                options.load = () => { };
                $.supplierCategory(options);
            } else {
                setTimeout(waitForJQuery, 30);
            }
        })();
    </script>
}
