@using GCTL.UI.Core.ViewModels
<link rel="stylesheet" href="~/css/custom/custom-datatable.css" asp-append-version="true" />

@await Html.PartialAsync("_CustomGrid", new GridModel
{
    GridId = "openingBalanceTable",
    AjaxUrl = "/OpeningBlance/GetGridData",
    AjaxMethod = "POST",
    ServerSide = true,
    ShowCheckbox = true,
    CheckColumnData = "autoId",
    CheckAllId = "selectAllOpeningBalance",
    CheckboxClass = "js-openingbalance-check",
    ShowSearchBox = true,
    ShowPagination = true,
    Columns = new List<GridColumn>
    {
        new() { Data = "comOpeningBalanceCode", Header = "ID", Width = "5%", IsEditLink = true, EditSelectorClass = "js-openingbalance-edit", IdField = "autoId", Align = "center", SortField = "ComOpeningBalanceCode" },
        new() { Data = "accountHead", Header = "Account Head", Width = "35%", Align = "left", SortField = "AccountHead" },
        new() { Data = "openingBalance", Header = "Opening Balance", Width = "15%", Align = "right", SortField = "OpeningBalance" },
        new() { Data = "trType", Header = "Tr Type", Width = "10%", Align = "center", SortField = "TrType" },
        new() { Data = "companyName", Header = "Company", Width = "18%", Align = "left", SortField = "CompanyName" },
        new() { Data = "branchName", Header = "Branch", Width = "17%", Align = "left", SortField = "BranchName" }
    }
})



