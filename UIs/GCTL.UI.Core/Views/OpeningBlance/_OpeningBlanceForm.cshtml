@using GCTL.UI.Core.ViewModels

<div class="card shadow-sm rounded-2">

    @await Html.PartialAsync("_Toolbars", new ToobarModel
    {
        Title = "Opening Balance Entry",
        ShowSave = true,
        SaveBtnId = "BlanceSaveBtn",
        SaveBtnClass = "js-Blance-save BlanceSaveBtn",
        EnableSave = true,

        ShowDelete = true,
        DeleteBtnId = "BlancedeleteBtn",
        DeleteBtnClass = "js-Blance-delete-confirm BlancedeleteBtn",
        EnableDelete = true,

        ShowClear = true,
        ClearBtnId = "btnClear",
        ClearBtnClass = "js-Blance-clear BlanceresetBtn",
        EnableClear = true,

        ShowPrint = true,
        PrintBtnId = "btnPrint",
        PrintBtnClass = "printBtn",
        ExcelBtnClass = "export-excel",
        PdfBtnClass = "export-pdf",
        EnablePrint = true,

        ShowFavorite = true,
        FavtBtnId = "btnFav",
        FavtBtnClass = "BlancefavBtn",
        EnableFavorite = true
    })

    <div class="card-body">
        <form id="BlanceTypeForm">
            <fieldset style="border: 1px solid #ccc; padding: 12px; border-radius: 5px;">
                <input type="hidden" id="BlanceautoId" name="autoId" />

                <fieldset class="border rounded-3 p-3 mb-3">
                    <div class="row g-3">

                        @* 1. Company Code *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Select,
                            InputId = "CompanyCode",
                            InputName = "CompanyCode",
                            LabelText = "Company",
                            Placeholder = "-- Select Company --",
                            IsRequired = true
                        })

                        @* 2. Branch Code *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Select,
                            InputId = "BranchCode",
                            InputName = "BranchCode",
                            LabelText = "Branch",
                            Placeholder = "-- Select Branch --",
                            IsRequired = true
                        })

                    </div>

                    <div class="row g-3 mt-1">

                        @* 3. Account Head (Sub-Sidiary Ledger) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Select,
                            InputId = "SubSusidiaryLedgerCodeNo",
                            InputName = "SubSusidiaryLedgerCodeNo",
                            LabelText = "Account Head",
                            Placeholder = "-- Select Account Head --",
                            IsRequired = true
                        })

                        @* 4. Opening Balance *@
                        <div class="col-md-3">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                IsVisible = true,
                                ShowOnInit = true,
                                ColumnClass = "",
                                FieldType = FieldType.Number,
                                InputId = "OpeningBalance",
                                InputName = "OpeningBalance",
                                LabelText = "Opening Balance",
                                Placeholder = "Opening Balance",
                                IsRequired = true
                            })
                        </div>

                        @* 5. TrType *@
                        <div class="col-md-3">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                IsVisible = true,
                                ShowOnInit = true,
                                ColumnClass = "",
                                FieldType = FieldType.Select,
                                InputId = "TrType",
                                InputName = "TrType",
                                LabelText = "Select TrType",
                                Placeholder = "-- Select --",
                                IsRequired = true
                            })
                        </div>

                    </div>
                </fieldset>

                <hr class="my-3 mx-1">

                @* --- Entry & Update Date Section --- *@
                <div class="row g-3">
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "BlancedisplayLDate",
                        LabelText = "Entry Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "BlancedisplayModifyDate",
                        LabelText = "Last Update Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })
                </div>

                @* Bottom Save Button *@
                <div class="col-12">
                    @await Html.PartialAsync("_Toolbars", new ToobarModel
                    {
                        Title = "",
                        ShowClear = false,
                        ShowDelete = false,
                        ShowPrint = false,
                        ShowFavorite = false,
                        IsPlain = true,
                        ReserveActionSlot = true,
                        IsMarginRight = true,
                        SaveBtnType = "submit"
                    })
                </div>

            </fieldset>
        </form>
    </div>
</div>