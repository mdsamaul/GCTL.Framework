@model GCTL.UI.Core.ViewModels.CfDefPlaceOfLoading.CfDefPlaceOfLoadingPageViewModel


<div id="PlaceOfLoading-page">

    <div class="row">

        <div class="col-lg-6">

            <form id="PlaceOfLoading-form"
                  asp-action="Setup"
                  asp-controller="CfDefPlaceOfLoading"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="card">

                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            
                            @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                                    {
                                Title = "Place Of Loading Information",
                                SaveBtnClass = "js-PlaceOfLoading-save",
                                DeleteBtnClass = "js-PlaceOfLoading-delete-confirm",
                                ClearBtnClass = "js-PlaceOfLoading-clear"
                                    })
                        </h5>
                    </div>

                    <div class="card-body js-PlaceOfLoading-form-container">

                        @await Html.PartialAsync("_Setup", Model.Setup)

                    </div>

                </div>

            </form>

        </div>

        <div class="col-lg-6">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        
                    </h5>
                </div>

                <div class="card-body js-PlaceOfLoading-grid-container">

                    @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                    {
                        GridId = "PlaceOfLoading-grid",
                        AjaxUrl = "/CfDefPlaceOfLoading/GetTableData",
                        AjaxMethod = "GET",
                        ServerSide = false,
                        ShowCheckbox = true,
                        CheckColumnData = "placeOfLoadingId",
                        CheckAllId = "PlaceOfLoading-check-all",
                        DefaultSortColumn = "placeOfLoadingId",
                        DefaultSortDirection = "desc",
                        Columns = new()
                        {
                            new() { Data = "placeOfLoadingId", Header = "ID", Width = "15%", IsEditLink = true, EditSelectorClass = "js-PlaceOfLoading-edit" },
                            new() { Data = "placeOfLoading", Header = "Place Of Loading", Width = "50%" },
                            new() { Data = "shortName", Header = "Short Name", Width = "25%" }
                        }
                    })

                </div>

            </div>

        </div>

    </div>

</div>

<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/placeofloading.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
        if (window.jQuery && typeof $.placeOfLoading === "function") {
            var options = { baseUrl: '@Url.Action("", "CfDefPlaceOfLoading")' };
            options.load = () => { };
            $.placeOfLoading(options);
        } else {
            setTimeout(waitForJQuery, 30);
        }
    })();
</script>