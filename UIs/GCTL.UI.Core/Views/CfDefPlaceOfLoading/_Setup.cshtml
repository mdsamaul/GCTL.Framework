@model GCTL.Core.ViewModels.CfDefPlaceOfLoading.CfDefPlaceOfLoadingSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Place Of Loading ID ---------- *@

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "PlaceOfLoadingId",
            LabelText = "ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-PlaceOfLoadingId-code",
            DefaultValue = Model?.PlaceOfLoadingId
        })

        @* ---------- Place Of Loading ---------- *@

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "PlaceOfLoading",
            LabelText = "Place Of Loading",
            FieldType = FieldType.Text,
            Placeholder = "Enter Place Of Loading",
            IsRequired = true,
            AutoFocus = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-PlaceOfLoading-check-duplicateName",
            DefaultValue = Model?.PlaceOfLoading,

        })

    </div>

    <div class="form-group row">

        @* ---------- Short Name ---------- *@

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ShortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            DefaultValue = Model?.ShortName
        })

    </div>

    @if (Model.Tc > 0)
    {
        <hr />

        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate.HasValue
                    ? Model.Ldate?.ToString("dd/MM/yyyy")
                    : ""
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate.HasValue
                    ? Model.ModifyDate?.ToString("dd/MM/yyyy")
                    : ""
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top:9px;">
    <div class="col-12">

        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-PlaceOfLoading-save",
            ReserveActionSlot = true
        })

    </div>
</div>