@model GCTL.Core.ViewModels.ShipmentModeLedgerSetup.ShipmentModeLedgerSetupSetupViewModel
@using GCTL.UI.Core.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering

<div id="loadingIndicator" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-80%, -80%); z-index: 9999;">
    <img src="/images/Spinner.gif" alt="Loading..." style="width: 80px; height: 80px;" />
</div>

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" id="lastCode" />
    <input type="hidden" asp-for="Tc" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Ldate" />
    <input type="hidden" asp-for="ModifyDate" />

    @* ---------- Row 1: ID & Shipment Mode ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ExpenseTypeId",
            LabelText = "ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 sml-field-col",
            CustomCssClass = "js-ExpenseTypeId-code",
            DefaultValue = Model?.ExpenseTypeId
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ExpenseType",
            LabelText = "Shipment Mode",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Shipment Mode --",
            SelectItems = ViewBag.ShipmentDD as SelectList,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 sml-field-col"
        })
    </div>

    @* ---------- Row 2: Expense Ledger & Revenue Ledger ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ExpenseLedgerCodeNo",
            LabelText = "Expense Ledger",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Expense Ledger --",
            SelectItems = ViewBag.ExpenseDD as SelectList,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 sml-field-col"
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "RevenueLedgerCodeNo",
            LabelText = "Revenue Ledger",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Revenue Ledger --",
            SelectItems = ViewBag.RevenueDD as SelectList,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 sml-field-col"
        })
    </div>

    @* ---------- Row 3: Advance Ledger ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "AdvanceLedgerCode",
            LabelText = "Advance Ledger",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Advance Ledger --",
            SelectItems = ViewBag.AdvanceDD as SelectList,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 sml-field-col"
        })
    </div>

    <hr id="sectionBreak" style="display:none;" />
    <div class="row g-4 mb-1" id="LdateModifyHide" style="display:none;">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "creationDateSpan",
            LabelText = "Creation Date:",
            FieldType = FieldType.ReadonlyDisplay,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 sml-field-col",
            ShowOnInit = Model.Ldate.HasValue,
            DefaultValue = Model.Ldate.HasValue ? Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt") : ""
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "modifyDateSpan",
            LabelText = "Last Update Date:",
            FieldType = FieldType.ReadonlyDisplay,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 sml-field-col",
            ShowOnInit = Model.ModifyDate.HasValue,
            DefaultValue = Model.ModifyDate.HasValue ? Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt") : ""
        })

    </div>

</div>

<div class="row g-4 no-print" style="margin-top: 9px;">
    <div class="col-12 col-md-6 col-xxl-12 sml-toolbar-col">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-ShipmentModeLedgerSetup-save",
            ReserveActionSlot = true,
            Style = "border-bottom:0px !important; padding-left:605px",
            ShowExtraContentLaptopOnly = true,
            ShowExtraContent1 = true,
            ShowExtraContent2 = false
        })
    </div>
</div>