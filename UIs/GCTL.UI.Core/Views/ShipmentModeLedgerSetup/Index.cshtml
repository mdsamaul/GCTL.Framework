@model GCTL.UI.Core.ViewModels.ShipmentModeLedgerSetup.ShipmentModeLedgerSetupPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Shipment Mode Ledger Setup";
    Model.Breadcrumb = "Shipment Mode Ledger Setup";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Shipment Mode Ledger Setup",
                            SaveBtnClass = "js-ShipmentModeLedgerSetup-save",
                            DeleteBtnClass = "js-ShipmentModeLedgerSetup-delete-confirm",
                            ClearBtnClass = "js-ShipmentModeLedgerSetup-clear"
                        })
                    </div>

                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="ShipmentModeLedgerSetup-form" asp-controller="ShipmentModeLedgerSetup">
                            <div class="js-ShipmentModeLedgerSetup-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GridModel
                {
                    GridId = "ShipmentModeLedgerSetup-grid",
                    AjaxUrl = "/ShipmentModeLedgerSetup/GetTableData",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckboxClass = "checkBox",
                    CheckColumnData = "expenseTypeId",
                    CheckAllId = "js-ShipmentModeLedgerSetup-checkall",
                    DefaultSortColumn = "expenseTypeId",
                    Columns = new()
                    {
                        new() { Data = "expenseTypeId", IsEditLink = true, EditSelectorClass = "js-ShipmentModeLedgerSetup-edit", Header = "ID", Width = "10%" },
                        new() { Data = "expenseType", Header = "Shipment Mode", Width = "22%", Align = "left" },
                        new() { Data = "expenseLedgerCodeNo", Header = "Expense Ledger", Width = "22%", Align = "left" },
                        new() { Data = "revenueLedgerCodeNo", Header = "Revenue Ledger", Width = "22%", Align = "left" },
                        new() { Data = "advanceLedgerCode", Header = "Advance Ledger", Width = "24%", Align = "left" }
                    }
                })
            </div>

        </div>
        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/shipmentModeLedgerSetup.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "ShipmentModeLedgerSetup")'
        };

        $.shipmentModeLedgerSetup(options);
    </script>
}
