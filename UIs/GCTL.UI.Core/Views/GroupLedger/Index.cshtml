@model GCTL.Core.ViewModels.Finance.ChartOfAccounts.GroupLedgerAddVM

<div class="coa-wrap">
    <partial name="~/Views/Shared/_ChartOfAccountsTabs.cshtml" model='@("GroupLedger")' />

    <!-- Setup Form Card -->
    <div class="coa-card">
        <div class="coa-ch" id="GroupLedger-formTitle">
            @Html.SmartLocalize("Group Ledger: new entry")
        </div>

        <form id="GroupLedger-form">
            <input type="hidden" id="GroupLedger-isEdit" value="0" />
            
            <!-- Group Ledger Entry Fields (Single line within equal columns) -->
            <div class="coa-entry-row">
                <div class="coa-form-col">
                    <label class="coa-form-label" title="@Html.SmartLocalize("GRL Code (auto)")">
                        @Html.SmartLocalize("GRL Code (auto)")
                    </label>
                    <div class="coa-code-preview" id="GroupLedgerCodePreview">
                        <span class="text-muted">@Html.SmartLocalize("Auto Generated")</span>
                    </div>
                    <input type="hidden" asp-for="GroupLedgerCodeNo" id="GroupLedgerCodeNo" />
                    <span asp-validation-for="GroupLedgerCodeNo" class="text-danger small"></span>
                </div>

                <div class="coa-form-col">
                    <label class="coa-form-label" for="GroupLedgerName" title="@Html.SmartLocalize("Group Ledger Name *")">
                        @Html.SmartLocalize("Group Ledger Name *")
                    </label>
                    <input type="text" class="coa-form-control" asp-for="GroupLedgerName" id="GroupLedgerName" placeholder="@Html.SmartLocalize("Enter Group Ledger name")" />
                    <span asp-validation-for="GroupLedgerName" class="text-danger small"></span>
                </div>

                <div class="coa-form-col">
                    <label class="coa-form-label" for="ShortName" title="@Html.SmartLocalize("Short Name")">
                        @Html.SmartLocalize("Short Name")
                    </label>
                    <input type="text" class="coa-form-control" asp-for="ShortName" id="ShortName" placeholder="@Html.SmartLocalize("Short Name")" />
                    <span asp-validation-for="ShortName" class="text-danger small"></span>
                </div>

                <div class="coa-form-col-auto">
                    <label class="coa-form-label d-none d-lg-block">&nbsp;</label>
                    <div class="d-flex align-items-center" style="height: 38px;">
                        <label class="coa-in mb-0">
                            <input type="checkbox" asp-for="IsActive" id="IsActive" value="true" checked />
                            <span>@Html.SmartLocalize("Active")</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="coa-fa">
                <button type="submit" class="coa-btn pri" id="GroupLedger-saveBtn">
                    @Html.SmartLocalize("Save")
                </button>
                <button type="button" class="coa-btn" id="GroupLedger-resetBtn">
                    @Html.SmartLocalize("Clear")
                </button>
            </div>
        </form>
    </div>

    <!-- Table Card -->
    <partial name="_Table" />
</div>

<partial name="_ConfirmDelete" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/finance/groupLedger.js" asp-append-version="true"></script>
}
