@model GCTL.Core.ViewModels.PaymentTerms.PaymentTermsSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="AutoId" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Payment Terms ID (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "PaymentTermsId",
            LabelText = "ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-PaymentTermsId-code",
            DefaultValue = Model?.PaymentTermsId
        })

        @* ---------- Type (Select) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Type",
            LabelText = "Type",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Type --",
            SelectItems = ViewBag.TypeDD as SelectList,
            IsRequired = true,
            ColumnClass = "col-lg-6",
            DefaultValue = Model?.Type
        })
    </div>

    <div class="form-group row">
        @* ---------- Percentise ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Percentise",
            LabelText = "Percentage (%)",
            FieldType = FieldType.Number,
            Placeholder = "Enter Percentage",
            IsRequired = true,
            ColumnClass = "col-lg-6",
            DefaultValue = Model?.Percentise
        })

        @* ---------- Credit Days ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CreditDays",
            LabelText = "Credit Days",
            FieldType = FieldType.Number,
            Placeholder = "Enter Credit Days",
            ColumnClass = "col-lg-6",
            DefaultValue = Model?.CreditDays?.ToString()
        })
    </div>

    <div class="form-group row">
        @* ---------- Payment Terms Name (calculated, readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "PaymentTermsName",
            LabelText = "Payment Terms Name",
            FieldType = FieldType.Textarea,
            Placeholder = "Calculated Payment Terms Name",
            IsReadonly = true,
            ColumnClass = "col-lg-12",
            DefaultValue = Model?.PaymentTermsName
        })
    </div>

    @if (Model != null && (Model.AutoId > 0 || Model.Tc > 0))
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }
</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-paymentterms-save",
            ReserveActionSlot = true,
        })
    </div>
</div>