@model GCTL.UI.Core.ViewModels.PaymentTerms.PaymentTermsPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Payment Terms";
    Model.Breadcrumb = "Payment Terms";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid px-3 px-xl-4">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Payment Terms",
                            SaveBtnClass = "js-paymentterms-save",
                            DeleteBtnClass = "js-paymentterms-delete-confirm",
                            ClearBtnClass = "js-paymentterms-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="paymentterms-form" asp-controller="PaymentTerms">
                            <div class="js-paymentterms-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "paymentTermsTable",
                    AjaxUrl = "/PaymentTerms/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "paymentTermsId",
                    CheckAllId = "paymentterms-check-all",
                    DefaultSortColumn = "paymentTermsId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "paymentTermsId", Header = "Code", Width = "15%", IsEditLink = true, EditSelectorClass = "js-paymentterms-edit" },
                        new() { Data = "paymentTermsName", Header = "Payment Terms Name", Width = "35%", Align = "left" },
                        new() { Data = "paymentType", Header = "Type", Width = "20%", Align = "left" },
                        new() { Data = "percentise", Header = "Percentage", Width = "15%", Align = "center" },
                        new() { Data = "creditDays", Header = "Credit Days", Width = "15%", Align = "center" }
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/paymentTerms.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $.paymentTerms({
                baseUrl: '/PaymentTerms'
            });
        });
    </script>
}