@model List<GCTL.Core.ViewModels.EmployeeContactInfos.EmployeeContactInfosSetupViewModel>

<table id="EmployeeContactInfos-grid" class="table table-striped  table-bordered table-sm table-hover table-common">

        <thead class="row-border">
            <tr class="table row-border">
                <th class="text-center text-middle" style="width: 5%;">
                    Select <br /> <input type="checkbox" id="EmployeeContactInfos-check-all" />
                </th>
                <th class="text-center text-middle" style="width: 6%;">Employee Id</th>
                <th class="text-center text-middle" style="width: 24%;"> Name</th>
                <th class="text-center text-middle" style="width: 24%;">Parmanent Address</th>
                <th class="text-center text-middle" style="width: 13%;">Post Office</th>
                <th class="text-center text-middle" style="width: 12%;">Thana</th>
                <th class="text-center text-middle" style="width: 10%;">District</th>
                <th class="text-center text-middle" style="width: 6%;">Action</th>
            </tr>
        </thead>
        <tbody>

            @if (Model == null || !Model.Any())
            {
                @* <tr class="text-center text-middle">
                    <td colspan="8">No  Employee Contact Infos Available.</td>
                </tr> *@
            }
            else
            {
            @foreach (var item in Model.OrderByDescending(x => x.EmpContactId))
                {
                    <tr>
                        <td class="text-center text-middle">
                            <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.EmpContactId" value="@item.EmpContactId" />
                        </td>
                        <td class="text-center text-middle">
                        <a title="Edit @($"{item.EmployeeName}'s Contact")" style="text-decoration: underline;" class="js-EmployeeContactInfos-edit" data-id="@item.EmpContactId">
                            @item.EmployeeId
                            </a>
                        </td>

                        <td class="text-left">@($"{item.EmployeeName}")</td>
                    <td class="text-left">@($"{item.ParmanentAddress}")</td>
                        <td class="text-center text-middle">@item.ParmanentPostOffice</td>
                        <td class="text-center text-middle">@item.ParmanentThana</td>
                        <td class="text-center text-middle">@item.DistrictName</td>

                        <td class="text-center text-middle">

                        <a title="Edit @($"{item.EmpContactId}")"
                           class="btn btn-sm js-EmployeeContactInfos-edit"
                           data-id="@item.EmpContactId"
                           data-employee-id="@item.EmployeeId"
                           href="javascript:void(0)">
                            <i class="fas fa-pencil-alt"></i>
                        </a>
                            <button type="button" title="Delete @($"{item.EmpContactId}")" class="btn  btn-sm js-EmployeeContactInfos-delete-confirm">
                                <i class="fas fa-trash fa-sm">&nbsp;</i>
                            </button>

                        </td>
                    </tr>
                }
            }

        </tbody>

</table>