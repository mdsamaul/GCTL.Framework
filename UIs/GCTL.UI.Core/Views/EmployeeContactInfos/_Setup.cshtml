@model GCTL.Core.ViewModels.EmployeeContactInfos.EmployeeContactInfosSetupViewModel
@using GCTL.UI.Core.ViewModels

                            <div style="padding-top: 10px;">

                                @* <input type="text" asp-for="Id" /> *@
                                <input type="hidden" asp-for="Ldate" />
                                <input type="hidden" asp-for="ModifyDate" />
                                <input type="hidden" asp-for="EmpContactId" />
                                <input type="hidden" asp-for="AutoId" />
                                <input type="hidden" id="SelectedBranchCode" value="@ViewBag.SelectedBranchCode" />
                                <input type="hidden" id="SelectedBranchName" value="@ViewBag.SelectedBranchName" />

                                <!-- ==================== HEADER ==================== -->
                                <div class="card" style="background: linear-gradient(to right, #f7fcff, #ffffff) !important;">
                                    <div class="card-body">

                                        <!-- Row 1: Company + Branch -->
                                        <div class="form-group row">
                                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                            {
                                                InputId = "CompanyCode",
                                                LabelText = "Company",
                                                FieldType = FieldType.Select,
                                                Placeholder = "Select Company",
                                                IsRequired = true,
                                                ColumnClass = "col-lg-5",
                                                LabelInline = true,
                                                LabelColWidth = 4,
                                                LabelColumnClass = "text-end",
                                                LabelCssClass = "fw-semibold",
                                                SelectItems = ViewBag.CoreCompanyDD as SelectList,
                                                DefaultValue = Model.CompanyCode,
                                                ReserveActionSlot = true
                                            })

                                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                            {
                                                InputId = "BranchCode",
                                                LabelText = "Branch",
                                                FieldType = FieldType.Select,
                                                Placeholder = "Select Branch",
                                                IsRequired = true,
                                                ColumnClass = "col-lg-5",
                                                LabelInline = true,
                                                LabelColWidth = 4,
                                                LabelColumnClass = "text-end",
                                                LabelCssClass = "fw-semibold",
                                                SelectItems = ViewBag.CoreBranchDD as SelectList,
                                                DefaultValue = Model.BranchCode,
                                                ReserveActionSlot = true
                                            })
                                        </div>

                                        <!-- Row 2: Employee Id + Employee Name -->
                                        <div class="form-group row mt-2">
                                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                            {
                                                InputId = "EmployeeId",
                                                LabelText = "Employee Id",
                                                FieldType = FieldType.Select,
                                                Placeholder = "Select Employee",
                                                IsRequired = true,
                                                ColumnClass = "col-lg-5",
                                                LabelInline = true,
                                                LabelColWidth = 4,
                                                LabelColumnClass = "text-end",
                                                LabelCssClass = "fw-semibold",
                                                SelectItems = ViewBag.EmployeeDD as SelectList,
                                                DefaultValue = Model.EmployeeId,
                                                ReserveActionSlot = true
                                            })

                                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                            {
                                                InputId = "FullName",
                                                LabelText = "Employee Name:",
                                                FieldType = FieldType.ReadonlyDisplay,
                                                ColumnClass = "col-lg-5",
                                                LabelInline = true,                 // ← এটা
                                                LabelColWidth = 4,
                                                LabelColumnClass = "text-end",      // ← এটা
                                                LabelCssClass = "form-label mb-0 fw-semibold",
                                                DefaultValue = Model.EmployeeName
                                            })
                                        </div>

                                        <!-- Row 3: Designation + Department -->
                                        <div class="form-group row mt-2">
                                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                            {
                                                InputId = "DesignationName",
                                                LabelText = "Designation:",
                                                FieldType = FieldType.ReadonlyDisplay,
                                                ColumnClass = "col-lg-5",
                                                LabelInline = true,                 // ← এটা
                                                LabelColWidth = 4,
                                                LabelColumnClass = "text-end",
                                                LabelCssClass = "form-label mb-0 fw-semibold",
                                                DefaultValue = Model.DesignationName
                                            })

                                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                            {
                                                InputId = "DepartmentName",
                                                LabelText = "Department:",
                                                FieldType = FieldType.ReadonlyDisplay,
                                                ColumnClass = "col-lg-5",
                                                LabelInline = true,                 // ← এটা
                                                LabelColWidth = 4,
                                                LabelColumnClass = "text-end",
                                                LabelCssClass = "form-label mb-0 fw-semibold",
                                                DefaultValue = Model.DepartmentName
                                            })
                                        </div>

                                    </div>
                                </div>

                                <!-- ==================== PERMANENT ADDRESS ==================== -->
                                <div style="position:relative; background: white; border: 0.5px solid #dddddd82;" class="row shadow my-3 py-3 rounded">
                                    <div style="position:absolute;  width:auto; top:-10px; background:#fff; padding:0 10px; border: .5px solid #dddddd82; left: 10px;" class="rounded">
                                        <h5 style="margin:0;"><small>Permanent Address</small></h5>
                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "ParmanentAddress",
                                            LabelText = "Address",
                                            FieldType = FieldType.Textarea,
                                            Placeholder = "Enter Address",
                                            ColumnClass = "col-lg-4",
                                            Rows = 1,
                                            AutoFocus = true,
                                            DefaultValue = Model.ParmanentAddress,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "ParmanentAddressBangla",
                                            LabelText = "Address (বাংলা)",
                                            FieldType = FieldType.Textarea,
                                            Placeholder = "Enter Address (বাংলা)",
                                            ColumnClass = "col-lg-4",
                                            Rows = 1,
                                            DefaultValue = Model.ParmanentAddressBangla,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "ParmanentPostOffice",
                                            LabelText = "Post Office",
                                            FieldType = FieldType.Text,
                                            Placeholder = "Enter Post Office",
                                            ColumnClass = "col-lg-4",
                                            DefaultValue = Model.ParmanentPostOffice,
                                            ReserveActionSlot = true
                                        })

                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "ParmanentThana",
                                            LabelText = "Thana",
                                            FieldType = FieldType.Text,
                                            Placeholder = "Enter Thana",
                                            ColumnClass = "col-lg-4",
                                            DefaultValue = Model.ParmanentThana,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "ParmanentPostCode",
                                            LabelText = "PostCode",
                                            FieldType = FieldType.Text,
                                            Placeholder = "Enter PostCode",
                                            ColumnClass = "col-lg-4",
                                            DefaultValue = Model.ParmanentPostCode,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "ParmanentDistrict",
                                            LabelText = "District",
                                            FieldType = FieldType.Select,
                                            Placeholder = "Select District",
                                            ColumnClass = "col-lg-4",
                                            SelectItems = ViewBag.DistrictDD as SelectList,
                                            ShowQuickAdd = true,
                                            QuickAddUrl = Url.Action("Index", "Districts"),
                                            QuickAddTarget = "#ParmanentDistrict",
                                            QuickAddReloadUrl = Url.Action("GetDistrictsSelections", "Cascading"),
                                            QuickAddTitle = "Districts",
                                            DefaultValue = Model.ParmanentDistrict,
                                            ReserveActionSlot = true
                                        })

                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
