@model ToobarModel
<div class="row">
    <div class="col-md-10">
        <h6 class="page-title">@Model.Title</h6>
    </div>
    <div class="btn-toolbar col-md-2 d-flex justify-content-end">
        <div class="btn-group">
            <button type="button" class="btn btn-default success-btn js-EmployeeContactInfos-save" data-toggle="tooltip" data-placement="bottom" title="Save">
                <i class="fas fa-save">&nbsp;</i> Save
            </button>
            <button type="button" class="btn btn-default primary-btn js-EmployeeContactInfos-clear" data-toggle="tooltip" data-placement="bottom" title="Clear">
                <i class="fas fa-sync">&nbsp;</i> Clear
            </button>
        </div>
    </div>
</div>