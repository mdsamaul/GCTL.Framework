@model GCTL.Core.ViewModels.BranchesTypeInfo.BranchTypeSetupViewModel

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <div class="col-12 col-md-6 gc-inline-select2">
            <label asp-for="CompanyCode">Company</label>
            <span class="text-danger"></span>
            <div class="input-group flex-nowrap">  
                <div class="input-group input-group-sm">

                    <select asp-for="CompanyCode"
                            class="form-select custom-select-single"
                            data-placeholder="Select Company"
                            asp-items="@ViewBag.CompanyCodeDD as SelectList">
                        <option></option>
                    </select>

                    <button type="button"
                            class="btn btn-outline-secondary js-quick-add"
                            data-url="@Url.Action("Index", "Companies")"
                            data-target="#CompanyCode"
                            data-reload-url="@Url.Action("GetCompany", "Cascading")"
                            data-title="Company">
                        <i class="fas fa-plus"></i>
                    </button>

                </div>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-12 col-md-6">
            <label asp-for="BranchCode">Branch Id</label>
            <input asp-for="BranchCode" class="form-control form-control-sm js-branchcode" readonly="readonly" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-12 col-md-6 mb-2 mb-md-0">
            <label asp-for="BranchName">Branch</label>
            <span class="text-danger">*</span>
            <input asp-for="BranchName" class="form-control form-control-sm js-branch-check-availability" placeholder="Enter Branch" />
            <span asp-validation-for="BranchName" class="text-danger" />
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Address">Address</label>
            <span class="text-danger">*</span>
            <textarea asp-for="Address" class="form-control form-control-sm" placeholder="Enter Address" style="resize:none;" rows="1"></textarea>
            <span asp-validation-for="Address" class="text-danger" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-12 col-md-6 mb-2 mb-md-0">
            <label asp-for="BanglaBranch">Branch (বাংলা)</label>
            <input asp-for="BanglaBranch" type="text" class="form-control form-control-sm" placeholder="Enter Branch (বাংলা)" />
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="AddressBangla">Address (বাংলা)</label>
            <input asp-for="AddressBangla" type="text" class="form-control form-control-sm" placeholder="Enter Address (বাংলা)" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-12 col-md-6 mb-2 mb-md-0">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="form-control form-control-sm phone-validationx" placeholder="Enter Phone" />
            <span asp-validation-for="Phone" class="text-danger" />
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control form-control-sm" placeholder="Enter Email" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-12 col-md-6">
            <label asp-for="Fax">Fax</label>
            <input asp-for="Fax" class="form-control form-control-sm" placeholder="Enter Fax" />
        </div>
    </div>

    @if (Model.Id > 0)
    {
        <hr />
        <div class="form-group row">
            <div class="col-12 col-md-6 mb-2 mb-md-0">
                @if (Model.Ldate.HasValue)
                {
                    <label>Creation Date: </label>
                    <label>@Model.Ldate.Value.ToString()</label>
                }
            </div>
            <div class="col-12 col-md-6">
                @if (Model.ModifyDate.HasValue)
                {
                    <label>Last Update Date: </label>
                    <label>@Model.ModifyDate.Value.ToString()</label>
                }
            </div>
        </div>
    }
</div>

<div class="btn-toolbar d-flex justify-content-end no-print" style="margin-top: 9px;">
    <div class="btn-group ms-auto">
        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "branch"
        })
    </div>
</div>