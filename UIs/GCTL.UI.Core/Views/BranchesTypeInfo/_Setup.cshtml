@model GCTL.Core.ViewModels.BranchesTypeInfo.BranchTypeSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Company (Select + Quick Add) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyCode",
            LabelText = "Company",
            FieldType = FieldType.Select,
            Placeholder = "Select Company",
            SelectItems = ViewBag.CompanyCodeDD as SelectList,
            ColumnClass = "col-lg-6",
            ShowQuickAdd = true,
            QuickAddUrl = Url.Action("Index", "Companies"),
            QuickAddTarget = "#CompanyCode",
            QuickAddReloadUrl = Url.Action("GetCompany", "Cascading"),
            QuickAddTitle = "Company"
        })

        
    </div>

    <div class="form-group row">
        

        @* ---------- Branch Id (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BranchCode",
            LabelText = "Branch Id",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-branchcode",
            DefaultValue = Model?.BranchCode
        })
    </div>

    <div class="form-group row">

        @* ---------- Branch Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BranchName",
            LabelText = "Branch",
            FieldType = FieldType.Text,
            Placeholder = "Enter Branch",
            IsRequired = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-branch-check-availability",
            DefaultValue = Model.BranchName,
            AutoFocus = true
        })

        @* ---------- Address ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Address",
            LabelText = "Address",
            FieldType = FieldType.Textarea,
            Placeholder = "Enter Address",
            IsRequired = true,
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Address
        })
    </div>

    <div class="form-group row">

        @* ---------- Branch (বাংলা) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BanglaBranch",
            LabelText = "Branch (বাংলা)",
            FieldType = FieldType.Text,
            Placeholder = "Enter Branch (বাংলা)",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.BanglaBranch
        })

        @* ---------- Address (বাংলা) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "AddressBangla",
            LabelText = "Address (বাংলা)",
            FieldType = FieldType.Text,
            Placeholder = "Enter Address (বাংলা)",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.AddressBangla
        })
    </div>

    <div class="form-group row">

        @* ---------- Phone ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone",
            LabelText = "Phone",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone",
            ColumnClass = "col-lg-6",
            CustomCssClass = "phone-validationx",
            DefaultValue = Model.Phone
        })

        @* ---------- Email ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Email
        })
    </div>

    <div class="form-group row">

        @* ---------- Fax ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Fax",
            LabelText = "Fax",
            FieldType = FieldType.Text,
            Placeholder = "Enter Fax",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Fax
        })
    </div>

    @if (Model.Id > 0)
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-branch-save",
            ReserveActionSlot = true,
            IsMarginRight = true
        })
    </div>
</div>