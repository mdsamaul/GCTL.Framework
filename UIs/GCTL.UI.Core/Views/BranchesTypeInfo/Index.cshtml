@model GCTL.UI.Core.ViewModels.BranchesTypeInfo.BranchTypePageViewModel

@{
    ViewBag.Title = "BranchesTypeInfo";
    Model.Breadcrumb = "Branch Information";
    Model.PageTitle = ViewBag.Title;
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }

    .btn-group-sm > .btn, .btn-sm {
        --bs-btn-padding-y: 0.3rem !important;
    }



    /* .custom-dd-box {
        border-radius: .375rem .0rem 0rem .375rem;
    } */
</style>

<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6 ps-0 pe-1">
                <div class="card">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                    {
                    Title = "Branch",
                            SaveBtnClass = "js-branch-save",
                            DeleteBtnClass = "js-branch-delete-confirm",
                            ClearBtnClass = "js-branch-clear"
                })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" id="branch-form">
                            <div class="js-branch-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6 pe-0 ps-1">
                        <div class="js-branch-grid-container">
                            <partial name="_Grid" />
                        </div>
            </div>
        </div>
    </div>
    <partial name="_BottomNavigation" />

</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/branchesTypeInfo.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
        if (window.jQuery && typeof $.branchesTypeInfo === "function") {
            var options = { baseUrl: '@Url.Action("", "BranchesTypeInfo")' };
            options.load = () => { };
            $.branchesTypeInfo(options);
        } else {
            setTimeout(waitForJQuery, 30);
        }
    })();
</script>
