@using GCTL.UI.Core.ViewModels

<div class="card shadow-sm rounded-2">

    @* ================= Toolbar Section ================= *@
    @await Html.PartialAsync("_Toolbars", new ToobarModel
    {
        Title = "Voucher Type",
        ShowSave = true,
        SaveBtnId = "VoucherSaveBtn",
        SaveBtnClass = "js-VoucherType-save VoucherSaveBtn",
        EnableSave = true,

        ShowDelete = true,
        DeleteBtnId = "VoucherdeleteBtn",
        DeleteBtnClass = "js-VoucherType-delete-confirm VoucherdeleteBtn",
        EnableDelete = true,

        ShowClear = true,
        ClearBtnId = "btnClear",
        ClearBtnClass = "js-VoucherType-clear VoucherresetBtn",
        EnableClear = true,

        ShowPrint = true,
        PrintBtnId = "btnPrint",
        PrintBtnClass = "printBtn",
        ExcelBtnClass = "export-excel",
        PdfBtnClass = "export-pdf",
        EnablePrint = true,

        ShowFavorite = true,
        FavtBtnId = "btnFav",
        FavtBtnClass = "VoucherfavBtn",
        EnableFavorite = true
    })

    <div class="card-body">
        <form id="VoucherTypeForm">
            <fieldset style="border: 1px solid #ccc; padding: 12px; border-radius: 5px;">
                <input type="hidden" id="VoucherautoId" name="autoId" />

                <fieldset class="border rounded-3 p-3 mb-3">
                    <div class="row g-3">

                        @* 1. Voucher Type *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Text,
                            InputId = "VoucherTypeName",
                            InputName = "Voucher_TypeName",
                            LabelText = "Voucher Type",
                            Placeholder = "Voucher Type",
                            IsRequired = true
                        })

                        @* 2. Description *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Text,
                            InputId = "Description",
                            InputName = "Description",
                            LabelText = "Description",
                            Placeholder = "Description",
                            IsRequired = true
                        })

                        @* 3. Numbering Method *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Select,
                            InputId = "numberingMethod",
                            InputName = "numberingMethod",
                            LabelText = "Numbering Method",
                            Placeholder = "Numbering Method",
                            IsRequired = true
                        })

                        @* 4. Starting Number *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Number,
                            InputId = "startingNumber",
                            InputName = "startingNumber",
                            Placeholder = "Starting Number",
                            LabelText = "Starting Number"
                        })

                        @* 5. Reset Duration *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Number,
                            InputId = "resetDuration",
                            InputName = "resetDuration",
                            LabelText = "Reset Duration",
                            Placeholder = "Reset Duration",
                            IsRequired = true
                        })

                        @* Duration Type *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Select,
                            InputId = "resetDurationTypeCode",
                            InputName = "resetDurationTypeCode",
                            LabelText = "Duration Type",
                            Placeholder = "Duration Type",
                            IsRequired = true
                        })                     

                        @* 7. Prefix *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Text,
                            InputId = "prefix",
                            InputName = "prefix",
                            LabelText = "Prefix",
                            Placeholder = "Prefix",
                            IsRequired = true
                        })

                        @* 8. Suffix *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Text,
                            InputId = "suffix",
                            InputName = "suffix",
                            Placeholder = "suffix",
                            LabelText = "Suffix"
                        })

                        @* 9. Padding *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-4",
                            FieldType = FieldType.Number,
                            InputId = "padding",
                            InputName = "padding",
                            LabelText = "Padding",
                            Placeholder = "Padding",
                            IsRequired = true
                        })

                    </div>
                </fieldset>

                <hr class="my-3 mx-1">

                @* --- Entry & Update Date Section --- *@
                <div class="row g-3">
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "VoucherdisplayLDate",
                        LabelText = "Entry Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "VoucherdisplayModifyDate",
                        LabelText = "Last Update Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })
                </div>

                @* Bottom Save Button *@
                <div class="col-12">
                    @await Html.PartialAsync("_Toolbars", new ToobarModel
                    {
                        Title = "",
                        ShowClear = false,
                        ShowDelete = false,
                        ShowPrint = false,
                        ShowFavorite = false,
                        IsPlain = true,
                        ReserveActionSlot = true,
                        IsMarginRight = true,
                        SaveBtnType = "submit"
                    })
                </div>

            </fieldset>
        </form>
    </div>
</div>