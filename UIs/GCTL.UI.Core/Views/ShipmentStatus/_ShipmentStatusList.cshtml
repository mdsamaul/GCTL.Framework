@using GCTL.UI.Core.ViewModels

@await Html.PartialAsync("_CustomGrid", new GridModel
{
    GridId = "shipmentStatusTable",
    AjaxUrl = "/shipment-status/get-grid-data",
    AjaxMethod = "POST",
    ServerSide = true,
    ShowCheckbox = true,
    CheckColumnData = "autoId",
    CheckAllId = "selectAllShipmentStatus",
    CheckboxClass = "js-shipmentstatus-check",
    ShowSearchBox = true,
    ShowPagination = true,
    Columns = new List<GridColumn>
    {
        new() { Data = "shipmentStatusId", Header = "Status ID", Width = "15%", IsEditLink = true, EditSelectorClass = "js-shipmentstatus-edit", IdField = "autoId", Align = "center", SortField = "ShipmentStatusId" },
        new() { Data = "shipmentStatus", Header = "Shipment Status", Width = "35%", Align = "left", SortField = "ShipmentStatus" },
        new() { Data = "shortName", Header = "Short Name", Width = "20%", Align = "left", SortField = "ShortName" },
        new() { Data = "transportModeType", Header = "Transport Mode", Width = "30%", Align = "left", SortField = "transportModeType" }
    }
})