@using GCTL.UI.Core.ViewModels

<div class="card shadow-sm rounded-2">
    <div class="card-body px-2">
        <form id="shipmentStatusForm">
            <input type="hidden" id="autoId" name="autoId" />

            <div class="row g-3">

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            InputId = "statusTransportModeTypeId",
                    LabelText = "Transport Mode Type:",
                    FieldType=FieldType.Select,
                    Placeholder = "Select Transport Mode",
                    SelectItems = ViewBag.TransportModeTypes as SelectList,
                    ColumnClass="col-md-6 mt-1",
                    ShowQuickAdd=true,
                    QuickAddUrl = Url.Action("Index", "TransportModeType"),
                    QuickAddTarget = "#statusTransportModeTypeId",
                    QuickAddReloadUrl = Url.Action("GettransportModes", "Cascading"),
                    QuickAddTitle = "Transport Mode Type"
                        })


                <div class="col-md-6 mt-1">
                </div>

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                    InputId = "shipmentStatusId",
                    LabelText = "Shipment Status ID",
                    FieldType=FieldType.Text,
                    Placeholder = "select Shipment Status",
                    IsReadonly= true,
                    ReserveActionSlot=true,
                    ColumnClass="col-6 mt-1"
                        })


                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                    InputId = "shipmentStatus",
                    LabelText = "Shipment Status",
                    IsRequired=true,
                    FieldType=FieldType.Text,
                    ReserveActionSlot=true,
                    Placeholder = "Enter Shipment Status",
                    ColumnClass="col-6 mt-1"
                        })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "statusShortName",
                    LabelText = "Short Name",
                    FieldType = FieldType.Text,
                    ReserveActionSlot = true,
                    ColumnClass = "col-6 mt-1",
                    Placeholder = "Enter Short Name"
                })

            </div>

            <div class="row g-3 mt-2">
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    ContainerId = "statusLDateContainer",
                    InputId = "statusDisplayLDate",
                    LabelText = "Creation Date:",
                    FieldType=FieldType.ReadonlyDisplay,
                    ColumnClass="col-6 mt-1",
                    ReserveActionSlot=true,
                    ShowOnInit=false
                })
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    ContainerId = "statusModifyDateContainer",
                    InputId = "statusDisplayModifyDate",
                    LabelText = "Modify Date:",
                    FieldType=FieldType.ReadonlyDisplay,
                    ColumnClass="col-6 mt-1",
                    ReserveActionSlot=true,ShowOnInit=false
                })
            </div>

            <div class="row mt-3">
                @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                {
                    SaveBtnClass = "saveShipmentStatusBtn",
                    ShowClear = false,
                    ShowDelete = false,
                    ShowFavorite = false,
                    ShowPrint = false,
                    IsPlain = true,
                    IsMarginRight=true
                })
            </div>
        </form>
    </div>
</div>