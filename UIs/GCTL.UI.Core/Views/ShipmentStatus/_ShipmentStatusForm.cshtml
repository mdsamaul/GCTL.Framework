<style>
    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: goldenrod !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }
</style>

<div class="card shadow-sm rounded-2">

    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
        Title = "Shipment Status",
        SaveBtnClass = "saveShipmentStatusBtn",
        DeleteBtnClass = "deleteShipmentStatusBtn",
        ClearBtnClass = "resetBtn",
        PdfBtnClass = "export-pdf",
        ExcelBtnClass = "export-excel",
        FavtBtnClass = "favBtn"
    })

    <div class="card-body">
        <form id="shipmentStatusForm">
            <input type="hidden" id="autoId" name="autoId" />

            <div class="row g-3">

                <div class="col-md-6 mt-1">
                    <label for="statusTransportModeTypeId" class="form-label fw-semibold">
                        Transport Mode Type:
                    </label>
                    <span class="text-danger"></span>
                    <div class="input-group flex-nowrap">
                        <div class="input-group input-group-sm">

                            <select id="statusTransportModeTypeId" name="transportModeTypeId"
                                    class="form-select form-select-sm custom-select-single"
                                    data-placeholder="Select Transport Mode"
                                    asp-items="ViewBag.TransportModeTypes">
                                <option></option>
                            </select>

                        </div>
                    </div>
                </div>

                <div class="col-md-6 mt-1">
                </div>

                <div class="col-md-6 mt-1">
                    <label for="shipmentStatusId" class="form-label fw-semibold">
                        Shipment Status ID
                    </label>
                    <input type="text"
                           readonly
                           class="form-control form-control-sm"
                           id="shipmentStatusId"
                           name="shipmentStatusId"
                           placeholder="Shipment Status ID">
                </div>

                <div class="col-md-6 mt-1">
                    <label for="shipmentStatus" class="form-label fw-semibold">
                        Shipment Status <span class="text-danger">*</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           id="shipmentStatus"
                           name="shipmentStatus"
                           placeholder="Enter Shipment Status">
                </div>

                <div class="col-md-6 mt-1">
                    <label for="statusShortName" class="form-label fw-semibold">
                        Short Name
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           id="statusShortName"
                           name="shortName"
                           placeholder="Enter Short Name">
                </div>

            </div>

            <div class="row g-3 mt-2">

                <div class="col-md-6 mt-1" id="statusLDateContainer" style="display:none;">
                    <label class="form-label fw-semibold">Creation Date</label>
                    <div id="statusDisplayLDate" class="form-control form-control-sm bg-light" style="min-height:42px;"></div>
                </div>

                <div class="col-md-6 mt-1" id="statusModifyDateContainer" style="display:none;">
                    <label class="form-label fw-semibold">Modify Date</label>
                    <div id="statusDisplayModifyDate" class="form-control form-control-sm bg-light" style="min-height:42px;"></div>
                </div>

            </div>

            <div class="row mt-3">
                @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                {
                    SaveBtnClass = "saveShipmentStatusBtn",
                    ShowClear = false,
                    ShowDelete = false,
                    ShowFavorite = false,
                    ShowPrint = false,
                    IsPlain = true,
                })
            </div>
        </form>
    </div>
</div>