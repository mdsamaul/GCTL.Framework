@model GCTL.Core.ViewModels.Finance.VoucherEntryVM.VoucherEntryVM
@{
    Layout = null;
    string vKind = !string.IsNullOrWhiteSpace(Model.VoucherTypeName) ? Model.VoucherTypeName.ToUpper() : "VOUCHER";
    string company = !string.IsNullOrWhiteSpace(Model.CompanyName) ? Model.CompanyName : "FORMOSA LOGISTICS LIMITED";
    string companySub = !string.IsNullOrWhiteSpace(Model.CompanyAddress) ? Model.CompanyAddress : (!string.IsNullOrWhiteSpace(Model.BranchName) ? Model.BranchName : "21, Hazaribagh, Dhaka-1209 Phone: Email:");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Voucher - @Model.VoucherNo</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f1f5f9;
            font-family: 'Times New Roman', Times, serif, Arial, sans-serif;
            color: #000000;
            font-size: 13px;
            line-height: 1.4;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* Top control bar (hidden when printing) */
        .print-toolbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 48px;
            background: #111;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            z-index: 9999;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .toolbar-title {
            font-size: 13px;
            font-weight: 600;
        }

        .toolbar-actions {
            display: flex;
            gap: 10px;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            border: 1px solid #444;
            cursor: pointer;
            text-decoration: none;
            background: #fff;
            color: #000;
        }
        .btn-action:hover {
            background: #e5e5e5;
        }
        .btn-close-win {
            background: #333;
            color: #fff;
            border-color: #555;
        }
        .btn-close-win:hover {
            background: #444;
        }

        /* Printable Paper Container */
        .paper-container {
            max-width: 820px;
            margin: 68px auto 40px auto;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 40px 48px 50px 48px;
            min-height: auto;
        }

        /* Centered Header */
        .voucher-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .org-name {
            font-size: 22px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
            color: #000;
        }

        .org-sub {
            font-size: 12px;
            color: #000;
            margin-bottom: 18px;
        }

        .voucher-title {
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #000;
        }

        /* Right Aligned Meta Table with vertically aligned colons */
        .meta-container {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 12px;
            width: 100%;
        }

        .meta-table {
            border-collapse: collapse;
            font-size: 13px;
            font-weight: bold;
            color: #000;
            border: none !important;
            width: auto !important;
            margin-left: auto;
        }

        .meta-table td {
            border: none !important;
            padding: 1px 3px;
            white-space: nowrap;
        }

        .meta-colon {
            text-align: center;
            padding: 1px 2px !important;
            font-weight: bold;
        }

        /* Table */
        .voucher-table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
            border: 1.5px solid #888 !important;
            border-left: 1.5px solid #888 !important;
            border-right: 1.5px solid #888 !important;
            font-size: 12.5px;
            color: #000;
            margin-bottom: 0;
            box-sizing: border-box;
        }

        .voucher-table th {
            border: 1px solid #888 !important;
            border-bottom: 1.5px solid #888 !important;
            padding: 6px 8px;
            text-align: center;
            vertical-align: middle;
            font-weight: bold;
            background: transparent !important;
            color: #000;
        }

        .voucher-table thead th {
            border-bottom: 1.5px solid #888 !important;
        }

        .voucher-table tbody tr:first-child td {
            border-top: 1.5px solid #888 !important;
        }

        .voucher-table th:first-child,
        .voucher-table td:first-child {
            border-left: 1.5px solid #888 !important;
        }

        .voucher-table th:nth-child(2),
        .voucher-table td:nth-child(2) {
            border-right: 1.5px solid #888 !important;
        }

        .voucher-table th:nth-child(3),
        .voucher-table td:nth-child(3) {
            border-left: 1.5px solid #888 !important;
        }

        .voucher-table th:last-child,
        .voucher-table td:last-child {
            border-right: 1.5px solid #888 !important;
        }

        .voucher-table td {
            border: 1px solid #888 !important;
            padding: 6px 8px;
            color: #000;
            background: transparent !important;
            vertical-align: middle;
        }

        .voucher-table td:last-child {
            border-right: 1.5px solid #888 !important;
        }

        .voucher-table tfoot td {
            font-weight: bold;
            border-top: 1.5px solid #888 !important;
        }

        .voucher-table tfoot td:first-child {
            border-left: 1.5px solid #888 !important;
            border-right: 1.5px solid #888 !important;
        }

        .voucher-table tfoot td:nth-child(2) {
            border-left: 1.5px solid #888 !important;
        }

        .voucher-table tfoot td:last-child {
            border-right: 1.5px solid #888 !important;
        }

        .text-center { text-align: center; }
        .text-start { text-align: left; }
        .text-end { text-align: right; }

        /* Attached Box below table */
        .attached-box {
            border: 1.5px solid #888 !important;
            border-top: none !important;
            border-left: 1.5px solid #888 !important;
            border-right: 1.5px solid #888 !important;
            border-bottom: 1.5px solid #888 !important;
            padding: 8px 10px;
            font-size: 12px;
            color: #000;
            line-height: 1.55;
            margin-bottom: 0;
            box-sizing: border-box;
        }

        .words-line {
            margin-bottom: 6px;
        }

        .field-label {
            font-weight: bold;
        }

        /* Signatures Section */
        .signatures-section {
            display: flex;
            justify-content: space-between;
            text-align: center;
            font-size: 12px;
            color: #000;
            padding: 0 5px;
        }

        .sig-col {
            width: 18%;
            text-align: center;
        }

        .sig-col-prep {
            width: 22%;
            text-align: center;
        }

        .sig-user {
            min-height: 20px;
            line-height: 20px;
            font-weight: bold;
            font-size: 12px;
            white-space: nowrap;
            color: #000;
        }

        .sig-space {
            height: 20px;
        }

        .sig-line {
            font-family: monospace, Arial, sans-serif;
            font-size: 13px;
            font-weight: bold;
            color: #000;
            letter-spacing: 1.5px;
            line-height: 1;
            margin: 4px 0 5px 0;
            overflow: hidden;
            white-space: nowrap;
        }

        .sig-label {
            font-weight: bold;
            color: #000;
        }

        /* PRINT MEDIA RULES */
        @@media print {
            body {
                background: #ffffff !important;
                color: #000000 !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 210mm !important;
                height: auto !important;
            }

            .print-toolbar {
                display: none !important;
            }

            .paper-container {
                position: relative !important;
                width: 210mm !important;
                max-width: 210mm !important;
                min-height: auto !important;
                height: auto !important;
                margin: 0 auto !important;
                padding: 16mm 20mm 15mm 20mm !important;
                border: none !important;
                box-shadow: none !important;
                box-sizing: border-box !important;
            }

            .print-bottom-block {
                position: static !important;
                width: 100% !important;
                margin-top: 130px !important;
                padding: 0 !important;
                box-sizing: border-box !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            .signatures-section {
                width: 100% !important;
            }

            @@page {
                size: A4 portrait;
                margin: 0 !important; /* Completely removes browser default title, date/time headers, and URL/page footers */
            }
        }
    </style>
</head>
<body>

    <!-- Floating Top Bar for user controls -->
    <div class="print-toolbar">
        <div class="toolbar-title">
            Voucher Print Preview — @Model.VoucherNo
        </div>
        <div class="toolbar-actions">
            <button type="button" class="btn-action" onclick="window.print();">
                Print / Save PDF
            </button>
            <button type="button" class="btn-action btn-close-win" onclick="window.close();">
                Close Window
            </button>
        </div>
    </div>

    <!-- Paper Sheet Wrapper -->
    <div class="paper-container">
        <div>
            <!-- Header Section -->
            <div class="voucher-header">
                <div class="org-name">@company</div>
                <div class="org-sub">@companySub</div>
                <div class="voucher-title">@vKind</div>
            </div>

            <!-- Metadata: Colon aligned -->
            <div class="meta-container">
                <table class="meta-table">
                    <tr>
                        <td class="text-start">Voucher No</td>
                        <td class="meta-colon">:</td>
                        <td class="text-start">@Model.VoucherNo</td>
                    </tr>
                    <tr>
                        <td class="text-start">Voucher Date</td>
                        <td class="meta-colon">:</td>
                        <td class="text-start">@(!string.IsNullOrWhiteSpace(Model.VoucherDateFormatted) ? Model.VoucherDateFormatted : (Model.VoucherDate != default(DateTime) ? Model.VoucherDate.ToString("dd/MM/yyyy") : ""))</td>
                    </tr>
                </table>
            </div>

            <!-- Double-entry Particulars Table -->
            <table class="voucher-table">
                <thead>
                    <tr>
                        <th style="width: 18%;">Acc Code</th>
                        <th style="width: 52%;">Particulars</th>
                        <th style="width: 15%;">Debit (BDT)</th>
                        <th style="width: 15%;">Credit (BDT)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Details)
                    {
                        var lineDesc = line.Description?.Trim();
                        var narr = Model.Narration?.Trim();
                        if (!string.IsNullOrWhiteSpace(lineDesc) && !string.IsNullOrWhiteSpace(narr) &&
                            (string.Equals(lineDesc, narr, StringComparison.OrdinalIgnoreCase) || narr.StartsWith(lineDesc, StringComparison.OrdinalIgnoreCase)))
                        {
                            lineDesc = null;
                        }
                        var fullAcc = !string.IsNullOrWhiteSpace(lineDesc) ? $"{line.AccName} - {lineDesc}" : (string.IsNullOrWhiteSpace(line.AccName) ? line.AccCode : line.AccName);
                        <tr>
                            <td class="text-center">@line.AccCode</td>
                            <td class="text-start">@fullAcc</td>
                            <td class="text-end">@((line.DebitAmount.HasValue && line.DebitAmount.Value > 0) ? line.DebitAmount.Value.ToString("N2") : "0.00")</td>
                            <td class="text-end">@((line.CreditAmount.HasValue && line.CreditAmount.Value > 0) ? line.CreditAmount.Value.ToString("N2") : "0.00")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" class="text-end">Total</td>
                        <td class="text-end">@Model.TotalDebit.ToString("N2")</td>
                        <td class="text-end">@Model.TotalCredit.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>

            <!-- Attached Box: In words & Narration -->
            <div class="attached-box">
                <div class="words-line">
                    <span class="field-label">In words : </span>
                    <span>@(string.IsNullOrWhiteSpace(Model.AmountInWords) ? "Zero Taka Only" : Model.AmountInWords)</span>
                </div>
                <div>
                    <span class="field-label">Narration: </span>
                    <span>@(string.IsNullOrWhiteSpace(Model.Narration) ? "" : Model.Narration)</span>
                </div>
            </div>
        </div>

        <!-- Bottom Section: Signatures + Footer (Generate Date/Time & Page No) -->
        <div class="print-bottom-block" style="width: 100%; margin-top: 130px;">
            <div class="signatures-section">
                <div class="sig-col">
                    <div class="sig-space"></div>
                    <div class="sig-line">-------------------------</div>
                    <div class="sig-label">Received By</div>
                </div>
                <div class="sig-col-prep">
                    <div class="sig-user">@(!string.IsNullOrWhiteSpace(Model.PreparedBy) && !Model.PreparedBy.Contains("@") ? Model.PreparedBy : "Md. Moklesur Rahman")</div>
                    <div class="sig-line">-------------------------</div>
                    <div class="sig-label">Prepared By</div>
                </div>
                <div class="sig-col">
                    <div class="sig-space"></div>
                    <div class="sig-line">-------------------------</div>
                    <div class="sig-label">Checked By</div>
                </div>
                <div class="sig-col">
                    <div class="sig-space"></div>
                    <div class="sig-line">-------------------------</div>
                    <div class="sig-label">Verified By</div>
                </div>
                <div class="sig-col">
                    <div class="sig-space"></div>
                    <div class="sig-line">-------------------------</div>
                    <div class="sig-label">Authorised<br />Signature</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', function() {
            try { window.focus(); } catch (e) {}
        });
        window.addEventListener('load', function() {
            setTimeout(function() {
                try {
                    window.focus();
                    window.print();
                } catch (e) {
                    console.log('Browser print error suppressed:', e);
                }
            }, 600);
        });
    </script>
</body>
</html>
