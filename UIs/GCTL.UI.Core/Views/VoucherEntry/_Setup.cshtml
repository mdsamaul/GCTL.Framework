@using GCTL.UI.Core.ViewModels

<div style="padding-top: 2px;">

    <input type="hidden" id="VoucherEntryAutoID" name="autoId" />
    <input type="hidden" id="VoucherEntryCodeNo" name="VoucherEntryCodeNo" />

    @* Main Information Section *@
    <div class="voucher-section mb-2">
        <div class="voucher-section-header d-flex align-items-center mb-2">
            <span class="voucher-section-bar"></span>
            <span class="voucher-section-title">Main Information</span>
        </div>
        <div class="row g-2">

            @* Row 1: Company & Branch *@
            <div class="col-md-6 position-relative">
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    IsVisible = true,
                    ShowOnInit = true,
                    ColumnClass = "w-100",
                    FieldType = FieldType.Select,
                    InputId = "CompanyCode",
                    InputName = "CompanyCode",
                    LabelText = "Company",
                    ReserveActionSlot = false,
                    Placeholder = "-- Select Company --",
                    IsRequired = true,
                    LabelInline = true,
                    LabelColWidth = 3,
                    LabelColumnClass = "text-end"
                })
                <hr class="voucher-divider" />
            </div>

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                FieldType = FieldType.Select,
                InputId = "BranchCode",
                InputName = "BranchCode",
                ReserveActionSlot = false,
                LabelText = "Branch",
                Placeholder = "-- Select Branch --",
                IsRequired = true,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })

            @* Row 2: Voucher Type & Voucher Date *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                FieldType = FieldType.Select,
                InputId = "VoucherTypeCode",
                InputName = "VoucherType_Code",
                ReserveActionSlot = false,
                LabelText = "Voucher Type",
                Placeholder = "-- Select Voucher Type --",
                IsRequired = true,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                FieldType = FieldType.Date,
                InputId = "VoucherDate",
                InputName = "VoucherDate",
                ReserveActionSlot = false,
                LabelText = "Voucher Date",
                IsRequired = true,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })

            @* Row 3: Voucher No *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                FieldType = FieldType.Text,
                InputId = "VoucherNo",
                InputName = "VoucherNo",
                ReserveActionSlot = false,
                LabelText = "Voucher No",
                Placeholder = "Voucher No",
                IsRequired = true,
                IsReadonly = true,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })
            <div class="col-md-6 d-none d-md-block"></div>

            @* Row 4: Narration in a new row *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-12 narration-col",
                FieldType = FieldType.Textarea,
                InputId = "Narration",
                InputName = "Narration",
                LabelText = "Narration",
                ReserveActionSlot = false,
                Placeholder = "Narration",
                IsRequired = true,
                Rows = 1,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })

        </div>
    </div>

    <input type="hidden" id="TmpDetailsAutoID">

    @* Details Information Section *@
    <div class="voucher-section mt-0 mb-2">
        <div class="voucher-section-header d-flex align-items-center mb-2">
            <span class="voucher-section-bar"></span>
            <span class="voucher-section-title">Details Information</span>
        </div>

        <div class="row g-2">

            @* Row 1: Tr. Type *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                JsEventClass = "custom-select-single",
                FieldType = FieldType.Select,
                InputId = "TrType",
                ReserveActionSlot = false,
                InputName = "TrType",
                LabelText = "Tr. Type",
                Placeholder = "-- Select Tr. Type --",
                IsRequired = true,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end",
                SelectItems = new Microsoft.AspNetCore.Mvc.Rendering.SelectList(new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                {
                    new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Text = "Dr", Value = "Dr" },
                    new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Text = "Cr", Value = "Cr" }
                }, "Value", "Text")
            })
            <div class="col-md-6 d-none d-md-block"></div>

            @* Row 2 & 3: Ledger Section (Right after Tr. Type, visible when Account Head is selected) *@
            <div class="col-md-6 mt-1 ledger-col" style="display:none;">
                <div class="ledger-row">
                    <span class="ledger-label">Group Ledger :</span>
                    <span class="ledger-value" id="GroupLedgerValue"></span>
                </div>
            </div>
            <div class="col-md-6 mt-1 ledger-col" style="display:none;">
                <div class="ledger-row">
                    <span class="ledger-label">Control Ledger :</span>
                    <span class="ledger-value" id="ControlLedgerValue"></span>
                </div>
            </div>
            <div class="col-md-6 mt-1 ledger-col" style="display:none;">
                <div class="ledger-row">
                    <span class="ledger-label">Sub Control Ledger :</span>
                    <span class="ledger-value" id="SubControlLedgerValue"></span>
                </div>
            </div>
            <div class="col-md-6 mt-1 ledger-col" style="display:none;">
                <div class="ledger-row">
                    <span class="ledger-label">Sub-Sidiary Ledgers :</span>
                    <span class="ledger-value" id="SubSidiaryLedgerValue"></span>
                </div>
            </div>

            @* Row 4: Account Head *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                JsEventClass = "custom-select-single",
                FieldType = FieldType.Select,
                ReserveActionSlot = false,
                InputId = "AccCode",
                InputName = "AccCode",
                LabelText = "Account Head",
                Placeholder = "-- Select Account Head --",
                IsRequired = true,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })
            <div class="col-md-6 d-none d-md-block"></div>

            @* Row 5: Description & Amount *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                FieldType = FieldType.Text,
                InputId = "Description",
                ReserveActionSlot = false,
                InputName = "Description",
                LabelText = "Description",
                Placeholder = "Description",
                IsReadonly = true,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                FieldType = FieldType.Text,
                InputId = "Amount",
                InputName = "Amount",
                ReserveActionSlot = false,
                LabelText = "Amount",
                Placeholder = "0.00",
                IsRequired = true,
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end",
                InputStyle = "text-align: right;"
            })

            @* Row 3: Cheque No & Cheque Date *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                FieldType = FieldType.Text,
                InputId = "ChequeNo",
                ReserveActionSlot = false,
                InputName = "ChequeNo",
                LabelText = "Cheque No",
                Placeholder = "Enter Cheque No",
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                IsVisible = true,
                ShowOnInit = true,
                ColumnClass = "col-md-6",
                FieldType = FieldType.Date,
                ReserveActionSlot = false,
                InputId = "ChequeDate",
                Placeholder = "dd/mm/yyyy",
                InputName = "ChequeDate",
                LabelText = "Cheque Date",
                LabelInline = true,
                LabelColWidth = 3,
                LabelColumnClass = "text-end"
            })

            @* Details Button Group with Previous Icons & Toolbar Hover Effect *@
            <div class="col-12 pe-0 mb-0 mt-1">
                <div class="details-icon-group d-flex justify-content-end align-items-center gap-2">
                    <!-- Add -->
                    <button type="button" id="AddDetails" title="Add" data-tooltip="Add" class="icon-btn add">
                        <i class="bi bi-journal-plus default-icon"></i>
                    </button>

                    <!-- Cancel -->
                    <button type="button" id="CancelDetails" title="Cancel" data-tooltip="Cancel" class="icon-btn cancel">
                        <i class="bi bi-journal-minus default-icon"></i>
                    </button>

                    <!-- Refresh -->
                    <button type="button" id="RefreshDetails" title="Refresh" data-tooltip="Refresh" class="icon-btn refresh">
                        <span class="icon-stack">
                            <i class="bi bi-journal journal-base"></i>
                            <i class="bi bi-arrow-repeat refresh-icon"></i>
                        </span>
                    </button>
                </div>
            </div>

            @* Details Table (100% Responsive, Strictly No Horizontal Scroll, Borderless) *@
            <div class="col-12 pe-0 pt-0 mt-0">
                <div class="table-responsive grid-no-horizontal-scroll">
                    @await Html.PartialAsync("_CustomGrid", new GridModel
                    {
                        GridId = "VoucherEntryTempGrid",
                        AjaxUrl = Url.Action("GetAllTmpVoucherDetails", "VoucherDetails") ?? "/VoucherDetails/all-tmp-voucher-details",
                        ServerSide = false,
                        ShowCheckbox = true,
                        ShowActionMenu = false,
                        CheckColumnData = "autoId",
                        CheckAllId = "none",
                        Compact = true,
                        Bordered = false,
                        Columns = new List<GridColumn>
                        {
                            new GridColumn { Data = "accCode", Header = "Acc. Code", Align = "center", Width = "16%", IsEditLink = true, IdField = "autoId", EditSelectorClass = "js-grid-edit" },
                            new GridColumn { Data = "accountHead", Header = "Account Head", Width = "22%" },
                            new GridColumn { Data = "description", Header = "Description", Width = "22%" },
                            new GridColumn { Data = "debitAmount", Header = "Debit", Align = "right", Width = "14%", RenderFn = "formatCurrency", TabularNumber = true },
                            new GridColumn { Data = "creditAmount", Header = "Credit", Align = "right", Width = "14%", RenderFn = "formatCurrency", TabularNumber = true },
                            new GridColumn { Data = "autoId", Header = "Action", Align = "center", Width = "10%", RenderFn = "voucherActionButtons", Sortable = false, Searchable = false }
                        }
                    }, new ViewDataDictionary(ViewData) { { "ShowCheckAll", false } })
                </div>
                <div class="d-flex justify-content-end align-items-center voucher-total-box mt-1 px-3 py-1" style="background-color: #f8f9fa; border: none; border-top: 1px solid #dee2e6; border-radius: 4px; font-size: 13px; gap: 20px;">
                    <span class="fw-bold">Total :</span>
                    <div><span class="text-muted small">Dr:</span> <span class="fw-bold" id="TotalDrValue">0.00</span></div>
                    <div><span class="text-muted small">Cr:</span> <span class="fw-bold" id="TotalCrValue">0.00</span></div>
                </div>
            </div>

        </div>
    </div>

    <hr class="my-2 mx-2">

    @* Entry / Update Date Section *@
    <div class="row g-2">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            IsVisible = true,
            ShowOnInit = true,
            ColumnClass = "col-md-6",
            FieldType = FieldType.ReadonlyDisplay,
            InputId = "EntryDate",
            LabelText = "Entry Date:",
            LabelInline = true,
            LabelColWidth = 3,
            ReserveActionSlot = false,
            LabelColumnClass = "text-end",
            LabelStyle = "font-size:12px; font-weight: 500;",
            InputStyle = "font-size:12px;"
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            IsVisible = true,
            ShowOnInit = true,
            ColumnClass = "col-md-6",
            FieldType = FieldType.ReadonlyDisplay,
            InputId = "UpdateDate",
            LabelText = "Last Update Date:",
            LabelInline = true,
            ReserveActionSlot = false,
            LabelColWidth = 3,
            LabelColumnClass = "text-end",
            LabelStyle = "font-size:12px; font-weight: 500;",
            InputStyle = "font-size:12px;"
        })
    </div>

    @* Bottom Save Button *@
    <div class="col-12 mt-2">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            SaveBtnClass = "js-VoucherEntry-save",
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            ReserveActionSlot = true,
            IsMarginRight = false,
            SaveBtnType = "submit",
            Style = "border-bottom:0px !important;"
        })
    </div>

</div>