<div class="card shadow-sm rounded-2 mt-3">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <label class="me-1 fw-bold" style="font-size: 14px;">Filter By:</label>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm" id="StartDate" style="width: 110px;">
                    <input type="text" class="form-control form-control-sm" id="EndDate" style="width: 110px;">
                    <button class="btn btn-secondary btn-sm" style="width: 82px;" id="SearchwithDate">Search</button>
                    <button class="btn btn-secondary btn-sm" style="width: 82px;" id="PreviewBtn">Preview</button>
                </div>

            </div>

        </div>

        <div class="row mb-3 align-items-center">

            <div class="col-md-6">
                <div class="d-flex align-items-center">
                    <label class="me-2" style="font-size: 14px;">Show</label>
                    <select id="VoucherEntrypageSize" class="form-select form-select-sm VoucherEntrypageSize" style="width: auto;">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="-1">All</option>
                    </select>
                    <span class="ms-2" style="font-size: 14px;">entries</span>
                </div>
            </div>

            <div class="col-md-6 d-flex justify-content-end align-items-center">
                <label for="table-search" class="me-2">Search</label>
                <input type="text" class="form-control" id="table-search" style="width: 150px;">
            </div>

        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered" style="font-size: 13px;">
                <thead class="table-light">
                    <tr>
                        <th class="text-center align-middle" style="width:5%">
                            <div class="d-flex flex-column align-items-center">
                                <span>Select</span>
                                <input type="checkbox" id="VoucherEntrySelectAll" class="form-check-input mt-1">
                            </div>
                        </th>
                        <th style="text-align: center; vertical-align:middle; width:15%" class="VoucherEntrySortable" data-column="VoucherNo">Voucher No. <i class="sort-icon fas fa-sort"></i></th>
                        <th style="text-align: center; vertical-align:middle; width:10%" class="VoucherEntrySortable" data-column="VoucherDate">Voucher Date <i class="sort-icon fas fa-sort"></i></th>
                        <th style="text-align: center; vertical-align:middle; width:30%" class="VoucherEntrySortable" data-column="Narration">Narration <i class="sort-icon fas fa-sort"></i></th>
                        <th style="text-align: center; vertical-align:middle; width:15%" class="VoucherEntrySortable" data-column="BranchCode">Branch <i class="sort-icon fas fa-sort"></i></th>
                        <th style="text-align: center; vertical-align:middle; width:10%" class="VoucherEntrySortable" data-column="Amount">Amount <i class="sort-icon fas fa-sort"></i></th>
                        <th style="text-align: center; vertical-align:middle; width:15%" class="VoucherEntrySortable" data-column="">Invoice No <i class="sort-icon fas fa-sort"></i></th>
                    </tr>
                </thead>
                <tbody id="VoucherEntrytable">
                    @* Data will be dynamically inserted here  *@
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap mt-3">
            <small class="text-muted" id="Entrypaginationtext"></small>

            <nav aria-label="Page navigation example">
                <ul class="pagination pagination-sm mb-0" id="paginationbutton">
                    @* <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">Next</a></li> *@
                </ul>
            </nav>
        </div>

    </div>
</div>