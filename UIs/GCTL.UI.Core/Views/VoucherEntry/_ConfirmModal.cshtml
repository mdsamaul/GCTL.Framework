<div class="modal fade" id="voucherConfirmModal" tabindex="-1" aria-labelledby="voucherConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2 px-3 bg-light">
                <h6 class="modal-title fs-9 fw-bold text-danger" id="voucherConfirmModalLabel">
                    <i class="fas fa-exclamation-triangle me-1"></i><span id="voucherConfirmTitle">@Html.SmartLocalize("Confirm Action")</span>
                </h6>
                <button type="button" class="btn-close fs-10" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 text-center fs-9">
                <p class="mb-0 text-body-secondary" id="voucherConfirmMessage">
                    @Html.SmartLocalize("Are you sure you want to proceed?")
                </p>
            </div>
            <div class="modal-footer py-2 px-3 bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-phoenix-secondary btn-sm" data-bs-dismiss="modal">
                    @Html.SmartLocalize("Cancel")
                </button>
                <button type="button" class="btn btn-danger btn-sm" id="btnConfirmAction">
                    @Html.SmartLocalize("Yes, Confirm")
                </button>
            </div>
        </div>
    </div>
</div>
