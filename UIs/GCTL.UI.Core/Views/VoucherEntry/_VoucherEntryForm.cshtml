@using GCTL.UI.Core.ViewModels

<div class="card shadow-sm rounded-2">

    @await Html.PartialAsync("_Toolbars", new ToobarModel
    {
        Title = "Voucher Entry",
        ShowSave = true,
        SaveBtnId = "VoucherEntrysaveBtn",
        SaveBtnClass = "js-Voucher-save VoucherEntrysaveBtn",
        EnableSave = true,

        ShowDelete = true,
        DeleteBtnId = "VoucherEntrydeleteBtn",
        DeleteBtnClass = "js-Voucher-delete-confirm VoucherEntrydeleteBtn",
        EnableDelete = true,

        ShowClear = true,
        ClearBtnId = "btnClear",
        ClearBtnClass = "js-Voucher-clear VoucherEntryresetBtn",
        EnableClear = true,

        ShowPrint = true,
        PrintBtnId = "btnPrint",
        PrintBtnClass = "printBtn",
        ExcelBtnClass = "export-excel",
        PdfBtnClass = "export-pdf",
        EnablePrint = true,

        ShowFavorite = true,
        FavtBtnId = "btnFav",
        FavtBtnClass = "VoucherEntryfavBtn",
        EnableFavorite = true
    })

    <div class="card-body">
        <form id="VoucherEntryForm">
            <fieldset style="border:1px solid #ccc; padding:5px; border-radius:5px;">

                <input type="hidden" id="VoucherEntryAutoID" name="autoId" />

                @* Main Information Section *@
                <fieldset class="border rounded-3 p-3 position-relative">
                    <legend class="float-none w-auto px-2 fw-bold"
                            style="font-size: 15px; border: 1px solid #dee2e6; border-radius: 6px; background-color: #f8f9fa;">
                        Main Information
                    </legend>
                    <div class="row g-3">

                        @* Company *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Select,
                            InputId = "CompanyCode",
                            InputName = "CompanyCode",
                            LabelText = "Company",
                            Placeholder = "-- Select Company --",
                            IsRequired = true
                        })

                        @* Branch *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Select,
                            InputId = "BranchCode",
                            InputName = "BranchCode",
                            LabelText = "Branch",
                            Placeholder = "-- Select Branch --",
                            IsRequired = true
                        })

                        @* Voucher Type *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Select,
                            InputId = "VoucherTypeCode",
                            InputName = "VoucherType_Code",
                            LabelText = "Voucher Type",
                            Placeholder = "-- Select Voucher Type --",
                            IsRequired = true
                        })

                        @* Voucher Date *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "VoucherDate",
                            InputName = "VoucherDate",
                            LabelText = "Voucher Date",
                            Placeholder = "Voucher Date",
                            IsRequired = true
                        })

                        @* Voucher No *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "VoucherNo",
                            InputName = "VoucherNo",
                            LabelText = "Voucher No",
                            Placeholder = "Voucher No",
                            IsRequired = true,
                            IsReadonly = true
                        })

                        @* Narration *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-12",
                            FieldType = FieldType.Textarea,
                            InputId = "Narration",
                            InputName = "Narration",
                            LabelText = "Narration",
                            Placeholder = "Narration",
                            IsRequired = true,
                            Rows = 2
                        })

                    </div>
                </fieldset>

                <input type="hidden" id="TmpDetailsAutoID">

                @* Details Information Section *@
                <fieldset class="border rounded-3 p-3 position-relative mt-2">
                    <legend class="float-none w-auto px-2 fw-bold"
                            style="font-size: 15px; border: 1px solid #dee2e6; border-radius: 6px; background-color: #f8f9fa;">
                        Details Information
                    </legend>

                    <div class="row g-3">

                        @* Tr. Type *@
                        <div class="col-md-6">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                IsVisible = true,
                                ShowOnInit = true,
                                ColumnClass = "",
                                FieldType = FieldType.Select,
                                InputId = "TrType",
                                InputName = "TrType",
                                LabelText = "Select Tr. Type",
                                Placeholder = "Select Tr. Type",
                                IsRequired = true
                            })
                        </div>
                        <div class="col-md-6"></div>

                        @* Ledger Section (hidden by default) *@
                        <div class="col-md-6" style="display:none;">
                            <div class="ledger-row">
                                <span class="ledger-label">Group Ledger :</span>
                                <span class="ledger-value" id="GroupLedgerValue"></span>
                            </div>
                        </div>
                        <div class="col-md-6" style="display:none;">
                            <div class="ledger-row">
                                <span class="ledger-label">Control Ledger :</span>
                                <span class="ledger-value" id="ControlLedgerValue"></span>
                            </div>
                        </div>
                        <div class="col-md-6" style="display:none;">
                            <div class="ledger-row">
                                <span class="ledger-label">Sub-Control Ledger :</span>
                                <span class="ledger-value" id="SubControlLedgerValue"></span>
                            </div>
                        </div>
                        <div class="col-md-6" style="display:none;">
                            <div class="ledger-row">
                                <span class="ledger-label">Sub-Sidiary Ledger :</span>
                                <span class="ledger-value" id="SubSidiaryLedgerValue"></span>
                            </div>
                        </div>

                        @* Account Head *@
                        <div class="col-md-6">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                IsVisible = true,
                                ShowOnInit = true,
                                ColumnClass = "",
                                FieldType = FieldType.Select,
                                InputId = "AccCode",
                                InputName = "AccCode",
                                LabelText = "Account Head",
                                Placeholder = "-- Select Account Head --",
                                IsRequired = true
                            })
                        </div>
                        <div class="col-md-6"></div>

                        @* Description *@
                        <div class="col-md-6">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                IsVisible = true,
                                ShowOnInit = true,
                                ColumnClass = "",
                                FieldType = FieldType.Text,
                                InputId = "Description",
                                InputName = "Description",
                                LabelText = "Description",
                                Placeholder = "Description",
                                IsReadonly = true
                            })
                        </div>

                        @* Amount *@
                        <div class="col-md-6">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                IsVisible = true,
                                ShowOnInit = true,
                                ColumnClass = "",
                                FieldType = FieldType.Number,
                                InputId = "Amount",
                                InputName = "Amount",
                                LabelText = "Amount",
                                Placeholder = "Amount",
                                IsRequired = true
                            })
                        </div>

                        @* Cheque No *@
                        <div class="col-md-6">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                IsVisible = true,
                                ShowOnInit = true,
                                ColumnClass = "",
                                FieldType = FieldType.Text,
                                InputId = "ChequeNo",
                                InputName = "ChequeNo",
                                LabelText = "Cheque No",
                                Placeholder = "Enter Cheque No"
                            })
                        </div>

                        @* Cheque Date *@
                        <div class="col-md-6">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                IsVisible = true,
                                ShowOnInit = true,
                                ColumnClass = "",
                                FieldType = FieldType.Date,
                                InputId = "ChequeDate",
                                InputName = "ChequeDate",
                                LabelText = "Cheque Date"
                            })
                        </div>

                        @* Details Button Group *@
                        <div class="row">
                            <div class="col-12">
                                <div class="details-icon-group">
                                    <button type="button" id="AddDetails" data-tooltip="Add" class="icon-btn add">
                                        <i class="fas fa-plus"></i>
                                    </button>

                                    <button type="button" id="CancelDetails" data-tooltip="Cancel" class="icon-btn cancel">
                                        <i class="fas fa-times"></i>
                                    </button>

                                    <button type="button" id="RefreshDetails" data-tooltip="Refresh" class="icon-btn refresh">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        @* Details Table *@
                        <div class="row">
                            <div class="col-12 table-responsive">
                                <table class="table table-bordered table-striped voucher-entry-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 5%; text-align:center;">Select</th>
                                            <th style="width: 15%; text-align:center;" data-column="AccCode">Acc. Code</th>
                                            <th style="width: 30%; text-align:center;" data-column="AccountHeadName">Account Head</th>
                                            <th style="width: 20%; text-align:center;" data-column="Description">Description</th>
                                            <th style="width: 15%; text-align:center;" data-column="DebitAmount">Debit</th>
                                            <th style="width: 15%; text-align:center;" data-column="CreditAmount">Credit</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="4" class="text-end fw-bold">Total</td>
                                            <td class="fw-bold">0.00</td>
                                            <td class="fw-bold">0.00</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <small class="text-muted"></small>
                            </div>
                        </div>

                    </div>
                </fieldset>

                <hr class="my-4 mx-2">

                @* Entry / Update Date Section *@
                <div class="row g-3">
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "EntryDate",
                        LabelText = "Entry Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "UpdateDate",
                        LabelText = "Last Update Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })
                </div>

                @* Bottom Save Button *@
                <div class="col-12">
                    @await Html.PartialAsync("_Toolbars", new ToobarModel
                    {
                        Title = "",
                        ShowClear = false,
                        ShowDelete = false,
                        ShowPrint = false,
                        ShowFavorite = false,
                        IsPlain = true,
                        ReserveActionSlot = true,
                        IsMarginRight = true,
                        SaveBtnType = "submit"
                    })
                </div>

            </fieldset>
        </form>
    </div>
</div>