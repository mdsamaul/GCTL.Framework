@model GCTL.UI.Core.ViewModels.CustomerType.CustomerTypePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Customer Type";
    Model.Breadcrumb = "Customer Type";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Customer Type",
                            SaveBtnClass = "js-customertype-save",
                            DeleteBtnClass = "js-customertype-delete-confirm",
                            ClearBtnClass = "js-customertype-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="customerType-form" asp-controller="CustomerType">
                            <div class="js-customertype-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "customerTypeTable",
                    AjaxUrl = "/CustomerType/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "customerTypeId",
                    CheckAllId = "customertype-check-all",
                    DefaultSortColumn = "customerTypeId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "customerTypeId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-customertype-edit" },
                        new() { Data = "customerType", Header = "Customer Type Name", Width = "55%"},
                        new() { Data = "shortName", Header = "Short Name", Width = "35%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/customerType.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $.customerType({
                baseUrl: '/CustomerType'
            });
        });
    </script>
}
