@model GCTL.Core.ViewModels.ClearAndF.Update.ShipmentUpdateViewModel

@{
    ViewData["Title"] = "Bill Entry";
}

<link href="~/css/selectCSS.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .sticky-bar {
        position: sticky;
    }

    /* Operation Fund Card System */
    .custom-fieldset {
        position: relative;
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 16px 14px 10px 14px;
        margin: 10px 0;
        box-shadow: 0 0 8px rgba(0, 0, 0, 0.06);
        background-color: #fff;
    }

        .custom-fieldset legend {
            position: absolute;
            top: -12px;
            left: 15px;
            background-color: white;
            padding: 0 8px;
            font-size: 0.88rem;
            font-weight: bold;
            color: #555;
            border: 1px solid #ddd;
            border-radius: 4px;
            width: auto;
        }

    .form-control-sm, .form-select-sm, textarea.form-control-sm {
        font-size: 0.82rem;
        padding: 2px 6px;
        height: 28px;
        border-radius: 3px;
        color: #000 !important;
    }

    textarea.form-control-sm {
        height: auto;
    }

    label.form-label, label.col-form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #444;
        margin-bottom: 1px;
    }

    .bg-light-input {
        background-color: #f0f1f2 !important;
    }

    thead th {
        background-color: #f8f9fa !important;
        color: #333;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .table-sm td {
        padding: 0.3rem 0.45rem;
        font-size: 0.82rem;
    }

    .input-group .input-group-text {
        padding-top: 0px !important;
        padding-bottom: 0px !important;
        font-size: 0.78rem;
    }

    .custom-dd-box {
        min-height: 28px !important;
        height: 28px !important;
        padding: 0 6px !important;
        border-radius: 3px !important;
    }
    .custom-dd-input {
        font-size: 0.82rem !important;
    }
</style>

<div class="container-fluid p-0">
    @* Toolbar on top *@
    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
        Title = "Job Bill Entry",
        SaveBtnId = "saveBillEntryBtn",
        DeleteBtnId = "deleteBillEntryBtn",
        ClearBtnId = "btnClear",
        PrintBtnId = "btnPrint"
    })

    @* Card 1: Job Entry List (_CustomGrid with Radio) *@
    <fieldset class="custom-fieldset card p-2 pt-3">
        <legend class="float-none w-auto px-2 fw-bold text-secondary small">
            <i class="fas fa-list me-1 text-primary"></i> Job Entry List
        </legend>

        <div id="jobSummary">

            <div class="row g-2 align-items-center mb-1">
                <div class="col-md-3">
                    <div class="row align-items-center gx-2">
                        <label class="col-auto col-form-label fw-semibold">Customer</label>
                        <div class="col">
                            <select class="form-select form-select-sm custom-select-single" id="customerFilter" data-placeholder="All Customers" asp-items="ViewBag.CustomerName as SelectList">
                                <option value="">All Customers</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="row align-items-center gx-2">
                        <label class="col-auto col-form-label fw-semibold">Shipment Mode</label>
                        <div class="col">
                            <select class="form-select form-select-sm custom-select-single" id="shipmentModeFilter" data-placeholder="All Shipment Modes" asp-items="ViewBag.ShipmentMode as SelectList">
                                <option value="">All Shipment Modes</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <!-- Empty -->
                </div>

                <div class="col-md-3">
                    <div class="row align-items-center gx-2">
                        <label class="col-auto col-form-label fw-semibold">Date</label>
                        <div class="col">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text py-0">From</span>
                                <input type="text" class="form-control form-control-sm custom-datepicker caiCon me-1" id="dateFrom" placeholder="DD/MM/YYYY">
                                <span class="input-group-text py-0 ms-1">To</span>
                                <input type="text" class="form-control form-control-sm custom-datepicker caiCon" id="dateTo" placeholder="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Top Grid with _CustomGrid & Radio *@
            @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
            {
                GridId = "JobSettingsTable",
                AjaxUrl = "/JobBillEntry/GetJobs",
                AjaxMethod = "POST",
                ServerSide = true,
                UseRadio = true,
                RadioName = "jobSelect",
                CheckColumnData = "id",
                DefaultSortColumn = "jobDate",
                DefaultSortDirection = "desc",
                PageLengths = [5,10,25,50,100,-1],
                DefaultPageLength = 5,
                CustomGridWrapper = false,
                CardWrapper = false,
                Columns = new()
                {
                    new() { Data = "jobNo", Header = "Job No.", Width = "8%", Align = "left" },
                    new() { Data = "jobDate", Header = "Job Date", Width = "8%", RenderFn = "formatDate" },
                    new() { Data = "shipmentMode", Header = "Shipment Mode", Width = "12%" },
                    new() { Data = "customerName", Header = "Customer", Width = "18%", Align = "left" },
                    new() { Data = "customerAddress", Header = "Address", Width = "27%", Align = "left" },
                    new() { Data = "docReceivedDate", Header = "Doc Received Date", Width = "8%", RenderFn = "formatDate" },
                    new() { Data = "invoice", Header = "Invoice No.", Width = "10%", Align = "left" },
                    new() { Data = "beno", Header = "B/E No.", Width = "9%", Align = "left", IsWrapable = false }
                }
            })
        </div>
    </fieldset>

    @* Card 2: Bill & Job Details (Exact form placement from your Razor code) *@
    <fieldset class="custom-fieldset card p-3">
        <legend class="float-none w-auto px-2 fw-bold text-secondary small">
            <i class="fas fa-file-invoice-dollar me-1 text-primary"></i> Bill & Job Details
        </legend>

        <input type="hidden" id="sdId" />

        <div class="row g-2">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Bill No</label>
                <input class="form-control form-control-sm" readonly id="billNo" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Bill Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="billDate" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6"></div>

            <!-- Job No (Read-only) -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Job No</label>
                <input class="form-control form-control-sm" readonly id="jobNo" />
                <span class="text-danger"></span>
            </div>

            <!-- Job Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Job Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="jobDate" />
                <span class="text-danger"></span>
            </div>

            <!-- Customer Name -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Customer Name</label>
                <select class="form-select form-select-sm custom-select-single" id="customerId" data-placeholder="Select Customer" asp-items="ViewBag.CustomerName as SelectList">
                    <option value="">Select Customer</option>
                </select>
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Customer Address</label>
                <textarea class="form-control form-control-sm" rows="2" id="customerAddress"></textarea>
                <span class="text-danger"></span>
            </div>

            <!-- Customer Delivery Address -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Customer Delivery Address</label>
                <select class="form-select form-select-sm custom-select-single" id="customerDeliveryAddress" data-placeholder="Select Customer Delivery Address">
                    <option value="">Select Customer Delivery Address</option>
                </select>
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Shipment Mode</label>
                <select class="form-select form-select-sm custom-select-single" id="shipmentModeId" data-placeholder="Select Shipment Mode" asp-items="ViewBag.ShipmentMode as SelectList">
                    <option value="">Select Shipment Mode</option>
                </select>
                <span class="text-danger"></span>
            </div>

            <!-- Port Name -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Port Name</label>
                <select class="form-select form-select-sm custom-select-single" id="portId" data-placeholder="Select Port" asp-items="ViewBag.PortName as SelectList">
                    <option value="">Select Port</option>
                </select>
                <span class="text-danger"></span>
            </div>

            <!-- Doc's Received Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Doc's Received Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="docsReceivedDate" />
                <span class="text-danger"></span>
            </div>

            <!-- LC/EXP No -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">EXP No</label>
                <input class="form-control form-control-sm" id="lcExpNo" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">EXP Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="expDate" />
                <span class="text-danger"></span>
            </div>

            <!-- LC Value -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">LC NO</label>
                <input class="form-control form-control-sm" id="lcNo" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">LC Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="lcDate" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">LC Value</label>
                <div class="d-flex gap-2 group-horizontal">
                    <input type="number" class="form-control form-control-sm" id="lcValue" />
                    <select class="form-select form-select-sm custom-select-single" id="lcValCurrencyId" data-placeholder="Select Currency" asp-items="ViewBag.CurrencyForLC as SelectList">
                        <option value="">Select Currency</option>
                    </select>
                </div>
                <span class="text-danger"></span>
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">BDT Rate</label>
                <div class="d-flex gap-2 group-horizontal">
                    <input type="number" class="form-control form-control-sm" id="bdtRate" />
                    <input type="number" class="form-control form-control-sm" id="bdtTotal" />
                </div>
                <span class="text-danger"></span>
                <span class="text-danger"></span>
            </div>

            <!-- Invoice No -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Invoice No</label>
                <input class="form-control form-control-sm" id="invoiceNo" />
                <span class="text-danger"></span>
            </div>

            <!-- Invoice Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Invoice Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="invoiceDate" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Invoice Value</label>
                <div class="d-flex gap-2 group-horizontal">
                    <input type="number" class="form-control form-control-sm" id="invoiceValue" />
                    <select class="form-select form-select-sm custom-select-single" id="invValCurrencyId" data-placeholder="Select Currency" asp-items="ViewBag.CurrencyForInvoice as SelectList">
                        <option value="">Select Currency</option>
                    </select>
                </div>
                <span class="text-danger"></span>
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">BDT Rate</label>
                <div class="d-flex gap-2 group-horizontal">
                    <input type="number" class="form-control form-control-sm" id="invBdtRate" />
                    <input type="number" class="form-control form-control-sm" id="invBdtTotal" />
                </div>
                <span class="text-danger"></span>
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Number of Transport</label>
                <input class="form-control form-control-sm" id="noTransport" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Demarage Day(s)</label>
                <input class="form-control form-control-sm" id="demarageDay" />
                <span class="text-danger"></span>
            </div>

            <!-- IP/EP No -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">IP/EP No</label>
                <input class="form-control form-control-sm" id="ipEpNo" />
                <span class="text-danger"></span>
            </div>

            <!-- IP Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">IP Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="ipDate" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Undertaking No</label>
                <input class="form-control form-control-sm" id="undertakingNo" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Arrival Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="arrivalDate" />
                <span class="text-danger"></span>
            </div>

            <!-- B/L No -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">B/L No</label>
                <input class="form-control form-control-sm" id="blNo" />
                <span class="text-danger"></span>
            </div>

            <!-- B/L Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">B/L Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="blDate" />
                <span class="text-danger"></span>
            </div>

            <!-- B/E No -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">B/E No</label>
                <input class="form-control form-control-sm" id="beNo" />
                <span class="text-danger"></span>
            </div>

            <!-- B/E Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">B/E Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="beDate" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">EFR No</label>
                <input class="form-control form-control-sm" id="efrNo" />
                <span class="text-danger"></span>
            </div>

            <!-- EFR Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">EFR Date</label>
                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="efrDate" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">ROT No</label>
                <input class="form-control form-control-sm" id="rotNo" />
                <span class="text-danger"></span>
            </div>

            <!-- Importer Name -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Importer Name</label>
                <select class="form-select form-select-sm custom-select-single" id="importerId" data-placeholder="Select Importer" asp-items="ViewBag.ImporterName as SelectList">
                    <option value="">Select Importer</option>
                </select>
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">HAWB</label>
                <input class="form-control form-control-sm" id="hawb" />
                <span class="text-danger"></span>
            </div>

            <!-- Container No -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Container No</label>
                <input class="form-control form-control-sm" id="containerNo" />
                <span class="text-danger"></span>
            </div>

            <!-- Material Description -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Material Description</label>
                <textarea class="form-control form-control-sm" rows="2" id="materialDescription"></textarea>
                <span class="text-danger"></span>
            </div>

            <!-- Quantity + Unit (Horizontal Group) -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Quantity & Unit (PKG)</label>
                <div class="d-flex gap-2 group-horizontal">
                    <input type="number" class="form-control form-control-sm" id="quantity" />
                    <select class="form-select form-select-sm custom-select-single" id="quantityUnitId" data-placeholder="Select Unit" asp-items="ViewBag.QuantityUnit as SelectList">
                        <option value="">Select Unit</option>
                    </select>
                </div>
                <span class="text-danger"></span>
                <span class="text-danger"></span>
            </div>

            <!-- Weight + Unit (Horizontal Group) -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Weight & Unit (KG)</label>
                <div class="d-flex gap-2 group-horizontal">
                    <input type="number" class="form-control form-control-sm" id="weight" />
                    <select class="form-select form-select-sm custom-select-single" id="weightUnitId" data-placeholder="Select Unit" asp-items="ViewBag.WeightUnit as SelectList">
                        <option value="">Select Unit</option>
                    </select>
                </div>
                <span class="text-danger"></span>
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Packing Quantity</label>
                <div class="d-flex gap-2 group-horizontal">
                    <input type="number" class="form-control form-control-sm" id="packQty" />
                    <select class="form-select form-select-sm custom-select-single" id="packQtyUnitId" data-placeholder="Select Unit" asp-items="ViewBag.QuantityUnit as SelectList">
                        <option value="">Select Unit</option>
                    </select>
                </div>
                <span class="text-danger"></span>
                <span class="text-danger"></span>
            </div>

            <!-- FWDR (Shipping Agent) -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">FWDR (Shipping Agent)</label>
                <input class="form-control form-control-sm" id="forwarderId" />
                <span class="text-danger"></span>
            </div>

            <!-- Vessel/Rott No -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Vessel/Rott No</label>
                <input class="form-control form-control-sm" id="vesselRottNo" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">ETA Delivery Date</label>
                <input asp-for="ETADeliveryDate" type="date" class="form-control form-control-sm custom-datepicker caiCon"
                       id="etaDeliveryDate" />
                <span asp-validation-for="ETADeliveryDate" class="text-danger"></span>
            </div>

            <!-- Actual Delivery Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Actual Delivery Date</label>
                <input asp-for="ActualDeliveryDate" type="date" class="form-control form-control-sm custom-datepicker caiCon"
                       id="actualDeliveryDate" />
                <span asp-validation-for="ActualDeliveryDate" class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Unstuffing Date</label>
                <input asp-for="UnstuffingDate" type="date" class="form-control form-control-sm custom-datepicker caiCon" id="unstuffingDate" />
                <span asp-validation-for="UnstuffingDate" class="text-danger"></span>
            </div>

            <!-- Place of Loading -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Place of Loading</label>
                <select asp-for="PlaceOfLoadingID" class="form-select form-select-sm custom-select-single" id="placeOfLoadingId" data-placeholder="Select Place" asp-items="ViewBag.PlaceOfLoading as SelectList">
                    <option value="">Select Place</option>
                </select>
                <span asp-validation-for="PlaceOfLoadingID" class="text-danger"></span>
            </div>

            <!-- ETD Date -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">ETD Date</label>
                <input asp-for="ETDDate" type="date" class="form-control form-control-sm custom-datepicker caiCon" id="etdDate" />
                <span asp-validation-for="ETDDate" class="text-danger"></span>
            </div>

            <!-- Shed / Yard -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Shed / Yard</label>
                <select asp-for="ShedYardID" class="form-select form-select-sm custom-select-single" id="shedYardId" data-placeholder="Select Shed/Yard" asp-items="ViewBag.ShedYard as SelectList">
                    <option value="">Select Shed/Yard</option>
                </select>
                <span asp-validation-for="ShedYardID" class="text-danger"></span>
            </div>

            <!-- Freight Charge -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Freight Charge</label>
                <select asp-for="FreightChargeID" class="form-select form-select-sm custom-select-single" id="freightChargeId" data-placeholder="Select Freight Charge" asp-items="ViewBag.FreightCharge as SelectList">
                    <option value="">Select Freight Charge</option>
                </select>
                <span asp-validation-for="FreightChargeID" class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Console No</label>
                <input class="form-control form-control-sm" id="consoleNo" />
                <span class="text-danger"></span>
            </div>

            <!-- Destination -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Destination</label>
                <select class="form-select form-select-sm custom-select-single" id="destinationId" data-placeholder="Select Destination" asp-items="ViewBag.PortName as SelectList">
                    <option value="">Select Destination</option>
                </select>
                <span class="text-danger"></span>
            </div>

            <!-- Remarks -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Remarks</label>
                <textarea class="form-control form-control-sm" rows="2" id="remarks"></textarea>
                <span class="text-danger"></span>
            </div>
        </div>

        @* Card 3: Agency Commission *@
        <fieldset class="custom-fieldset card p-3">
            <legend class="float-none w-auto px-2 fw-bold text-secondary small">
                Agency Commission
            </legend>
            <div class="row g-2">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Minimum Ag Comm (tk)</label>
                    <input type="number" class="form-control form-control-sm" id="agComm" placeholder="0.00" />
                    <span class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label">On Invoice Value (%)</label>
                    <input class="form-control form-control-sm" id="onInvVal" />
                    <span class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Amount</label>
                    <input class="form-control form-control-sm" id="amount" />
                    <span class="text-danger"></span>
                </div>
            </div>
        </fieldset>

        @* Quick Add Head & Cost *@
        <div class="row g-2 align-items-end mb-2">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Head</label>
                <select class="form-select form-select-sm custom-select-single" id="headId" data-placeholder="Select Head" asp-items="ViewBag.Head as SelectList">
                    <option value="">Select Head</option>
                </select>
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label">Cost</label>
                <input class="form-control form-control-sm" id="cost" placeholder="0.00" type="number" />
                <span class="text-danger"></span>
            </div>

            <div class="col-lg-4 col-md-3">
                <button class="btn btn-sm btn-primary" id="btnAddCost">
                    <i class="bi bi-plus-square-fill me-1"></i> Add
                </button>
            </div>
        </div>

        <fieldset class="custom-fieldset border rounded p-3 bg-white mb-3">
            <legend class="float-none w-auto px-2 fw-bold text-secondary small">
                Custom Handling Charge
            </legend>

            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0" id="chargeTable">
                    <thead class="text-center">
                        <tr class="small">
                            <th class="fw-bold text-center" style="width: 6%;">SL No.</th>
                            <th class="fw-bold text-center" style="width: 8%;">Is Rec.</th>
                            <th class="fw-bold text-start ps-2" style="width: 26%;">CHC Head</th>
                            <th class="fw-bold text-start ps-2" style="width: 30%;">Description</th>
                            <th class="fw-bold text-end pe-2" style="width: 14%;">Bill Amount Rate</th>
                            <th class="fw-bold text-center" style="width: 10%;">Include With Bill</th>
                            <th class="fw-bold text-center" style="width: 6%;">Action</th>
                        </tr>
                    </thead>
                    <tbody class="small fw-bold text-black" id="chargeTableBody" style="font-size: 0.85rem;">
                        <!-- Rows populated via AJAX -->
                    </tbody>
                </table>
            </div>
        </fieldset>

        <fieldset class="custom-fieldset border rounded p-3 bg-white mb-3">
            <legend class="float-none w-auto px-2 fw-bold text-secondary small">
                Expenses in Details
            </legend>

            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0" id="expenceDetailTable">
                    <thead class="text-center">
                        <tr class="small">
                            <th class="fw-bold text-center" style="width: 6%;">SL No.</th>
                            <th class="fw-bold text-start ps-2" style="width: 26%;">Expense Head</th>
                            <th class="fw-bold text-center" style="width: 10%;">Is Rece.</th>
                            <th class="fw-bold text-center" style="width: 18%;">Service Type</th>
                            <th class="fw-bold text-end pe-2" style="width: 14%;">Confirm Amount</th>
                            <th class="fw-bold text-end pe-2" style="width: 14%;">Bill Amount</th>
                            <th class="fw-bold text-center" style="width: 12%;">Include With Bill</th>
                        </tr>
                    </thead>
                    <tbody class="small fw-bold text-black" id="expenceDetailTableBody" style="font-size: 0.85rem;">
                        <!-- Rows populated via AJAX -->
                    </tbody>
                </table>
            </div>
        </fieldset>

        <div class="row g-3">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Special Discount (Bill Deduct)</label>
                <input class="form-control" id="disc" placeholder="0.00" />
                <span class="text-danger"></span>
            </div>
            <div class="col-lg-4 col-md-6"></div>
            <div class="col-lg-8 col-md-6 text-end pt-3">
                <span class="fw-bold me-3">Creation Date: <span id="creationDate">2026-01-29</span></span>
                <span class="fw-bold">Last Update: <span id="lastUpdateDate">2026-01-29</span></span>
            </div>
        </div>
    </fieldset>



    @* Card 4: Custom Handling Charge *@

    @* Card 5: Expenses in Details *@


    @* Card 6: Bill History *@
    <fieldset class="custom-fieldset card p-2 mb-3">
        <legend class="float-none w-auto px-2 fw-bold text-secondary small">
            <i class="fas fa-history me-1 text-primary"></i> Bill History
        </legend>

        @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
        {
            GridId = "BillHistoryTable",
            AjaxUrl = "/JobBillEntry/GetBillHistory",
            AjaxMethod = "POST",
            ServerSide = true,
            ShowCheckbox = true,
            CheckAllId = "checkAllBills",
            CheckColumnData = "billNo",
            DefaultSortColumn = "billNo",
            DefaultSortDirection = "desc",
            PageLengths = [5, 10, 25, 50, 100],
            DefaultPageLength = 10,
            CustomGridWrapper = false,
            CardWrapper = false,
            Columns = new()
            {
                new() { Data = "billNo", Header = "Bill No", Align = "left", IsEditLink = true, EditSelectorClass = "bill-detail-link", IdField = "billNo" },
                new() { Data = "billDate", Header = "Bill Date", RenderFn = "formatDate" },
                new() { Data = "jobNo", Header = "Job No", Align = "left" },
                new() { Data = "shipmentMode", Header = "Shipment Mode" },
                new() { Data = "customer", Header = "Customer", Align = "left" },
                new() { Data = "deliveryDate", Header = "Delivery Date", RenderFn = "formatDate" },
                new() { Data = "hawb", Header = "HAWB", Align = "left" },
                new() { Data = "beNo", Header = "BE No", Align = "left" },
                new() { Data = "invoiceValue", Header = "Invoice Value", Align = "right" }
            }
        })
    </fieldset>

    @* Standard Bottom Navigation *@
    @await Html.PartialAsync("_bottomNavigation")
</div>

@section Scripts {
    <script src="~/js/pages/BillEntry/billEntry.js" asp-append-version="true"></script>
}