<div class="p-1 pt-0 ob-page-wrapper">
    @if (ViewData["ShowPageTitle"] as bool? != true)
    {
        <!-- Top Header: Title and Subtitle -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2 pb-1 border-bottom">
            <div>
                <h4 class="text-body-emphasis mb-0 fw-bold" style="font-size: 1.15rem;">
                    @Html.SmartLocalize("Opening Balance Setup")
                    <span id="selectedFyDisplay" class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2" style="font-size: 0.8rem; vertical-align: middle;"></span>
                </h4>
            </div>
        </div>
    }


    <!-- Summary Metrics Row (Debit, Credit, Difference) -->
    <div class="row g-3 mb-2">
        <div class="col-12 col-md-4">
            <div class="ob-stat-card" style="--stat-color: #2563eb;">
                <span class="ob-stat-label">@Html.SmartLocalize("Total Debit")</span>
                <b class="ob-stat-num mt-1" id="lblTotalDebit">৳ 0.00</b>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="ob-stat-card" style="--stat-color: #0284c7;">
                <span class="ob-stat-label">@Html.SmartLocalize("Total Credit")</span>
                <b class="ob-stat-num mt-1" id="lblTotalCredit">৳ 0.00</b>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="ob-stat-card" id="cardDifference" style="--stat-color: #16a34a;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="ob-stat-label">@Html.SmartLocalize("Difference")</span>
                    <span class="badge badge-subtle-success" id="badgeDiffStatus" style="font-size: 12px;">
                        <i class="fas fa-check-circle me-1"></i>@Html.SmartLocalize("Balanced")
                    </span>
                </div>
                <b class="ob-stat-num mt-1 text-success" id="lblDifference">৳ 0.00</b>
            </div>
        </div>
    </div>

    <!-- Setup of Opening Balance Form with standard _Toolbars -->
    <div class="card shadow-none border-gray-200 mb-2">
        <div class="card-header p-0">
            @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
            {
                // Title = "Opening Balance Setup",
                SaveBtnId = "btnSave",
                SaveBtnClass = "js-ob-save",
                DeleteBtnId = "btnDelete",
                DeleteBtnClass = "js-ob-delete-confirm",
                ClearBtnId = "btnClear",
                ClearBtnClass = "js-ob-clear",
                PrintBtnId = "btnPrint",
                ShowPrint = true,
                ShowTitle = true
            })
        </div>
        <div class="card-body px-3 pt-2 pb-2">
            <form id="OpeningBalance-form" autocomplete="off" novalidate>
                <div class="alert alert-danger d-none" id="OpeningBalance-modalAlertError"></div>
                <input type="hidden" id="OpeningBalance-isEdit" value="0" />
                <input type="hidden" id="OpeningBalance-autoId" value="" />

                <div class="row gx-3">
                    <!-- Row 1: Company | Branch -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="modalCompany">@Html.SmartLocalize("Company")</label>
                        <select class="form-select form-select-sm custom-select-single" id="modalCompany" data-placeholder="@Html.SmartLocalize("Select Company")">
                            @foreach (var comp in dropdowns.Companies)
                            {
                                <option value="@comp.Code" data-id="@comp.Id" selected="@(comp.Code == "001" ? "selected" : null)">@comp.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="modalBranch">@Html.SmartLocalize("Branch")</label>
                        <select class="form-select form-select-sm custom-select-single" id="modalBranch" data-placeholder="@Html.SmartLocalize("Select Branch")">
                            @foreach (var br in dropdowns.Branches)
                            {
                                <option value="@br.Code" data-id="@br.Id" selected="@(br.Code == "01" || br.Code == "1" ? "selected" : null)">@br.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label fw-semibold req" for="modalFinancialYear">@Html.SmartLocalize("Financial Year")</label>
                        <select class="form-select form-select-sm custom-select-single" id="modalFinancialYear" data-placeholder="@Html.SmartLocalize("Select Financial Year")" required>
                            <option value="">@Html.SmartLocalize("Select Financial Year")...</option>
                            @for (int i = 0; i < dropdowns.FinancialYears.Count; i++)
                            {
                                var fy = dropdowns.FinancialYears[i];
                                <option value="@fy.Code" data-current="@(fy.IsCurrent ? "1" : "0")" selected="@(fy.IsCurrent ? "selected" : null)">@fy.Name</option>
                            }
                        </select>
                    </div>
                    <!-- hr divider -->
                    <div class="col-4 py-0 mt-2 mb-2">
                        <div style="width: 100%; border-top: 1px solid var(--phoenix-border-color, #e3e6ed);"></div>
                    </div><div class="col-8 py-0 mt-2 mb-2"></div>

                    <!-- Row 2: OB Code | Financial Year + Opening Date -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold req" for="modalObCode">@Html.SmartLocalize("OB Code")</label>
                        <input type="text" class="form-control form-control-sm bg-light" id="modalObCode" readonly placeholder="@Html.SmartLocalize("Auto-generated")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold req" for="modalAccountHead">@Html.SmartLocalize("Account Head")</label>
                        <select class="form-select form-select-sm custom-select-single" id="modalAccountHead" data-placeholder="@Html.SmartLocalize("Select Account Code - Account Head")" required>
                            <option value="">@Html.SmartLocalize("Select Account Code - Account Head")...</option>
                            @foreach (var grp in dropdowns.AccountHeads.GroupBy(a => a.GroupName))
                            {
                                <optgroup label="@grp.Key">
                                    @foreach (var acc in grp)
                                    {
                                        <option value="@acc.Code" data-deftype="@acc.DefaultTrType">@acc.Code - @acc.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold req" for="modalAmount">@Html.SmartLocalize("Opening Balance")</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" style="font-size: 13px;">৳</span>
                                    <input type="number" class="form-control form-control-sm text-end" id="modalAmount" min="0" step="0.01" placeholder="0.00" required />
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold req" for="modalTrType">@Html.SmartLocalize("Transaction Type")</label>
                                <select class="form-select form-select-sm custom-select-single" id="modalTrType" data-placeholder="@Html.SmartLocalize("Select Dr / Cr")" required>
                                    <option value="">@Html.SmartLocalize("Select Dr / Cr")...</option>
                                    <option value="Dr">@Html.SmartLocalize("Dr (Debit)")</option>
                                    <option value="Cr">@Html.SmartLocalize("Cr (Credit)")</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    @* <div class="col-md-6">
                        <div class="row g-2"> *@
                            <div class="col-4">
                                <label class="form-label fw-semibold req" for="modalOpeningDate">@Html.SmartLocalize("Opening Date")</label>
                                <div class="position-relative">
                                    <input type="text" class="form-control form-control-sm custom-datepicker vch-date-picker gc-date-input" id="modalOpeningDate" placeholder="dd/mm/yyyy" autocomplete="off" required />
                                </div>
                            </div>
                    @*     </div>
                    </div> *@

                    <!-- Row 3: Account Head | Opening Balance + Transaction Type -->

                    <!-- Row 4: Reference | Description (textarea) -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="modalReference">@Html.SmartLocalize("Reference")</label>
                        <input type="text" class="form-control form-control-sm" id="modalReference" maxlength="100" placeholder="@Html.SmartLocalize("e.g. OB-JV-001, REF-001")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="modalDescription">@Html.SmartLocalize("Description")</label>
                        <input type="text" class="form-control form-control-sm" id="modalDescription" maxlength="255" placeholder="@Html.SmartLocalize("Enter description or remarks (optional)")" />
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Excel File Upload Section (Format: | Download Template | Upload file (.csv) | File save |) -->
    <div class="ob-excel-panel border-gray-200 mb-2 py-1">
        <form id="OpeningBalance-formUploadCsv" enctype="multipart/form-data">
            <div class="d-flex flex-wrap align-items-center gap-3 fs-9">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-body-emphasis">@Html.SmartLocalize("Format"):</span>
                    <a href="@Url.Action("DownloadTemplate", "OpeningBalance")" class="btn toolbar-btn toolbar-btn-print" id="btnDownloadTemplate">
                        <i class="fas fa-download"></i>
                        <span>@Html.SmartLocalize("Download Template")</span>
                    </a>
                </div>

                <span class="text-body-tertiary d-none d-md-inline"></span>

                <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 480px;">
                    <label class="form-label mb-0 fw-semibold text-body-secondary text-nowrap" for="fileCsv">@Html.SmartLocalize("Upload file (.xlsx / .xls)"):</label>
                    <input class="form-control form-control-sm" type="file" id="fileCsv" accept=".xlsx,.xls,.csv" />
                </div>

                <div class="d-flex align-items-center">
                    <button type="submit" class="btn toolbar-btn toolbar-btn-save" id="btnUploadCsv">
                        <i class="fas fa-save"></i>
                        <span>@Html.SmartLocalize("File save")</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
    <!-- Table Grid Partial -->
    @await Html.PartialAsync("_Table")

</div>
<!-- Action Confirm Modal (Replaces browser confirm) -->
@await Html.PartialAsync("_ConfirmModal")

@section Scripts {
    <script src="~/js/pages/DatePickerCustom/DatePickerCustomBy404.js"></script>
    <script src="~/js/pages/OpeningBalance/openingBalance.js" asp-append-version="true"></script>
}
