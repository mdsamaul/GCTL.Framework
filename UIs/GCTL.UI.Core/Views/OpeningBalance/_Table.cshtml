@using GCTL.Core.ViewModels.Finance.OpeningBalancesVM
@{
    var dropdowns = ViewBag.Dropdowns as OpeningBalanceDropdownsVM ?? new OpeningBalanceDropdownsVM();
}

<div class="card shadow-none border-gray-200">
    <!-- Filter Bar with Reduced Padding Matching User Design -->
    <div class="card-header border-gray-200 bg-body-highlight px-2 py-1 pt-0">
        <div class="row g-2 align-items-end">
            <div class="col-auto d-none d-md-block align-self-center me-2">
                <span class="fw-bold fs-9 text-body-emphasis">
                    <i class="fas fa-filter me-1 text-primary"></i>@Html.SmartLocalize("Filter by"):
                </span>
            </div>
            <div class="col-6 col-sm-4 col-md-3">
                <label class="form-label fs-10 fw-semibold text-muted mb-1" for="fFinancialYear">@Html.SmartLocalize("Financial Year")</label>
                <select class="form-select form-select-sm custom-select-single" id="fFinancialYear" data-placeholder="@Html.SmartLocalize("All Years")">
                    <option value="">@Html.SmartLocalize("All Years")</option>
                    @foreach (var fy in dropdowns.FinancialYears)
                    {
                        <option value="@fy.Code">@fy.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <label class="form-label fs-10 fw-semibold text-muted mb-1" for="fFrom">@Html.SmartLocalize("Date from")</label>
                <input type="text" class="form-control form-control-sm" id="fFrom" placeholder="dd/mm/yyyy" />
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <label class="form-label fs-10 fw-semibold text-muted mb-1" for="fTo">@Html.SmartLocalize("To")</label>
                <input type="text" class="form-control form-control-sm" id="fTo" placeholder="dd/mm/yyyy" />
            </div>
            <div class="col-6 col-sm-4 col-md-3">
                <label class="form-label fs-10 fw-semibold text-muted mb-1" for="fAccountHead">@Html.SmartLocalize("Account Head")</label>
                <select class="form-select form-select-sm custom-select-single" id="fAccountHead" data-placeholder="@Html.SmartLocalize("All Accounts")">
                    <option value="">@Html.SmartLocalize("All Accounts")</option>
                    @foreach (var grp in dropdowns.AccountHeads.GroupBy(a => a.GroupName))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var acc in grp)
                            {
                                <option value="@acc.Code">@acc.Code - @acc.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-phoenix-secondary btn-sm" id="btnResetFilters" title="@Html.SmartLocalize("Reset Filters")">
                    <i class="fas fa-undo-alt me-1"></i>@Html.SmartLocalize("Reset")
                </button>
            </div>
        </div>
    </div>

    <!-- Table Grid Body Matching StudentAdmission -->
    <div class="card-body p-3 pt-1">
        <!-- Controls row: PageSize, BulkActions, Search -->
        <div class="row g-3 justify-content-between align-items-center mb-0">
            <div class="col-12 col-sm-auto">
                <div class="d-flex align-items-center">
                    <span class="fs-9 text-body-tertiary me-2">@Html.SmartLocalize("Show")</span>
                    <select id="OpeningBalance-pageSizeSelect" class="form-select form-select-sm" style="width: 75px;">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span class="fs-9 text-body-tertiary ms-2">@Html.SmartLocalize("entries")</span>
                </div>
            </div>

            <div class="col-12 col-sm-auto">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-none" id="OpeningBalance-bulkSelectActions">
                        <button type="button" class="btn btn-phoenix-danger btn-sm" id="OpeningBalance-delSel">
                            <i class="fas fa-trash me-1"></i>@Html.SmartLocalize("Delete Selected")
                        </button>
                    </div>

                    <div class="search-box" id="OpeningBalance-searchBox">
                        <form class="position-relative" id="OpeningBalance-searchForm" onsubmit="return false;">
                            <input class="form-control search-input search form-control-sm" id="OpeningBalance-searchInput" type="search" placeholder="@Html.SmartLocalize("Search here...")" aria-label="Search" />
                            <span class="fas fa-search search-box-icon"></span>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Leads Table Grid -->
        <div class="table-responsive ms-n1 ps-1 scrollbar">
            <table class="table table-sm fs-9 leads-table table-hover align-middle mb-0 adms-table" id="OpeningBalance-table">
                <thead id="OpeningBalance-table-head">
                    <tr>
                        <th class="white-space-nowrap fs-9 align-middle text-center py-1" style="width: 40px;">
                            <div class="form-check mb-0 fs-8 d-inline-block">
                                <input class="form-check-input" id="OpeningBalance-check-all py-1" type="checkbox" />
                            </div>
                        </th>
                        <th class="sort align-middle text-center text-nowrap cursor-pointer py-1" scope="col" data-sort="ComOpeningBalanceCode">
                            @Html.SmartLocalize("OB Code")
                        </th>
                        <th class="sort align-middle text-center text-nowrap cursor-pointer py-1" style="width: 17%" scope="col" data-sort="GeneralLedgerName">
                            @Html.SmartLocalize("Account Head")
                        </th>
                        <th class="sort align-middle text-center text-nowrap cursor-pointer py-1" style="width: 7%" scope="col" data-sort="OpeningBalance">
                            @Html.SmartLocalize("Opening Balance")
                        </th>
                        <th class="sort align-middle text-center text-nowrap cursor-pointer py-1" scope="col" data-sort="TrType">
                            @Html.SmartLocalize("Tr. Type")
                        </th>
                        <th class="sort align-middle text-center text-nowrap cursor-pointer py-1" scope="col" data-sort="OpeningDate">
                            @Html.SmartLocalize("Opening Date")
                        </th>
                        <th class="sort align-middle text-center text-nowrap cursor-pointer py-1" scope="col" data-sort="FinancialCodeNo">
                            @Html.SmartLocalize("Financial Year")
                        </th>
                        <th class="align-middle text-center text-nowrap py-1" scope="col">
                            @Html.SmartLocalize("Reference")
                        </th>
                        <th class="align-middle text-center text-nowrap py-1" scope="col">
                            @Html.SmartLocalize("Description")
                        </th>
                        <th class="align-middle text-center text-nowrap py-1" scope="col" style="width: 150px; min-width: 140px;">
                            @Html.SmartLocalize("Actions")
                        </th>
                    </tr>
                </thead>
                <tbody id="OpeningBalance-body">
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            @Html.SmartLocalize("Loading opening balance records...")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls Matching StudentAdmission -->
        <div class="d-flex flex-wrap align-items-center justify-content-between py-1 pe-0 fs-9 mt-2">
            <div class="d-flex">
                <p class="mb-0 d-none d-sm-block me-3 fw-semibold text-body" id="OpeningBalance-paginationInfo">
                    @Html.SmartLocalize("Showing 0 to 0 of 0 entries")
                </p>
            </div>
            <div class="d-flex">
                <button class="page-link" id="OpeningBalance-prevPageBtn"><span class="fas fa-chevron-left"></span></button>
                <ul class="mb-0 pagination" id="OpeningBalance-paginationLinks"></ul>
                <button class="page-link pe-0" id="OpeningBalance-nextPageBtn"><span class="fas fa-chevron-right"></span></button>
            </div>
        </div>
    </div>
</div>
