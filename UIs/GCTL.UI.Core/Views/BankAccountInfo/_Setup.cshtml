@model GCTL.Core.ViewModels.CoreBankAccountInformations.CoreBankAccountInformationSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;padding-left:15px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <input type="hidden" asp-for="AutoId" />

        @* ---------- ID (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "AccInfoId",
            LabelText = "ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-AccInfoId-code",
            DefaultValue = Model?.AccInfoId
        })
    </div>

    <div class="form-group row">

        @* ---------- Bank Name (Select) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BankId",
            LabelText = "Bank Name",
            FieldType = FieldType.Select,
            Placeholder = "--Select Bank Name--",
            SelectItems = ViewBag.BankDD as SelectList,
            IsRequired = true,
            ColumnClass = "col-lg-6"
        })

        @* ---------- Branch (Select) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BranchId",
            LabelText = "Branch",
            FieldType = FieldType.Select,
            Placeholder = "--Select Branch Name--",
            SelectItems = ViewBag.BranchDD as SelectList,
            IsRequired = true,
            ColumnClass = "col-lg-6"
        })
    </div>

    <div class="form-group row">

        @* ---------- A/C Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "AccountName",
            LabelText = "A/C Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter A/C Name",
            IsRequired = true,
            ColumnClass = "col-lg-6",
            DefaultValue = Model.AccountName
        })

        @* ---------- A/C No ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "AccountNo",
            LabelText = "A/C No",
            FieldType = FieldType.Text,
            Placeholder = "Enter A/C No",
            IsRequired = true,
            ColumnClass = "col-lg-6",
            DefaultValue = Model.AccountNo
        })
    </div>

    @if (Model.AutoId > 0)
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-BankAccountInfo-save",
            ReserveActionSlot = true,
            IsMarginRight = true
        })
    </div>
</div>