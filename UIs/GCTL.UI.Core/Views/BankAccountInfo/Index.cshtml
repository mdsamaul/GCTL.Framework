@model GCTL.UI.Core.ViewModels.CoreBankAccountInformations.CoreBankAccountInformationPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Bank Account Information";
    Model.Breadcrumb = "Bank Account Information";
}

<style>
    /* Wrapper for tabs */
    .tabwrap {
        margin-bottom: 10px;
    }

    /* Basic styling for the tab container */
    .MenuTab {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        border-bottom: 2px solid #ddd;
        flex-wrap: wrap;
    }

    .MenuTab li {
        margin: 0 1px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.1rem;
        text-decoration: none;
        color: #4a4a4a;
        font-weight: bold;
        white-space: nowrap;
        border: 1px solid lightgray;
        border-bottom: none;
        background: linear-gradient(to right, #f7fcff, #ffffff) !important;
        border-radius: 10px 10px 0 0;
        font-size: 14px;
        text-align: center;
        transition: background 0.3s, color 0.3s;
    }

    .MenuTab li a {
        display: flex;
        text-decoration: none;
        color: #4a4a4a;
        font-weight: bold;
        white-space: nowrap;
        border: none;
        font-size: 14px;
        text-align: center;
        padding: 6px 16px;
    }

    .MenuTab li.selected {
        background: linear-gradient(to right, #ffffff, #ffffff);
        color: #4a4a4a;
        font-weight: bold;
        border: 1px solid lightgray;
        border-radius: 10px 10px 0 0;
        background-color: white;
        border-bottom: none;
    }

    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        <!-- Navigation tabs -->
                        <div class="tabwrap" style="z-index: 100; width: 100%;">
                            <ul class="MenuTab">
                                <li>
                                    <a href="/BankInformations/Index?PageID=41">Bank</a>
                                </li>
                                <li>
                                    <a href="/BankBranchInformations/Index?PageID=41">Branch</a>
                                </li>
                                <li class="selected">
                                    <a href="/BankAccountInfo/Index?PageID=41">A/C Info</a>
                                </li>
                            </ul>
                        </div>
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Bank Account Information",
                            SaveBtnClass = "js-bankaccountinfo-save",
                            DeleteBtnClass = "js-bankaccountinfo-delete-confirm",
                            ClearBtnClass = "js-bankaccountinfo-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="bankaccountinfo-form" asp-controller="BankAccountInfo">
                            <div class="js-bankaccountinfo-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "bankAccountInfoTable",
                    AjaxUrl = "/BankAccountInfo/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "accInfoId",
                    CheckAllId = "bankaccountinfo-check-all",
                    DefaultSortColumn = "accInfoId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "accInfoId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-bankaccountinfo-edit" },
                        new() { Data = "accountName", Header = "Account Name", Width = "27%"},
                        new() { Data = "accountNo", Header = "Account No", Width = "20%"},
                        new() { Data = "bankName", Header = "Bank Name", Width = "21%"},
                        new() { Data = "branchName", Header = "Branch Name", Width = "22%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/bankAccountInfo.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "BankAccountInfo")'
        };

        $.bankAccountInfo(options);
    </script>
}
