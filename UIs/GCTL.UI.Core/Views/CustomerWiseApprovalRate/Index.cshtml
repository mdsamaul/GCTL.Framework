@model GCTL.Core.ViewModels.CustomerWiseApprovalRate.CustomerWiseApprovalRateViewModel

@{
    ViewData["Title"] = "Customer Wise Approval Rate Entry";
}

<link rel="stylesheet" href="~/css/custom/custom-datatable.css" asp-append-version="true" />
<link href="~/css/selectCSS.css" rel="stylesheet" />

<style>
    /* Flat & Crisp Design matching OperationFund */
    .custom-fieldset,
    .custom-fieldset:hover,
    .card,
    .card:hover,
    .btn,
    .btn:hover,
    .form-control,
    .form-select,
    .table,
    .toolbar-container,
    .sticky-bar {
        box-shadow: none !important;
        transform: none !important;
    }

    .toolbar-container,
    .toolbar-container.bg-white {
        background-color: #ffffff !important;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        box-shadow: none !important;
        border-radius: 4px;
        margin-bottom: 10px;
    }

    .custom-fieldset {
        position: relative;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        border-radius: 4px;
        padding: 10px 14px 10px 14px;
        margin-top: 10px !important;
        margin-bottom: 10px !important;
        background-color: #ffffff !important;
    }

    .custom-fieldset legend {
        display: none !important;
    }

    thead th,
    div.dt-container table.dataTable thead th,
    .custom-grid-table thead th {
        background: #f8fafc !important;
        background-image: none !important;
        color: #334155 !important;
        font-size: 12.5px;
        font-weight: 600;
        border-bottom: 1px solid #e2e8f0 !important;
        border-top: none !important;
    }

    .custom-grid-table tbody td {
        padding: 4px 6px !important;
        font-size: 12.5px;
        vertical-align: middle;
    }
</style>

<div class="container-fluid p-0">
    <!-- Toolbar like OFR / Bill / Operation Fund -->
    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
        Title = "Customer Wise Approval Rate Entry",
        SaveBtnId = "btnSave",
        DeleteBtnId = "btnDelete",
        ClearBtnId = "btnClear"
    })

    <!-- Setup Card -->
    <div class="custom-fieldset card p-2 border-0">
        <partial name="_Setup" />
    </div>

    <!-- Master List Grid at Bottom -->
    <div class="custom-fieldset card p-2 border-0">
        <partial name="_Grid" />
    </div>

    <!-- Bottom Navigation / Auditing -->
    <partial name="_bottomNavigation" />
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title fs-6"><i class="fa fa-exclamation-triangle me-1"></i> Confirm Delete</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-3">
                <p class="mb-0">Are you sure you want to delete this Customer Wise Approval Rate entry?</p>
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmDelete" class="btn btn-sm btn-danger px-3">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/customerWiseApprovalRate.js" asp-append-version="true"></script>
}
