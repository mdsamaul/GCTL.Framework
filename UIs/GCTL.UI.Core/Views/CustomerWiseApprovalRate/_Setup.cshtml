@model GCTL.Core.ViewModels.CustomerWiseApprovalRate.CustomerWiseApprovalRateViewModel
@using GCTL.UI.Core.ViewModels

<style>
    .form-control-sm, .form-select-sm,
    textarea.form-control-sm {
        font-size: 13px;
        padding: 2px 6px;
        height: 28px;
        border-radius: 3px;
        color: #000 !important;
    }

    textarea.form-control-sm {
        height: auto;
    }

    label,
    .form-label {
        font-size: 12px !important;
        font-weight: 600 !important;
        color: #495057 !important;
        white-space: nowrap;
    }

    label .text-danger,
    label sup,
    label span.text-danger,
    .form-label .text-danger,
    .form-label sup,
    .form-label span {
        font-size: 13px !important;
        line-height: 1 !important;
        vertical-align: middle !important;
        margin-left: 2px !important;
        display: inline-block !important;
    }

    .bg-light {
        background-color: #f0f1f2 !important;
    }

    .section-title {
        color: #0b6623;
        font-weight: 700;
        font-size: 13.5px;
        margin-top: 10px;
        margin-bottom: 8px;
    }

    .cwar-id-input {
        border: 1.5px solid #2e7d32 !important;
        background-color: #f6fff6 !important;
        font-weight: 700;
        color: #1b5e20 !important;
    }

    .grid-btn-group .btn {
        padding: 4px 8px;
        line-height: 1;
        height: 28px;
    }

    .audit-footer {
        margin-top: 15px;
        padding-top: 10px;
        border-top: 1px solid #e2e8f0;
        font-size: 12.5px;
    }

    #cwarGrid th, #cwarGrid td {
        font-size: 12.5px;
    }
</style>

<div class="container-fluid py-0">
    <form id="cwarForm">
        <!-- Row 1: Customer (Left) -->
        <div class="row mb-2 align-items-center">
            <div class="col-md-6">
                <div class="row align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">Customer <span class="text-danger">*</span></label>
                    <div class="col-sm-6">
                        <select class="form-select form-select-sm custom-select-single" id="ddlCustomer" data-placeholder="-- Select Customer --">
                            <option value="">-- Select Customer --</option>
                            @if (ViewBag.CustomerList != null)
                            {
                                foreach (var item in (SelectList)ViewBag.CustomerList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Address (Left) | Phone (Right) -->
        <div class="row mb-2 align-items-start">
            <div class="col-md-6">
                <div class="row align-items-start">
                    <label class="col-sm-4 text-sm-end form-label mb-0 pt-1">Address</label>
                    <div class="col-sm-6">
                        <textarea class="form-control form-control-sm bg-light" id="txtAddress" rows="2" readonly placeholder="Enter Address"></textarea>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">Phone</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control form-control-sm bg-light" id="txtPhone" readonly placeholder="Enter Phone Number" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 3: Email (Left) -->
        <div class="row mb-2 align-items-center">
            <div class="col-md-6">
                <div class="row align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">Email</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control form-control-sm bg-light" id="txtEmail" readonly placeholder="Enter valid email" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Divider -->
        <div class="row">
            <div class="col-12">
                <hr class="my-2 text-muted opacity-25">
            </div>
        </div>

        <!-- Row 4: CWAR ID (Left) -->
        <div class="row mb-2 align-items-center">
            <div class="col-md-6">
                <div class="row align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">CWAR ID</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control form-control-sm cwar-id-input" id="txtCwarId" value="@Model.CostingId" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Agency Commission -->
        <div class="section-title">
            Agency Commission:
        </div>

        <!-- Row 5: Minimum Agency Comm. (Left) | On Invoice Value (Right) -->
        <div class="row mb-2 align-items-center">
            <div class="col-md-6">
                <div class="row align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">Minimum Agency Comm.</label>
                    <div class="col-sm-6">
                        <input type="number" step="0.01" class="form-control form-control-sm text-end" id="txtMinAgencyComm" placeholder="Enter Minimum Agency Commission" />
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">On Invoice Value</label>
                    <div class="col-sm-6">
                        <div class="input-group input-group-sm flex-nowrap">
                            <input type="number" step="0.01" class="form-control form-control-sm text-end" id="txtOnInvoiceValue" placeholder="Enter On Invoice Value" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Custom Handling Charge -->
        <div class="section-title">
            Custom Handiling Charge:
        </div>
        <div class="row g-2 align-items-center mb-2">
            <div class="col">
                <div class="row g-1 align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">CHC Head</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm custom-select-single" id="ddlChcHead" data-placeholder="--Select CHC Head--">
                            <option value="">--Select CHC Head--</option>
                            @if (ViewBag.ChcHeadList != null)
                            {
                                foreach (var item in (SelectList)ViewBag.ChcHeadList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="row g-1 align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">Type</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm custom-select-single" id="ddlExpenseType" data-placeholder="--Select Type--">
                            <option value="">--Select Type--</option>
                            @if (ViewBag.ExpenseTypeList != null)
                            {
                                foreach (var item in (SelectList)ViewBag.ExpenseTypeList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="row g-1 align-items-center">
                    <label class="col-sm-4 text-sm-end form-label mb-0">Bill Amt. Rate</label>
                    <div class="col-sm-8">
                        <input type="number" step="0.01" class="form-control form-control-sm text-end" id="txtBillAmount" placeholder="Enter Bill Amount" />
                    </div>
                </div>
            </div>

            <div class="col-auto text-end grid-btn-group">
                <button type="button" id="btnAddGridRow" class="btn btn-sm btn-outline-success" title="Add / Update Row">
                    <i class="fa fa-list-alt"></i><i class="fa fa-plus fa-xs"></i>
                </button>
                <button type="button" id="btnRemoveGridRow" class="btn btn-sm btn-outline-danger" title="Remove Selected Row">
                    <i class="fa fa-list-alt"></i><i class="fa fa-times fa-xs"></i>
                </button>
                <button type="button" id="btnResetGridInputs" class="btn btn-sm btn-outline-secondary" title="Reset Inputs">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </div>

        <!-- Temp Table like the one in the Bill page -->
        <div class="row mt-2">
            <div class="col-12">
                <div id="gridContainer" class="table-responsive">
                    <table class="table table-bordered align-middle table-common custom-grid-table table-sm table-hover mb-0" id="cwarGrid">
                        <thead class="text-center">
                            <tr class="small">
                                <th class="fw-bold text-center" style="width: 5%;">Sel.</th>
                                <th class="fw-bold text-center" style="width: 12%;">ID</th>
                                <th class="fw-bold text-start ps-2" style="width: 38%;">CHC Head</th>
                                <th class="fw-bold text-start ps-2" style="width: 25%;">Shipment Mode</th>
                                <th class="fw-bold text-end pe-2" style="width: 20%;">Bill Amount</th>
                            </tr>
                        </thead>
                        <tbody class="small fw-bold text-black" id="cwarGridBody" style="font-size: 13px;">
                            <!-- Dynamic rows populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Audit Footer -->
        <div class="audit-footer row text-muted">
            <div class="col-md-6">
                Entry Date: <span id="lblEntryDate" class="fw-bold text-dark">-</span>
            </div>
            <div class="col-md-6 text-md-end">
                Last Update Date: <span id="lblModifyDate" class="fw-bold text-dark">-</span>
            </div>
        </div>
    </form>
</div>
