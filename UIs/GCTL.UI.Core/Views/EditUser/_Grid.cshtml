@using GCTL.UI.Core.ViewModels

@await Html.PartialAsync("_CustomGrid", new GridModel
{
    GridId = "editUserGrid",
    AjaxUrl = "/EditUser/GetPaginatedList",
    ServerSide = true,
    ShowCheckbox = false,
    DefaultSortColumn = "userId",
    DefaultSortDirection = "asc",
    Compact = true,
    Columns = new()
    {
        new() { Data = "userId", Header = "ID", Width = "10%", Align = "center" },
        new() { Data = "username", Header = "User Name", Width = "25%" },
        new() { Data = "fullName", Header = "Full Name", Width = "35%", Align = "left" },
        new() { Data = "userType", Header = "User Type", Width = "15%", Align = "center" },
        new() { Data = "entryDate", Header = "Entry Date", Width = "15%", Align = "center" }
    }
})

