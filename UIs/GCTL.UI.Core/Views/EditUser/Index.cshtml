@model GCTL.UI.Core.ViewModels.EditUsers.EditUserPageViewModel

@{
    ViewBag.Title = "Edit User Profile";
    Model.Breadcrumb = "Edit User Profile";
    Model.PageTitle = ViewBag.Title;
}

<style>
    .dataTables_scrollBody > table > thead > tr > th {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }

    table a {
        text-decoration: underline !important;
        color: #0000e0 !important;
    }

    #editUserGrid th:last-child,
    #editUserGrid td:last-child {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    /* Formosa responsive split layout (900px - 1500px and >1500px) */
    @@media (min-width: 900px) and (max-width: 1500px) {
        .eu-layout-form-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            margin-bottom: .5rem;
        }

        .eu-layout-form-col .card-body {
            padding-bottom: .5rem !important;
        }

        .eu-layout-grid-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
    }

    @@media (min-width: 1500.02px) {
        .eu-layout-form-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }

        .eu-layout-grid-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-xl-6 eu-layout-form-col pe-xl-1 ps-0">
                <div class="card card-primary">
                    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                    {
                        Title = Model.PageTitle,
                        SaveBtnClass = "js-edituser-save",
                        ClearBtnClass = "js-edituser-clear",
                        ShowDelete = false,
                        ShowFavorite = false,
                        ShowPrint = false
                    })
                    <div class="card-body" style="padding-left: 12px; padding-right: 12px; padding-top: 10px; padding-bottom: 12px;">
                        <form id="editUserForm">
                            <div class="js-edituser-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-6 eu-layout-grid-col ps-xl-1 pe-0 pb-0">
                <div class="card card-primary p-2">
                    <partial name="_Grid" />
                </div>
            </div>
        </div>
    </div>

    <partial name="_BottomNavigation" />
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/pages/useredit.js" asp-append-version="true"></script>
}

