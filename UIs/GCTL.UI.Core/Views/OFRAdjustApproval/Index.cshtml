<style>
    .card-header {
        min-height: 50px;
    }

    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 0px;
    }
    /* Remove padding, margin, border, background, and hover effects */
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        background: transparent !important;
        color: inherit !important;
        box-shadow: none !important;
    }

        /* Remove selected page button styling */
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: transparent !important;
            color: inherit !important;
            font-weight: normal !important;
            border: none !important;
        }

        /* Remove hover effect */
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: transparent !important;
            color: inherit !important;
        }


    #employee-filter-grid tbody tr td:first-child {
        width: 5%;
        padding: 0;
    }

    #employee-filter-grid thead th:first-child {
        width: 5%;
    }

    th.no-sort::after,
    th.no-sort::before {
        display: none !important;
    }

    .single-row-form .row {
        flex-wrap: nowrap !important;
    }

    .single-row-form .col-equal {
        flex: 1;
        min-width: 0;
        max-width: none;
        display: flex;
        flex-direction: column;
    }

    .single-row-form .label-container {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.5rem;
        padding: 0.25rem;
    }

    .single-row-form .form-label {
        margin: 0;
        font-size: 13px;
        text-align: start;
        word-wrap: break-word;
        hyphens: auto;
    }

    .single-row-form .form-control,
    .single-row-form .form-select {
        flex: 1;
    }


    /* Flat & Crisp Design */
    .custom-fieldset,
    .custom-fieldset:hover,
    .card,
    .card:hover,
    .btn,
    .btn:hover,
    .form-control,
    .form-select,
    .table,
    .toolbar-container,
    .sticky-bar {
        box-shadow: none !important;
        transform: none !important;
    }

    /* Make toolbar flat with crisp background, no shadow, subtle border */
    .toolbar-container,
    .toolbar-container.bg-white {
        background-color: #ffffff !important;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        box-shadow: none !important;
        border-radius: 4px;
        margin-bottom: 10px;
    }

    /* Crisp sections: clean white against #f8fafc app background with ultra-subtle crisp border */
    .custom-fieldset {
        position: relative;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        border-radius: 4px;
        padding: 10px 14px 10px 14px;
        margin-top: 10px !important;
        margin-bottom: 10px !important;
        background-color: #ffffff !important;
    }

    .custom-fieldset legend {
        display: none !important;
    }

    thead th,
    div.dt-container table.dataTable thead th,
    .custom-grid-table thead th {
        background: #f8fafc !important;
        background-image: none !important;
        color: #334155 !important;
        font-size: 12.5px;
        font-weight: 600;
        border-bottom: 1px solid #e2e8f0 !important;
        border-top: none !important;
    }

    div.dt-container table.dataTable thead th.col-select-cell,
    div.dt-container table.dataTable tbody td.col-select-cell,
    .custom-grid-table thead th.col-select-cell,
    .custom-grid-table tbody td.col-select-cell,
    th.col-select-cell,
    td.col-select-cell {
        padding: 0 !important;
    }

    /* Crisp Bottom Navigation & Pagination */
    .bottom-nav .card {
        box-shadow: none !important;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        border-radius: 4px !important;
        background-color: #ffffff !important;
    }

    div.dt-container .pagination .page-link {
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
        border-radius: 4px !important;
        box-shadow: none !important;
    }

    div.dt-container .pagination .page-item.active .page-link {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        color: #ffffff !important;
    }
</style>

<div class="container-fluid p-0">
    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
        Title = "Operational Fund Requisition Adjust Approval",
        SaveBtnId = "adjustApprove-SaveBtn",
        DeleteBtnId = "adjustApprove-DeleteBtn",
        ClearBtnId = "adjustApprove-Clear"
    })
    <div class="custom-fieldset card p-2 border-0">
        <partial name="_AdjustAppoveGrid" />
    </div>

    <div class="custom-fieldset card p-2 border-0">
        <partial name="_AdjustApproveSetup" />
    </div>

    <div class="custom-fieldset card p-2 mb-0 border-0">
        <partial name="_AdjustApproveBotomGrid" />
    </div>

    <partial name="_bottomNavigation"/>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/lib/bootstrap-multiselect-master/dist/css/bootstrap-multiselect.min.css" rel="stylesheet" />
    <script src="~/lib/bootstrap-multiselect-master/dist/js/bootstrap-multiselect.min.js"></script>

    <script src="~/js/pages/OperationalFund/adjustApproved.js" asp-append-version="true"></script>
}
