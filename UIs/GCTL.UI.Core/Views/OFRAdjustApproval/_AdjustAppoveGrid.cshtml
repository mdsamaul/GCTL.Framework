<style>
    fieldset {
        border: 1px solid #dee2e6 !important;
    }

    .page-link:focus {
        box-shadow: none;
    }

    div.dt-layout-end,
    div.dt-layout-full,
    div.dt-layout-start {
        padding: 0;
    }
</style>

<div class="row mb-2">
    <div class="col-12">
        <span class="text-dark" style="font-size: 13px; border-bottom: 2px solid #0d6efd; padding-bottom: 2px;">
            <i class="fas fa-filter me-1"></i> Filter By
        </span>
    </div>
</div>

<div class="row g-2 align-items-center mb-1">
    <div class="col-md-3">
        <div class="row align-items-center gx-2">
            <label class="col-auto col-form-label fw-semibold">Customer</label>
            <div class="col">
                <select id="Bill-Customer" class="form-select form-select-sm custom-select-single"></select>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="row align-items-center gx-2">
            <label class="col-auto col-form-label fw-semibold">Shipment Mode</label>
            <div class="col">
                <select id="Bill-ShipmentMode" class="form-select form-select-sm custom-select-single"></select>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <!-- Empty -->
    </div>
    <div class="col-md-4">
        <div class="row align-items-center gx-2">
            <label class="col-auto col-form-label fw-semibold">Date</label>
            <div class="col">
                <div class="input-group input-group-sm">
                    <span class="input-group-text py-0">From</span>
                    <input type="text" class="form-control form-control-sm custom-datepicker caiCon me-1 rounded-start-0" id="dateFrom" placeholder="DD/MM/YYYY">
                    <span class="input-group-text py-0 ms-1">To</span>
                    <input type="text" class="form-control form-control-sm custom-datepicker caiCon rounded-start-0" id="dateTo" style="border-radius: 0px;" placeholder="DD/MM/YYYY">
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_CustomGrid", new GridModel
{
    GridId = "Bill-Table",
    AjaxUrl = "/OFRAdjustApproval/GetAllRequisitionTopGrid",
    AjaxMethod = "POST",
    ServerSide = true,
    UseRadio = true,
    RadioName = "ApproveChecked",
    CheckColumnData = "jobNo",
    DefaultSortColumn = "jobDate",
    DefaultSortDirection = "desc",
    PageLengths = [5, 10, 25, 50, 100, -1],
    DefaultPageLength = 5,
    CustomGridWrapper = false,
    Columns = new()
    {
        new() { Data = "jobNo", Header = "Job No.", Width = "8%", Align = "left", IsWrapable = false, IsCopyable = true },
        new() { Data = "jobDate", Header = "Job Date", Width = "8%", RenderFn = "formatDate" },
        new() { Data = "shipmentMode", Header = "Shipment Mode", Width = "12%" },
        new() { Data = "customerName", Header = "Customer", Width = "18%", Align = "left" },
        new() { Data = "customerAddress", Header = "Address", Width = "27%", Align = "left" },
        new() { Data = "docReceivedDate", Header = "Doc Received Date", Width = "8%", RenderFn = "formatDate" },
        new() { Data = "invoice", SortField = "invoice", Header = "Invoice No.", Width = "10%", Align = "right" },
        new() { Data = "beNo", Header = "B/E No.", Width = "9%", Align = "left", IsWrapable = false }
    }
})