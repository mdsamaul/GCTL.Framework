@model GCTL.Core.ViewModels.Finance.ChartOfAccounts.ControlLedgerAddVM

<div class="coa-wrap">
    <partial name="~/Views/Shared/_ChartOfAccountsTabs.cshtml" model='@("ControlLedger")' />

    <!-- Setup Form Card -->
    <div class="coa-card">
        <div class="coa-ch" id="ControlLedger-formTitle">
            @Html.SmartLocalize("Control Ledger: new entry")
        </div>

        <form id="ControlLedger-form">
            <input type="hidden" id="ControlLedger-isEdit" value="0" />

            <!-- Row 1: Parent Hierarchy Selection (Single line, strictly no wrap) -->
            <div class="coa-parents-row">
                <div class="coa-form-col">
                    <label class="coa-form-label" for="GroupLedgerCodeNo" title="@Html.SmartLocalize("Group Ledger *")">
                        @Html.SmartLocalize("Group Ledger *")
                    </label>
                    <select class="form-select choiceDD" asp-for="GroupLedgerCodeNo" id="GroupLedgerCodeNo">
                        <option value="">-- @Html.SmartLocalize("Select Group Ledger") --</option>
                        @if (ViewBag.Groups != null)
                        {
                            foreach (var g in ViewBag.Groups)
                            {
                                <option value="@g.Code">@g.DisplayText</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="GroupLedgerCodeNo" class="text-danger small"></span>
                </div>
            </div>

            <!-- Row 2: Control Ledger Entry Fields (Single line within equal columns) -->
            <div class="coa-entry-row">
                <div class="coa-form-col">
                    <label class="coa-form-label" title="@Html.SmartLocalize("CL Code (auto)")">
                        @Html.SmartLocalize("CL Code (auto)")
                    </label>
                    <div class="coa-code-preview" id="ControlLedgerCodePreview">
                        <span class="text-muted">@Html.SmartLocalize("Select Group first")</span>
                    </div>
                    <input type="hidden" asp-for="ControlLedgerCodeNo" id="ControlLedgerCodeNo" />
                    <span asp-validation-for="ControlLedgerCodeNo" class="text-danger small"></span>
                </div>

                <div class="coa-form-col">
                    <label class="coa-form-label" for="ControlLedgerName" title="@Html.SmartLocalize("Control Ledger Name *")">
                        @Html.SmartLocalize("Control Ledger Name *")
                    </label>
                    <input type="text" class="coa-form-control" asp-for="ControlLedgerName" id="ControlLedgerName" placeholder="@Html.SmartLocalize("Enter Control Ledger name")" />
                    <span asp-validation-for="ControlLedgerName" class="text-danger small"></span>
                </div>

                <div class="coa-form-col">
                    <label class="coa-form-label" for="ShortName" title="@Html.SmartLocalize("Short Name")">
                        @Html.SmartLocalize("Short Name")
                    </label>
                    <input type="text" class="coa-form-control" asp-for="ShortName" id="ShortName" placeholder="@Html.SmartLocalize("Short Name")" />
                    <span asp-validation-for="ShortName" class="text-danger small"></span>
                </div>

                <div class="coa-form-col-auto">
                    <label class="coa-form-label d-none d-lg-block">&nbsp;</label>
                    <div class="d-flex align-items-center" style="height: 38px;">
                        <label class="coa-in mb-0">
                            <input type="checkbox" asp-for="IsActive" id="IsActive" value="true" checked />
                            <span>@Html.SmartLocalize("Active")</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="coa-fa">
                <button type="submit" class="coa-btn pri" id="ControlLedger-saveBtn">
                    @Html.SmartLocalize("Save")
                </button>
                <button type="button" class="coa-btn" id="ControlLedger-resetBtn">
                    @Html.SmartLocalize("Clear")
                </button>
            </div>
        </form>
    </div>

    <!-- Table Card -->
    <partial name="_Table" />
</div>

<partial name="_ConfirmDelete" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/finance/controlLedger.js" asp-append-version="true"></script>
}
