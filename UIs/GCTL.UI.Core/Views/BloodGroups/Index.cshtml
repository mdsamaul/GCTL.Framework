@model GCTL.UI.Core.ViewModels.BloodGroups.BloodGroupPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Blood Group Info";
    Model.Breadcrumb = "Blood Group Info";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Blood Group Info",
                            SaveBtnClass = "js-bloodgroup-save",
                            DeleteBtnClass = "js-bloodgroup-delete-confirm",
                            ClearBtnClass = "js-bloodgroup-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="bloodgroup-form" asp-controller="BloodGroups">
                            <div class="js-bloodgroup-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "bloodGroupTable",
                    AjaxUrl = "/BloodGroups/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "bloodGroupCode",
                    CheckAllId = "bloodgroup-check-all",
                    DefaultSortColumn = "bloodGroupCode",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "bloodGroupCode", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-bloodgroup-edit" },
                        new() { Data = "bloodGroup", Header = "Blood Group", Width = "50%"},
                        new() { Data = "banglaBloodGroup", Header = "Blood Group (বাংলা)", Width = "40%", Align = "center" }
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/bloodGroups.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "BloodGroups")'
        };

        $.bloodGroups(options);
    </script>
}
