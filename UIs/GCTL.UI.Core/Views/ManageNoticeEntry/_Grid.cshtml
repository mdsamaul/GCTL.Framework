@using GCTL.UI.Core.ViewModels

<style>
    .multiselect-container.dropdown-menu {
        min-width: 100% !important;
        width: auto;
    }

    .btn-group.single-select .multiselect-container input[type="radio"] {
        display: none !important;
    }

    .btn-group.single-select .multiselect-container label {
        padding-left: 0px;
    }
</style>

<div class="col-xl-12 col-md-12 col-lg-12 col-sm-12 col-12 py-2 p-0">
    <div class="row g-2 dropdown-wrapper">
        <div class="col-xl col-lg col-md col-sm-4 col-6">
            <label for="companySelect" class="form-label text-start mb-1 fw-semibold">Company</label>
            <select id="companySelect" class="form-select form-select-sm mx-auto"></select>
        </div>
        <div class="col-xl col-lg col-md col-sm-4 col-6">
            <label for="branchSelect" class="form-label text-start mb-1 fw-semibold">Branch</label>
            <select id="branchSelect" class="form-select form-select-sm mx-auto" multiple="multiple"></select>
        </div>
        <div class="col-xl col-lg col-md col-sm-4 col-6">
            <label for="departmentSelect" class="form-label text-start mb-1 fw-semibold">Department</label>
            <select id="departmentSelect" class="form-select form-select-sm mx-auto" multiple="multiple"></select>
        </div>
        <div class="col-xl col-lg col-md col-sm-4 col-6">
            <label for="designationSelect" class="form-label text-start mb-1 fw-semibold">Designation</label>
            <select id="designationSelect" class="form-select form-select-sm mx-auto" multiple="multiple"></select>
        </div>
        <div class="col-xl col-lg col-md col-sm-4 col-6">
            <label for="employeeSelect" class="form-label text-start mb-1 fw-semibold">Employee</label>
            <select id="employeeSelect" class="form-select form-select-sm mx-auto" multiple="multiple"></select>
        </div>
        <select id="activityStatusSelect" class="form-select form-select-sm mx-auto" multiple="multiple" hidden>
            <option value="01" selected>Active</option>
            <option value="02">Inactive</option>
        </select>
    </div>
</div>

<div class="mb-1 mt-2 border-0">
    <div class="p-0">
        @await Html.PartialAsync("_CustomGrid", new GridModel
        {
            GridId = "employee-filter-grid",
            ServerSide = false,
            ShowCheckbox = true,
            CheckAllId = "employee-check-all",
            CheckboxClass = "empSelect",
            CheckColumnData = "employeeId",
            Bordered = true,
            Compact = true,
            Hover = true,
            Striped = true,
            CustomGridWrapper = true,
            Columns = new()
            {
                new() { Data = "employeeId", Header = "Emp. ID", Width = "8%", Align = "center" },
                new() { Data = "employeeName", Header = "Name", Width = "18%", Align = "left" },
                new() { Data = "designationName", Header = "Designation", Width = "15%", Align = "left" },
                new() { Data = "departmentName", Header = "Department", Width = "14%", Align = "center" },
                new() { Data = "branchName", Header = "Branch", Width = "12%", Align = "center" },
                new() { Data = "employeeTypeName", Header = "Emp. Type", Width = "10%", Align = "center" },
                new() { Data = "employmentNature", Header = "Emp. Nature", Width = "10%", Align = "center" },
                new() { Data = "joiningDate", Header = "Joining Date", Width = "9%", Align = "center" },
                new() { Data = "employeeStatus", Header = "Activity Status", Width = "8%", Align = "center" }
            }
        })
    </div>
</div>

<div id="noticeForm" class="col-md-12">
    <partial name="_Setup" />
</div>

