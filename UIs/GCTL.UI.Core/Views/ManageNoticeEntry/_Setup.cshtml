@using GCTL.UI.Core.ViewModels

<div class="p-0">
    <form id="notice-form" class="mt-2">
        <input type="hidden" id="Tc" name="Tc" />

        <div class="row g-2 align-items-start">
            @* Row 1: Left = NoticeId | Right = Blank *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "NoticeId",
                LabelText = "Notice Id:",
                FieldType = FieldType.Text,
                IsReadonly = true,
                LabelInline = true,
                LabelColWidth = 4,
                LabelCssClass = "text-end d-block",
                ColumnClass = "col-lg-6 col-md-6 col-12 mb-2"
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                FieldType = FieldType.Blank,
                ColumnClass = "col-lg-6 col-md-6 col-12 d-none d-md-block mb-2"
            })

            @* Row 2: Left = NoticeTitle | Right = Active? *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "NoticeTitle",
                LabelText = "Notice Title:",
                FieldType = FieldType.Text,
                Placeholder = "Enter Notice Title",
                IsRequired = true,
                LabelInline = true,
                LabelColWidth = 4,
                LabelCssClass = "text-end d-block",
                ColumnClass = "col-lg-6 col-md-6 col-12 mb-2"
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "Status",
                LabelText = "Active?",
                FieldType = FieldType.Checkbox,
                LabelInline = true,
                LabelColWidth = 4,
                LabelCssClass = "text-end d-block",
                ColumnClass = "col-lg-6 col-md-6 col-12 mb-2"
            })

            @* Row 3: Left = Details | Right = Priority Level *@
            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "NoticeDesc",
                LabelText = "Details:",
                FieldType = FieldType.Textarea,
                Placeholder = "Enter Notice Details",
                Rows = 4,
                LabelInline = true,
                LabelColWidth = 4,
                LabelCssClass = "text-end d-block",
                ColumnClass = "col-lg-6 col-md-6 col-12 mb-2"
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "PriorityLevel",
                LabelText = "Priority Level:",
                FieldType = FieldType.Select,
                LabelInline = true,
                LabelColWidth = 4,
                LabelCssClass = "text-end d-block",
                SelectItems = new SelectList(new[]
                {
                    new { Value = "0", Text = "Normal" },
                    new { Value = "1", Text = "Important" }
                }, "Value", "Text", "0"),
                ColumnClass = "col-lg-6 col-md-6 col-12 mb-2"
            })

            @* Row 4: Left = File Upload | Right = Send Email *@
            <div class="col-lg-6 col-md-6 col-12 mb-2">
                <div class="row align-items-center gx-2">
                    <div class="col-4">
                        <label class="form-label mb-0 text-end d-block" for="fileUpload">File Upload:</label>
                    </div>
                    <div class="col-8">
                        <input type="file" id="fileUpload" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-12 mb-2">
                <div class="row align-items-center gx-2">
                    <div class="col-4"></div>
                    <div class="col-8">
                        <button type="button" class="btn btn-default success-btn btn-sm" id="sendMail">
                            Send Email
                        </button>
                    </div>
                </div>
            </div>

            @* Audit Date Info *@
            <div class="col-12" id="DateInfo" style="display:none;">
                <div class="container-fluid mx-auto mt-2">
                    <div class="d-md-flex justify-content-around">
                        <div style="width:10%"></div>
                        <div style="width:37%" class="text-center me-3">
                            <hr class="border border-2 text-dark p-0 m-0">
                        </div>
                        <div style="width:6%"></div>
                        <div style="width:37%" class="text-center p-0 m-0 ms-3">
                            <hr class="border border-2 text-dark m-0">
                        </div>
                        <div style="width:10%"></div>
                    </div>
                    <div class="d-md-flex justify-content-around">
                        <div style="width:10%"></div>
                        <div style="width:37%" class="text-center me-3">
                            <p class="mb-0 small">
                                Entry Date: <span name="LDate" id="LDate"></span>
                            </p>
                        </div>
                        <div style="width:6%"></div>
                        <div style="width:37%" class="text-center p-0 m-0 ms-3">
                            <p class="mb-0 small">
                                Last Update Date: <span name="ModifyDate" id="ModifyDate"></span>
                            </p>
                        </div>
                        <div style="width:10%"></div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

