@model GCTL.UI.Core.ViewModels.Religions.ReligionPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Religion Info";
    Model.Breadcrumb = "Religion Info";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Religion Info",
                            SaveBtnClass = "js-religion-save",
                            DeleteBtnClass = "js-religion-delete-confirm",
                            ClearBtnClass = "js-religion-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="religion-form" asp-controller="Religions">
                            <div class="js-religion-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Dynamic Grid Column -->
            <div class="col-md-6">
                <div class="js-religion-grid-container" id="religionGridContainer">
                    @if (Model.DynamicGrid != null)
                    {
                        @await Html.PartialAsync("_DynamicGrid", Model.DynamicGrid)
                    }
                </div>
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/grid-manager.js" asp-append-version="true"></script>
    <script src="~/js/pages/religions.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "Religions")'
        };
        options.load = () => {
            loadGridPage('religionGridContainer', '/Religions/GetTableData', 1, 10);
        };

        $.religions(options);
    </script>
}
