@model GCTL.UI.Core.ViewModels.Religions.ReligionPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Religion Info";
    Model.Breadcrumb = "Religion Info";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Religion Info",
                            SaveBtnClass = "js-religion-save",
                            DeleteBtnClass = "js-religion-delete-confirm",
                            ClearBtnClass = "js-religion-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="religion-form" asp-controller="Religions">
                            <div class="js-religion-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "religionTable",
                    AjaxUrl = "/Religions/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "religionCode",
                    CheckAllId = "religion-check-all",
                    DefaultSortColumn = "religionCode",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "religionCode", Header = "Code", Width = "20%", IsEditLink = true, EditSelectorClass = "js-religion-edit" },
                        new() { Data = "religion", Header = "Religion Name", Width = "45%", Align = "left" },
                        new() { Data = "shortName", Header = "Short Name", Width = "35%", Align = "left" }
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/religions.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "Religions")'
        };

        $.religions(options);
    </script>
}
