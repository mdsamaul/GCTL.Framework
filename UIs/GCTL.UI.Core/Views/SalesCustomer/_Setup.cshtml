                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "VatRegNo",
                    LabelText = "VAT Reg No",
                    FieldType = FieldType.Text,
                    Placeholder = "VAT Reg No",
                    ColumnClass = "col-md-6",
                    DefaultValue = Model.VatRegNo
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Bin",
                    LabelText = "BIN",
                    FieldType = FieldType.Text,
                    Placeholder = "BIN",
                    ColumnClass = "col-md-6",
                    DefaultValue = Model.Bin
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Tin",
                    LabelText = "TIN",
                    FieldType = FieldType.Text,
                    Placeholder = "TIN",
                    ColumnClass = "col-md-6",
                    DefaultValue = Model.Tin
                })

               
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "Cpid",
                        LabelText = "Contact Person",
                        FieldType = FieldType.MultiSelect,
                        Placeholder = "Select Contact Person",
                        SelectItems = ViewBag.ContactDD as SelectList,
                        ColumnClass = "col-lg-6",
                        ShowQuickAdd = true,
                        QuickAddUrl = Url.Action("Index", "ContactPersonInfo"),
                        QuickAddTarget = "#ContactPerson",
                        QuickAddReloadUrl = Url.Action("GetCountrys", "Cascading"),
                        QuickAddTitle = "Contact Person Info",
                        CustomAttributes = new Dictionary<string, string> { { "table-view", "true" } }
                    })

