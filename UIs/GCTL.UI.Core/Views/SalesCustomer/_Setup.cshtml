<style>
    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }

    .dropdown-menu {
        max-height: 200px;
        overflow-y: auto;
        width: 100%;
    }

    .table th, .table td {
        padding: 8px;
        text-align: left;
    }

    .table td {
        cursor: pointer;
    }

    .contact-person-checkbox {
        margin: 0;
    }

    .dropdown-menu {
        position: absolute;
        background: #fff;
        width: 100%;
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid #ddd;
        padding: 10px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        z-index: 1050;
    }

    #contactSearch {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 14px;
    }

    #contactPersonDropdown {
        width: 650px;
    }

        #contactPersonDropdown .table-responsive {
            max-height: 600px;
            overflow-y: auto;
        }
</style>

@model GCTL.Core.ViewModels.AddSalesCustomer.SalesCustomerViewModel
@using GCTL.UI.Core.ViewModels

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Customer Information</h5>
        <div>
            <button type="submit" id="salesCustomer-btnSave" class="btn btn-light btn-sm text-dark rounded-start px-2 text-nowrap saveBtn">
                <i class="fas fa-save me-1"></i> Save
            </button>
            <button type="button" id="salesCustomer-btnDelete" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap deleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="button" id="salesCustomer-btnBulkDelete" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap d-none deleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="reset" id="salesCustomer-resetBtn" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap resetBtn">
                <i class="fas fa-eraser me-1"></i> Clear
            </button>
            <button type="button" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap printBtn">
                <i class="fas fa-print me-1"></i> Print
            </button>
            <button type="button" class="btn btn-light btn-sm text-dark rounded-end px-2 text-nowrap favBtn">
                <i class="fas fa-star me-1"></i> Fav
            </button>
        </div>
    </div>
    <div class="card-body">
        <form id="customerForm">
            <div class="row g-3">

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerId",
                    LabelText = "Customer Id",
                    FieldType = FieldType.Text,
                    IsReadonly = true,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.CustomerId
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerCode",
                    LabelText = "Customer Code",
                    FieldType = FieldType.Text,
                    Placeholder = "Customer Code",
                    ColumnClass = "col-md-6",
                    DefaultValue = Model.CustomerCode
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerName",
                    LabelText = "Customer Name",
                    FieldType = FieldType.Text,
                    Placeholder = "Customer Name",
                    IsRequired = true,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model.CustomerName
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "ShortName",
                    LabelText = "Short Name",
                    FieldType = FieldType.Text,
                    Placeholder = "Short Name",
                    ColumnClass = "col-md-6",
                    DefaultValue = Model.ShortName
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerAddress",
                    LabelText = "Address",
                    FieldType = FieldType.Text,
                    Placeholder = "Address",
                    IsRequired = true,
                    ColumnClass = "col-md-12",
                    DefaultValue = Model.CustomerAddress
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CountryId",
                    LabelText = "Country",
                    FieldType = FieldType.Select,
                    Placeholder = "Select Country",
                    SelectItems = ViewBag.CountryDD as SelectList,
                    ColumnClass = "col-md-6",
                    ShowQuickAdd = true,
                    QuickAddUrl = Url.Action("Index", "Country"),
                    QuickAddTarget = "#CountryId",
                    QuickAddReloadUrl = Url.Action("GetCountrys", "Cascading"),
                    QuickAddTitle = "Country"
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "City",
                    LabelText = "City",
                    FieldType = FieldType.Text,
                    Placeholder = "City",
                    ColumnClass = "col-md-6",
