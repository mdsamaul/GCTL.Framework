                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "OpeningBalance",
                    LabelText = "Opening Balance",
                    FieldType = FieldType.Number,
                    Placeholder = "Opening Balance",
                    ColumnClass = "col-md-3",
                   // DefaultValue = Model.OpeningBalance
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "TransactionType",
                    LabelText = "Type",
                    FieldType = FieldType.Select,
                    Placeholder = "--Select Type--",
                    SelectItems = new SelectList(new[] { "Debit", "Credit" }),
                    ColumnClass = "col-md-3",
                    DefaultValue = Model.TransactionType
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "OpeningDate",
                    LabelText = "Opening Date",
                    FieldType = FieldType.Date,
                    Placeholder = "Opening Date",
                    ColumnClass = "col-md-6",
                   // DefaultValue = Model.OpeningDate
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CreditLimit",
                    LabelText = "Credit Limit",
                    FieldType = FieldType.Number,
                    Placeholder = "Credit Limit",
                    ColumnClass = "col-md-6",
                   // DefaultValue = Model.CreditLimit
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerType",
                    LabelText = "Customer Type",
                    FieldType = FieldType.Select,
                    Placeholder = "--Select Type--",
                    SelectItems = new SelectList(new[]
                    {
                        new { Value = "0", Text = "General" },
                        new { Value = "1", Text = "In House" }
                    }, "Value", "Text"),
                    ColumnClass = "col-md-6",
                    DefaultValue = Model.CustomerType
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Category",
