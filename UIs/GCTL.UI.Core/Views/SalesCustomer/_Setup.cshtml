@model GCTL.Core.ViewModels.AddSalesCustomer.SalesCustomerViewModel
@using GCTL.UI.Core.ViewModels

<div class="card rounded shadow-sm">
    <div class="card-header dynamic-grid-header">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "Customer Information",
            SaveBtnId = "salesCustomer-btnSave",
            SaveBtnClass = "js-salescustomer-save",
            DeleteBtnId = "salesCustomer-btnDelete",
            DeleteBtnClass = "js-salescustomer-delete-btn",
            ClearBtnId = "salesCustomer-resetBtn",
            ClearBtnClass = "js-salescustomer-clear",
            PrintBtnId = "salesCustomer-btnPrint",
            PrintBtnClass = "js-salescustomer-print",
            FavtBtnId = "salesCustomer-btnFav",
            FavtBtnClass = "js-salescustomer-fav"
        })
    </div>
    <div class="card-body px-4 py-3">
        <form id="customerForm">
            <div class="row gx-2 gy-1">

                @* ---------- Customer ID (readonly) ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerId",
                    LabelText = "Customer Id",
                    FieldType = FieldType.Text,
                    IsReadonly = true,
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.CustomerId
                })

                @* ---------- Customer Code ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerCode",
                    LabelText = "Customer Code",
                    FieldType = FieldType.Text,
                    Placeholder = "Customer Code",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.CustomerCode
                })

                @* ---------- Customer Name ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerName",
                    LabelText = "Customer Name",
                    FieldType = FieldType.Text,
                    Placeholder = "Customer Name",
                    IsRequired = true,
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.CustomerName,
                    AutoFocus = true
                })

                @* ---------- Short Name ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "ShortName",
                    LabelText = "Short Name",
                    FieldType = FieldType.Text,
                    Placeholder = "Short Name",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.ShortName
                })

                @* ---------- Customer Address (2 rows) ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerAddress",
                    LabelText = "Address",
                    FieldType = FieldType.Textarea,
                    Rows = 2,
                    Placeholder = "Address",
                    IsRequired = true,
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-12",
                    DefaultValue = Model?.CustomerAddress
                })

                @* ---------- Country ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CountryId",
                    LabelText = "Country",
                    FieldType = FieldType.Select,
                    Placeholder = "Select Country",
                    SelectItems = ViewBag.CountryDD as SelectList,
                    ColumnClass = "col-md-6",
                    ReserveActionSlot = false,
                    ShowQuickAdd = false,
                    DefaultValue = Model?.CountryId
                })

                @* ---------- City ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "City",
                    LabelText = "City",
                    FieldType = FieldType.Text,
                    Placeholder = "City",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.City
                })

                @* ---------- State / Province ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "StateOrProvince",
                    LabelText = "State/Province",
                    FieldType = FieldType.Text,
                    Placeholder = "State/Province",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.StateOrProvince
                })

                @* ---------- Zip Code ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "ZipCode",
                    LabelText = "Zip Code",
                    FieldType = FieldType.Text,
                    Placeholder = "Zip Code",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.ZipCode
                })

                @* ---------- Phone ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Phone",
                    LabelText = "Phone",
                    FieldType = FieldType.Text,
                    Placeholder = "Phone Number",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.Phone
                })

                @* ---------- Fax ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Fax",
                    LabelText = "Fax",
                    FieldType = FieldType.Text,
                    Placeholder = "Fax",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.Fax
                })

                @* ---------- Email ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Email",
                    LabelText = "Email",
                    FieldType = FieldType.Text,
                    Placeholder = "Email",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.Email
                })

                @* ---------- URL ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Url",
                    LabelText = "URL",
                    FieldType = FieldType.Text,
                    Placeholder = "URL",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.Url
                })

                @* ---------- VAT Reg No ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "VatRegNo",
                    LabelText = "VAT Reg No",
                    FieldType = FieldType.Text,
                    Placeholder = "VAT Reg No",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.VatRegNo
                })

                @* ---------- BIN ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Bin",
                    LabelText = "BIN",
                    FieldType = FieldType.Text,
                    Placeholder = "BIN",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.Bin
                })

                @* ---------- TIN (Left col, right is empty) ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Tin",
                    LabelText = "TIN",
                    FieldType = FieldType.Text,
                    Placeholder = "TIN",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.Tin
                })

                <div class="col-md-6 d-none d-md-block"></div>

                @* ---------- Contact Person (MultiSelect, Left col, right is empty) ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Cpid",
                    LabelText = "Contact Person",
                    FieldType = FieldType.MultiSelect,
                    Placeholder = "Select Contact Person",
                    SelectItems = ViewBag.ContactDD as SelectList,
                    ColumnClass = "col-md-6",
                    ReserveActionSlot = false,
                    ShowQuickAdd = true,
                    QuickAddUrl = Url.Action("Index", "ContactPersonInfo"),
                    QuickAddTarget = "#ContactPerson",
                    QuickAddReloadUrl = Url.Action("GetCountrys", "Cascading"),
                    QuickAddTitle = "Contact Person Info",
                    CustomAttributes = new Dictionary<string, string> { { "table-view", "true" } }
                })

                <div class="col-md-6 d-none d-md-block"></div>

                @* ---------- Opening Balance ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "OpeningBalance",
                    LabelText = "Opening Balance",
                    FieldType = FieldType.Number,
                    Placeholder = "Opening Balance",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-3",
                    DefaultValue = Model?.OpeningBalance?.ToString()
                })

                @* ---------- Transaction Type ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "TransactionType",
                    LabelText = "Type",
                    FieldType = FieldType.Select,
                    Placeholder = "--Select Type--",
                    SelectItems = new SelectList(new[] { "Debit", "Credit" }),
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-3",
                    DefaultValue = Model?.TransactionType
                })

                @* ---------- Opening Date ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "OpeningDate",
                    LabelText = "Opening Date",
                    FieldType = FieldType.Date,
                    Placeholder = "Opening Date",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.OpeningDate?.ToString("yyyy-MM-dd")
                })

                @* ---------- Credit Limit ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CreditLimit",
                    LabelText = "Credit Limit",
                    FieldType = FieldType.Number,
                    Placeholder = "Credit Limit",
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.CreditLimit?.ToString()
                })

                @* ---------- Customer Type ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "CustomerType",
                    LabelText = "Customer Type",
                    FieldType = FieldType.Select,
                    Placeholder = "--Select Type--",
                    SelectItems = new SelectList(new[]
                    {
                        new { Value = "0", Text = "General" },
                        new { Value = "1", Text = "In House" }
                    }, "Value", "Text"),
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.CustomerType
                })

                @* ---------- Customer Category ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "Category",
                    LabelText = "Customer Category",
                    FieldType = FieldType.Select,
                    Placeholder = "--Select Customer Category--",
                    SelectItems = new SelectList(new[]
                    {
                        new { Value = "regular", Text = "Regular Customer" },
                        new { Value = "premium", Text = "Premium Customer" },
                        new { Value = "vip", Text = "VIP Customer" },
                        new { Value = "new", Text = "New Customer" }
                    }, "Value", "Text"),
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.Category
                })

                @* ---------- Sales Person ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "SalesPerson",
                    LabelText = "Sales Person",
                    FieldType = FieldType.Select,
                    Placeholder = "--Select Sales Person--",
                    SelectItems = new SelectList(new[]
                    {
                        new { Value = "sabbir_ahmed", Text = "Sabbir Ahmed" },
                        new { Value = "nabila_sultana", Text = "Nabila Sultana" },
                        new { Value = "rafi_miah", Text = "Rafi Miah" },
                        new { Value = "tara_karim", Text = "Tara Karim" },
                        new { Value = "soumya_ray", Text = "Soumya Ray" }
                    }, "Value", "Text"),
                    ReserveActionSlot = false,
                    ColumnClass = "col-md-6",
                    DefaultValue = Model?.SalesPerson
                })

            </div>

            @* ---------- Audit / Creation & Modify Date ---------- *@
            <div class="row g-2 mt-1">
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    ContainerId = "salesCustomerLDateContainer",
                    InputId = "displayLDate",
                    LabelText = "Creation Date",
                    FieldType = FieldType.ReadonlyDisplay,
                    ColumnClass = "col-md-6",
                    ShowOnInit = false
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    ContainerId = "salesCustomerModifyDateContainer",
                    InputId = "displayModifyDate",
                    LabelText = "Modify Date",
                    FieldType = FieldType.ReadonlyDisplay,
                    ColumnClass = "col-md-6",
                    ShowOnInit = false
                })
            </div>

            @* ---------- Preview / Reports Action Footer ---------- *@
            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-3">
                <div>
                    <button type="button" class="btn btn-outline-secondary btn-sm me-2 rounded-pill shadow-none" id="previewBtn">
                        <i class="fas fa-file-alt me-1"></i> Preview
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill shadow-none" id="listPreviewBtn">
                        <i class="fas fa-list me-1"></i> List Preview
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>