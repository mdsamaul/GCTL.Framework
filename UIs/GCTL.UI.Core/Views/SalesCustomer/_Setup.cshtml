                    FieldType = FieldType.Select,
                    Placeholder = "--Select Customer Category--",
                    SelectItems = new SelectList(new[]
                    {
                        new { Value = "regular", Text = "Regular Customer" },
                        new { Value = "premium", Text = "Premium Customer" },
                        new { Value = "vip", Text = "VIP Customer" },
                        new { Value = "new", Text = "New Customer" }
                    }, "Value", "Text"),
                    ColumnClass = "col-md-6",
                    DefaultValue = Model.Category
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "SalesPerson",
                    LabelText = "Sales Person",
                    FieldType = FieldType.Select,
                    Placeholder = "--Select Sales Person--",
                    SelectItems = new SelectList(new[]
                    {
                        new { Value = "sabbir_ahmed", Text = "Sabbir Ahmed" },
                        new { Value = "nabila_sultana", Text = "Nabila Sultana" },
                        new { Value = "rafi_miah", Text = "Rafi Miah" },
                        new { Value = "tara_karim", Text = "Tara Karim" },
