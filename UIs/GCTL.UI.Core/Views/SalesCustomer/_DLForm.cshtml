<style>
    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }

    #DLcontactSearch {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 14px;
