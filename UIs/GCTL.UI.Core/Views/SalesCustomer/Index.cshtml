@using GCTL.Core.ViewModels.AddSalesCustomer


<style>
    .content {
        margin-right: 0 !important;
    }
    .equal-height-container {
        display: flex; 
    }
    .fill-height { 
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    #delivery-form-container { 
        overflow: hidden; /* Prevents overflow from parent */ 
    } 
    #delivery-form-container {
        overflow-y:hidden;
        flex-grow: 1;
    } /* Form container should take full height of its column */
    #customer-form-container,
    #delivery-form-container { 
        height: 100%; 
        display: flex; 
        flex-direction: column;
    } /* Form card takes full height */

    #customer-form-container .card, #delivery-form-container .card {
        flex: 1; display: flex; 
        flex-direction: column;
    } /* Table container takes full height */

        #customer-list-container, #delivery-list-container {
            height: auto !important; 
            display: block !important;
            flex: none !important; 
        } /* Table card structure */
        .table-card {
            flex-direction: column;
        } /* Card body takes all available space */
        .table-card .card-body {
            padding: 0; 
            display: block !important;
            flex-direction: column; 
            min-height: 0; /* Allows flex item to shrink below content size */ 
            overflow: hidden;
        } /* Scrollable table area */
            .table-scroll-area { 
                display: block !important; 
                overflow-y: visible !important;
                min-height: auto; /* Allows flex item to shrink below content size */
                height: auto !important;
            } /* Fixed footer doesn't grow or shrink */
                .pagination-footer {
                    flex: 0 0 auto; 
                    padding: 8px 12px; 
                } /* Make sure table takes full width */ 
                .table-scroll-area table {
                    width: 100%;
                    margin-bottom: 0; 
                    table-layout: auto; 
                } /* Ensure table header sticks to top if we want that behavior */
                .table-scroll-area thead {
                    position: sticky; top: 0;
                    background-color: #fff; z-index: 1;
                }
                .select2-container .select2-selection--single {
                    height: 48px !important;
                    padding: 8px 12px;
                    font-size: 16px;
                }
                .select2-container--default .select2-selection--single .select2-selection__arrow b {
                    border-width: 8px 6px 0 6px !important;
                    left: 10% !important; top: 85% !important;
                }
                #contactPersonModal .modal-dialog {
                    max-width: 1600px !important; /* custom width */
                     width: 95% !important; /* optional, relative to viewport */
 } </style>

@model SalesCustomerViewModel
@{
    ViewData["Title"] = "Customer Information";
}
<div class="mb-3" style="display:flex;">
    <div class="card-body">
        <ul class="nav nav-tabs" id="customerTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="customer-info-tab" data-bs-toggle="tab" data-bs-target="#customer-info" type="button" role="tab" aria-controls="customer-info" aria-selected="true">Customer Info</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="delivery-address-tab" data-bs-toggle="tab" data-bs-target="#delivery-address" type="button" role="tab" aria-controls="delivery-address" aria-selected="false">Delivery Address</button>
            </li>
        </ul>

        <div class="tab-content" id="customerTabsContent">
            <div class="tab-pane fade show active" id="customer-info" role="tabpanel" aria-labelledby="customer-info-tab">
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="card">
                        <div id="customer-form-container">
                            @await Html.PartialAsync("_Setup", new SalesCustomerViewModel())
                        </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="customer-list-container">
                            @await Html.PartialAsync("_Table")
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="delivery-address" role="tabpanel" aria-labelledby="delivery-address-tab">
                <div class="row  mt-3">
                    <div class="col-md-6">
                        <div class="card">
                            <div id="delivery-form-container">
                                @await Html.PartialAsync("_DLForm", new SalesDeliveryLocationViewModel())
                            </div>
                        </div>
                        
                    </div>
                    <div class="col-md-6">
                        <div id="delivery-list-container">
                            @await Html.PartialAsync("_DLTable")
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");


    }

    <script src="~/js/pages/CustomerRelationshipManagement/salesCustomerData.js"></script>
	<script src="~/js/pages/customerrelationshipmanagement/salesDeliveryLocation.js"></script>
    @* Contact Person *@
    <script src="~/js/pages/customerrelationshipmanagement/SaleContactPerson.js"></script>



    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <link href="~/select2/css/select2.min.css" rel="stylesheet" />





	
	<link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" />
	<script src="~/lib/toastr.js/toastr.min.js"></script>

    <!-- SweetAlert2 JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>




}


<!-- Modal -->
<div class="modal fade" id="contactPersonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Contact Person</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex gap-1">
                <div id="partialOne" class="col-md-6">
                    @await Html.PartialAsync("~/Views/ContactPerson/ContactPersonForm.cshtml")
                </div>
                <div id="partialTwo" class="col-md-6">
                    @await Html.PartialAsync("~/Views/ContactPerson/ContactPersonGrid.cshtml")
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

