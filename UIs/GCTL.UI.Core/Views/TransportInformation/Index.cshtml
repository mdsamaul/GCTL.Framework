@model GCTL.UI.Core.ViewModels.TransportInformation.TransportInformationPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Transport Information";
    Model.Breadcrumb = "Transport Information";
}

<style>

    #TransportDeleteModalBodyHeightFeixd {
        height: 50px !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }

    .bg-light {
        background-color: #fff !important;
        color: #000 !important;
    }

    .form-control:disabled, .form-control[readonly] {
        background-color: #fff !important;
    }

    /* Plus Button Style */
    .btn-plus {
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        padding: 0 10px;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd; /* Bootstrap blue */
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

    /* Country wrapper */
    .Vehicle-input-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .Vehicle-select-wrap {
        flex: 1;
        min-width: 0; /* flex child shrink fix */
    }

        /* Select2 container full width */
    .Vehicle-select-wrap .select2-container {
            width: 100% !important;
        }

    /* Plus button */
    .btn-plus {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-6 pe-1">
                <div class="card">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Transport Information",
                            SaveBtnClass = "js-TransportInformation-save",
                            DeleteBtnClass = "js-TransportInformation-delete-confirm",
                            ClearBtnClass = "js-TransportInformation-clear",
                            ReserveActionSlot=true
                        })
                    </div>
                    <div class="card-body px-2">

                        <form asp-action="Setup" method="post" id="TransportInformation-form" asp-controller="TransportInformation">

                            <div class="js-TransportInformation-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6 ps-1">
                <div class="card">
                        <div class="js-TransportInformation-grid-container">
                            @await Html.PartialAsync("_CustomGrid", new GridModel
                            {
                                GridId = "TransportInformation-grid",
                                CheckAllId = "js-TransportInformation-checkall",
                                Columns = new List<GridColumn>
                                {
                                    new() { Header = "ID", Width="10%"  },
                                    new() { Header = "Transport No.",Width="23%" },
                                    new() { Header = "Transport Type" ,Width="32%" },
                                    new() { Header = "Port Name",Width="20%" }
                                },
                                ShowCheckbox = true,   // ← add this
                                Bordered = true,
                                Striped =true
                            })

                        </div>
                </div>
            </div>

        </div>
        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/transportInformation.js"></script>
    <script type="text/javascript">
        var options = {
        baseUrl: '@Url.Action("", "TransportInformation")'
        };
        options.load = () => {
        };

        $.transportInformation(options);
    </script>
}

