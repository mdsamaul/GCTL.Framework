@model GCTL.Core.ViewModels.TransportInformation.TransportInformationSetupViewModel

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>
    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <div class="col-lg-6">
            <label asp-for="VehicleId">ID </label>
            <div class="input-group input-group-sm">
                <input asp-for="VehicleId" type="text" class="form-control form-control-sm js-VehicleId-code" readonly="readonly" />
            </div>
        </div>

        <div class="col-lg-6">
            <label asp-for="VehicleTypeId">Transport Type<span style="color:red">*</span></label>
            <div class="Vehicle-input-wrapper">
                <div class="Vehicle-select-wrap">
                    <select asp-for="VehicleTypeId"
                            asp-items="ViewBag.VehicleDD"
                            class="form-control form-control-sm custom-select-single"
                            tabindex="1">
                        <option value="">-- Select Transport Type --</option>
                    </select>
                </div>
                <button type="button" class="btn btn-plus js-quick-add"
                        data-url="@Url.Action("Index", "TransportType")"
                        data-target="#VehicleTypeId"
                        data-reload-url="@Url.Action("GetTransportTypes", "Cascading")"
                        data-title="Transport Type">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="VehicleNo">Transport No.<span style="color:red">*</span></label>
            <input type="text" asp-for="VehicleNo" class="form-control form-control-sm" placeholder="Enter Transport No." tabindex="2" />
        </div>

        <div class="col-lg-6">
            <label asp-for="PortNameId">Port Name</label>
            <div class="Vehicle-input-wrapper">
                <div class="Vehicle-select-wrap">
                    <select asp-for="PortNameId"
                            asp-items="ViewBag.PortNameDD"
                            class="form-control form-control-sm custom-select-single"
                            tabindex="3">
                        <option value="">-- Select Port Name --</option>
                    </select>
                </div>
                <button type="button" class="btn btn-plus js-quick-add"
                        data-url="@Url.Action("Index", "PortName")"
                        data-target="#PortNameId"
                        data-reload-url="@Url.Action("GetPortNames", "Cascading")"
                        data-title="Port Name">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
    </div>

    @if (Model.Tc > 0)
    {

        <hr />
        <div class="form-group row" id="LdateModifyHide">
            <div class="col-lg-6">
                @if (Model.Ldate.HasValue)
                {
                    <label>Creation Date: </label>

                    <label>@Model.Ldate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
            <div class="col-lg-6">
                @if (Model.ModifyDate.HasValue)
                {
                    <label>Last Update Date: </label>

                    <label>@Model.ModifyDate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
        </div>

    }

</div>
<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "TransportInformation"
        })
    </div>
</div>
