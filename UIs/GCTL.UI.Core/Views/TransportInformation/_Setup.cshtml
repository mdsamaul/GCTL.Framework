@model GCTL.Core.ViewModels.TransportInformation.TransportInformationSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Vehicle ID (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "VehicleId",
            LabelText = "ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-VehicleId-code",

            DefaultValue= Model?.VehicleId


        })

        @* ---------- Transport Type (Select + Quick Add) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "VehicleTypeId",
            LabelText = "Transport Type",
            FieldType = FieldType.Select,
            Placeholder = "Select Transport Type",
            SelectItems = ViewBag.VehicleDD as SelectList,
            IsRequired = true,
            ColumnClass = "col-lg-6",
            ShowQuickAdd = true,
            QuickAddUrl = Url.Action("Index", "TransportType"),
            QuickAddTarget = "#VehicleTypeId",
            QuickAddReloadUrl = Url.Action("GetTransportTypes", "Cascading"),
            QuickAddTitle = "Transport Type"
        })
    </div>

    <div class="form-group row">

        @* ---------- Transport No. ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "VehicleNo",
            LabelText = "Transport No.",
            FieldType = FieldType.Text,
            Placeholder = "Enter Transport No.",
            IsRequired = true,
            ReserveActionSlot = true,
            ColumnClass = "col-lg-6",
            DefaultValue=Model.VehicleNo
        })

        @* ---------- Port Name (Select + Quick Add) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "PortNameId",
            LabelText = "Port Name",
            FieldType = FieldType.Select,
            Placeholder = "Select Port Name",
            SelectItems = ViewBag.PortNameDD as SelectList,
            ColumnClass = "col-lg-6",
            ShowQuickAdd = true,
            QuickAddUrl = Url.Action("Index", "PortName"),
            QuickAddTarget = "#PortNameId",
            QuickAddReloadUrl = Url.Action("GetPortNames", "Cascading"),
            QuickAddTitle = "Port Name"
        })
    </div>

    @if (Model.Tc > 0)
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-TransportInformation-save",
            ReserveActionSlot = true,
           Style="border-bottom:0px !important;"
            // IsMarginRight = true
        })
    </div>
</div>