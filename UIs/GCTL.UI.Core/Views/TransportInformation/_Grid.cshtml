@model List<GCTL.Core.ViewModels.TransportInformation.TransportInformationSetupViewModel>

<table id="TransportInformation-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="TransportInformation-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">ID</th>
            <th class="text-center text-middle" style="width: 23%;">Transport No.</th>
            <th class="text-center text-middle" style="width: 32%;">Transport Type</th>
            <th class="text-center text-middle" style="width: 20%;">Port Name</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                @* <td colspan="8">No Data Available.</td> *@
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.VehicleId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" id="js-TransportInformation-checkbox" class="text-center text-middle checkBox" data-id="@item.VehicleId" value="@item.VehicleId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-TransportInformation-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.VehicleId" title="Edit">
                            @item.VehicleId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.VehicleNo</td>
                    <td class="text-center text-middle">@item.VehicleType</td>
                    <td class="text-center text-middle">@item.PortName</td>

                </tr>
            }
        }

    </tbody>
</table>

