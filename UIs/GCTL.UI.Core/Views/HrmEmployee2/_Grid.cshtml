@await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
{
    GridId = "HrmEmployee2-grid",
    AjaxUrl = "/HrmEmployee2/GetTableData",
    AjaxMethod = "POST",
    ServerSide = true,
    ShowCheckbox = true,
    CheckColumnData = "employeeId",
    CheckAllId = "HrmEmployee2-check-all",
    DefaultSortColumn = "employeeId",
    DefaultSortDirection = "desc",
    CardWrapper = true,
    CardTitle = "Employee Information List",
    IconClass = "fa-solid fa-users",
    AddButtonUrl = "/HrmEmployee2/Setup",
    AddButtonText = "Add Employee",
    AddButtonId = "add_employee",
    Columns = new()
    {
        new() { Data = "employeeId", Header = "Employee Id", Width = "8%", IsEditLink = true, EditSelectorClass = "js-HrmEmployee2-edit" },
        new() { Data = "firstName", Header = "Name", Width = "18%", RenderFn = "hrmEmpName" },
        new() { Data = "firstNameBangla", Header = "Name (বাংলা)", Width = "18%", RenderFn = "hrmEmpNameBn" },
        new() { Data = "sexCode", Header = "Gender", Width = "7%" },
        new() { Data = "nationalityCode", Header = "Nationality", Width = "10%" },
        new() { Data = "nationalIdno", Header = "National ID", Width = "11%" },
        new() { Data = "telephone", Header = "Phone", Width = "10%" },
        new() { Data = "photoUrl", Header = "Picture", Width = "8%", Sortable = false, Searchable = false, RenderFn = "hrmEmpPhoto" },
        new() { Data = "autoId", Header = "Actions", Width = "10%", Sortable = false, Searchable = false, RenderFn = "hrmEmpActions" }
    }
})
