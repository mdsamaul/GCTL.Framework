@model GCTL.Core.ViewModels.HrmEmployees2.HrmEmployee2SetUpViewModel
@using GCTL.UI.Core.ViewModels

@{
    ViewBag.Title = "Employee Information List";
    Model.PageTitle = "Employee Information System";
    Model.Breadcrumb = "Employee Information System";
}

<div id="customLoadingOverlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background-color:rgba(0,0,0,0.5);z-index:9999;justify-content:center;align-items:center;">
    <div style="background-color:white;padding:20px;border-radius:5px;box-shadow:0 0 10px rgba(0,0,0,0.3);text-align:center;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <p style="margin-top:10px;margin-bottom:0;">Loading data...</p>
    </div>
</div>

<partial name="_PageHeader" model="Model" />

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-0">
                    <div class="card-header border-transparent py-1">
                        @await Html.PartialAsync("_Toolbars", new ToobarModel
                        {
                            Title = "Employee Information System",
                            SaveBtnClass = "js-HrmEmployee2-save",
                            DeleteBtnClass = "js-HrmEmployee2-delete-confirm",
                            ClearBtnClass = "js-HrmEmployee2-clear"
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <form asp-action="Setup" id="HrmEmployee2-form" method="post" enctype="multipart/form-data" asp-controller="HrmEmployee2">
        <div class="container-fluid">
            <div class="form-group row pt-2">

                <!-- ================= LEFT SIDE ================= -->
                <div class="col-md-9 gc-inline-select2">
                    <div class="card">
                        <div class="card-header py-0">
                            @await Html.PartialAsync("_TabButton")
                        </div>
                        <div class="card-body pt-1">
                            <div class="pt-2">

                                <input type="hidden" id="lastCode" />
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="Ldate" />
                                <input type="hidden" asp-for="ModifyDate" />
                                <input type="hidden" asp-for="AutoId" />

                                <!-- ========== Row 1 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Company",
                                        InputId = "CompanyCode",
                                        FieldType = FieldType.Select,
                                        IsRequired = true,
                                        Placeholder = "--Select Company--",
                                        SelectItems = ViewBag.CoreCompanyDD as SelectList,
                                        DefaultValue = Model.CompanyCode,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 2 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Employee ID",
                                        InputId = "EmployeeId",
                                        FieldType = FieldType.Text,
                                        IsRequired = true,
                                        Placeholder = "Enter Employee Id",
                                        DefaultValue = Model.EmployeeId,
                                        JsEventClass = "js-code",
                                        AutoFocus = true,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "First Name",
                                        InputId = "FirstName",
                                        FieldType = FieldType.Text,
                                        IsRequired = true,
                                        Placeholder = "Enter Employee First Name",
                                        DefaultValue = Model.FirstName,
                                        JsEventClass = "js-check-availability",
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Last Name",
                                        InputId = "LastName",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Employee Last Name",
                                        DefaultValue = Model.LastName,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 3 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "First Name (বাংলা)",
                                        InputId = "FirstNameBangla",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter First Name (বাংলা)",
                                        DefaultValue = Model.FirstNameBangla,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Last Name (বাংলা)",
                                        InputId = "LastNameBangla",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Last Name (বাংলা)",
                                        DefaultValue = Model.LastNameBangla,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 4 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Father's Name",
                                        InputId = "FatherName",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Father's Name",
                                        DefaultValue = Model.FatherName,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Mother's Name",
                                        InputId = "MotherName",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Mother's Name",
                                        DefaultValue = Model.MotherName,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 5 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Father's Occupation",
                                        InputId = "FatherOccupation",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Father's Occupation",
                                        DefaultValue = Model.FatherOccupation,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Mother's Occupation",
                                        InputId = "MotherOccupation",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Mother's Occupation",
                                        DefaultValue = Model.MotherOccupation,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Date of Birth",
                                        InputId = "DateOfBirthOrginal",
                                        FieldType = FieldType.Date,
                                        DefaultValue = Model.DateOfBirthOrginal?.ToString("dd/MM/yyyy"),
                                        Placeholder = "dd/mm/yyyy",
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 6 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Date of Birth (Certificate)",
                                        InputId = "DateOfBirthCertificate",
                                        FieldType = FieldType.Date,
                                        DefaultValue = Model.DateOfBirthCertificate?.ToString("dd/MM/yyyy"),
                                        Placeholder = "dd/mm/yyyy",
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Birth Certificate No",
                                        InputId = "BirthCertificateNo",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Birth Certificate No.",
                                        DefaultValue = Model.BirthCertificateNo,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Place Of Birth",
                                        InputId = "PlaceOfBirth",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Place Of Birth",
                                        DefaultValue = Model.PlaceOfBirth,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 7 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Gender",
                                        InputId = "SexCode",
                                        FieldType = FieldType.Select,
                                        IsRequired = true,
                                        Placeholder = "--Select Gender--",
                                        SelectItems = ViewBag.SexesDD as SelectList,
                                        DefaultValue = Model.SexCode,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Blood Group",
                                        InputId = "BloodGroupCode",
                                        FieldType = FieldType.Select,
                                        Placeholder = "--Select Blood Group--",
                                        SelectItems = ViewBag.BloodGroupDD as SelectList,
                                        DefaultValue = Model.BloodGroupCode,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Nationality",
                                        InputId = "NationalityCode",
                                        FieldType = FieldType.Select,
                                        Placeholder = "--Select Nationality--",
                                        SelectItems = ViewBag.NationalityDD as SelectList,
                                        DefaultValue = Model.NationalityCode,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 8 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "National ID",
                                        InputId = "NationalIdno",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter National Id No.",
                                        DefaultValue = Model.NationalIdno,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Religion",
                                        InputId = "ReligionCode",
                                        FieldType = FieldType.Select,
                                        Placeholder = "--Select Religion--",
                                        SelectItems = ViewBag.ReligionDD as SelectList,
                                        DefaultValue = Model.ReligionCode,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Other Activities/Hobbies",
                                        InputId = "ExtraCurriActivities",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Extra Curriculum Activities",
                                        DefaultValue = Model.ExtraCurriActivities,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 9 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Marital Status",
                                        InputId = "MaritalStatusCode",
                                        FieldType = FieldType.Select,
                                        Placeholder = "--Select Marital Status--",
                                        SelectItems = ViewBag.MaritalyDD as SelectList,
                                        DefaultValue = Model.MaritalStatusCode,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Marriage Date",
                                        InputId = "MarriageDate",
                                        FieldType = FieldType.Date,
                                        DefaultValue = Model.MarriageDate?.ToString("dd/MM/yyyy"),
                                        Placeholder = "dd/mm/yyyy",
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Spouse's Name",
                                        InputId = "Spouse",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Spouse's Name",
                                        DefaultValue = Model.Spouse,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 10 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "No of Son(s)",
                                        InputId = "NoOfSon",
                                        FieldType = FieldType.Number,
                                        Placeholder = "Enter No of Son",
                                        DefaultValue = Model.NoOfSon?.ToString(),
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "No Of Daughter(s)",
                                        InputId = "NoOfDaughters",
                                        FieldType = FieldType.Number,
                                        Placeholder = "Enter No of Daughter",
                                        DefaultValue = Model.NoOfDaughters?.ToString(),
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Personal Mobile No.",
                                        InputId = "Telephone",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Personal Mobile No",
                                        DefaultValue = Model.Telephone,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Row 11 ========== -->
                                <div class="row g-5 mb-2">
                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Personal Email",
                                        InputId = "PersonalEmail",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Personal Email",
                                        DefaultValue = Model.PersonalEmail,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "Card No",
                                        InputId = "CardNo",                                        
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Card No.",
                                        DefaultValue = Model.CardNo,
                                        ReserveActionSlot = false
                                    })

                                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                    {
                                        ColumnClass = "col-lg-4",
                                        LabelText = "TIN No",
                                        InputId = "TinNo",
                                        FieldType = FieldType.Text,
                                        Placeholder = "Enter Tin No.",
                                        DefaultValue = Model.TinNo,
                                        ReserveActionSlot = false
                                    })
                                </div>

                                <!-- ========== Excel Upload Section ========== -->
                                <div class="container-fluid px-0 my-3">
                                    <div class="rounded-3 shadow-sm border">
                                        <div class="card-header py-2">
                                            <h6 class="mb-0">Excel File Upload</h6>
                                        </div>
                                        <div class="p-3">
                                            <div class="row g-5 align-items-center">
                                                <div class="col-md-6 d-flex align-items-center">
                                                    <label class="form-label mb-0 me-2">Excel File Format</label>
                                                    <a href="@Url.Action("DownloadExcel", "HrmEmployee2")"
                                                       class="btn btn-light border shadow-sm">
                                                        <i class="fa fa-download"></i>
                                                        <span class="ms-2">Download Excel</span>
                                                    </a>
                                                </div>
                                                <div class="col-md-6">
                                                    <div id="excelUploadForm">
                                                        @Html.AntiForgeryToken()
                                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                                            <label for="excelFile" class="form-label mb-0">📂 Upload Excel File</label>
                                                            <div class="custom-file-upload btn btn-outline-light border shadow-sm position-relative overflow-hidden" style="color:#000">
                                                                <i class="fa fa-folder-open"></i>
                                                                <span id="choosefileText">Choose File</span>
                                                                <input type="file" id="excelFileInput" name="excelFile"
                                                                       accept=".xlsx,.xls"
                                                                       style="position:absolute;left:0;top:0;opacity:0;width:100%;height:100%;cursor:pointer;">
                                                            </div>
                                                            <button type="button" class="btn btn-light border shadow-sm">
                                                                <i class="fa fa-upload me-1"></i> Upload
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div id="checkExcelFileFormate"
                                                         style="display:none;color:red;font-weight:bold;"
                                                         class="form-text mt-1">
                                                        ⚠️ Only .xlsx or .xls files are allowed!
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ========== Creation / Modify Date ========== -->
                                @if (Model.AutoId > 0)
                                {
                                    <hr />
                                    <div class="form-group row" id="LdateModifyHide">
                                        <div class="col-lg-4">
                                            @if (Model.Ldate.HasValue)
                                            {
                                                <label>Creation Date: </label>
                                                <label>@Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt")</label>
                                            }
                                        </div>
                                        <div class="col-lg-4">
                                            @if (Model.ModifyDate.HasValue)
                                            {
                                                <label>Last Update Date: </label>
                                                <label>@Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt")</label>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- ========== Buttons ========== -->
                                <div class="form-group row mt-3">
                                    <div class="col-12">
                                        
                                        @* <button type="button" class="btn btn-default btn-common js-HrmEmployee2-save btn-circle float-end">
                                            <i class="fas fa-save"></i> Save
                                        </button> *@

                                        <div class="col-6">
                                            <a href="@Url.Action("Index")" class="btn btn-default btn-common btn-circle">
                                                <i class="fas fa-arrow-alt-circle-left"></i> Back To List
                                            </a>
                                        </div>


                                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                                        {
                                            Title = "",
                                            SaveBtnClass = "js-HrmEmployee2-save",
                                            ShowClear = false,
                                            ShowDelete = false,
                                            ShowFavorite = false,
                                            ShowPrint = false,
                                            IsPlain = true,
                                            ReserveActionSlot = false,
           Style="border-bottom:0px !important;"
                                        })
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= RIGHT SIDE (Photo + Signature) ================= -->
                <div class="col-md-3">
                    <div class="card sticky-top" style="top: 80px; z-index: 100;">
                        <div class="card-body">

                            <!-- Employee Picture -->
                            <div class="img-preview text-center mb-4">
                                <h6 class="mb-2">Employee Picture</h6>
                                <div class="photo-box border rounded bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
                                     style="width:180px;height:180px;overflow:hidden;">
                                    <img id="photoPreview"
                                         class="img-fluid js-file-chooser"
                                         data-target="#Photo"
                                         data-default="/images/Images.png"
                                         src="@(string.IsNullOrEmpty(Model.PhotoUrl) ? "/images/Images.png" : Model.PhotoUrl)"
                                         alt="Employee Picture"
                                         style="max-width:100%;max-height:100%;object-fit:cover;" />
                                </div>
                                <input type="hidden" asp-for="IsClearPhoto" />
                                <div class="d-flex justify-content-center gap-2 mb-2">
                                    <button type="button" class="btn btn-secondary btn-sm js-file-chooser" data-target="#Photo">
                                        <i class="fas fa-upload me-1"></i> Browse Photo
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm js-clear-file"
                                            data-file="#photoPreview" data-tag="#IsClearPhoto">
                                        <i class="fas fa-trash-alt me-1"></i> Clear
                                    </button>
                                </div>
                                <div class="custom-file d-none">
                                    <input type="hidden" asp-for="PhotoUrl" value="@Model.PhotoUrl" />
                                    <input type="file" name="Photo" class="custom-file-input form-control form-control-sm js-file"
                                           data-target="#photoPreview" id="Photo" accept="image/*" />
                                </div>
                            </div>

                            <!-- Digital Signature -->
                            <div class="img-preview text-center">
                                <h6 class="mb-2">Digital Signature</h6>
                                <div class="signature-box border rounded bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
                                     style="width:180px;height:120px;overflow:hidden;">
                                    <img id="signaturePreview"
                                         class="img-fluid js-file-chooser"
                                         data-target="#Signature"
                                         data-default="/images/signature.jpg"
                                         src="@(string.IsNullOrEmpty(Model.DigitalSignatureUrl) ? "/images/signature.jpg" : Model.DigitalSignatureUrl)"
                                         alt="Digital Signature"
                                         style="max-width:100%;max-height:100%;object-fit:contain;" />
                                </div>
                                <input type="hidden" asp-for="IsClearSignature" />
                                <div class="d-flex justify-content-center gap-2 mb-2">
                                    <button type="button" class="btn btn-secondary btn-sm js-file-chooser" data-target="#Signature">
                                        <i class="fas fa-upload me-1"></i> Browse Signature
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm js-clear-file"
                                            data-file="#signaturePreview" data-tag="#IsClearSignature">
                                        <i class="fas fa-trash-alt me-1"></i> Clear
                                    </button>
                                </div>
                                <div class="custom-file d-none">
                                    <input type="hidden" asp-for="DigitalSignatureUrl" value="@Model.DigitalSignatureUrl" />
                                    <input type="file" name="Signature" class="custom-file-input form-control form-control-sm js-file"
                                           data-target="#signaturePreview" id="Signature" accept="image/*" />
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <partial name="_BottomNavigation" />
        </div>
    </form>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/pages/hrmEmployee2.js"></script>
    <script type="text/javascript">
        var options = {
        baseUrl: '@Url.Action("", "HrmEmployee2")'
        };
        options.load = () => { };
        $.hrmEmployee2(options);

        function validateBanglaInput(input) {
        const banglaRegex = /^[\u0980-\u09FF\s]*$/;
        if (!banglaRegex.test(input.value)) {
        input.value = input.value.slice(0, -1);
        }
        }

        function validatePasteBangla(event) {
        const pastedText = (event.clipboardData || window.clipboardData).getData('text');
        const banglaRegex = /^[\u0980-\u09FF\s]*$/;
        if (!banglaRegex.test(pastedText)) {
        event.preventDefault();
        }
        }
    </script>
}