                    </div>

                    <!-- Is Custom Job No -->
                    <div class="col-lg-4 col-md-6">
                        <div class="form-check mt-4">
                            <input type="checkbox" class="form-check-input" id="isCustomJobNo" />
                            <label class="form-check-label">Is Custom Job No</label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6"></div>
                    <!-- Job No (Read-only) -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Job No</label>
                        <input class="form-control form-control-sm" readonly id="jobNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Job Date -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Job Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="jobDate" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Customer Name -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Customer Name</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Customer" id="customerId" asp-items="ViewBag.CustomerName as SelectList">
                            <option value="">Select Customer</option>
                        </select>
                        <span class="text-danger"></span>
                    </div>

                    <!-- Customer Delivery Address -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Customer Address</label>
                        <textarea class="form-control form-control-sm" rows="1" id="customerAddress"></textarea>
                        <span class="text-danger"></span>
                    </div>
                    <!-- Customer Delivery Address -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Customer Delivery Address</label>
                        <textarea class="form-control form-control-sm" rows="1" id="customerDeliveryAddress"></textarea>
                        <span class="text-danger"></span>
                    </div>

                    <!-- Port Name -->
                    <div class="col-lg-4 col-md-6">
                    </div>
                    <!-- Port Name -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Port Name</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Port" id="portId" asp-items="ViewBag.PortName as SelectList">
                            <option value="">Select Port</option>
                        </select>
                        <span class="text-danger"></span>
                    </div>

                    <!-- Doc's Received Date -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Doc's Received Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="docsReceivedDate" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- LC/EXP No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">LC/EXP No</label>
                        <input class="form-control form-control-sm" id="lcExpNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- LC Value -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">L/C Value</label>
                        <div class="d-flex gap-2 group-horizontal">
                            <input type="number" class="form-control form-control-sm" id="lcValue" />
                            <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Unit" id="lcUnitId" asp-items="ViewBag.QuantityUnit as SelectList">
                                <option value="">Select Unit</option>
                            </select>
                        </div>
                        <span class="text-danger"></span>
                        <span class="text-danger"></span>
                    </div>

                    <!-- IP/EP No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">IP/EP No</label>
                        <input class="form-control form-control-sm" id="ipEpNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- IP Date -->
                    <div class="col-lg-4 col-md-6 custom-date-wrapper">
                        <label class="form-label">IP Date</label>
                        <input type="text" class="form-control form-control-sm custom-datepicker caiCon" id="ipDate" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Importer Name -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Importer Name</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Importer" id="importerId" asp-items="ViewBag.ImporterName as SelectList">
                            <option value="">Select Importer</option>
                        </select>
                        <span class="text-danger"></span>
                    </div>

                    <!-- Invoice No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Invoice No</label>
                        <input class="form-control form-control-sm" id="invoiceNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Invoice Date -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Invoice Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="invoiceDate" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- B/L No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">B/L No</label>
                        <input class="form-control form-control-sm" id="blNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- B/L Date -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">B/L Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="blDate" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- B/E No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">B/E No</label>
                        <input class="form-control form-control-sm" id="beNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- B/E Date -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">B/E Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="beDate" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Container No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Container No</label>
                        <input class="form-control form-control-sm" id="containerNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Container Size -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Container Size</label>
                        <input class="form-control form-control-sm" id="containerSize" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- LCA No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">LCA No</label>
                        <input class="form-control form-control-sm" id="lcaNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Discharge Date -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Discharge Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="dischargeDate" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Material Description -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Material Description</label>
                        <textarea class="form-control form-control-sm" rows="1" id="materialDescription"></textarea>
                        <span class="text-danger"></span>
                    </div>

                    <!-- Quantity + Unit (Horizontal Group) -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Quantity & Unit (PKG)</label>
                        <div class="d-flex gap-2 group-horizontal">
                            <input type="number" class="form-control form-control-sm" id="quantity" />
                            <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Unit" id="quantityUnitId" asp-items="ViewBag.QuantityUnit as SelectList">
                                <option value="">Select Unit</option>
                            </select>
                        </div>
                        <span class="text-danger"></span>
                        <span class="text-danger"></span>
                    </div>

                    <!-- Weight + Unit (Horizontal Group) -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Weight & Unit (KG)</label>
                        <div class="d-flex gap-2 group-horizontal">
                            <input type="number" class="form-control form-control-sm" id="weight" />
                            <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Unit" id="weightUnitId" asp-items="ViewBag.QuantityUnit as SelectList">
                                <option value="">Select Unit</option>
                            </select>
                        </div>
                        <span class="text-danger"></span>
                        <span class="text-danger"></span>
                    </div>

                    <!-- FWDR (Shipping Agent) -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">FWDR (Shipping Agent)</label>

                        <input class="form-control form-control-sm" id="forwarderId" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Vessel/Rott No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Vessel/Rott No</label>
                        <input class="form-control form-control-sm" id="vesselRottNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Remarks -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control form-control-sm" rows="1" id="remarks"></textarea>
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="border-bottom border-2 pt-1"></div>

                <form asp-action="Create" method="post" id="shipmentForm">
                    <div class="row pb-2">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="JobNo" id="jobNoHidden" value="" />
                        <input type="hidden" asp-for="AutoId" id="autoId" />
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">ETA Delivery Date</label>
                            <input asp-for="ETADeliveryDate" type="date" class="form-control form-control-sm custom-datepicker caiCon"
                                   id="etaDeliveryDate" />
                            <span asp-validation-for="ETADeliveryDate" class="text-danger"></span>
                        </div>

                        <!-- Actual Delivery Date -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Actual Delivery Date</label>
                            <input asp-for="ActualDeliveryDate" type="date" class="form-control form-control-sm custom-datepicker caiCon"
                                   id="actualDeliveryDate" />
                            <span asp-validation-for="ActualDeliveryDate" class="text-danger"></span>
                        </div>

                        <!-- Unstuffing Date -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Unstuffing Date</label>
                            <input asp-for="UnstuffingDate" type="text" class="form-control form-control-sm custom-datepicker caiCon" id="unstuffingDate" />
                            <span asp-validation-for="UnstuffingDate" class="text-danger"></span>
                        </div>

                        <!-- Place of Loading -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Place of Loading</label>
                            <select asp-for="PlaceOfLoadingID" class="form-select form-select-sm custom-select-single" data-placeholder="Select Place" id="placeOfLoadingId" asp-items="ViewBag.PlaceOfLoading as SelectList">
                                <option value="">Select Place</option>
                            </select>
                            <span asp-validation-for="PlaceOfLoadingID" class="text-danger"></span>
                        </div>

                        <!-- ETD Date -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">ETD Date</label>
                            <input asp-for="ETDDate" type="text" class="form-control form-control-sm custom-datepicker caiCon" id="etdDate" />
                            <span asp-validation-for="ETDDate" class="text-danger"></span>
                        </div>

                        <!-- Shed / Yard -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Shed / Yard</label>
                            <select asp-for="ShedYardID" class="form-select form-select-sm custom-select-single" data-placeholder="Select Shed/Yard" id="shedYardId" asp-items="ViewBag.ShedYard as SelectList">
                                <option value="">Select Shed/Yard</option>
                            </select>
                            <span asp-validation-for="ShedYardID" class="text-danger"></span>
                        </div>

                        <!-- Freight Charge -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Freight Charge</label>
                            <select asp-for="FreightChargeID" class="form-select form-select-sm custom-select-single" data-placeholder="Select Freight Charge" id="freightChargeId" asp-items="ViewBag.FreightCharge as SelectList">
                                <option value="">Select Freight Charge</option>
                            </select>
                            <span asp-validation-for="FreightChargeID" class="text-danger"></span>
                        </div>

                        <!-- Shipment Status (Highlighted) -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Shipment Status</label>
                            <textarea asp-for="ShipmentStatus" class="form-control form-control-sm highlighted-status" rows="1"
                                      id="shipmentStatus"></textarea>
                            <span asp-validation-for="ShipmentStatus" class="text-danger"></span>
                        </div>

                        <div class="col-lg-4 col-md-6"></div>

                        <!-- Creation Date -->
                        <div class="col-lg-4 col-md-6 d-flex align-items-center create-modify-dateshow">
