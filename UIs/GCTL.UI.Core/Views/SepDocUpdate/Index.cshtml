                    @* ---------- ETD Date (shared Sea+Air) — no button needed ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "etdDate",
                        LabelText = "ETD Date",
                        FieldType = FieldType.Date,
                        ReserveActionSlot = true
                    })

                    <!-- ============ DYNAMIC: Sea only (4 fields) — no button needed ============ -->
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "seaFinalIgmRecDate",
                        LabelText = "Final IGM Rec. Dt.",
                        FieldType = FieldType.Date,
                        VisibilityGroup = "seaFieldsGroup",
                        ShowOnInit = false,
                        ReserveActionSlot = true
                    })
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "seaShipArrivedDate",
                        LabelText = "Ship Arrived",
                        FieldType = FieldType.Date,
                        VisibilityGroup = "seaFieldsGroup",
                        ShowOnInit = false,
                        ReserveActionSlot = true
                    })
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "unstuffDischargeDate",
                        LabelText = "Unstuff/Discharge",
                        FieldType = FieldType.Date,
                        VisibilityGroup = "seaFieldsGroup",
                        ShowOnInit = false,
                        ReserveActionSlot = true
                    })
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "seaEstimatedDeliveryDate",
                        LabelText = "Estimated Delivery",
                        FieldType = FieldType.Date,
                        VisibilityGroup = "seaFieldsGroup",
                        ShowOnInit = false,
                        ReserveActionSlot = true
                    })

                    <!-- ============ DYNAMIC: Air only (2 fields) — no button needed ============ -->
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "flightArrivalDate",
                        LabelText = "Flight Actual Arrival Date",
                        FieldType = FieldType.Date,
                        VisibilityGroup = "airFieldsGroup",
                        ShowOnInit = false,
                        ReserveActionSlot = true
                    })
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "arrivalNoticeDate",
                        LabelText = "Arrival Notice Rcvd From Express Dt.",
                        FieldType = FieldType.Date,
                        VisibilityGroup = "airFieldsGroup",
                        ShowOnInit = false,
                        ReserveActionSlot = true
                    })

                    @* ---------- Docs Bank Sign Date — no button needed ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "docsBankSignDate",
                        LabelText = "Docs Bank Sign Date",
                        FieldType = FieldType.Date,
                        ReserveActionSlot = true
                    })

                    @* ---------- B/E No./Date — no button needed ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "beNoDate",
                        LabelText = "B/E No./Date",
                        ReserveActionSlot = true
                    })

                    @* ---------- Actual Delivery Date — no button needed ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "actualDeliveryDate",
                        LabelText = "Actual Delivery Date",
                        FieldType = FieldType.Date,
                        ReserveActionSlot = true
                    })

                    @* ---------- Shed/Yard (QuickAddSelect) — keeps button ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "shedYardId",
                        LabelText = "Shed/Yard",
                        FieldType = FieldType.QuickAddSelect,
                        Placeholder = "Select Shed/Yard",
                        SelectItems = ViewBag.ShedYard as SelectList,
                        ShowQuickAdd = true,
                        QuickAddUrl = Url.Action("Index", "Companies"),
                        QuickAddTarget = "#CompanyCode",
                        QuickAddReloadUrl = Url.Action("GetCompany", "Cascading"),
                        QuickAddTitle = "Company"
                    })

                    @* ---------- HAWB — no button needed ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "hawb",
                        LabelText = "HAWB",
                        ReserveActionSlot = true
                    })

                    @* ---------- MAWB — no button needed ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "mawb",
                        LabelText = "MAWB",
                        ReserveActionSlot = true
                    })

                    @* ---------- Assessment No — no button needed ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "assessmentNo",
                        LabelText = "Assessment No",
                        ReserveActionSlot = true
                    })

                    @* ---------- R-No / Client & Station SL No (DualInput) ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "rNo",
                        LabelText = "R-No / Client & Station SL No",
                        FieldType = FieldType.DualInput,
                        SecondField = new DynamicFieldColumnModel
                        {
                            InputId = "clientStationwiseSLNo",
                            FieldType = FieldType.Text
                        },
                        ReserveActionSlot=true
                    })

                    @* ---------- Freight Charge — Select, no quick-add ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "freightChargeId",
                        LabelText = "Freight Charge",
                        FieldType = FieldType.Select,
                        Placeholder = "Select Freight Charge",
                        SelectItems = ViewBag.FreightCharge as SelectList,
                        ReserveActionSlot = true
                    })

                    @* ---------- Term (Textarea) ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "term",
                        LabelText = "Term",
                        FieldType = FieldType.Textarea,
                        ReserveActionSlot=true
                    })

                    @* ---------- Remarks (Textarea) ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "remarks",
