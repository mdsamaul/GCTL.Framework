@using GCTL.UI.Core.ViewModels
@model GCTL.UI.Core.ViewModels.SepDocUpdate.ShipmentUpdateSetupViewModel
@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Documentation / Job Entry";
    Model.Breadcrumb = "Documentation";
}

<link href="~/css/selectCSS.css" rel="stylesheet" />

<style>
    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: calc(1.5em + .5rem + 2px) !important; /* Bootstrap form-select-sm */
        padding: .25rem .5rem !important;
        border: 1px solid #ced4da !important;
        border-radius: .375rem !important;
        background-color: #fff;
        display: flex;
        align-items: center;
    }

    .select2-container--default .select2-selection__rendered {
        line-height: normal !important;
        padding-left: 0 !important;
        padding-right: 20px !important;
        color: #212529;
        font-size: .875rem;
    }

    .select2-container--default .select2-selection__arrow {
        height: 100% !important;
        right: 8px;
    }

    .select2-container--default .select2-selection__clear {
        margin-right: 18px;
    }

    /* Focus */
    .select2-container--default.select2-container--focus .select2-selection--single,
    .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
    }

    .form-label {
        padding-left: 0rem !important;
        line-height: 1.2 !important;
        text-transform: capitalize !important;
        margin-bottom: 0 !important;
    }

    /* ================= Toolbar ================= */

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .toolbar-left {
        flex-shrink: 0;
    }

    .toolbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: nowrap;
    }

    /* Large Screen (default) */

    .toolbar-showing {
        width: 120px;
    }

    /* Wrapper for the large-screen filters (customer / shipment / date) */
    .toolbar-large-filters {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: nowrap;
    }

    .toolbar-customer {
        width: 250px;
    }

    .toolbar-shipment {
        width: 240px;
    }

    .toolbar-date {
        width: 380px;
    }

    .toolbar-search {
        width: 300px;
    }

    /* Small/mid screen filter block - hidden by default on large screens */
    .sm-topshow {
        display: none;
    }

    /* 1350px */

    @@media (max-width:1370px) {

        .sm-topshow {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 10px;
            padding-bottom: 10px;
        }

            .sm-topshow .toolbar-customer-sm,
            .sm-topshow .toolbar-shipment-sm {
                width: 220px;
            }

            .sm-topshow .toolbar-date-sm {
                width: 100%;
                max-width: 420px;
            }

        .toolbar-right {
            gap: 8px;
        }
        /* Hide large-screen customer/shipment/date filters */
        .toolbar-large-filters {
            display: none;
        }

        .toolbar-customer {
            width: 225px;
        }

        .toolbar-search {
            width: 225px;
        }

        .toolbar-date {
            width: 321px;
        }

        .toolbar .form-control,
        .toolbar .form-select,
        .toolbar .input-group-text {
            font-size: 13px;
            padding: .25rem .45rem;
        }
    }

    /* Tablet */

    @@media (max-width:1200px) {

        .toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .toolbar-right {
            flex-wrap: wrap;
        }

        .toolbar-search {
            width: 100%;
        }

        .sm-topshow .toolbar-customer-sm,
        .sm-topshow .toolbar-shipment-sm,
        .sm-topshow .toolbar-date-sm {
            width: 100%;
            max-width: 100%;
        }
    }

    .form-control-sm,
    .form-select-sm {
        font-size: 0.82rem;
    }

    .form-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 2px;
    }

    .nav-tabs .nav-link.active {
        font-weight: 700;
        border-bottom: 2px solid #0d6efd;
    }

    /* dynamic Sea / Air group - hidden until a shipment mode is picked */
    #seaFieldsGroup, #airFieldsGroup {
        display: none;
    }

    .group-title {
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 4px;
        margin: 1rem 0 .75rem;
    }

    .toolbar-doc {
        display: none;
        opacity: 0;
        transform: translateY(-15px);
        transition: all .35s ease;
    }

        .toolbar-doc.show {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }
</style>

@* <partial name="_PageHeader" model="Model" /> *@
<!-- Toolbar Entry -->
<div id="toolbarEntry" class="toolbar-doc show">
    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
        Title = "Documentation/Job Entry",
        SaveBtnClass = "doc-save-entry-btn",
        DeleteBtnClass = "doc-delete-entry-btn",
        ClearBtnClass = "doc-clear-entry-btn",
        PdfBtnClass = "doc-pdf-entry-btn",
        ExcelBtnClass = "doc-excel-entry-btn",
    })
</div>

<!-- Toolbar Upload -->
<div id="toolbarUpload" class="toolbar-doc">
    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
        Title = "Document Upload Info",
        SaveBtnClass = "doc-seve-upload-btn",
        DeleteBtnClass = "doc-delete-upload-btn",
        ClearBtnClass = "doc-clear-upload-btn",
        PdfBtnClass = "doc-pdf-upload-btn",
        ExcelBtnClass = "doc-excel-upload-btn",
    })
</div>

<!-- Tabs... -->
<form id="sepDocForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="tc" name="Tc" value="0" />

    <ul class="nav nav-tabs mb-3" id="sepDocTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="entry-tab" data-bs-toggle="tab" data-bs-target="#entryTabPane" type="button" role="tab">
                Documentation/Job Entry
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="upload-tab" data-bs-toggle="tab" data-bs-target="#uploadTabPane" type="button" role="tab">
                Document Upload Info
            </button>
        </li>
    </ul>

    <div class="tab-content" id="sepDocTabContent">
        <div class="entry-only px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded toolbar-doc show" style="display:none;">
            <div class="mb-3">
                <div id="jobSummary">

                    <!-- Small/Mid screen filters (shown below 1350px) -->
                    <div class="sm-topshow">
                        <span class="label-text filter-by-sm">Filter By:</span>
                        <div class="toolbar-customer-sm">
                            <select class="form-select form-select-sm custom-select-single"
                                    id="customerFilterSm"
                                    data-placeholder="Select Customer"
                                    asp-items="ViewBag.CustomerName as SelectList">
                                <option value="">All Customers</option>
                            </select>
                        </div>

                        <div class="toolbar-shipment-sm">
                            <select class="form-select form-select-sm custom-select-single"
                                    id="shipmentModeFilterSm"
                                    data-placeholder="Select Shipment Mode"
                                    asp-items="ViewBag.ShipmentMode as SelectList">
                                <option value="">All Shipment Modes</option>
                            </select>
                        </div>

                        <div class="toolbar-date-sm">
                            <div class="input-group input-group-sm custom-date-group">
                                <span class="input-group-text">From</span>
                                <input type="date" class="form-control custom-datepicker caiCon" id="dateFromSm">

                                <span class="input-group-text">To</span>
                                <input type="date" class="form-control custom-datepicker caiCon" id="dateToSm">
                            </div>
                        </div>
                    </div>

                    <div class="toolbar mb-4">

                        <!-- Left -->
                        <div class="toolbar-left">
                            <div class="input-group input-group-sm toolbar-showing">
                                <span class="input-group-text">Showing</span>

                                <select class="form-select" id="pageSizeSelect">
                                    <option value="5" selected>5</option>
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>

                        <!-- Right -->
                        <div class="toolbar-right">
                            <span class="label-text toolbar-large-filters">Filter By:</span>
                            <!-- Large screen filters (hidden below 1350px) -->
                            <div class="toolbar-large-filters">
                                <div class="toolbar-customer">
                                    <select class="form-select form-select-sm custom-select-single"
                                            id="customerFilter"
                                            data-placeholder="Select Customer"
                                            asp-items="ViewBag.CustomerName as SelectList">
                                        <option value="">All Customers</option>
                                    </select>
                                </div>

                                <div class="toolbar-shipment">
                                    <select class="form-select form-select-sm custom-select-single"
                                            id="shipmentModeFilter"
                                            data-placeholder="Select Shipment Mode"
                                            asp-items="ViewBag.ShipmentMode as SelectList">
                                        <option value="">All Shipment Modes</option>
                                    </select>
                                </div>

                                <div class="toolbar-date">
                                    <div class="input-group input-group-sm custom-date-group">
                                        <span class="input-group-text">Date From</span>
                                        <input type="date" class="form-control custom-datepicker caiCon" id="dateFrom">

                                        <span class="input-group-text">To</span>
                                        <input type="date" class="form-control custom-datepicker caiCon" id="dateTo">
                                    </div>
                                </div>
                            </div>

                            <div class="toolbar-search">
                                <input class="form-control form-control-sm"
                                       id="searchInput"
                                       type="text"
                                       placeholder="Search">
                            </div>

                        </div>

                    </div>
                    <div class="table-responsive ms-n1 ps-1 scrollbar">
                        <table class="table table-bordered table-sm table-responsive-sm fs-9 mb-0 border-top border-translucent dyn-tableDrag" id="JobSettingsTable">
                            <thead>
                                <tr>
                                    <th class="sort white-space-nowrap align-middle ps-0 text-center" scope="col" data-sort="JobNo">Job No</th>
                                    <th class="sort white-space-nowrap align-middle ps-2 text-center" scope="col" data-sort="ShipmentMode">Shipment Mode</th>
                                    <th class="sort white-space-nowrap align-middle ps-2 text-center" scope="col" data-sort="JobDate">Job Date</th>
                                    <th class="sort white-space-nowrap align-middle ps-2 text-center" scope="col" data-sort="CustomerName">Customer Name</th>
                                    <th class="sort white-space-nowrap align-middle ps-2 text-center" scope="col" data-sort="DocReceivedDate">Doc Received Date</th>

                                </tr>
                            </thead>
                            <tbody class="list" id="job-settings-table">
                                <!-- Table rows will be populated here dynamically -->
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-between py-3 pe-0 fs-9 border-bottom border-translucent">
                        <div class="d-flex">
                            <p class="mb-0 d-none d-sm-block me-3 fw-semibold text-body" id="dataListInfo"></p>
                        </div>
                        <div class="d-flex">
                            <button class="page-link" id="paginationPrev"><span class="fas fa-chevron-left"></span></button>
                            <ul class="mb-0 pagination" id="paginationNumbers"></ul>
                            <button class="page-link pe-0" id="paginationNext"><span class="fas fa-chevron-right"></span></button>
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- ==================== TAB 1: Documentation / Job Entry ==================== -->
        <div class="tab-pane fade show active" id="entryTabPane" role="tabpanel">
            <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded">
                <div class="row">

                    @* ---------- Shipment Mode (MultiSelect) — no button needed ---------- *@
