    ViewData["Title"] = "Shipment Entry";
}

<link href="~/css/selectCSS.css" rel="stylesheet" />


<style>
    /* .sticky-bar {
        position: sticky;
        top: 65px;
        z-index: 1020; 
    } */

    /* Bootstrap form-select-sm style for Select2 */
    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: calc(1.5em + .5rem + 2px) !important; /* Bootstrap form-select-sm */
        padding: .25rem .5rem !important;
        border: 1px solid #ced4da !important;
        border-radius: .375rem !important;
        background-color: #fff;
        display: flex;
        align-items: center;
    }

    .select2-container--default .select2-selection__rendered {
        line-height: normal !important;
        padding-left: 0 !important;
        padding-right: 20px !important;
        color: #212529;
        font-size: .875rem;
    }

    .select2-container--default .select2-selection__arrow {
        height: 100% !important;
        right: 8px;
    }

    .select2-container--default .select2-selection__clear {
        margin-right: 18px;
    }

    /* Focus */
    .select2-container--default.select2-container--focus .select2-selection--single,
    .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
    }

    .form-label {
        padding-left: 0rem !important;
        line-height: 1.2 !important;
        text-transform: capitalize !important;
        margin-bottom: 0 !important;
    }

    /* ================= Toolbar ================= */

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .toolbar-left {
        flex-shrink: 0;
    }

    .toolbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: nowrap;
    }

    /* Large Screen (default) */

    .toolbar-showing {
        width: 145px;
    }

    /* Wrapper for the large-screen filters (customer / shipment / date) */
    .toolbar-large-filters {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: nowrap;
    }

    .toolbar-customer {
        width: 300px;
    }

    .toolbar-shipment {
        width: 240px;
    }

    .toolbar-date {
        width: 420px;
    }

    .toolbar-search {
        width: 300px;
    }

    /* Small/mid screen filter block - hidden by default on large screens */
    .sm-topshow {
        display: none;
    }

    /* 1350px */

    @@media (max-width:1370px) {

        .sm-topshow {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 10px;
            padding-bottom: 10px;
        }

            .sm-topshow .toolbar-customer-sm,
            .sm-topshow .toolbar-shipment-sm {
                width: 220px;
            }

            .sm-topshow .toolbar-date-sm {
                width: 100%;
                max-width: 420px;
            }

        .toolbar-right {
            gap: 8px;
        }
        /* Hide large-screen customer/shipment/date filters */
        .toolbar-large-filters {
            display: none;
        }

        .toolbar-customer {
            width: 225px;
        }

        .toolbar-search {
            width: 225px;
        }

        .toolbar-date {
            width: 321px;
        }

        .toolbar .form-control,
        .toolbar .form-select,
        .toolbar .input-group-text {
            font-size: 13px;
            padding: .25rem .45rem;
        }
    }

    /* Tablet */

    @@media (max-width:1200px) {

        .toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .toolbar-right {
            flex-wrap: wrap;
        }

        .toolbar-search {
            width: 100%;
        }

        .sm-topshow .toolbar-customer-sm,
        .sm-topshow .toolbar-shipment-sm,
        .sm-topshow .toolbar-date-sm {
            width: 100%;
            max-width: 100%;
        }
    }

</style>



