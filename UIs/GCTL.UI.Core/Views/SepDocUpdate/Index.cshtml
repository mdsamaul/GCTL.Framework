                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Name of Freight Forwarder</label>
                        <input class="form-control form-control-sm" id="nameOfFreightForwarder" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Vessel/Rott No</label>
                        <input class="form-control form-control-sm" id="vesselRottNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Place of Loading</label>
                        <div class="input-group flex-nowrap">
                            <div class="input-group input-group-sm">

                           
                                <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Place of Loading" id="placeOfLoadingId" asp-items="ViewBag.PlaceOfLoading as SelectList">
                                    <option value="">Select Place of Loading</option>
                                </select>

                                <button type="button"
                                        class="btn btn-outline-secondary js-quick-add"
                                        data-url="@Url.Action("Index", "Companies")"
                                        data-target="#CompanyCode"
                                        data-reload-url="@Url.Action("GetCompany", "Cascading")"
                                        data-title="Company">
                                    <i class="fas fa-plus"></i>
                                </button>

                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Shed/Yard</label>
                       
                        <div class="input-group flex-nowrap">
                            <div class="input-group input-group-sm">

                                <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Shed/Yard" id="shedYardId" asp-items="ViewBag.ShedYard as SelectList">
                                    <option value="">Select Shed/Yard</option>
                                </select>

                                <button type="button"
                                        class="btn btn-outline-secondary js-quick-add"
                                        data-url="@Url.Action("Index", "Companies")"
                                        data-target="#CompanyCode"
                                        data-reload-url="@Url.Action("GetCompany", "Cascading")"
                                        data-title="Company">
                                    <i class="fas fa-plus"></i>
                                </button>

                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">HAWB</label>
                        <input class="form-control form-control-sm" id="hawb" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">MAWB</label>
                        <input class="form-control form-control-sm" id="mawb" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Assessment No</label>
                        <input class="form-control form-control-sm" id="assessmentNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">R-No / Client &amp; Station SL No</label>
                        <div class="d-flex gap-2">
                            <input class="form-control form-control-sm" id="rNo" />
                            <input class="form-control form-control-sm" id="clientStationwiseSLNo" />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Freight Charge</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Freight Charge" id="freightChargeId" asp-items="ViewBag.FreightCharge as SelectList">
                            <option value="">Select Freight Charge</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Term</label>
                        <textarea class="form-control form-control-sm" rows="1" id="term"></textarea>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control form-control-sm" rows="1" id="remarks"></textarea>
                    </div>
                </div>

                <!-- ============ DYNAMIC: shown for Sea + Air (common) ============ -->
                <div id="commonDeliveryGroup" style="display:none;">
                    <div class="group-title">Delivery Tracking</div>
                    <div class="row">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">ETD</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="etdDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Docs Bank Sign Date</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="docsBankSignDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">B/E No / Date</label>
                            <div class="d-flex gap-2">
                                <input class="form-control form-control-sm" id="beNo" placeholder="B/E No" />
                                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="beDate" />
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Actual Delivery</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="actualDeliveryDate" />
                        </div>
                    </div>
                </div>

                <!-- ============ DYNAMIC: Sea only ============ -->
                <div id="seaFieldsGroup">
                    <div class="group-title">Sea Import &amp; Export</div>
                    <div class="row">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Final IGM Rec. Dt.</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="finalIgmRecDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Ship Arrived</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="shipArrivedDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Unstuff/Discharge</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="unstuffDischargeDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Estimated Delivery</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="estimatedDeliveryDate" />
                        </div>
                    </div>
                </div>

                <!-- ============ DYNAMIC: Air only ============ -->
                <div id="airFieldsGroup">
                    <div class="group-title">Air Import &amp; Export</div>
                    <div class="row">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Flight Actual Arrival Dt.</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="flightArrivalDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Arrival Notice Rcvd From Express Dt.</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="arrivalNoticeDate" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 border-bottom border-2 py-1"></div>

                @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                {
                    Title = "",
                    SaveBtnClass = "doc-save-entry-btn",
                    ShowClear=false,
                    ShowDelete=false,
                    ShowFavorite=false,
                    ShowPrint=false,
                    IsPlain=true
                })
               
            </div>

            <!-- ==================== Grid of saved jobs ==================== -->
            <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded mt-3">
                <div class="toolbar mb-3 d-flex justify-content-between flex-wrap gap-2">
                    <div class="input-group input-group-sm" style="width:120px">
                        <span class="input-group-text">Show</span>
                        <select class="form-select" id="pageSizeSelect">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                    <input class="form-control form-control-sm" style="max-width:280px" id="searchInput" type="text" placeholder="Search" />
                </div>

                <div class="table-responsive scrollbar">
                    <table class="table table-bordered table-sm fs-9 mb-0" id="jobListTable">
                        <thead>
                            <tr>
                                <th>Sel.</th>
                                <th>Job No</th>
                                <th>Job Date</th>
                                <th>Customer</th>
                                <th>Customer Address</th>
                                <th>Shipment Mode</th>
                                <th>Doc Received Date</th>
                                <th>LC Value</th>
                                <th>Job Status</th>
                            </tr>
                        </thead>
                        <tbody id="job-list-body"></tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center py-3">
                    <p class="mb-0" id="dataListInfo"></p>
                    <div class="d-flex">
                        <button type="button" class="page-link" id="paginationPrev">&laquo;</button>
                        <ul class="mb-0 pagination" id="paginationNumbers"></ul>
                        <button type="button" class="page-link" id="paginationNext">&raquo;</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== TAB 2: Document Upload Info ==================== -->
        <div class="tab-pane fade" id="uploadTabPane" role="tabpanel">
            <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded">
                <div class="card mb-3">
                    <div class="card-header bg-light fw-bold">Main Information</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Job No</label>
                                <input class="form-control form-control-sm" id="uploadJobNoDisplay" readonly />
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Date</label>
                                <input class="form-control form-control-sm" id="uploadJobDateDisplay" readonly />
                            </div>
                            <div class="col-lg-4 col-md-6"></div>
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Customer</label>
                                <input class="form-control form-control-sm" id="uploadCustomerDisplay" readonly />
                            </div>
                            <div class="col-lg-8 col-md-6">
                                <label class="form-label">Address</label>
                                <textarea class="form-control form-control-sm" rows="1" id="uploadAddressDisplay" readonly></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive scrollbar mb-3">
                    <table class="table table-bordered table-sm fs-9 mb-0" id="documentTable">
                        <thead>
                            <tr>
                                <th style="width:40px">Sel.</th>
                                <th>Sl No.</th>
                                <th>Document Name</th>
                                <th>Description</th>
                                <th>Uploaded File</th>
                                <th style="width:70px"></th>
                            </tr>
                        </thead>
                        <tbody id="document-list-body">
                            <tr><td colspan="6" class="text-center">No data available</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Upload File</label>
                        <input type="file" class="form-control form-control-sm" id="uploadFile" />
                        <small class="text-primary">Max Size 15 MB</small>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Document Name</label>
                        <input class="form-control form-control-sm" id="documentName" placeholder="Enter Document Name" />
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Description</label>
                        <textarea class="form-control form-control-sm" rows="1" id="documentDescription" placeholder="Enter Document Description"></textarea>
                    </div>
                </div>

                <div class="mt-3">
                    @* <button type="button" class="btn btn-phoenix-primary" id="uploadDocumentBtn">
                        <i class="fas fa-upload text-primary"></i> <span>Upload</span>
                    </button> *@
                    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                    {
                        Title = "",
                        SaveBtnClass = "doc-seve-upload-btn",
                        ShowClear = false,
                        ShowDelete = false,
                        ShowFavorite = false,
                        ShowPrint = false,
                        IsPlain = true
                    })
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/pages/sepdocumentation.js"></script>
}
