@model GCTL.UI.Core.ViewModels.SepDocUpdate.ShipmentUpdateSetupViewModel
@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Documentation / Job Entry";
    Model.Breadcrumb = "Documentation";
}

<link href="~/css/selectCSS.css" rel="stylesheet" />

<style>
    .form-label {
        padding-left: 0rem !important;
        line-height: 1.2 !important;
        text-transform: capitalize !important;
        margin-bottom: 0 !important;
    }

    .nav-tabs .nav-link.active {
        font-weight: 700;
        border-bottom: 2px solid #0d6efd;
    }

    /* dynamic Sea / Air group - hidden until a shipment mode is picked */
    #seaFieldsGroup, #airFieldsGroup {
        display: none;
    }

    .group-title {
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 4px;
        margin: 1rem 0 .75rem;
    }
</style>

<partial name="_PageHeader" model="Model" />
@await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
    Title = "Documentation/Job Entry",
        SaveBtnClass=""
    })
@await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
    Title = "Documentation/Job Entry",
        SaveBtnClass=""
    })
<form id="sepDocForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="tc" name="Tc" value="0" />

    <ul class="nav nav-tabs mb-3" id="sepDocTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="entry-tab" data-bs-toggle="tab" data-bs-target="#entryTabPane" type="button" role="tab">
                Documentation/Job Entry
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="upload-tab" data-bs-toggle="tab" data-bs-target="#uploadTabPane" type="button" role="tab">
                Document Upload Info
            </button>
        </li>
    </ul>

    <div class="tab-content" id="sepDocTabContent">

        <!-- ==================== TAB 1: Documentation / Job Entry ==================== -->
        <div class="tab-pane fade show active" id="entryTabPane" role="tabpanel">
            <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded">
                <div class="row">

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Shipment Mode</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Shipment Mode" id="shipmentModeId" asp-items="ViewBag.ShipmentMode as SelectList">
                            <option value="">Select Shipment Mode</option>
                        </select>
                        <input type="hidden" id="transportModeTypeId" name="TransportModeTypeId" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="form-check mt-4">
                            <input type="checkbox" class="form-check-input" id="isCustomJobNo" />
                            <label class="form-check-label">Is Custom Job No</label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Job No</label>
                        <input class="form-control form-control-sm" readonly id="jobNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Job Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="jobDate" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Customer Name</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Customer" id="customerId" asp-items="ViewBag.CustomerName as SelectList">
                            <option value="">Select Customer</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Customer Address</label>
                        <textarea class="form-control form-control-sm" rows="1" id="customerAddress"></textarea>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Customer Delivery Address</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Customer Delivery" id="deliveryLocationCode" asp-items="ViewBag.CustomerDeliveryAddress as SelectList">
                            <option value="">Select Customer Delivery</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Port Name</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Port" id="portId" asp-items="ViewBag.PortName as SelectList">
                            <option value="">Select Port</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Doc's Received Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="docReceivedDate" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Exp No</label>
                        <input class="form-control form-control-sm" id="expNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Exp Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="expDate" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">LC No</label>
                        <input class="form-control form-control-sm" id="lcNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">LC Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="lcDate" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">L/C Value</label>
                        <div class="d-flex gap-2">
                            <input type="number" class="form-control form-control-sm" id="lcValue" />
                            <select class="form-select form-select-sm custom-select-single" data-placeholder="Currency" id="currencyId" asp-items="ViewBag.Currency as SelectList">
                                <option value="">Curr.</option>
                            </select>
                            <input type="number" class="form-control form-control-sm" id="bdtRate" placeholder="BDT Rate" />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">IP/EP No</label>
                        <input class="form-control form-control-sm" id="ipNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">IP Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="ipDate" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Importer Name</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Importer" id="importerId" asp-items="ViewBag.ImporterName as SelectList">
                            <option value="">Select Importer</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Invoice No</label>
                        <input class="form-control form-control-sm" id="invoiceNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Invoice Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="invoiceDate" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Invoice Value</label>
                        <div class="d-flex gap-2">
                            <input type="number" class="form-control form-control-sm" id="invoiceValue" />
                            <input type="number" class="form-control form-control-sm" id="assessableRate" placeholder="Assessable Rate" />
                            <input type="number" class="form-control form-control-sm" id="assessableValue" placeholder="Assessable Value" />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">B/L No</label>
                        <input class="form-control form-control-sm" id="blNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">B/L Date</label>
                        <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="blDate" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Container No</label>
                        <input class="form-control form-control-sm" id="containerNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Container Size</label>
                        <input class="form-control form-control-sm" id="containerSize" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">LCA No</label>
                        <input class="form-control form-control-sm" id="lcaNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Material Description</label>
                        <textarea class="form-control form-control-sm" rows="1" id="materialDescription"></textarea>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Quantity &amp; Unit</label>
                        <div class="d-flex gap-2">
                            <input type="number" class="form-control form-control-sm" id="quntity1" />
                            <select class="form-select form-select-sm custom-select-single" data-placeholder="Unit" id="unit1" asp-items="ViewBag.QuantityUnit as SelectList">
                                <option value="">Unit</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Weight &amp; Unit</label>
                        <div class="d-flex gap-2">
                            <input type="number" class="form-control form-control-sm" id="quntity2" />
                            <select class="form-select form-select-sm custom-select-single" data-placeholder="Unit" id="unit2" asp-items="ViewBag.QuantityUnit as SelectList">
                                <option value="">Unit</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">FWDR (Shipping Agent)</label>
                        <input class="form-control form-control-sm" id="fwdrShippingAgent" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Name of Freight Forwarder</label>
                        <input class="form-control form-control-sm" id="nameOfFreightForwarder" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Vessel/Rott No</label>
                        <input class="form-control form-control-sm" id="vesselRottNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Place of Loading</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Place of Loading" id="placeOfLoadingId" asp-items="ViewBag.PlaceOfLoading as SelectList">
                            <option value="">Select Place of Loading</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Shed/Yard</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Shed/Yard" id="shedYardId" asp-items="ViewBag.ShedYard as SelectList">
                            <option value="">Select Shed/Yard</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">HAWB</label>
                        <input class="form-control form-control-sm" id="hawb" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">MAWB</label>
                        <input class="form-control form-control-sm" id="mawb" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Assessment No</label>
                        <input class="form-control form-control-sm" id="assessmentNo" />
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">R-No / Client &amp; Station SL No</label>
                        <div class="d-flex gap-2">
                            <input class="form-control form-control-sm" id="rNo" />
                            <input class="form-control form-control-sm" id="clientStationwiseSLNo" />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Freight Charge</label>
                        <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Freight Charge" id="freightChargeId" asp-items="ViewBag.FreightCharge as SelectList">
                            <option value="">Select Freight Charge</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Term</label>
                        <textarea class="form-control form-control-sm" rows="1" id="term"></textarea>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control form-control-sm" rows="1" id="remarks"></textarea>
                    </div>
                </div>

                <!-- ============ DYNAMIC: shown for Sea + Air (common) ============ -->
                <div id="commonDeliveryGroup" style="display:none;">
                    <div class="group-title">Delivery Tracking</div>
                    <div class="row">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">ETD</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="etdDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Docs Bank Sign Date</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="docsBankSignDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">B/E No / Date</label>
                            <div class="d-flex gap-2">
                                <input class="form-control form-control-sm" id="beNo" placeholder="B/E No" />
                                <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="beDate" />
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Actual Delivery</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="actualDeliveryDate" />
                        </div>
                    </div>
                </div>

                <!-- ============ DYNAMIC: Sea only ============ -->
                <div id="seaFieldsGroup">
                    <div class="group-title">Sea Import &amp; Export</div>
                    <div class="row">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Final IGM Rec. Dt.</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="finalIgmRecDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Ship Arrived</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="shipArrivedDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Unstuff/Discharge</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="unstuffDischargeDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Estimated Delivery</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="estimatedDeliveryDate" />
                        </div>
                    </div>
                </div>

                <!-- ============ DYNAMIC: Air only ============ -->
                <div id="airFieldsGroup">
                    <div class="group-title">Air Import &amp; Export</div>
                    <div class="row">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Flight Actual Arrival Dt.</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="flightArrivalDate" />
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Arrival Notice Rcvd From Express Dt.</label>
                            <input type="date" class="form-control form-control-sm custom-datepicker caiCon" id="arrivalNoticeDate" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 border-bottom border-2 py-1"></div>

                @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                {
                    Title = "",
                    IsPlain = true,
                    SaveBtnClass = "saveBtn"
                })
            </div>

            <!-- ==================== Grid of saved jobs ==================== -->
            <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded mt-3">
                <div class="toolbar mb-3 d-flex justify-content-between flex-wrap gap-2">
                    <div class="input-group input-group-sm" style="width:120px">
                        <span class="input-group-text">Show</span>
                        <select class="form-select" id="pageSizeSelect">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                    <input class="form-control form-control-sm" style="max-width:280px" id="searchInput" type="text" placeholder="Search" />
                </div>

                <div class="table-responsive scrollbar">
                    <table class="table table-bordered table-sm fs-9 mb-0" id="jobListTable">
                        <thead>
                            <tr>
                                <th>Sel.</th>
                                <th>Job No</th>
                                <th>Job Date</th>
                                <th>Customer</th>
                                <th>Customer Address</th>
                                <th>Shipment Mode</th>
                                <th>Doc Received Date</th>
                                <th>LC Value</th>
                                <th>Job Status</th>
                            </tr>
                        </thead>
                        <tbody id="job-list-body"></tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center py-3">
                    <p class="mb-0" id="dataListInfo"></p>
                    <div class="d-flex">
                        <button type="button" class="page-link" id="paginationPrev">&laquo;</button>
                        <ul class="mb-0 pagination" id="paginationNumbers"></ul>
                        <button type="button" class="page-link" id="paginationNext">&raquo;</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== TAB 2: Document Upload Info ==================== -->
        <div class="tab-pane fade" id="uploadTabPane" role="tabpanel">
            <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded">
                <div class="card mb-3">
                    <div class="card-header bg-light fw-bold">Main Information</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Job No</label>
                                <input class="form-control form-control-sm" id="uploadJobNoDisplay" readonly />
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Date</label>
                                <input class="form-control form-control-sm" id="uploadJobDateDisplay" readonly />
                            </div>
                            <div class="col-lg-4 col-md-6"></div>
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Customer</label>
                                <input class="form-control form-control-sm" id="uploadCustomerDisplay" readonly />
                            </div>
                            <div class="col-lg-8 col-md-6">
                                <label class="form-label">Address</label>
                                <textarea class="form-control form-control-sm" rows="1" id="uploadAddressDisplay" readonly></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive scrollbar mb-3">
                    <table class="table table-bordered table-sm fs-9 mb-0" id="documentTable">
                        <thead>
                            <tr>
                                <th style="width:40px">Sel.</th>
                                <th>Sl No.</th>
                                <th>Document Name</th>
                                <th>Description</th>
                                <th>Uploaded File</th>
                                <th style="width:70px"></th>
                            </tr>
                        </thead>
                        <tbody id="document-list-body">
                            <tr><td colspan="6" class="text-center">No data available</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Upload File</label>
                        <input type="file" class="form-control form-control-sm" id="uploadFile" />
                        <small class="text-primary">Max Size 15 MB</small>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Document Name</label>
                        <input class="form-control form-control-sm" id="documentName" placeholder="Enter Document Name" />
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Description</label>
                        <textarea class="form-control form-control-sm" rows="1" id="documentDescription" placeholder="Enter Document Description"></textarea>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="button" class="btn btn-phoenix-primary" id="uploadDocumentBtn">
                        <i class="fas fa-upload text-primary"></i> <span>Upload</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/pages/sepdocumentation.js"></script>
}
