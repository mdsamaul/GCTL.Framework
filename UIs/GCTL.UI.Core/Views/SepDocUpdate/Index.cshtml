                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "rNo",
                        LabelText = "R-No / Client & Station SL No",
                        Placeholder = "R-No / Client & Station SL No",
                        FieldType = FieldType.Text,                        
                        ReserveActionSlot=true
                    })

                    @* ---------- Freight Charge — Select, no quick-add ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "freightChargeId",
                        LabelText = "Freight Charge",
                        FieldType = FieldType.Select,
                        Placeholder = "Select Freight Charge",
                        SelectItems = ViewBag.FreightCharge as SelectList,
                        ReserveActionSlot = true
                    })

                    @* ---------- Term (Textarea) ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "term",
                        LabelText = "Term",
                        FieldType = FieldType.Textarea,
                        ReserveActionSlot=true,
                        Placeholder = "Term",
                        Rows=2
                    })

                    @* ---------- Remarks (Textarea) ---------- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "remarks",
                        LabelText = "Remarks",
                        FieldType = FieldType.Textarea,
                        ReserveActionSlot=true,
                        Placeholder = "Remarks",
                        Rows=2
                    })

                </div>

                <div class="border-bottom border-2 my-2"></div>

                @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                {
                    Title = "",
                    SaveBtnClass = "doc-save-entry-btn",
                    ShowClear = false,
                    ShowDelete = false,
                    ShowFavorite = false,
                    ShowPrint = false,
                    IsPlain = true,
                    ReserveActionSlot = true,
                    Style = "border-bottom:0px !important;"
                })
            </div>

            <!-- ==================== Grid of saved jobs ==================== -->
            <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded mt-3">
                @* <div class="toolbar mb-3 d-flex justify-content-between flex-wrap gap-2">
                    <div class="input-group input-group-sm" style="width:120px">
                        <span class="input-group-text">Show</span>
                        <select class="form-select" id="pageSizeSelectBottom">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                    <input class="form-control form-control-sm" style="max-width:280px" id="searchInputBottom" type="text" placeholder="Search" />
                </div> *@
                <!-- Search and Page Size -->
                <div class="toolbar pb-2">

                    @* <div class="toolbar-left">
                        <div class="input-group input-group-sm toolbar-showing">
                            <span class="input-group-text">Showing</span>
                            <select class="form-select" id="statusPageSizeSelect">
                                <option>10</option>
                                <option>25</option>
                                <option>50</option>
                                <option>100</option>
                            </select>
                        </div>
                    </div> *@
                    <div class="toolbar-right">
                        <span class="label-text">Filter By:</span>
                        <div class="toolbar-item toolbar-customer">
                            <select class="form-select form-select-sm custom-select-single"
                                    id="customerLoadGridFilter" data-placeholder="Select Customer"
                                    asp-items="ViewBag.CustomerName as SelectList">
                                <option value="">All Customers</option>
                            </select>
                        </div>

                        <div class="toolbar-item toolbar-date">
                            <div class="input-group input-group-sm custom-date-group">
                                <span class="input-group-text">Date From</span>
                                <input type="date" class="form-control custom-datepicker caiCon" id="dateLoadGridFrom">
                                <span class="input-group-text">To</span>
                                <input type="date" class="form-control custom-datepicker caiCon" id="dateLoadGridTo">
                            </div>
                        </div>

                        <div class="toolbar-item toolbar-search">
                            @* <input class="form-control form-control-sm"
                                   id="statusSearchInput"
                                   type="text"
                                   placeholder="Search"> *@
                        </div>
                    </div>

                </div>

                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "jobListTable",
                    AjaxUrl = "/SepDocUpdate/GetJobs",
                    AjaxMethod = "POST",
                    ServerSide = true,
                    ShowCheckbox = true,
                    CheckColumnData = "tc",
                    CheckAllId = "selectAllJobs",
                    ShowActionMenu = false,
                    ShowRowNumbers = false,
                    DefaultSortColumn = "JobNo",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "jobNo", Header = "Job No", IsEditLink = true, EditSelectorClass = "job-detail-link", IdField = "tc" },
                        new() { Data = "jobDateFormatted", Header = "Job Date", Align = "center" },
                        new() { Data = "customerName", Header = "Customer", Align = "left" },
                        new() { Data = "customerAddress", Header = "Customer Address", Align = "left" },
                        new() { Data = "shipmentMode", Header = "Shipment Mode", Align = "left" },
                        new() { Data = "docReceivedDateFormatted", Header = "Doc Received Date", Align = "center" },
                        new() { Data = "lcValue", Header = "LC Value", Align = "center" },
                        new() { Data = "jobStatus", Header = "Job Status", Align = "center" }
                    }
                })
            </div>
        </div>

        <!-- ==================== TAB 2: Document Upload Info ==================== -->
        <div class="tab-pane fade" id="uploadTabPane" role="tabpanel">
            <div class="pt-2 pb-0 bg-white shadow rounded sep-doc-form-card">
                <div class="card mb-3">
                    <div class="card-header bg-light fw-bold">Main Information</div>
                    <div class="card-body">
                        <div class="row g-3 sep-doc-fields-row">
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                InputId = "uploadJobNoDisplay",
                                LabelText = "Job No",
                                IsReadonly = true,
                                ReserveActionSlot = true
                            })
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                InputId = "uploadJobDateDisplay",
                                LabelText = "Date",
                                IsReadonly = true,
                                ReserveActionSlot = true
                            })
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel { FieldType = FieldType.Blank })
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                InputId = "uploadCustomerDisplay",
                                LabelText = "Customer",
                                IsReadonly = true,
                                ReserveActionSlot = true
                            })
                            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                            {
                                ColumnClass = "col-lg-8 col-md-6",
                                InputId = "uploadAddressDisplay",
                                LabelText = "Address",
                                FieldType = FieldType.Textarea,
                                IsReadonly = true
                            })
                        </div>
                    </div>
                </div>

                <div class="table-responsive scrollbar mb-3">
                    <table class="table table-bordered table-sm fs-9 mb-0" id="documentTable">
                        <thead>
                            <tr>
                                <th style="width:40px">Sel.</th>
                                <th>Sl No.</th>
                                <th>Document Name</th>
                                <th>Description</th>
                                <th>Uploaded File</th>
                                <th style="width:70px"></th>
                            </tr>
                        </thead>
                        <tbody id="document-list-body">
                            <tr><td colspan="6" class="text-center">No data available</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="row g-3 sep-doc-fields-row">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Upload File</label>
                        <input type="file" class="form-control form-control-sm" id="uploadFile" />
                        <small class="text-primary">Max Size 15 MB</small>
                    </div>

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "documentName",
                        LabelText = "Document Name",
                        Placeholder = "Enter Document Name",
                        ReserveActionSlot = true
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        InputId = "documentDescription",
                        LabelText = "Description",
                        FieldType = FieldType.Textarea,
                        Placeholder = "Enter Document Description"
                    })
                </div>

                <div class="border-bottom border-2 my-2"></div>

                @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                {
                    Title = "",
                    SaveBtnClass = "doc-seve-upload-btn",
                    ShowClear = false,
                    ShowDelete = false,
                    ShowFavorite = false,
                    ShowPrint = false,
                    IsPlain = true,
                    Style = "border-bottom:0px !important;"
                })
            </div>
        </div>
    </div>
</form>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/pages/sepdocumentation.js"></script>
}
