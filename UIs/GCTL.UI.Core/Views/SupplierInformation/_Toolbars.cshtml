

@model ToobarModel

<div class="row">
    <div class="col-md-5">
        <h6 class="page-title">@Model.Title</h6>
    </div>
    <div class="col-md-7">
        <div class="btn-toolbar d-flex justify-content-end">
            <div class="btn-group">

                <button type="button" class="btn btn-default success-btn js-SupplierInformation-save" data-toggle="tooltip" data-placement="bottom" title="Save">
                    <i class="fa fa-save">&nbsp;</i> Save
                </button>

                <button type="button" class="btn btn-default danger-btn js-SupplierInformation-delete-confirm" data-toggle="tooltip" data-placement="bottom" title="Delete">
                    <i class="fa fa-trash">&nbsp;</i> Delete
                </button>

                <button type="button" class="btn btn-default primary-btn js-SupplierInformation-clear" data-toggle="tooltip" data-placement="bottom" title="Clear">
                    <i class="fas fa-sync">&nbsp;</i> Clear
                </button>

                <button type="button" class="btn btn-default info-btn btn-sm" data-toggle="tooltip" data-placement="bottom" title="Print">
                    <i class="fas fa-print">&nbsp;</i> Print
                </button>

                <button type="button" class="btn btn-default warning-btn btn-sm" data-toggle="tooltip" data-placement="bottom" title="Favorite">
                    <i class="far fa-star">&nbsp;</i> Favorite
                </button>

            </div>
        </div>
    </div>
</div>

