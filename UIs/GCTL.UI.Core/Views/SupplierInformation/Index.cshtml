@model GCTL.UI.Core.ViewModels.SupplierInformation.SupplierInformationPageViewModel

<!-- Content Header (Page header) -->
@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Supplier Information";
    Model.Breadcrumb = "Supplier Information";
}

<style>
    .dataTables_filter label {
        margin-right: 0px !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }
</style>
