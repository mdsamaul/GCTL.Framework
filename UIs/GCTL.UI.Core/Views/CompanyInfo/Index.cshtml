@model GCTL.UI.Core.ViewModels.CompanyInfo.CompanyInfoPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Company Information";
    Model.Breadcrumb = "Company Information";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Company Information",
                            SaveBtnClass = "js-CompanyInfo-save",
                            DeleteBtnClass = "js-CompanyInfo-delete-confirm",
                            ClearBtnClass = "js-CompanyInfo-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="CompanyInfo-form" asp-controller="CompanyInfo">
                            <div class="js-CompanyInfo-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "companyInfoTable",
                    AjaxUrl = "/CompanyInfo/GetTableData",
                    AjaxMethod = "GET",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "companyId",
                    CheckAllId = "CompanyInfo-check-all",
                    DefaultSortColumn = "companyId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "companyId", Header = "ID", Width = "6%", IsEditLink = true, EditSelectorClass = "js-CompanyInfo-edit" },
                        new() { Data = "companyName", Header = "Company Name", Width = "23%"},
                        new() { Data = "shortName", Header = "Short Name", Width = "12%"},
                        new() { Data = "companyAddress", Header = "Address", Width = "40%"},
                        new() { Data = "companyForName", Header = "Company For", Width = "19%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

<script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/companyInfo.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
        if (window.jQuery && typeof $.companyInfo === "function") {
            var options = { baseUrl: '@Url.Action("", "CompanyInfo")' };
            options.load = () => { };
            $.companyInfo(options);
        } else {
            setTimeout(waitForJQuery, 30);
        }
    })();
</script>