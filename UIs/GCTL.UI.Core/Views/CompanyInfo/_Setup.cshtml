@model GCTL.Core.ViewModels.CompanyInfo.CompanyInfoSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" id="lastCode" />
    <input type="hidden" asp-for="Tc" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Ldate" />
    <input type="hidden" asp-for="ModifyDate" />

    @* ---------- Row 1: Company ID & Company For ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyId",
            LabelText = "Company ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            CustomCssClass = "js-CompanyId-code",
            DefaultValue = Model?.CompanyId
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyForId",
            LabelText = "Company For",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Company For --",
            IsRequired = true,
            SelectItems = ViewBag.CompanyForDD as SelectList,
            CustomCssClass = "js-Type",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false
        })
    </div>

    @* ---------- Row 2: Company Name & Short Name ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyName",
            LabelText = "Company Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Company Name",
            IsRequired = true,
            CustomCssClass = "js-CompanyName-check-duplicateName",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            DefaultValue = Model.CompanyName,
            AutoFocus = true,
            ReserveActionSlot = false
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ShortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.ShortName
        })
    </div>

    @* ---------- Row 3: Address & Local Office Address ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyAddress",
            LabelText = "Address",
            FieldType = FieldType.Text,
            Placeholder = "Enter Address",
            IsRequired = true,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.CompanyAddress
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "LocalOfficeAddress",
            LabelText = "Local Office Address",
            FieldType = FieldType.Text,
            Placeholder = "Enter Local Office Address",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.LocalOfficeAddress
        })
    </div>

    @* ---------- Row 4: Zip Code & City ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ZipCode",
            LabelText = "Zip/Postal Code",
            FieldType = FieldType.Text,
            Placeholder = "Enter Zip/Postal Code",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.ZipCode
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "City",
            LabelText = "City",
            FieldType = FieldType.Text,
            Placeholder = "Enter City",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.City
        })
    </div>

    @* ---------- Row 5: State & Country ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "State",
            LabelText = "State",
            FieldType = FieldType.Text,
            Placeholder = "Enter State",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.State
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CountryId",
            LabelText = "Country",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Country --",
            SelectItems = ViewBag.CountryDD as SelectList,
            CustomCssClass = "js-Type",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false
        })
    </div>

    @* ---------- Row 6: Phone & Fax ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone",
            LabelText = "Phone",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.Phone
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Fax",
            LabelText = "Fax",
            FieldType = FieldType.Text,
            Placeholder = "Enter Fax",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.Fax
        })
    </div>

    @* ---------- Row 7: Email & Url ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.Email
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Url",
            LabelText = "Url",
            FieldType = FieldType.Text,
            Placeholder = "Enter Url",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.Url
        })
    </div>

    @* ---------- Row 8: Remarks ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Remarks",
            LabelText = "Remarks",
            FieldType = FieldType.Text,
            Placeholder = "Enter Remarks",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.Remarks
        })
    </div>

    @if (Model.Tc > 0)
    {
        <hr class="my-2" />
        <div class="row g-4 mb-1" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 ci-field-col",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }

</div>

<div class="row g-4 no-print" style="margin-top: 9px;">
    <div class="col-12 col-md-6 col-xxl-12 ci-toolbar-col">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-CompanyInfo-save",
            ReserveActionSlot = true,
            Style = "border-bottom:0px !important; padding-left:605px",
            ShowExtraContentLaptopOnly = true,
            ShowExtraContent1 = true,
            ShowExtraContent2 = false
        })
    </div>
</div>