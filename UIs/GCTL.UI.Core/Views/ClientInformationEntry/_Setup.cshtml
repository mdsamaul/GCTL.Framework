@model GCTL.Core.ViewModels.ClientInformationEntry.ClientInformationEntrySetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="AutoId" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Client ID (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ClientId",
            LabelText = "Client ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-CompanyId-code",
            DefaultValue = Model?.ClientId
        })
    </div>

    <div class="form-group row">

        @* ---------- Client Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ClientName",
            LabelText = "Client Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Client Name",
            IsRequired = true,
            CustomCssClass = "js-ClientName-check-duplicateName",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.ClientName
        })

        @* ---------- Short Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ShortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.ShortName
        })
    </div>

    <div class="form-group row">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ClientAddress",
            LabelText = "Address",
            FieldType = FieldType.Text,
            Placeholder = "Enter Address",
            ColumnClass = "col-lg-12",
            DefaultValue = Model.ClientAddress
        })
    </div>

    <div class="form-group row">

        @* ---------- Country (Select + Quick Add) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CountryId",
            LabelText = "Country",
            FieldType = FieldType.Select,
            Placeholder = "Select Country",
            SelectItems = ViewBag.CountryDD as SelectList,
            ColumnClass = "col-lg-6",
            ShowQuickAdd = true,
            QuickAddUrl = Url.Action("Index", "Country"),
            QuickAddTarget = "#CountryId",
            QuickAddReloadUrl = Url.Action("GetCountrys", "Cascading"),
            QuickAddTitle = "Country"
        })

        @* ---------- City ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "City",
            LabelText = "City",
            FieldType = FieldType.Text,
            Placeholder = "Enter City",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.City
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "State",
            LabelText = "State/Province",
            FieldType = FieldType.Text,
            Placeholder = "Enter State",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.State
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ZipCode",
            LabelText = "Zip Code",
            FieldType = FieldType.Text,
            Placeholder = "Enter Zip Code",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.ZipCode
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone",
            LabelText = "Phone",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Phone
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Fax",
            LabelText = "Fax",
            FieldType = FieldType.Text,
            Placeholder = "Enter Fax",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Fax
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Email
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Url",
            LabelText = "Url",
            FieldType = FieldType.Text,
            Placeholder = "Enter Url",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Url
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Bin",
            LabelText = "Bin",
            FieldType = FieldType.Text,
            Placeholder = "Enter Bin",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Bin
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Vat",
            LabelText = "Vat Reg No.",
            FieldType = FieldType.Text,
            Placeholder = "Enter Vat Reg No.",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Vat
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Tin",
            LabelText = "Tin",
            FieldType = FieldType.Text,
            Placeholder = "Enter Tin",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Tin
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ContatPerson1",
            LabelText = "Contact Person 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Contact Person 1",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.ContatPerson1
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Designation1",
            LabelText = "Designation",
            FieldType = FieldType.Text,
            Placeholder = "Enter Designation",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Designation1
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone1",
            LabelText = "Phone",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Phone1
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email1",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Email1
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ContatPerson2",
            LabelText = "Contact Person 2",
            FieldType = FieldType.Text,
            Placeholder = "Enter Contact Person 2",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.ContatPerson2
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Designation2",
            LabelText = "Designation",
            FieldType = FieldType.Text,
            Placeholder = "Enter Designation",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Designation2
        })
    </div>

    <div class="form-group row">

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone2",
            LabelText = "Phone",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Phone2
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email2",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.Email2
        })
    </div>

    @if (Model.AutoId > 0)
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt")
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-ClientInformationEntry-save",
            ReserveActionSlot = true,
            IsMarginRight = true
        })
    </div>
</div>