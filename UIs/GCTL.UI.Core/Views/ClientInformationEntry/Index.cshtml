@model GCTL.UI.Core.ViewModels.ClientInformationEntry.ClientInformationEntryPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Client Information Entry";
    Model.Breadcrumb = "Client Information Entry";
}

<style>
    /* Responsive layout:
       - Laptop / smaller screens (<= 1600px): Form is on Top (100%), Inputs are col-3 (25% width, 2 inputs = 50% width + 50% gap), Grid is on Bottom (100%)
       - Big screen (> 1600px): Form is on Left (50%), Inputs are 50% (2 per row), Grid is on Right (50%)
    */
    @@media (max-width: 1600px) {
        .cie-layout-form-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            margin-bottom: 1rem;
        }

        .cie-layout-grid-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            padding-bottom: 1.5rem !important;
        }

        .cie-field-col {
            flex: 0 0 25% !important;
            max-width: 25% !important;
        }

        .cie-toolbar-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }
    }

    @@media (min-width: 1600.02px) {
        .cie-layout-form-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }

        .cie-layout-grid-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }

        .cie-field-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }

        .cie-toolbar-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
        }
    }

    @@media (max-width: 991.98px) {
        .cie-field-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }

        .cie-toolbar-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
        }
    }

    @@media (max-width: 575.98px) {
        .cie-field-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
        }

        .cie-toolbar-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
        }
    }

    .btn-plus {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

    .country-input-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .country-select-wrap {
        flex: 1;
        min-width: 0;
    }

        .country-select-wrap .select2-container {
            width: 100% !important;
        }
</style>

<section class="content consistent-look">
    <partial name="_PageHeader" model="Model" />

    <div class="">
        <div class="row g-2">

            <!-- Setup Form Column (Top on Laptop, Left on Big Screen) -->
            <div class="col-12 col-xxl-6 cie-layout-form-col">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Client Information Entry",
                            SaveBtnClass = "js-ClientInformationEntry-save",
                            DeleteBtnClass = "js-ClientInformationEntry-delete-confirm",
                            ClearBtnClass = "js-ClientInformationEntry-clear",
                            ShowExtraContentLaptopOnly = true
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="ClientInformationEntry-form" asp-controller="ClientInformationEntry">
                            <div class="js-ClientInformationEntry-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Table Grid Column (Bottom on Laptop, Right on Big Screen) -->
            <div class="col-10 col-xxl-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "ClientInformationEntry-grid",
                    AjaxUrl = "/ClientInformationEntry/GetTableData",
                    AjaxMethod = "GET",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "clientId",
                    CheckAllId = "ClientInformationEntry-check-all",
                    DefaultSortColumn = "clientId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "clientId", Header = "ID", Width = "6%", IsEditLink = true, EditSelectorClass = "js-ClientInformationEntry-edit", IdField = "clientId" },
                        new() { Data = "clientName", Header = "Client Name", Width = "30%", Align = "left"},
                        new() { Data = "phone", Header = "Phone", Width = "13%", Align = "left"},
                        new() { Data = "email", Header = "Email", Width = "20%", Align = "left"},
                        new() { Data = "clientAddress", Header = "Address", Width = "31%", Align = "left"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    <script src="~/js/app.input.validation.js" defer></script>
    <script src="~/js/pages/clientInformationEntry.js" defer></script>
    <script type="text/javascript">
        (function waitForJQuery() {
            if (window.jQuery && typeof $.clientInformationEntry === "function") {
                var options = { baseUrl: '@Url.Action("", "ClientInformationEntry")' };
                options.load = () => { };
                $.clientInformationEntry(options);
            } else {
                setTimeout(waitForJQuery, 30);
            }
        })();
    </script>
}
