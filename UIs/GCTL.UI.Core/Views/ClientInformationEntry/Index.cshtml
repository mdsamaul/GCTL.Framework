@model GCTL.UI.Core.ViewModels.ClientInformationEntry.ClientInformationEntryPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Client Information Entry";
    Model.Breadcrumb = "Client Information Entry";
}

<style>
    .btn-plus {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

    .country-input-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .country-select-wrap {
        flex: 1;
        min-width: 0;
    }

        .country-select-wrap .select2-container {
            width: 100% !important;
        }
</style>

<section class="content consistent-look">
    <partial name="_PageHeader" model="Model" />

    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Client Information Entry",
                            SaveBtnClass = "js-ClientInformationEntry-save",
                            DeleteBtnClass = "js-ClientInformationEntry-delete-confirm",
                            ClearBtnClass = "js-ClientInformationEntry-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="ClientInformationEntry-form" asp-controller="ClientInformationEntry">
                            <div class="js-ClientInformationEntry-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "clientInformationEntryTable",
                    AjaxUrl = "/ClientInformationEntry/GetTableData",
                    AjaxMethod = "GET",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "clientId",
                    CheckAllId = "ClientInformationEntry-check-all",
                    DefaultSortColumn = "clientId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "clientId", Header = "ID", Width = "6%", IsEditLink = true, EditSelectorClass = "js-ClientInformationEntry-edit" },
                        new() { Data = "clientName", Header = "Client Name", Width = "30%"},
                        new() { Data = "phone", Header = "Phone", Width = "14%"},
                        new() { Data = "email", Header = "Email", Width = "20%"},
                        new() { Data = "clientAddress", Header = "Address", Width = "30%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/clientInformationEntry.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $.clientInformationEntry({
                baseUrl: '/ClientInformationEntry'
            });
        });
    </script>
}