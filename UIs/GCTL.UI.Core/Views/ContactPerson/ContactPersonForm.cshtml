<style>
    .form-floating .selectLabel {
        font-size: 14px !important;
    }

    .form-floating label {
        text-transform: none;
        font-size: 13px;
    }

    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }
</style>

<div class="card shadow-sm rounded-2">
    <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap">
        <h4 class="mb-0">Contact Person Info</h4>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" form="contactForm" class="btn btn-sm btn-outline-primary saveBtn" id="saveBtn">
                <i class="fas fa-save me-1"></i> Save
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger deleteBtn" id="deleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="reset" class="btn btn-sm btn-outline-secondary resetBtn">
                <i class="fas fa-eraser me-1"></i> Clear
            </button>
            <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item export-pdf" href="#"><i class="fas fa-file-pdf me-1"></i> PDF</a></li>
                    <li><a class="dropdown-item export-excel" href="#"><i class="fas fa-file-excel me-1"></i> Excel</a></li>
                </ul>
            </div>
            <button type="button" class="btn btn-sm btn-outline-warning favBtn">
                <i class="fas fa-star me-1"></i> Fav
            </button>
        </div>
    </div>

    <div class="card-body">
        <form id="contactForm">
            <input type="hidden" id="autoId" name="autoId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <input readonly type="text" class="form-control" name="cpid" id="cpid" placeholder="Contact ID">
                        <label for="cpid">Contact ID</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="contactPersonName" id="contactPersonName" placeholder="Enter Contact Person Name">
                        <label for="contactPersonName">Contact Person Name<span style="color:red">*</span></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" name="designationCode" id="designationCode">
                            <option value=""> </option>
                        </select>
                        <label for="designationCode"></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="contactPersonMobile" id="contactPersonMobile" placeholder="Enter Mobile Number">
                        <label for="contactPersonMobile">Mobile Number<span style="color:red">*</span></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="email" class="form-control" name="contactPersonEmail" id="contactPersonEmail" placeholder="Enter Email Address">
                        <label for="contactPersonEmail">Email Address</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" name="compnayCode" id="companyCode">
                            @* <option value="001">ABC Company</option> *@
                        </select>
                        <label for="companyCode"></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" name="employeeID" id="employeeID">
                            <option value=""> </option>
                        </select>
                        <label for="employeeID">Employee</label>
                    </div>
                </div>
            </div>

            <!-- Creation/Modify Date Display -->
            <div class="row g-3 mt-2">
                <div class="col-md-6" id="lDateContainer" style="display: none;">
                    <label class="form-label fw-bold text-muted small">Creation Date</label>
                    <div id="displayLDate" class="bg-white p-3 border rounded-3"></div>
                </div>
                <div class="col-md-6" id="modifyDateContainer" style="display: none;">
                    <label class="form-label fw-bold text-muted small">Modify Date</label>
                    <div id="displayModifyDate" class="bg-white p-3 border rounded-3"></div>
                </div>
            </div>

            <!-- Save Button (Bottom) -->
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary btn-sm saveBtn">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

