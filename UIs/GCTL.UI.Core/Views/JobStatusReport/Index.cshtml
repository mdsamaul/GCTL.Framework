@{
    ViewData["Title"] = "Job Status Report";
    Layout = "_Layout";
}

<style>
    :root {
        --primary: #0056b3;
        --secondary: #003366;
        --bg-frost: #f4f7f9;
        --white: #ffffff;
        --pending: #ff9800;
        --delivered: #4caf50;
        --transit: #9c27b0;
        --border: #e0e6ed;
        --text-main: #334155;
    }

    .job-status-dashboard {
        color: var(--text-main);
        font-family: 'Segoe UI', Roboto, sans-serif;
    }

    /* Main Container */
    .dashboard-container {
        padding: 6px 0 25px 0;
        max-width: 100%;
        margin: 0 auto;
    }

    /* Status Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 16px;
    }

    .stat-card {
        background: white;
        padding: 14px 18px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border-bottom: 4px solid var(--primary);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        user-select: none;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 14px rgba(0,0,0,0.06);
    }

    .stat-card.active-card {
        transform: translateY(-3px);
        box-shadow: 0 8px 18px rgba(0, 51, 102, 0.18) !important;
        border-top: 2px solid rgba(0, 86, 179, 0.2);
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-size: 1.25rem;
        color: white;
        flex-shrink: 0;
    }

    .stat-info h3 {
        font-size: 0.8rem;
        color: #64748b;
        text-transform: uppercase;
        margin: 0 0 4px 0;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .stat-info p {
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--secondary);
        margin: 0;
        line-height: 1;
    }

    /* Filter Section - One Line Design Across Laptop and Desktop */
    .filter-section {
        background: white;
        padding: 8px 12px;
        border-radius: 8px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        border: 1px solid var(--border);
        flex-wrap: nowrap;
        width: 100%;
        box-sizing: border-box;
    }

    .filter-label {
        font-weight: 700;
        color: var(--secondary);
        font-size: 0.82rem;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 4px;
        flex: 0 0 auto;
        margin: 0;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 4px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .filter-group.filter-date-group {
        flex: 0 0 auto;
    }

    .filter-group.filter-date-group input {
        width: 90px !important;
        min-width: 90px !important;
        max-width: 95px !important;
        padding: 4px 22px 4px 6px !important;
        font-size: 0.78rem !important;
    }

    .filter-group.filter-group-customer {
        flex: 1.4 1 140px;
        min-width: 110px;
    }

    .filter-group.filter-group-mode {
        flex: 1 1 105px;
        min-width: 95px;
    }

    .filter-group.filter-group-port {
        flex: 0.9 1 95px;
        min-width: 85px;
    }

    .filter-group.filter-group-status {
        flex: 0.9 1 100px;
        min-width: 90px;
    }

    .filter-group.filter-group-export {
        flex: 1 1 120px;
        min-width: 105px;
    }

    .filter-group label {
        font-size: 0.78rem;
        font-weight: 600;
        white-space: nowrap;
        color: #475569;
        margin: 0;
    }

    .filter-group input.form-control,
    .filter-group select.form-select {
        width: 100%;
        padding: 4px 6px;
        border: 1px solid var(--border);
        border-radius: 5px;
        font-size: 0.79rem;
        outline: none;
        background-color: #ffffff;
        color: var(--text-main);
        height: 31px;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .filter-group input.custom-datepicker,
    .filter-group input.flatpickr-alt-input,
    .filter-group input.caiCon,
    .filter-group input[type="date"] {
        background-image: url('/images/icons/calender.svg') !important;
        background-repeat: no-repeat !important;
        background-position: right 6px center !important;
        background-size: 13px 13px !important;
        padding-right: 22px !important;
        cursor: pointer;
    }

    .filter-group .custom-dd-wrapper {
        width: 100% !important;
    }

    .filter-group .custom-dd-input {
        min-height: 31px !important;
        height: 31px !important;
        padding: 2px 6px !important;
        font-size: 0.79rem !important;
        border-radius: 5px !important;
    }

    .filter-actions {
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        margin-left: 2px;
    }

    .btn-export-rep {
        background: var(--delivered);
        color: white;
        border: none;
        padding: 4px 12px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.79rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 31px;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .btn-export-rep:hover {
        background: #3d8b40;
        box-shadow: 0 4px 10px rgba(76, 175, 80, 0.3);
    }

    /* Responsive adjustments for Tablets/Mobile */
    @@media (max-width: 991px) {
        .filter-section {
            flex-wrap: wrap;
            gap: 8px;
        }
        .filter-label {
            flex: 0 0 100%;
        }
        .filter-group {
            flex: 1 1 calc(50% - 8px);
        }
        .filter-actions {
            margin-left: auto;
        }
    }

    /* Card Wrapper for DataTables */
    .job-tables-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid var(--border);
        overflow: hidden;
    }



    /* Portal Banner */
    .portal-banner {
        background: #fde9d9;
        border: 1px solid #fbd2b3;
        color: #8a3c00;
        font-weight: 700;
        font-size: 0.86rem;
        padding: 7px 14px;
        border-radius: 6px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .portal-banner i {
        font-size: 1rem;
    }

    .job-table-outer {
        width: 100%;
        overflow: visible;
    }

    .table-responsive {
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
        width: 100%;
    }

    .table-responsive::-webkit-scrollbar {
        height: 7px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: #64748b;
    }

    .custom-grid-table {
        width: 100% !important;
        margin-bottom: 0 !important;
        background: #ffffff !important;
        border-collapse: collapse;
    }

    .custom-grid-table thead th,
    .custom-grid-table th {
        font-size: 0.72rem !important;
        font-weight: 600 !important;
        vertical-align: middle !important;
        text-align: center !important;
        white-space: nowrap !important;
        padding: 5px 4px !important;
        background: #f8fafc !important;
        color: #334155;
        border-bottom: 2px solid var(--border) !important;
    }

    .custom-grid-table th[title] {
        cursor: help;
        border-bottom: 1px dotted #94a3b8;
    }

    .custom-grid-table td {
        font-size: 0.73rem !important;
        vertical-align: middle !important;
        text-align: center !important;
        padding: 4px 4px !important;
        white-space: nowrap !important;
        background: #ffffff !important;
    }

    .custom-grid-table td.amount-cell,
    .custom-grid-table td.text-end {
        text-align: right !important;
        padding-right: 6px !important;
        font-variant-numeric: tabular-nums;
    }

    .custom-grid-table td.cell-wrap,
    .custom-grid-table td.text-start {
        white-space: normal !important;
        word-break: break-word;
        max-width: 140px;
        text-align: left !important;
    }

    .currency-sym {
        font-weight: 600;
        color: #475569;
        font-size: 0.75rem;
        display: inline-block;
        margin-right: 2px;
    }

    /* Fixed Controls (Length, Search, Info, Pagination) */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        position: static !important;
        flex-shrink: 0;
    }

    .dataTables_wrapper .dataTables_length label,
    .dataTables_wrapper .dataTables_filter label {
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        font-size: 0.82rem !important;
        color: #475569 !important;
        margin-bottom: 0 !important;
    }

    .dataTables_wrapper .dataTables_length select {
        width: auto !important;
        display: inline-block !important;
        font-size: 0.82rem !important;
        padding: 2px 24px 2px 8px !important;
    }

    .dataTables_wrapper .dataTables_filter input {
        width: 200px !important;
        display: inline-block !important;
        font-size: 0.82rem !important;
        padding: 4px 8px !important;
    }

    .dataTables_wrapper .dataTables_info {
        font-size: 0.8rem !important;
        color: #64748b !important;
        font-weight: 500 !important;
        padding-top: 0 !important;
    }

    .dataTables_wrapper .dataTables_paginate .pagination {
        margin: 0 !important;
        font-size: 0.82rem !important;
    }

    /* Badges in tables */
    .status-badge {
        padding: 0;
        border-radius: 0;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
        white-space: nowrap;
        background: transparent !important;
        border: none !important;
    }

    .status-badge.pending {
        color: #c2410c;
    }

    .status-badge.delivered {
        color: #15803d;
    }

    .status-badge.transit {
        color: #7e22ce;
    }

    .job-no-cell {
        color: var(--primary);
        font-weight: 600;
    }


    @@media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
        .filter-section {
            flex-direction: column;
            align-items: stretch;
        }
        .filter-group {
            width: 100%;
        }
    }
</style>

<div class="job-status-dashboard">
    <div class="dashboard-container">

        <!-- Stats Grid (4 Cards) -->
        <div class="stats-grid">
            <div class="stat-card active-card" data-status-filter="" title="Click to view all jobs">
                <div class="stat-icon" style="background: var(--primary);">
                    <i class="fas fa-briefcase"></i>
                </div>
                <div class="stat-info">
                    <h3>Total Jobs</h3>
                    <p id="statTotalJobs">0</p>
                </div>
            </div>
            <div class="stat-card" style="border-color: var(--pending);" data-status-filter="Pending" title="Click to filter Pending jobs">
                <div class="stat-icon" style="background: var(--pending);">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-info">
                    <h3>Pending</h3>
                    <p id="statPendingJobs">0</p>
                </div>
            </div>
            <div class="stat-card" style="border-color: var(--transit);" data-status-filter="In Transit" title="Click to filter In Transit jobs">
                <div class="stat-icon" style="background: var(--transit);">
                    <i class="fas fa-truck-fast"></i>
                </div>
                <div class="stat-info">
                    <h3>In Transit</h3>
                    <p id="statTransitJobs">0</p>
                </div>
            </div>
            <div class="stat-card" style="border-color: var(--delivered);" data-status-filter="Delivered" title="Click to filter Delivered jobs">
                <div class="stat-icon" style="background: var(--delivered);">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-info">
                    <h3>Delivered</h3>
                    <p id="statDeliveredJobs">0</p>
                </div>
            </div>
        </div>

        <!-- Filter Bar (One Line Design with Instant Auto-Refresh) -->
        <div class="filter-section">
            <span class="filter-label"><i class="fas fa-filter"></i> Filter By:</span>
            
            <!-- From Date -->
            <div class="filter-group filter-date-group">
                <label for="filterFromDate">From</label>
                <input type="text" id="filterFromDate" class="form-control form-control-sm custom-datepicker caiCon auto-filter" value="@DateTime.Now.ToString("01/MM/yyyy")" placeholder="DD/MM/YYYY" autocomplete="off" />
            </div>

            <!-- To Date -->
            <div class="filter-group filter-date-group">
                <label for="filterToDate">To</label>
                <input type="text" id="filterToDate" class="form-control form-control-sm custom-datepicker caiCon auto-filter" value="@DateTime.Now.ToString("dd/MM/yyyy")" placeholder="DD/MM/YYYY" autocomplete="off" />
            </div>

            <!-- Customer (Single Select - Default None) -->
            <div class="filter-group filter-group-customer">
                <select id="filterCustomerId" class="form-select form-select-sm custom-select-single auto-filter" data-placeholder="select customer">
                    <option value="" selected>select customer</option>
                    @if (ViewBag.Customers != null)
                    {
                        foreach (SelectListItem item in (SelectList)ViewBag.Customers)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Shipment Mode (Single Select, Default Air) -->
            <div class="filter-group filter-group-mode">
                <select id="filterShipmentMode" class="form-select form-select-sm custom-select-single auto-filter" data-placeholder="Shipment Mode">
                    <option value="Air" selected>Air Freight</option>
                    <option value="Sea">Sea Freight</option>
                    @if (ViewBag.ShipmentModes != null)
                    {
                        foreach (SelectListItem item in (SelectList)ViewBag.ShipmentModes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Port Type (Single Select) -->
            <div class="filter-group filter-group-port">
                <select id="filterPortType" class="form-select form-select-sm custom-select-single auto-filter" data-placeholder="Port Type">
                    <option value="">Port Type</option>
                    @if (ViewBag.PortTypes != null)
                    {
                        foreach (SelectListItem item in (SelectList)ViewBag.PortTypes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Job Status (Single Select) -->
            <div class="filter-group filter-group-status">
                <select id="filterJobStatus" class="form-select form-select-sm custom-select-single auto-filter" data-placeholder="-- Job Status --">
                    <option value="">-- Job Status --</option>
                    <option value="Pending">Pending</option>
                    <option value="In Transit">In Transit</option>
                    <option value="Delivered">Delivered</option>
                </select>
            </div>

            <!-- Export Format (Single Select with Placeholder) -->
            <div class="filter-group filter-group-export">
                <select id="filterExportFormat" class="form-select form-select-sm custom-select-single" data-placeholder="Select Exp. Format">
                    <option value="">Select Exp. Format</option>
                    <option value="PDF">PDF</option>
                    <option value="Excel">Excel</option>
                    <option value="CSV">CSV</option>
                </select>
            </div>

            <!-- Actions (Export button only, search is automatic) -->
            <div class="filter-actions">
                <button type="button" class="btn-export-rep" id="btnExport" title="Export report (Defaults to PDF if format not selected)">
                    <i class="fas fa-file-export"></i> EXPORT
                </button>
            </div>
        </div>

        <!-- Data Tables Container (Unified Single Container - Dynamically Changes Grid) -->
        <div class="job-tables-card">
            <div class="p-3">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div class="fw-bold text-secondary" id="gridTitle" style="font-size: 0.95rem;">
                        <i class="fas fa-plane text-primary me-2"></i>Job List(Air):
                    </div>
                </div>

                <!-- Air Freight Table (21 Columns) - Default Visible -->
                <div id="airTableContainer" style="display: block;">
                    <div class="job-table-outer">
                        <table id="airJobTable" class="table table-bordered table-hover custom-grid-table w-100">
                            <thead>
                                <tr>
                                    <th class="text-center align-middle" title="Serial Number" data-bs-toggle="tooltip" style="width: 32px;">SL</th>
                                    <th class="text-center align-middle" title="Job Number" data-bs-toggle="tooltip">Job No</th>
                                    <th class="text-center align-middle" title="Job Date" data-bs-toggle="tooltip">Job Dt</th>
                                    <th class="text-center align-middle" title="Shipment Mode" data-bs-toggle="tooltip">Mode</th>
                                    <th class="text-center align-middle" title="Port Name" data-bs-toggle="tooltip">Port</th>
                                    <th class="text-center align-middle" title="Doc's Receive Date" data-bs-toggle="tooltip">Doc Rec.</th>
                                    <th class="text-center align-middle" title="Invoice Number" data-bs-toggle="tooltip">Inv. No</th>
                                    <th class="text-center align-middle" title="Invoice Value" data-bs-toggle="tooltip">Inv. Val</th>
                                    <th class="text-center align-middle" title="Material Name &amp; Packages Quantity" data-bs-toggle="tooltip">Material &amp; Qty</th>
                                    <th class="text-center align-middle" title="Express Name, Country" data-bs-toggle="tooltip">Express/Ctry</th>
                                    <th class="text-center align-middle" title="Letter of Credit (L/C) Number" data-bs-toggle="tooltip">L/C No</th>
                                    <th class="text-center align-middle" title="Express / House Air Waybill (HAWB) Number" data-bs-toggle="tooltip">HAWB No</th>
                                    <th class="text-center align-middle" title="Master Air Waybill (MAWB) Number" data-bs-toggle="tooltip">MAWB No</th>
                                    <th class="text-center align-middle" title="Estimated Time of Departure (ETD)" data-bs-toggle="tooltip">ETD</th>
                                    <th class="text-center align-middle" title="Flight Actual Arrival Date" data-bs-toggle="tooltip">Flight Arr.</th>
                                    <th class="text-center align-middle" title="Arrival Notice Received From Express Date" data-bs-toggle="tooltip">Arr. Notice</th>
                                    <th class="text-center align-middle" title="Bill of Entry Number" data-bs-toggle="tooltip">B/E No</th>
                                    <th class="text-center align-middle" title="Bill of Entry Date" data-bs-toggle="tooltip">B/E Dt</th>
                                    <th class="text-center align-middle" title="Actual Delivery Date" data-bs-toggle="tooltip">Delivery Dt</th>
                                    <th class="text-center align-middle" title="Shipment Status" data-bs-toggle="tooltip">Status</th>
                                    <th class="text-center align-middle" title="Remarks" data-bs-toggle="tooltip">Remarks</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <!-- Sea Freight Table (26 Columns) - Hidden by default -->
                <div id="seaTableContainer" style="display: none;">
                    <div class="job-table-outer">
                        <table id="seaJobTable" class="table table-bordered table-hover custom-grid-table w-100">
                            <thead>
                                <tr>
                                    <th class="text-center align-middle" title="Serial Number" data-bs-toggle="tooltip" style="width: 32px;">SL</th>
                                    <th class="text-center align-middle" title="Job Number" data-bs-toggle="tooltip">Job No</th>
                                    <th class="text-center align-middle" title="Job Date" data-bs-toggle="tooltip">Job Dt</th>
                                    <th class="text-center align-middle" title="Shipment Mode" data-bs-toggle="tooltip">Mode</th>
                                    <th class="text-center align-middle" title="Port Name" data-bs-toggle="tooltip">Port</th>
                                    <th class="text-center align-middle" title="Doc's Receive Date" data-bs-toggle="tooltip">Doc Rec.</th>
                                    <th class="text-center align-middle" title="Invoice Number" data-bs-toggle="tooltip">Inv. No</th>
                                    <th class="text-center align-middle" title="Invoice Value" data-bs-toggle="tooltip">Inv. Val</th>
                                    <th class="text-center align-middle" title="Container / Packages Quantity" data-bs-toggle="tooltip">Cont./Pkgs</th>
                                    <th class="text-center align-middle" title="Shipper" data-bs-toggle="tooltip">Shipper</th>
                                    <th class="text-center align-middle" title="Bill of Lading (B/L) Number" data-bs-toggle="tooltip">B/L No</th>
                                    <th class="text-center align-middle" title="Estimated Time of Departure (ETD)" data-bs-toggle="tooltip">ETD</th>
                                    <th class="text-center align-middle" title="Final IGM Receive Date" data-bs-toggle="tooltip">IGM Rec.</th>
                                    <th class="text-center align-middle" title="Ship Arrived Date" data-bs-toggle="tooltip">Ship Arr.</th>
                                    <th class="text-center align-middle" title="Unstuff / Discharge Date" data-bs-toggle="tooltip">Discharge</th>
                                    <th class="text-center align-middle" title="Docs Bank Sign Date" data-bs-toggle="tooltip">Bank Sign</th>
                                    <th class="text-center align-middle" title="Bill of Entry Number" data-bs-toggle="tooltip">B/E No</th>
                                    <th class="text-center align-middle" title="Bill of Entry Date" data-bs-toggle="tooltip">B/E Dt</th>
                                    <th class="text-center align-middle" title="Estimated Delivery Date" data-bs-toggle="tooltip">Est. Del.</th>
                                    <th class="text-center align-middle" title="Actual Delivery Date" data-bs-toggle="tooltip">Act. Del.</th>
                                    <th class="text-center align-middle" title="Shipment Status" data-bs-toggle="tooltip">Status</th>
                                    <th class="text-center align-middle" title="Remarks" data-bs-toggle="tooltip">Remarks</th>
                                    <th class="text-center align-middle" title="Term" data-bs-toggle="tooltip">Term</th>
                                    <th class="text-center align-middle" title="Vessel Name &amp; Rotation No." data-bs-toggle="tooltip">Vessel</th>
                                    <th class="text-center align-middle" title="Container Number" data-bs-toggle="tooltip">Cont. No</th>
                                    <th class="text-center align-middle" title="Freight Forwarder Name &amp; Phone" data-bs-toggle="tooltip">Forwarder</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/pages/jobStatusReport.js" asp-append-version="true"></script>
}