@model List<GCTL.Core.ViewModels.TransportType.TransportTypeSetupViewModel>

    
<table id="TransportType-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="TransportType-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">ID</th>
            <th class="text-center text-middle" style="width: 52%;">Transport Type</th>
            <th class="text-center text-middle" style="width: 28%;">Short Name</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                @* <td colspan="8">No Data Available.</td> *@
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.VehicleTypeId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" id="js-TransportType-checkbox" class="text-center text-middle checkBox" data-id="@item.VehicleTypeId" value="@item.VehicleTypeId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-TransportType-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.VehicleTypeId" title="Edit">
                            @item.VehicleTypeId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.VehicleType</td>
                    <td class="text-center text-middle">@item.ShortName</td>

                </tr>
            }
        }

    </tbody>
</table>
