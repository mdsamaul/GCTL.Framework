@model GCTL.UI.Core.ViewModels.Nationalitys.NationalitysPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Nationality Info";
    Model.Breadcrumb = "Nationality Info";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-6 pr-0">
                <div class="card">
                    <div class="card-header px-2">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Nationality Info",
                            SaveBtnClass = "js-Nationalitys-save",
                            DeleteBtnClass = "js-Nationalitys-delete-confirm",
                            ClearBtnClass = "js-Nationalitys-clear"

                        })
                    </div>
                    <div class="card-body px-2">

                        <form asp-action="Setup" method="post" id="Nationalitys-form" asp-controller="Nationalitys">

                            <div class="js-Nationalitys-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6" style="height:570px;overflow:auto;">
                <div class="card">
                    <div class="card-body p-2 pt-3">
                        <div class="js-Nationalitys-grid-container">
                            @await Html.PartialAsync("_Grid", Model.NationalitysList)
                        </div>
                    </div>
                </div>
            </div>


        </div>


        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/nationalitys.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "Nationalitys")'
        };
        options.load = () => {
        };

        $.nationalitys(options);
    </script>
}


