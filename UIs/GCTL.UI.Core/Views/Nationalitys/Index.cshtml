@model GCTL.UI.Core.ViewModels.Nationalitys.NationalitysPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Nationality Info";
    Model.Breadcrumb = "Nationality Info";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Nationality Info",
                            SaveBtnClass = "js-nationality-save",
                            DeleteBtnClass = "js-nationality-delete-confirm",
                            ClearBtnClass = "js-nationality-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="nationality-form" asp-controller="Nationalitys">
                            <div class="js-nationality-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "nationalityTable",
                    AjaxUrl = "/Nationalitys/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "nationalityCode",
                    CheckAllId = "nationality-check-all",
                    DefaultSortColumn = "nationalityCode",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "nationalityCode", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-nationality-edit" },
                        new() { Data = "nationality", Header = "Nationality", Width = "90%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/nationalitys.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "Nationalitys")'
        };

        $.nationalitys(options);
    </script>
}
