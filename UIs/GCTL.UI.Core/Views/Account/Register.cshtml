@model RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign Up";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GCTL HRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page-bg">
    <!-- Animated Blobs in the Background -->
    <div class="auth-blob auth-blob-1"></div>
    <div class="auth-blob auth-blob-2"></div>

    <div class="auth-card-container">
        <div class="auth-card auth-card-grid">
                <div class="auth-card-panel auth-card-visual">
                    <div class="auth-visual-image" style="background-image:url('@Url.Content("~/images/auth_illustration.png")');"></div>
                    <div class="auth-visual-copy">
                        <h4>Join the team with secure access</h4>
                        <p>Create your account to access the dashboard, manage workflows, and stay connected with your organization.</p>
                    </div>
                </div>

                <div class="auth-card-panel auth-card-form">
                    <!-- Brand Logo -->
                    <a href="/" class="auth-brand">
                        <i class="bi bi-box-fill"></i>
                        <span>Formosa Logistics Ltd</span>
                    </a>

                    <h3 class="fw-bold mb-2">Create Account</h3>
                    <p class="text-muted small mb-4">Register your account to access your employee portal</p>

                    <form asp-controller="Account" asp-action="Register" method="post">
                
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger py-2 px-3 small mb-4" role="alert">
                            <div class="d-flex align-items-center mb-1">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Registration Failed</strong>
                            </div>
                            <div asp-validation-summary="All" class="text-danger small" style="list-style-type: none; padding-left: 0; margin-bottom: 0;"></div>
                        </div>
                    }

                    <!-- Full Name Input -->
                    <div class="form-group-animated">
                        <input asp-for="FullName" class="form-control" placeholder=" " required />
                        <label asp-for="FullName">Full Name</label>
                    </div>

                    <!-- Email Input -->
                    <div class="form-group-animated">
                        <input asp-for="Email" class="form-control" autocomplete="username" placeholder=" " required />
                        <label asp-for="Email">Email Address</label>
                    </div>

                    <!-- Password Input -->
                    <div class="form-group-animated">
                        <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder=" " required />
                        <label asp-for="Password">Password</label>
                    </div>

                    <!-- Confirm Password Input -->
                    <div class="form-group-animated">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder=" " required />
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary-modern w-100 mb-3">
                        Sign Up <i class="bi bi-person-plus ms-2"></i>
                    </button>
                </form>

                    <div class="text-center text-muted small mt-4">
                        Already have an account? 
                        <a asp-controller="Account" asp-action="Login" class="text-primary text-decoration-none fw-semibold">Sign In</a>
                    </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
