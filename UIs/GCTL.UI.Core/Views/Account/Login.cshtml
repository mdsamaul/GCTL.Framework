@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GCTL HRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page-bg">
    <!-- Animated Blobs in the Background -->
    <div class="auth-blob auth-blob-1"></div>
    <div class="auth-blob auth-blob-2"></div>

    <div class="auth-card-container">
        <div class="auth-card auth-card-grid">
            <div class="auth-card-panel auth-card-visual">
                <div class="auth-visual-image" style="background-image:url('@Url.Content("~/images/auth_illustration.png")');"></div>
                <div class="auth-visual-copy">
                    <h4>Secure access made simple</h4>
                    <p>Sign in to continue to your dashboard and track the latest updates, insights, and workflows in one place.</p>
                </div>
            </div>

            <div class="auth-card-panel auth-card-form">
                <!-- Brand Logo -->
                <a href="/" class="auth-brand">
                    <i class="bi bi-box-fill"></i>
                    <span>GCTL Framework</span>
                </a>

                <h3 class="fw-bold mb-2">Welcome Back</h3>
                <p class="text-muted small mb-4">Please enter your credentials to access your dashboard</p>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-4" role="alert">
                        <div class="d-flex align-items-center mb-1">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Authentication Failed</strong>
                        </div>
                        <div asp-validation-summary="All" class="text-danger small" style="list-style-type: none; padding-left: 0; margin-bottom: 0;"></div>
                    </div>
                }

                <!-- Email Input -->
                <div class="form-group-animated">
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder=" " required />
                    <label asp-for="Email">Email Address</label>
                </div>

                <!-- Password Input -->
                <div class="form-group-animated">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder=" " required />
                    <label asp-for="Password">Password</label>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me</label>
                    </div>
                    <a href="#" class="text-primary small text-decoration-none fw-semibold">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary-modern w-100 mb-3">
                    Sign In <i class="bi bi-arrow-right ms-2"></i>
                </button>
                </form>

                <div class="text-center text-muted small mt-4">
                    Don't have an account? 
                    <a asp-controller="Account" asp-action="Register" class="text-primary text-decoration-none fw-semibold">Sign Up</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
