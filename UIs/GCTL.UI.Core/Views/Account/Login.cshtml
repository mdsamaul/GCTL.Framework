@model LoginViewModel
@{
    ViewData["Title"] = "C&F Management System | Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="~/images/CoIcon.ico" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --gctl-logo-h: clamp(40px, 3.646vw, 85px);
            --formosa-logo-h: clamp(34px, 3.021vw, 70px);
            --brand-1: #0a2a5e;
            --brand-2: #0b5ed7;
            --brand-3: #19b5fe;
            --accent: #ff8a1f;
            --ink: #0f1b33;
            --muted: #64748b;
            --line: #dbe3ef;
            --bg: #eef3fa;
            --card: #ffffff;
            --radius: clamp(14px, 1.15vw, 22px);
            --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
            --font-head: 'Poppins', 'Inter', system-ui, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100%;
            overflow-x: hidden;
            overflow-y: auto;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            font-family: var(--font-body);
            color: var(--ink);
            background-color: #ffffff;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(8px, 1.5vh, 20px);
            -webkit-font-smoothing: antialiased;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: 0;
            background-image: url('@Url.Content("~/images/login-bg.jpg?v=5")');
            background-position: center center;
            background-repeat: no-repeat;
            background-size: cover;
            opacity: 0.10;
            pointer-events: none;
        }

        /* ---------- Main shell (fluid & responsive across all resolutions) ---------- */
        .shell {
            position: relative;
            z-index: 1;
            width: min(94vw, clamp(760px, 61.458vw, 1750px));
            height: clamp(520px, 72.22vh, 1080px);
            max-height: min(calc(100vh - 24px), calc(100dvh - 24px), 1100px);
            display: grid;
            grid-template-columns: 1.12fr .88fr;
            background: var(--card);
            border-radius: var(--radius);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            box-shadow: 0 25px 70px -15px rgba(10, 42, 94, .22), 0 10px 25px -10px rgba(10, 42, 94, .12);
            animation: rise .7s cubic-bezier(.2,.8,.2,1) both;
        }

        @@keyframes rise {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* =========================================================
           LEFT — HERO PANEL
           ========================================================= */
        .hero {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            min-height: 0;
            color: #fff;
            padding: clamp(20px, 2.96vh, 32px) clamp(24px, 2.5vw, 48px) 0;
            background: linear-gradient(155deg, var(--brand-1) 0%, #0a3f8f 48%, var(--brand-2) 100%);
            display: flex;
            flex-direction: column;
        }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            opacity: .18;
            background-image: radial-gradient(#fff 1.1px, transparent 1.2px);
            background-size: 22px 22px;
            mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
            -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
        }

        .hero::after {
            content: "";
            position: absolute;
            width: clamp(340px, 28vw, 520px);
            height: clamp(340px, 28vw, 520px);
            right: clamp(-160px, -8vw, -100px);
            top: clamp(-160px, -8vw, -100px);
            z-index: -1;
            background: radial-gradient(circle, rgba(25,181,254,.45), transparent 65%);
        }

        /* ► GCTL INFOSYS LOGO */
        .brand {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            margin-top: clamp(16px, 4.63vh, 50px);
            flex-shrink: 0;
        }

        .brand img {
            display: block;
            height: var(--gctl-logo-h);
            max-height: var(--gctl-logo-h);
            width: auto;
            object-fit: contain;
        }

        .brand img.hide { display: none; }
        .brand .fallback { display: none; font-weight: 800; font-size: clamp(16px, 1.04vw, 20px); color: #0a2a5e; letter-spacing: 1px; }
        .brand.no-logo .fallback { display: block; }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: clamp(10px, 2.4vh, 26px);
            padding: clamp(5px, 0.65vh, 7px) clamp(10px, 0.73vw, 14px);
            border-radius: 999px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.22);
            font-size: clamp(11px, 0.65vw, 12.5px);
            font-weight: 600;
            backdrop-filter: blur(6px);
            width: fit-content;
            flex-shrink: 0;
        }

        .badge i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #35e08a;
            box-shadow: 0 0 0 4px rgba(53,224,138,.25);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            50% { box-shadow: 0 0 0 8px rgba(53,224,138,0); }
        }

        .hero-description {
            font-size: clamp(12px, 0.73vw, 14px);
            line-height: 1.65;
            color: #ffffff;
            font-weight: 400;
            margin-top: clamp(8px, 1.48vh, 16px);
            margin-bottom: clamp(8px, 1.48vh, 16px);
            max-width: 520px;
            opacity: .94;
            flex-shrink: 0;
        }

        .features {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(8px, 1.11vh, 12px) clamp(12px, 1.04vw, 20px);
            margin-top: clamp(6px, 1.48vh, 16px);
            max-width: 520px;
            flex-shrink: 0;
        }

        .feat {
            display: flex;
            gap: clamp(8px, 0.6vw, 11px);
            align-items: flex-start;
        }

        .feat .ic {
            flex: none;
            width: clamp(28px, 1.77vw, 34px);
            height: clamp(28px, 1.77vw, 34px);
            border-radius: clamp(8px, 0.52vw, 10px);
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.2);
            display: grid;
            place-items: center;
        }

        .feat .ic svg {
            width: clamp(14px, 0.88vw, 17px);
            height: clamp(14px, 0.88vw, 17px);
            stroke: #fff;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .feat b {
            display: block;
            font-size: clamp(11.5px, 0.7vw, 13.5px);
            font-weight: 600;
        }

        .feat small {
            display: block;
            font-size: clamp(10.5px, 0.625vw, 12px);
            opacity: .75;
            margin-top: 2px;
            line-height: 1.35;
        }

        /* Background graphic (inline SVG scene) — fills whatever height is left */
        .scene {
            margin-top: auto;
            margin-inline: clamp(-48px, -2.5vw, -24px);
            line-height: 0;
            position: relative;
            z-index: 0;
            flex-shrink: 0;
            max-height: clamp(130px, 26vh, 270px);
        }

        .scene svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        .float { animation: float 6s ease-in-out infinite; }
        .plane { animation: fly 9s linear infinite; }
        @@keyframes float { 50% { transform: translateY(-5px); } }
        @@keyframes fly { from { transform: translate(-40px,18px); } to { transform: translate(40px,-18px); } }
        .wave { animation: wave 7s linear infinite; }
        @@keyframes wave { to { transform: translateX(-80px); } }

        /* =========================================================
           RIGHT — LOGIN PANEL
           ========================================================= */
        .panel {
            position: relative;
            min-height: 0;
            padding: clamp(16px, 3.33vh, 36px) clamp(22px, 2.7vw, 52px) clamp(14px, 2.22vh, 24px);
            display: flex;
            flex-direction: column;
            background: linear-gradient(180deg, #fff 0%, #f9fbff 100%);
            overflow-y: auto;
        }

        /* ► FORMOSA LOGO — right side */
        .client-logo {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin: 0;
            flex-shrink: 0;
        }

        .client-logo img {
            height: var(--formosa-logo-h);
            width: auto;
            max-width: 100%;
            object-fit: contain;
            display: block;
            mix-blend-mode: multiply;
        }

        .client-logo .fallback {
            display: none;
            font-family: var(--font-head);
            font-weight: 800;
            font-size: clamp(15px, 0.94vw, 18px);
            letter-spacing: 3px;
            color: var(--brand-1);
        }

        .panel h2 {
            font-family: var(--font-head);
            font-size: clamp(1.3rem, 1.458vw, 2.1rem);
            font-weight: 700;
            letter-spacing: -.3px;
            color: var(--ink);
            line-height: 1.25;
            margin-top: auto;
        }

        .panel .sub {
            color: var(--muted);
            font-size: clamp(0.75rem, 0.73vw, 0.95rem);
            margin-top: clamp(3px, 0.55vh, 6px);
            line-height: 1.4;
        }

        form {
            margin-top: clamp(12px, 2.4vh, 26px);
            margin-bottom: auto;
        }

        .field {
            margin-bottom: clamp(8px, 1.48vh, 16px);
        }

        .field label {
            display: block;
            font-size: clamp(11px, 0.65vw, 12.5px);
            font-weight: 600;
            color: #334155;
            margin-bottom: clamp(3px, 0.55vh, 6px);
            letter-spacing: .2px;
        }

        .input {
            position: relative;
            display: flex;
            align-items: center;
            border: 1.5px solid var(--line);
            border-radius: clamp(10px, 0.68vw, 13px);
            background: #ffffff !important;
            background-color: #ffffff !important;
            transition: .2s;
            overflow: hidden;
        }

        .input:focus-within {
            border-color: var(--brand-2);
            box-shadow: 0 0 0 4px rgba(11,94,215,.12);
            background: #ffffff !important;
            background-color: #ffffff !important;
        }

        .input svg.lead-ic {
            width: clamp(16px, 0.99vw, 19px);
            height: clamp(16px, 0.99vw, 19px);
            margin-left: clamp(10px, 0.78vw, 15px);
            stroke: #8a98ae;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex: none;
            transition: .2s;
            background: transparent;
        }

        .input:focus-within svg.lead-ic {
            stroke: var(--brand-2);
        }

        .input input {
            flex: 1;
            border: 0;
            outline: 0;
            background: #ffffff !important;
            background-color: #ffffff !important;
            padding: clamp(9px, 1.2vh, 13px) clamp(10px, 0.73vw, 14px);
            font: inherit;
            font-size: clamp(13px, 0.78vw, 15px);
            color: var(--ink);
            min-width: 0;
        }

        .input input:focus,
        .input input:active,
        .input input:hover {
            background: #ffffff !important;
            background-color: #ffffff !important;
            outline: none;
        }

        /* Prevent autofill & browser default styling from turning background blue/yellow/gray */
        .input input:-webkit-autofill,
        .input input:-webkit-autofill:hover,
        .input input:-webkit-autofill:focus,
        .input input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px #ffffff inset !important;
            box-shadow: 0 0 0 1000px #ffffff inset !important;
            -webkit-text-fill-color: var(--ink) !important;
            color: var(--ink) !important;
            background-color: #ffffff !important;
            background: #ffffff !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        .input input:autofill,
        .input input:autofill:hover,
        .input input:autofill:focus {
            filter: none;
            box-shadow: 0 0 0 1000px #ffffff inset !important;
            -webkit-text-fill-color: var(--ink) !important;
            background-color: #ffffff !important;
            background: #ffffff !important;
        }

        #txtusername, #txtUserPassword,
        #txtusername:focus, #txtUserPassword:focus,
        #txtusername:active, #txtUserPassword:active,
        #txtusername:-webkit-autofill, #txtUserPassword:-webkit-autofill,
        #txtusername:-webkit-autofill:hover, #txtUserPassword:-webkit-autofill:hover,
        #txtusername:-webkit-autofill:focus, #txtUserPassword:-webkit-autofill:focus,
        #txtusername:-webkit-autofill:active, #txtUserPassword:-webkit-autofill:active {
            background-color: #ffffff !important;
            background: #ffffff !important;
            -webkit-box-shadow: 0 0 0 1000px #ffffff inset !important;
            box-shadow: 0 0 0 1000px #ffffff inset !important;
            -webkit-text-fill-color: var(--ink) !important;
            color: var(--ink) !important;
        }

        .input input::placeholder {
            color: #a2aec1;
        }

        .eye {
            border: 0;
            background: #ffffff !important;
            background-color: #ffffff !important;
            cursor: pointer;
            padding: 0 clamp(10px, 0.78vw, 15px);
            height: 100%;
            display: grid;
            place-items: center;
        }

        .eye svg {
            width: clamp(16px, 0.99vw, 19px);
            height: clamp(16px, 0.99vw, 19px);
            stroke: #8a98ae;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: stroke .2s;
        }

        .eye:hover svg {
            stroke: var(--brand-2);
        }

        .field-validation-error {
            color: #b42318;
            font-size: clamp(11px, 0.625vw, 12px);
            margin-top: 4px;
            display: block;
        }

        .row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 2px 0 clamp(10px, 1.85vh, 20px);
            font-size: clamp(12px, 0.7vw, 13.5px);
        }

        .check {
            display: flex;
            align-items: center;
            gap: 9px;
            cursor: pointer;
            color: #475569;
            user-select: none;
        }

        .check input {
            appearance: none;
            width: clamp(16px, 0.94vw, 18px);
            height: clamp(16px, 0.94vw, 18px);
            border: 1.5px solid #b6c2d6;
            border-radius: 5px;
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: .15s;
            background: #fff;
            margin: 0;
        }

        .check input:checked {
            background: var(--brand-2);
            border-color: var(--brand-2);
        }

        .check input:checked::after {
            content: "";
            width: 9px;
            height: 5px;
            border: 2px solid #fff;
            border-top: 0;
            border-right: 0;
            transform: rotate(-45deg) translate(1px,-1px);
        }

        a.link {
            color: var(--brand-2);
            text-decoration: none;
            font-weight: 600;
        }

        a.link:hover {
            text-decoration: underline;
        }

        .btn {
            width: 100%;
            border: 0;
            cursor: pointer;
            color: #fff;
            font: inherit;
            font-weight: 600;
            font-size: clamp(13px, 0.81vw, 15.5px);
            padding: clamp(10px, 1.3vh, 14px) clamp(14px, 0.94vw, 18px);
            border-radius: clamp(10px, 0.68vw, 13px);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(100deg, var(--brand-2), var(--brand-3));
            box-shadow: 0 12px 26px -8px rgba(11,94,215,.55);
            transition: transform .15s, box-shadow .2s, filter .2s;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 30px -8px rgba(11,94,215,.6);
            filter: brightness(1.04);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn svg {
            width: clamp(16px, 0.99vw, 19px);
            height: clamp(16px, 0.99vw, 19px);
            stroke: #fff;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform .2s;
        }

        .btn:hover svg {
            transform: translateX(3px);
        }

        .btn.loading {
            pointer-events: none;
            opacity: .85;
        }

        .btn.loading .btn-text::after {
            content: "…";
        }

        .msg {
            display: none;
            margin-bottom: clamp(10px, 1.3vh, 14px);
            padding: clamp(8px, 1vh, 10px) clamp(10px, 0.8vw, 14px);
            border-radius: 10px;
            font-size: clamp(12px, 0.7vw, 13.5px);
            background: #fff1f0;
            color: #b42318;
            border: 1px solid #fecdca;
        }

        .msg.show {
            display: block;
        }

        .msg ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        /* ► TEXT BELOW SIGN IN (.info block) */
        .info {
            margin-top: 0;
            padding-top: clamp(8px, 1.48vh, 16px);
            border-top: 1px solid var(--line);
            text-align: center;
            line-height: 1.65;
            flex-shrink: 0;
        }

        .info .modules {
            font-size: clamp(10.5px, 0.65vw, 12.5px);
            color: #475569;
            font-weight: 500;
        }

        .info .modules .dot {
            color: var(--accent);
            font-weight: 700;
            padding: 0 4px;
        }

        .info .sys {
            margin-top: clamp(4px, 0.8vh, 10px);
            font-size: clamp(10.5px, 0.65vw, 12.5px);
            color: #64748b;
        }

        .info .sys b {
            color: var(--brand-1);
            font-weight: 700;
        }

        .info .copy {
            font-size: clamp(10px, 0.625vw, 12px);
            color: #64748b;
        }

        .info .copy a {
            color: var(--brand-2);
            font-weight: 600;
            text-decoration: none;
        }

        .info .copy a:hover {
            text-decoration: underline;
        }

        /* =========================================================
           RESPONSIVE MEDIA QUERIES (Tablets, Mobiles, Extreme Ratios)
           ========================================================= */
        @@media (max-width: 860px) {
            body {
                padding: 16px;
                align-items: safe center;
            }
            .shell {
                grid-template-columns: minmax(0, 1fr);
                height: auto;
                min-height: auto;
                max-height: none;
                width: min(94vw, 560px);
                margin: 0 auto;
                border-radius: 18px;
            }
            .hero, .panel {
                min-width: 0;
                overflow: visible;
            }
            .hero {
                padding: 24px 24px 0;
            }
            .hero::after {
                display: none;
            }
            .brand {
                margin-top: 0;
            }
            .panel {
                padding: 24px 24px 18px;
            }
            .client-logo {
                margin-bottom: 16px;
            }
            .scene {
                flex: none;
                width: calc(100% + 48px);
                height: auto;
                aspect-ratio: 800 / 310;
                margin: 14px -24px 0;
                max-height: none;
            }
            .scene svg {
                height: 100%;
            }
        }

        @@media (max-width: 520px) {
            body {
                padding: 0;
            }
            .shell {
                min-height: 100vh;
                min-height: 100dvh;
                border-radius: 0;
                border: 0;
                width: 100%;
                box-shadow: none;
            }
            .hero {
                padding: 18px 18px 0;
            }
            .features {
                grid-template-columns: 1fr;
                gap: 10px;
                margin-top: 14px;
            }
            .scene {
                width: calc(100% + 36px);
                margin: 10px -18px 0;
            }
            .panel {
                padding: 18px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>

<body>
<main class="shell">

    <!-- ===================== LEFT : BRAND / HERO ===================== -->
    <section class="hero" aria-label="Product overview">

        <!-- ► GCTL INFOSYS LOGO -->
        <div class="brand">
            <img src="@Url.Content("~/images/gctl-logo.png")" alt="GCTL Infosys"
                 onerror="this.classList.add('hide'); this.parentElement.classList.add('no-logo');">
            <div class="fallback">GCTL <span>INFOSYS</span></div>
        </div>

        <div class="badge"><i></i> Clearing &amp; Forwarding ERP &middot; 2026 Edition</div>

        <p class="hero-description">
            One unified platform to manage customs clearance, import &amp; export shipments,
            port logistics, bill of entry documentation, job costing and client invoicing —
            with real-time visibility from booking to delivery.
        </p>

        <div class="features">
            <div class="feat">
                <div class="ic">
                    <svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
                </div>
                <div><b>Customs Clearance</b><small>B/E &amp; documentation workflow</small></div>
            </div>
            <div class="feat">
                <div class="ic">
                    <svg viewBox="0 0 24 24"><path d="M3 17l2 3h14l2-3"/><path d="M5 17V11l7-3 7 3v6M12 8V3"/></svg>
                </div>
                <div><b>Port &amp; Shipping</b><small>Vessel &amp; container tracking</small></div>
            </div>
            <div class="feat">
                <div class="ic">
                    <svg viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8M12 13v8"/></svg>
                </div>
                <div><b>Import &amp; Export</b><small>End-to-end job operations</small></div>
            </div>
            <div class="feat">
                <div class="ic">
                    <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6M9 12h.01M12 12h.01M15 12h.01M9 16h.01M12 16h.01M15 16h.01"/></svg>
                </div>
                <div><b>Billing &amp; Costing</b><small>Invoicing &amp; expense tracking</small></div>
            </div>
        </div>

        <!-- ► BACKGROUND GRAPHIC (inline SVG scene with animations) -->
        <div class="scene" aria-hidden="true">
            <svg viewBox="0 0 800 330" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="sea" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#0e57b8" stop-opacity=".55"/><stop offset="1" stop-color="#061f48"/>
                    </linearGradient>
                    <linearGradient id="hull" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#1b2f55"/><stop offset="1" stop-color="#0b1730"/>
                    </linearGradient>
                </defs>

                <!-- globe + route -->
                <g opacity=".5" fill="none" stroke="#9be7ff" stroke-width="1.2">
                    <circle cx="610" cy="70" r="62"/>
                    <ellipse cx="610" cy="70" rx="26" ry="62"/>
                    <ellipse cx="610" cy="70" rx="48" ry="62"/>
                    <path d="M548 70h124M556 44h108M556 96h108"/>
                </g>
                <path d="M120 120C260 20 470 10 600 60" fill="none" stroke="#9be7ff" stroke-width="1.5" stroke-dasharray="4 6" opacity=".7"/>
                <g class="plane">
                    <g transform="translate(560 44) rotate(14)" fill="#fff">
                        <path d="M0 8L34 2 44 0 30 10 40 24 34 24 18 14 8 18 8 12z" transform="scale(.9)"/>
                    </g>
                </g>

                <!-- sky skyline / far shore -->
                <path d="M0 215h800v20H0z" fill="#0a2f6b" opacity=".6"/>

                <!-- gantry crane (right) -->
                <g fill="none" stroke="#cfe6ff" stroke-width="3.5" stroke-linecap="round" opacity=".92">
                    <path d="M700 250V120M760 250V120M700 120h60M690 120L610 120M640 120V95M620 120L700 70M700 70L760 120M700 70h-90"/>
                    <path d="M650 120v28" stroke-dasharray="3 4"/>
                </g>
                <rect x="636" y="148" width="28" height="14" rx="2" fill="#ff8a1f"/>

                <!-- container stacks on quay -->
                <g>
                    <rect x="680" y="226" width="34" height="24" fill="#ff8a1f"/>
                    <rect x="716" y="226" width="34" height="24" fill="#19b5fe"/>
                    <rect x="752" y="226" width="34" height="24" fill="#ef4444"/>
                    <rect x="698" y="202" width="34" height="24" fill="#22c55e"/>
                    <rect x="734" y="202" width="34" height="24" fill="#ff8a1f"/>
                </g>

                <!-- ship -->
                <g class="float">
                    <!-- bridge -->
                    <rect x="455" y="170" width="52" height="42" rx="3" fill="#e8f1ff"/>
                    <rect x="462" y="178" width="38" height="7" fill="#0b5ed7"/>
                    <rect x="462" y="192" width="38" height="5" fill="#0b5ed7" opacity=".6"/>
                    <rect x="474" y="152" width="14" height="18" fill="#cfe0f7"/>
                    <!-- containers -->
                    <g>
                        <rect x="130" y="186" width="40" height="26" fill="#ff8a1f"/>
                        <rect x="172" y="186" width="40" height="26" fill="#19b5fe"/>
                        <rect x="214" y="186" width="40" height="26" fill="#ef4444"/>
                        <rect x="256" y="186" width="40" height="26" fill="#f5c518"/>
                        <rect x="298" y="186" width="40" height="26" fill="#19b5fe"/>
                        <rect x="340" y="186" width="40" height="26" fill="#22c55e"/>
                        <rect x="382" y="186" width="40" height="26" fill="#ff8a1f"/>

                        <rect x="172" y="160" width="40" height="26" fill="#22c55e"/>
                        <rect x="214" y="160" width="40" height="26" fill="#19b5fe"/>
                        <rect x="256" y="160" width="40" height="26" fill="#ff8a1f"/>
                        <rect x="298" y="160" width="40" height="26" fill="#ef4444"/>
                        <rect x="340" y="160" width="40" height="26" fill="#f5c518"/>

                        <rect x="214" y="134" width="40" height="26" fill="#ef4444"/>
                        <rect x="256" y="134" width="40" height="26" fill="#19b5fe"/>
                        <rect x="298" y="134" width="40" height="26" fill="#22c55e"/>
                    </g>
                    <!-- hull -->
                    <path d="M96 212H540L506 258H132Z" fill="url(#hull)"/>
                    <path d="M104 224H532" stroke="#ff8a1f" stroke-width="4"/>
                </g>

                <!-- sea -->
                <rect y="250" width="800" height="80" fill="url(#sea)"/>
                <g class="wave" fill="none" stroke="#9be7ff" stroke-width="2" opacity=".45" stroke-linecap="round">
                    <path d="M-80 266q20-10 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0"/>
                    <path d="M-60 290q20-10 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0"/>
                </g>

                <!-- truck on quay -->
                <g transform="translate(560 232)">
                    <rect x="0" y="0" width="64" height="30" rx="3" fill="#e8f1ff"/>
                    <path d="M64 8h18l10 12v10H64z" fill="#19b5fe"/>
                    <rect x="70" y="12" width="12" height="8" fill="#0a2a5e" opacity=".7"/>
                    <circle cx="16" cy="32" r="6" fill="#0a1a38"/>
                    <circle cx="50" cy="32" r="6" fill="#0a1a38"/>
                    <circle cx="82" cy="32" r="6" fill="#0a1a38"/>
                </g>
                <rect y="262" width="800" height="3" fill="#fff" opacity=".08"/>
            </svg>
        </div>
    </section>

    <!-- ===================== RIGHT : LOGIN ===================== -->
    <section class="panel" aria-label="Sign in">

        <!-- ► FORMOSA LOGO (top right) -->
        <div class="client-logo">
            <div>
                <img src="@Url.Content("~/images/Formosa.png")" alt="Formosa"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
                <div class="fallback">FORMOSA</div>
            </div>
        </div>

        <h2>Welcome Back 👋</h2>
        <p class="sub">Sign in to access your C&amp;F Management System</p>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm" autocomplete="on">
            @Html.AntiForgeryToken()

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="msg show" style="background:#ecfdf5; color:#065f46; border-color:#a7f3d0;" role="status">
                    <i class="fas fa-circle-check" style="margin-right:6px;"></i>@TempData["SuccessMessage"]
                </div>
            }
            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="msg show" style="background:#fff3cd; color:#856404; border-color:#ffeeba;" role="alert">
                    <i class="fas fa-clock" style="margin-right:6px;"></i>@ViewData["ErrorMessage"]
                </div>
            }
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="msg show" role="alert">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <div class="field">
                <label for="txtusername">Username</label>
                <div class="input">
                    <svg class="lead-ic" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                    <input asp-for="Email" id="txtusername" name="Email" type="text" placeholder="Enter your username" autocomplete="username" required autofocus />
                </div>
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label for="txtUserPassword">Password</label>
                <div class="input">
                    <svg class="lead-ic" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                    <input asp-for="Password" id="txtUserPassword" name="Password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                    <button type="button" class="eye" id="eye" aria-label="Show password">
                        <svg id="eyeIcon" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="row">
                <label class="check">
                    <input asp-for="RememberMe" type="checkbox" id="remember" name="RememberMe" />
                    <span>Remember me</span>
                </label>
                <a href="#" id="forgotPassword" class="link">Forgot password?</a>
            </div>

            <button class="btn" type="submit" id="btn">
                <span class="btn-text">Sign In</span>
                <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
        </form>

        <!-- ► TEXT BELOW SIGN IN -->
        <div class="info">
            <div class="modules">
                Customs Clearance <span class="dot">&middot;</span> Import &amp; Export <span class="dot">&middot;</span> Port Logistics<br>
                Job Costing <span class="dot">&middot;</span> Billing <span class="dot">&middot;</span> Financial Accounting Management
            </div>
            <div class="sys"><b>C &amp; F Management System</b> &nbsp;|&nbsp; Version 2026</div>
            <div class="copy">Copyright &copy; 2026 <a href="https://gctlinfosys.com/" target="_blank">GCTL Infosys</a>. All rights reserved.</div>
        </div>
    </section>

</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script>
    // Show / Hide Password
    const pw = document.getElementById('txtUserPassword');
    const eyeBtn = document.getElementById('eye');
    const eyeIcon = document.getElementById('eyeIcon');

    if (eyeBtn && pw) {
        eyeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const isPassword = pw.type === 'password';
            pw.type = isPassword ? 'text' : 'password';
            eyeBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
            if (isPassword) {
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
            } else {
                eyeIcon.innerHTML = '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>';
            }
        });
    }

    // Forgot Password
    $('#forgotPassword').on('click', function (e) {
        e.preventDefault();
        var username = $.trim($('#txtusername').val());
        if (!username) {
            alert('Please enter your username first.');
            $('#txtusername').focus();
            return;
        }
        window.location.href = '/ForgotPassword?username=' + encodeURIComponent(username);
    });

    // Button loading state on submit
    const loginForm = document.getElementById('loginForm');
    const loginBtn = document.getElementById('btn');
    if (loginForm && loginBtn) {
        loginForm.addEventListener('submit', function () {
            if ($(loginForm).valid && !$(loginForm).valid()) {
                return;
            }
            loginBtn.classList.add('loading');
        });
    }
</script>
</body>
</html>
