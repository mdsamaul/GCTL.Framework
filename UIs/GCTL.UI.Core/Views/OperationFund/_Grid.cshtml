<style>
    /* Fieldset and Table Header Styling */
    fieldset {
        border: 1px solid #dee2e6 !important;
    }

    .table thead th {
        font-size: 0.85rem !important;
        font-weight: 700 !important;
        background-color: #f8f9fa !important;
        color: #333;
        border-bottom: 2px solid #dee2e6 !important;
    }

    .page-link:focus {
        box-shadow: none;
    }

    #Job-tbody td {
        color: #000 !important;
        font-size: 0.75rem;
        font-weight: 700;
    }

    /* Radio Button Styling */
    .job-radio {
        width: 15px;
        height: 15px;
        cursor: pointer; /* hover এ pointer */
        accent-color: #0d6efd; /* modern browsers এ check color (Bootstrap primary blue) */
        margin: 0 auto; /* center align */
    }

        /* Optional: hover effect */
        .job-radio:hover {
            transform: scale(1.2);
        }

        /* Optional: checked effect */
        .job-radio:checked {
            border: 2px solid #0d6efd;
            box-shadow: 0 0 3px #0d6efd;
        }

</style>
<div class="container-fluid py-0">
    <fieldset class="border rounded p-3 bg-white shadow-sm">
        <legend class="float-none w-auto px-2 fw-bold text-secondary small">Job Entry List</legend>
        <div class="row mb-2">
            <div class="col-12">
                <span class="text-dark fw-bold" style="font-size: 0.8rem; border-bottom: 2px solid #0d6efd; padding-bottom: 2px;">
                    <i class="fas fa-filter me-1"></i> Filter By
                </span>
            </div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6 col-lg-4 d-flex align-items-center">
                <label class="fw-bold me-2 mb-0" style="flex: 0 0 80px; font-size:0.85rem;">Customer</label>
                <select class="form-select form-select-sm" id="Customer"></select>
            </div>

            <div class="col-md-6 col-lg-4 d-flex align-items-center">
                <label class="fw-bold me-2 mb-0" style="flex: 0 0 80px; font-size:0.85rem;">Shipment Mode</label>
                <select class="form-select form-select-sm" id="Job-ShipmentMode">
                </select>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center" style="font-size:0.85rem;">
                <span class="text-secondary">Show</span>
                <select class="form-select form-select-sm mx-2" style="width: 80px !important;" id="Job-PageSize">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="-1">All</option>
                </select>
                <span class="text-secondary">Entries</span>
            </div>

            <div class="d-flex align-items-center" style="font-size:0.85rem;">
                <label class="me-2 mb-0 fw-bold">Search:</label>
                <input type="search" class="form-control form-control-sm" placeholder="Search here.." style="width:250px;" id="Job-SearchInput">
            </div>
        </div>

        <div class="table-responsive border rounded mb-3">
            <table class="table table-sm table-bordered table-striped table-hover align-middle mb-0 text-nowrap" id="JobTable">
                <thead class="table-light">
                    <tr class="small align-middle">
                        <th class="text-center fw-bold py-1" style="width:3%">
                            <div class="d-flex flex-column align-items-center justify-content-center">
                                <span class="mb-1">Sel</span>
                                <input type="radio" class="form-check-input m-0 shadow-none" disabled>
                            </div>
                        </th>

                        <th class="fw-bold px-1" data-column="JobNo" style="width:30%">
                            <div class="d-flex align-items-center justify-content-start">
                                <span>Job No.</span>
                                <i class="fas fa-sort sort-icon ms-1"></i>
                            </div>
                        </th>
                        <th class="fw-bold px-1 text-center" data-column="JobDate" style="width:10%">
                            <div class="d-flex align-items-center justify-content-center">
                                <span>Job Date</span>
                                <i class="fas fa-sort sort-icon ms-1"></i>
                            </div>
                        </th>
                        <th class="fw-bold px-1 text-center" data-column="ShipmentMode" style="width:15%">
                            <div class="d-flex align-items-center justify-content-center">
                                <span>Shipment Mode</span>
                                <i class="fas fa-sort sort-icon ms-1"></i>
                            </div>
                        </th>
                        <th class="fw-bold px-1" data-column="Customer" style="width:30%">
                            <div class="d-flex align-items-center justify-content-start">
                                <span>Customer Name</span>
                                <i class="fas fa-sort sort-icon ms-1"></i>
                            </div>
                        </th>
                        <th class="fw-bold px-1 text-center" data-column="DocReceivedDate" style="width:12%">
                            <div class="d-flex align-items-center justify-content-center">
                                <span>Doc Received Date</span>
                                <i class="fas fa-sort sort-icon ms-1"></i>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody class="small" id="Job-tbody">
                </tbody>
            </table>
        </div>

        <div class="row align-items-center">
            <div class="col-sm-6 text-center text-sm-start mb-2 mb-sm-0">
                <small class="text-muted Job-Pagination-message"></small>
            </div>
            <div class="col-sm-6">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0 justify-content-center justify-content-sm-end" id="Job-Pagination">
                    </ul>
                </nav>
            </div>
        </div>

    </fieldset>
</div>