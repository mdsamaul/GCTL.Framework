<style>
    /* Fieldset and Table Header Styling */
    fieldset {
        border: 1px solid #dee2e6 !important;
    }

    .page-link:focus {
        box-shadow: none;
    }

    #Job-tbody td {
        color: #000 !important;
        font-size: 13px;
        font-weight: 700;
    }

    /* Radio Button Styling */
    .job-radio {
        width: 15px;
        height: 15px;
        cursor: pointer; /* hover এ pointer */
        accent-color: #0d6efd; /* modern browsers এ check color (Bootstrap primary blue) */
        margin: 0 auto; /* center align */
    }

        /* Optional: hover effect */
        .job-radio:hover {
            transform: scale(1.2);
        }

        /* Optional: checked effect */
        .job-radio:checked {
            border: 2px solid #0d6efd;
            box-shadow: 0 0 3px #0d6efd;
        }

</style>
<div class="row mb-2">
    <div class="col-12">
        <span class="text-dark" style="font-size: 13px; border-bottom: 2px solid #0d6efd; padding-bottom: 2px;">
            <i class="fas fa-filter me-1"></i> Filter By
        </span>
    </div>
</div>
<div class="row g-5">
    <div class="col-lg-4">
        <div class="row align-items-center gx-2">
            <label class="col-auto col-form-label fw-semibold">
                Customer
            </label>
            <div class="col">
                <select id="Customer" class="form-select form-select-sm"></select>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="row align-items-center gx-2">
            <label class="col-auto col-form-label fw-semibold">
                Shipment Mode
            </label>
            <div class="col">
                <select id="Job-ShipmentMode" class="form-select form-select-sm"></select>
            </div>
        </div>
    </div>
</div>

@* <div class="table-responsive px-0"> *@
    @await Html.PartialAsync("_CustomGrid", new GridModel
    {
        GridId = "JobTable",
        AjaxUrl = "/OperationFund/GetAllJobList",
        AjaxMethod = "POST",
        ServerSide = true,
        UseRadio = true,
        RadioName = "jobSelect",
        CheckColumnData = "jobNo",
        DefaultSortColumn = "jobDate",
        DefaultSortDirection = "desc",
        CustomGridWrapper = false,
        Columns = new()
    {
        new() { Data = "jobNo", Header = "Job No.", Width = "8%", Align = "left" },
        new() { Data = "jobDate", Header = "Job Date", Width = "8%", RenderFn = "formatDate" },
        new() { Data = "shipmentMode", Header = "Shipment Mode", Width = "12%" },
        new() { Data = "customer", Header = "Customer", Width = "18%", Align = "left" },
        new() { Data = "customerAddress", Header = "Address", Width = "27%", Align = "left" },
        new() { Data = "docReceivedDate", Header = "Doc Received Date", Width = "8%", RenderFn = "formatDate" },
        new() {  Data = "invoice", Header = "Invoice No.", Width = "10%", Align = "left" },
        new() { Data = "beno", Header = "B/E No.", Width = "9%", Align = "left", IsWrapable = false }
    }
    })
