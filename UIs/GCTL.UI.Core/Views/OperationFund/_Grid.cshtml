<style>
    /* Fieldset and Table Header Styling */
    fieldset {
        border: 1px solid #dee2e6 !important;
    }

    .table thead th {
        font-size: 0.85rem !important;
        font-weight: 700 !important;
        background-color: #f8f9fa !important;
        color: #333;
        border-bottom: 2px solid #dee2e6 !important;
    }

    .page-link:focus {
        box-shadow: none;
    }

    #Job-tbody td {
        color: #000 !important;
        font-size: 0.75rem;
        font-weight: 700;
    }

    /* Radio Button Styling */
    .job-radio {
        width: 15px;
        height: 15px;
        cursor: pointer; /* hover এ pointer */
        accent-color: #0d6efd; /* modern browsers এ check color (Bootstrap primary blue) */
        margin: 0 auto; /* center align */
    }

        /* Optional: hover effect */
        .job-radio:hover {
            transform: scale(1.2);
        }

        /* Optional: checked effect */
        .job-radio:checked {
            border: 2px solid #0d6efd;
            box-shadow: 0 0 3px #0d6efd;
        }

    div.dt-layout-end,
    div.dt-layout-full,
    div.dt-layout-start {
        padding: 0;
    }
</style>
<div class="row mb-2">
    <div class="col-12">
        <span class="text-dark fw-bold" style="font-size: 0.8rem; border-bottom: 2px solid #0d6efd; padding-bottom: 2px;">
            <i class="fas fa-filter me-1"></i> Filter By
        </span>
    </div>
</div>
<div class="row g-3 mb-0">
    <div class="col-md-6 col-lg-4 d-flex align-items-center">
        <label class="fw-bold me-2 mb-0" style="flex: 0 0 80px; font-size:0.85rem;">Customer</label>
        <select class="form-select form-select-sm" id="Customer"></select>
    </div>

    <div class="col-md-6 col-lg-4 d-flex align-items-center">
        <label class="fw-bold me-2 mb-0" style="flex: 0 0 80px; font-size:0.85rem;">Shipment Mode</label>
        <select class="form-select form-select-sm" id="Job-ShipmentMode">
        </select>
    </div>
</div>

@* <div class="table-responsive px-0"> *@
    @await Html.PartialAsync("_CustomGrid", new GridModel
    {
        GridId = "JobTable",
        AjaxUrl = "/OperationFund/GetAllJobList",
        ServerSide = true,
        UseRadio = true,
        RadioName = "jobSelect",
        CheckColumnData = "jobNo",
        DefaultSortColumn = "jobNo",
        Columns = new()
    {
        new() { Data = "jobNo", Header = "Job No.", Width = "30%", Align = "left" },
        new() { Data = "jobDate", Header = "Job Date", Width = "10%", RenderFn = "formatDate" },
        new() { Data = "shipmentMode", Header = "Shipment Mode", Width = "15%" },
        new() { Data = "customer", Header = "Customer Name", Width = "30%", Align = "left" },
        new() { Data = "docReceivedDate", Header = "Doc Received Date", Width = "12%", RenderFn = "formatDate" }
    }
    })
