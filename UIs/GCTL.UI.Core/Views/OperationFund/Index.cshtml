 @* @model GCTL.UI.Core.ViewModels.EmployeeNonInvestmentEntry.EmployeeNonInvestmentPageViewModel *@

@* @{
    Model.Breadcrumb = "EmployeeNonInvestmentEntry";
    Model.PageTitle = "Employee Non Investment Entry";
} *@

<style>
    #employee-filter-grid tbody tr td:first-child {
        width: 5%;
        padding: 0;
    }

    #employee-filter-grid thead th:first-child {
        width: 5%;
    }

    th.no-sort::after,
    th.no-sort::before {
        display: none !important;
    }

    .single-row-form .row {
        flex-wrap: nowrap !important;
    }

    .single-row-form .col-equal {
        flex: 1;
        min-width: 0;
        max-width: none;
        display: flex;
        flex-direction: column;
    }

    .single-row-form .label-container {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.5rem;
        padding: 0.25rem;
    }

    .single-row-form .form-label {
        margin: 0;
        font-size: 13px;
        text-align: start;
        word-wrap: break-word;
        hyphens: auto;
    }

    .single-row-form .form-control,
    .single-row-form .form-select {
        flex: 1;
    }


    /* Flat Design */
    .custom-fieldset,
    .custom-fieldset:hover,
    .card,
    .card:hover,
    .btn,
    .btn:hover,
    .form-control,
    .form-select,
    .table {
        box-shadow: none !important;
        transform: none !important;
    }

    .custom-fieldset {
        position: relative;
        border: 1px solid #e2e8f0 !important;
        border-radius: 4px;
        padding: 18px 14px 12px 14px;
        margin-top: 20px !important;
        margin-bottom: 20px !important;
        background-color: #fff;
    }

    .custom-fieldset legend {
        position: absolute;
        top: -11px;
        left: 14px;
        background-color: #fff;
        padding: 0 8px;
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 3px;
        width: auto;
        margin-bottom: 0;
    }

    thead th,
    div.dt-container table.dataTable thead th,
    .custom-grid-table thead th {
        background: #f8fafc !important;
        background-image: none !important;
        color: #334155 !important;
        font-size: 12.5px;
        font-weight: 600;
        border-bottom: 1px solid #e2e8f0 !important;
        border-top: none !important;
    }

    .bottom-nav .card {
        box-shadow: none !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 4px !important;
    }
</style>

<div class="container-fluid p-0">
    @* <div class="card rounded">
        <div class="card-header bg-white px-2">
            <partial name="_Toolbars" ></partial>
        </div>
    </div> *@
    @* <partial name="_Toolbars" /> *@
    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
        Title = "Operational Fund Requisition Entry",
        SaveBtnId = "Req-SaveBtn",
        DeleteBtnId = "Req-DeleteBtn",
        ClearBtnId = "Req-Clear"
    })
    <fieldset class="custom-fieldset card p-2 pt-4">
        <legend class="float-none w-auto px-2 fw-bold text-secondary small">Job Entry List</legend>
        <partial name="_Grid" />
    </fieldset>

    <fieldset class="custom-fieldset card p-2">
        <partial name="_Setup" />
    </fieldset>

    <fieldset class="custom-fieldset card p-2 mb-0">
        <partial name="_nonInvGrid" />
    </fieldset>

    <partial name="_bottomNavigation"/>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <script src="~/js/pages/OperationalFund/fundform.js"></script>
    <script src="~/js/pages/OperationalFund/requisitionEntry.js"></script>
    <script src="~/js/pages/OperationalFund/tmpDetails.js"></script>

}
