@model GCTL.Core.ViewModels.ForgotPasswords.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset Password - C & F Management System";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="~/images/CoIcon.ico" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --gctl-logo-h: 70px;
            --formosa-logo-h: 58px;
            --brand-1: #0a2a5e;
            --brand-2: #0b5ed7;
            --brand-3: #19b5fe;
            --accent: #ff8a1f;
            --ink: #0f1b33;
            --muted: #64748b;
            --line: #dbe3ef;
            --bg: #eef3fa;
            --card: #ffffff;
            --radius: 22px;
            --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
            --font-head: 'Poppins', 'Inter', system-ui, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100%;
            overflow-x: hidden;
            overflow-y: auto;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            font-family: var(--font-body);
            color: var(--ink);
            background-color: #ffffff;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            -webkit-font-smoothing: antialiased;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: 0;
            background-image: url('@Url.Content("~/images/login-bg.jpg?v=5")');
            background-position: center center;
            background-repeat: no-repeat;
            background-size: cover;
            opacity: 0.10;
            pointer-events: none;
        }

        /* ---------- Main shell (always fits inside the browser window) ---------- */
        .shell {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 1180px;
            min-height: min(calc(100vh - 32px), 780px);
            min-height: min(calc(100dvh - 32px), 780px);
            display: grid;
            grid-template-columns: 1.12fr .88fr;
            background: var(--card);
            border-radius: var(--radius);
            overflow: hidden;
            border: 1px solid #e2e8f0;
            box-shadow: 0 30px 80px -20px rgba(10, 42, 94, .35), 0 8px 24px rgba(10, 42, 94, .08);
            animation: rise .7s cubic-bezier(.2, .8, .2, 1) both;
            position: relative;
        }

        @@keyframes rise {
            from {
                opacity: 0;
                transform: translateY(12px) scale(.99);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* =========================================================
           LEFT — HERO / VERIFICATION PANEL
           ========================================================= */
        .hero {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            min-height: 0;
            color: #fff;
            padding: clamp(20px, 3vh, 32px) 48px 0;
            background: linear-gradient(155deg, var(--brand-1) 0%, #0a3f8f 48%, var(--brand-2) 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            opacity: .18;
            background-image: radial-gradient(#fff 1.1px, transparent 1.2px);
            background-size: 22px 22px;
            mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
            -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 520px;
            height: 520px;
            right: -160px;
            top: -160px;
            z-index: -1;
            background: radial-gradient(circle, rgba(25, 181, 254, .45), transparent 65%);
        }

        /* Background graphic (inline SVG scene) — fills whatever height is left */
        .scene {
            /* flex: 1;
            min-height: 140px;
            margin-top: 10px;
            margin-inline: -48px;
            line-height: 0;
            position: relative;
            z-index: 0; */
             /* margin-top: 105px; */
            margin-inline: -48px;
            line-height: 0;
            position: relative;
            z-index: 0;
        }

        .scene svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        .float { animation: float 6s ease-in-out infinite; }
        .plane { animation: fly 9s linear infinite; }
        @@keyframes float { 50% { transform: translateY(-5px); } }
        @@keyframes fly { from { transform: translate(-40px, 18px); } to { transform: translate(40px, -18px); } }
        .wave { animation: wave 7s linear infinite; }
        @@keyframes wave { to { transform: translateX(-80px); } }

        /* ► GCTL INFOSYS LOGO */
        .brand {
            display: block;
            align-items: center;
            /* background: #ffffff; */
            /* padding: 6px 14px;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, .14);
            margin-bottom: clamp(10px, 1.8vh, 16px);
            width: fit-content;
            transition: transform .2s ease;
            border:1px solid #33507d;
            opacity:60%; */
            margin-top:50px;
            margin-bottom:20px;
        }
       

        .brand:hover {
            transform: translateY(-1px);
        }

        .brand img {
            height: var(--gctl-logo-h);
            width: auto;
            max-width: 100%;
            object-fit: contain;
            display: block;
        }

        .brand.no-logo img {
            display: none;
        }

        .brand .fallback {
            display: none;
            font-family: var(--font-head);
            font-weight: 800;
            font-size: 19px;
            letter-spacing: .5px;
            color: #0a2a5e;
        }

        .brand .fallback span {
            color: #ff8a1f;
        }

        .brand.no-logo .fallback {
            display: block;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, .1);
            border: 1px solid rgba(255, 255, 255, .18);
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 11.5px;
            font-weight: 600;
            letter-spacing: .4px;
            color: #e2eeff;
            backdrop-filter: blur(8px);
            width: fit-content;
        }

        .badge i {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, .35);
            display: inline-block;
        }

        .hero h2 {
            font-family: var(--font-head);
            font-size: clamp(22px, 2.8vh, 28px);
            font-weight: 700;
            margin-top: 10px;
            letter-spacing: -.3px;
            color: #ffffff;
        }

        .hero-description {
            font-size: 13.5px;
            line-height: 1.6;
            color: rgba(255, 255, 255, .9);
            font-weight: 400;
            margin-top: 6px;
            margin-bottom: clamp(12px, 2vh, 18px);
        }

        /* Verification Method Tabs */
        .method-tabs {
            display: flex;
            background: rgba(0, 0, 0, .22);
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 12px;
            padding: 4px;
            gap: 4px;
            margin-bottom: clamp(12px, 2vh, 18px);
        }

        .method-tab {
            flex: 1;
            text-align: center;
        }

        .method-tab input[type="radio"] {
            display: none;
        }

        .method-tab label {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            color: rgba(255, 255, 255, .82);
            user-select: none;
        }

        .method-tab label i {
            font-size: 14px;
        }

        .method-tab input[type="radio"]:checked + label {
            background: #ffffff;
            color: var(--brand-1);
            box-shadow: 0 4px 14px rgba(0, 0, 0, .18);
        }

        .hero-field {
            margin-bottom: 14px;
        }

        .hero-field label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: #e0edff;
            margin-bottom: 6px;
            letter-spacing: .2px;
        }

        .hero-input {
            position: relative;
            display: flex;
            align-items: center;
            border: 1.5px solid rgba(255, 255, 255, .25);
            border-radius: 13px;
            background: #ffffff !important;
            background-color: #ffffff !important;
            transition: .2s;
            overflow: hidden;
            box-shadow: 0 4px 14px rgba(0, 0, 0, .12);
        }

        .hero-input:focus-within {
            border-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(255, 255, 255, .3);
        }

        .hero-input svg.lead-ic {
            width: 19px;
            height: 19px;
            margin-left: 15px;
            stroke: #8a98ae;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex: none;
            transition: .2s;
        }

        .hero-input input {
            flex: 1;
            border: 0;
            outline: 0;
            background: #ffffff !important;
            background-color: #ffffff !important;
            padding: 13px 14px;
            font: inherit;
            font-size: 14.5px;
            color: var(--ink);
            min-width: 0;
        }

        .hero-input input::placeholder {
            color: #94a3b8;
        }

        /* Send OTP Button */
        .btn-send-otp {
            width: 100%;
            padding: 13px 18px;
            background: #ffffff;
            color: var(--brand-1);
            border: none;
            border-radius: 13px;
            font: inherit;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .18);
        }

        .btn-send-otp:hover:not(:disabled) {
            background: #f0f7ff;
            color: var(--brand-2);
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(0, 0, 0, .24);
        }

        .btn-send-otp:disabled {
            opacity: .75;
            cursor: not-allowed;
            transform: none;
        }

        /* Status Alert inside Left Panel */
        .left-status-box {
            margin-top: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.45;
            display: none;
        }

        .left-status-box.success {
            background: rgba(34, 197, 94, .2);
            border: 1px solid rgba(134, 239, 172, .6);
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .left-status-box.error {
            background: rgba(239, 68, 68, .25);
            border: 1px solid rgba(254, 202, 202, .6);
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .secure-code-info {
            background: rgba(255, 255, 255, .12);
            border: 1px solid rgba(255, 255, 255, .2);
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 13px;
            line-height: 1.5;
            color: #ffffff;
            margin-top: 6px;
            display: none;
        }

        .hero-footer {
            font-size: 12px;
            color: rgba(255, 255, 255, .75);
            margin-top: clamp(14px, 2.5vh, 24px);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .hero-footer b {
            color: #ffffff;
        }

        /* =========================================================
           RIGHT — SET PASSWORD PANEL
           ========================================================= */
        .panel {
            position: relative;
            min-height: 0;
            padding: clamp(20px, 3.8vh, 42px) 52px clamp(16px, 2.5vh, 24px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: linear-gradient(180deg, #fff 0%, #f9fbff 100%);
        }

        /* ► FORMOSA LOGO — right side */
        .client-logo {
            position: absolute;
            top: clamp(18px, 3.4vh, 36px);
            left: 52px;
            right: 52px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin: 0;
        }

        .client-logo img {
            height: var(--formosa-logo-h);
            width: auto;
            max-width: 100%;
            object-fit: contain;
            display: block;
        }

        .client-logo .fallback {
            display: none;
            font-family: var(--font-head);
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 3px;
            color: var(--brand-1);
        }

        .panel h2 {
            font-family: var(--font-head);
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -.3px;
            color: var(--ink);
        }

        .panel .sub {
            color: var(--muted);
            font-size: 14px;
            margin-top: 6px;
        }

        form {
            margin-top: clamp(12px, 2.2vh, 22px);
        }

        .field {
            margin-bottom: clamp(10px, 1.8vh, 15px);
        }

        .field label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
            letter-spacing: .2px;
        }

        .input {
            position: relative;
            display: flex;
            align-items: center;
            border: 1.5px solid var(--line);
            border-radius: 13px;
            background: #ffffff !important;
            background-color: #ffffff !important;
            transition: .2s;
            overflow: hidden;
        }

        .input:focus-within {
            border-color: var(--brand-2);
            box-shadow: 0 0 0 4px rgba(11, 94, 215, .12);
            background: #ffffff !important;
            background-color: #ffffff !important;
        }

        .input svg.lead-ic {
            width: 19px;
            height: 19px;
            margin-left: 15px;
            stroke: #8a98ae;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex: none;
            transition: .2s;
            background: transparent;
        }

        .input:focus-within svg.lead-ic {
            stroke: var(--brand-2);
        }

        .input input {
            flex: 1;
            border: 0;
            outline: 0;
            background: #ffffff !important;
            background-color: #ffffff !important;
            padding: 13px 14px;
            font: inherit;
            font-size: 15px;
            color: var(--ink);
            min-width: 0;
        }

        .input input:focus,
        .input input:active,
        .input input:hover {
            background: #ffffff !important;
            background-color: #ffffff !important;
            outline: none;
        }

        /* Prevent autofill styling */
        .input input:-webkit-autofill,
        .input input:-webkit-autofill:hover,
        .input input:-webkit-autofill:focus,
        .input input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px #ffffff inset !important;
            box-shadow: 0 0 0 1000px #ffffff inset !important;
            -webkit-text-fill-color: var(--ink) !important;
            color: var(--ink) !important;
            background-color: #ffffff !important;
            background: #ffffff !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        .input input:autofill,
        .input input:autofill:hover,
        .input input:autofill:focus {
            filter: none;
            box-shadow: 0 0 0 1000px #ffffff inset !important;
            -webkit-text-fill-color: var(--ink) !important;
            background-color: #ffffff !important;
            background: #ffffff !important;
        }

        .input input::placeholder {
            color: #a2aec1;
        }

        .eye {
            border: 0;
            background: #ffffff !important;
            background-color: #ffffff !important;
            cursor: pointer;
            padding: 0 15px;
            height: 100%;
            display: grid;
            place-items: center;
        }

        .eye svg {
            width: 19px;
            height: 19px;
            stroke: #8a98ae;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: stroke .2s;
        }

        .eye:hover svg {
            stroke: var(--brand-2);
        }

        .field-validation-error,
        .validation-error {
            color: #b42318;
            font-size: 12px;
            margin-top: 4px;
            display: block;
        }

        /* ► BUTTON (same as login) */
        .btn {
            width: 100%;
            border: 0;
            cursor: pointer;
            color: #fff;
            font: inherit;
            font-weight: 600;
            font-size: 15.5px;
            padding: 14px 18px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(100deg, var(--brand-2), var(--brand-3));
            box-shadow: 0 12px 26px -8px rgba(11, 94, 215, .55);
            transition: transform .15s, box-shadow .2s, filter .2s;
            margin-top: 8px;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 30px -8px rgba(11, 94, 215, .6);
            filter: brightness(1.04);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn svg {
            width: 19px;
            height: 19px;
            stroke: #fff;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform .2s;
        }

        .btn:hover svg {
            transform: translateX(3px);
        }

        .btn.loading {
            pointer-events: none;
            opacity: .85;
        }

        .btn.loading .btn-text::after {
            content: "…";
        }

        .msg {
            display: none;
            margin-bottom: 14px;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13.5px;
            background: #fff1f0;
            color: #b42318;
            border: 1px solid #fecdca;
        }

        .msg.show {
            display: block;
        }

        .back-link {
            text-align: center;
            margin-top: clamp(14px, 2.2vh, 20px);
        }

        .back-link a {
            color: var(--brand-2);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: color .2s;
        }

        .back-link a:hover {
            text-decoration: underline;
        }

        /* ► TEXT BELOW SIGN IN (.info block) */
        .info {
            margin-top: clamp(14px, 2.8vh, 26px);
            padding-top: clamp(10px, 1.8vh, 16px);
            border-top: 1px solid var(--line);
            text-align: center;
            line-height: 1.7;
        }

        .info .modules {
            font-size: 12px;
            color: #475569;
            font-weight: 500;
        }

        .info .modules .dot {
            color: var(--accent);
            font-weight: 700;
            padding: 0 4px;
        }

        .info .sys {
            margin-top: clamp(6px, 1.2vh, 10px);
            font-size: 12px;
            color: #64748b;
        }

        .info .sys b {
            color: var(--brand-1);
            font-weight: 700;
        }

        .info .copy {
            font-size: 11.5px;
            color: #64748b;
        }

        .info .copy a {
            color: var(--brand-2);
            font-weight: 600;
            text-decoration: none;
        }

        .info .copy a:hover {
            text-decoration: underline;
        }

        /* =========================================================
           RESPONSIVE — Proportional across ALL devices
           ========================================================= */
        @@media (max-height: 760px) {
            :root {
                --gctl-logo-h: 52px;
                --formosa-logo-h: 46px;
            }
            .hero {
                padding: 20px 36px 16px;
            }
            .panel {
                padding: 20px 42px 16px;
            }
            .panel h2 {
                font-size: 24px;
            }
            .client-logo {
                top: 18px;
            }
            .input input, .hero-input input {
                padding: 10px 12px;
                font-size: 14px;
            }
            .btn {
                padding: 11px 16px;
                font-size: 14.5px;
            }
        }

        @@media (max-width: 860px) {
            body {
                padding: 16px;
                align-items: safe center;
            }
            .shell {
                grid-template-columns: minmax(0, 1fr);
                grid-template-rows: auto auto;
                border-radius: 18px;
                min-height: auto;
                max-width: 560px;
                margin: 0 auto;
                overflow: hidden;
            }
            .hero, .panel {
                min-width: 0;
            }
            .hero {
                min-height: auto;
                padding: 24px 24px 0;
            }
            .hero::after {
                display: none;
            }
            .scene {
                width: calc(100% + 48px);
                margin: 10px -24px 0;
                min-height: 150px;
            }
            .panel {
                padding: 24px 24px 20px;
            }
            .client-logo {
                position: static;
                margin-bottom: 16px;
                justify-content: flex-end;
            }
            .panel h2 {
                font-size: 24px;
            }
        }

        @@media (max-width: 480px) {
            body {
                padding: 0;
            }
            .shell {
                min-height: 100vh;
                min-height: 100dvh;
                border-radius: 0;
                border: 0;
            }
            .hero {
                padding: 20px 18px 0;
            }
            .scene {
                width: calc(100% + 36px);
                margin: 10px -18px 0;
                min-height: 130px;
            }
            .panel {
                padding: 20px 18px;
            }
        }
    </style>
</head>

<body>
<main class="shell">

    <!-- ===================== LEFT : VERIFICATION CHANNEL ===================== -->
    <section class="hero" aria-label="Identity Verification">
        <div class="hero-top">
            <!-- ► GCTL INFOSYS LOGO -->
            <div class="brand">
                <img src="@Url.Content("~/images/gctl-logo.png")" alt="GCTL Infosys"
                     onerror="this.classList.add('hide'); this.parentElement.classList.add('no-logo');">
                <div class="fallback">GCTL <span>INFOSYS</span></div>
            </div>

            <div class="badge"><i></i> Password Assistance &middot; 2026 Edition</div>

            <h2>Account Recovery 🛡️</h2>
            <p class="hero-description">
                Choose your verification channel and provide your username to receive a security code.
            </p>

            <!-- Verification Method Tabs -->
            <div class="method-tabs">
                <div class="method-tab">
                    <input type="radio" id="tabOtp" name="ResetMethodSelector" value="otp" @(Model.ResetMethod == "otp" ? "checked" : "") />
                    <label for="tabOtp"><i class="fas fa-envelope-open-text"></i> Email OTP</label>
                </div>
                <div class="method-tab">
                    <input type="radio" id="tabSecureCode" name="ResetMethodSelector" value="secureCode" @(Model.ResetMethod == "secureCode" ? "checked" : "") />
                    <label for="tabSecureCode"><i class="fas fa-key"></i> Secure Code</label>
                </div>
            </div>

            <!-- Username Input (on left) -->
            <div class="hero-field">
                <label for="leftUsername">Username</label>
                <div class="hero-input">
                    <svg class="lead-ic" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                    <input type="text" id="leftUsername" value="@Model.Username" placeholder="Enter your username" autocomplete="username" autofocus required />
                </div>
            </div>

            <!-- OTP Action Section -->
            <div id="leftOtpActionGroup">
                <button type="button" id="btnSendOtp" class="btn-send-otp">
                    <i class="fas fa-paper-plane"></i> <span id="btnOtpText">Send Verification OTP</span>
                </button>
                <div id="leftStatusAlert" class="left-status-box"></div>
            </div>

            <!-- Secure Code Info Section -->
            <div id="leftSecureCodeInfo" class="secure-code-info">
                <i class="fas fa-info-circle"></i> Enter your username above, then provide your assigned Secure Code on the right to set your new password.
            </div>
        </div>

        <!-- ► BACKGROUND GRAPHIC (inline SVG scene with animations) -->
        <div class="scene" aria-hidden="true">
            <svg viewBox="0 0 800 330" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="sea" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#0e57b8" stop-opacity=".55"/><stop offset="1" stop-color="#061f48"/>
                    </linearGradient>
                    <linearGradient id="hull" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#1b2f55"/><stop offset="1" stop-color="#0b1730"/>
                    </linearGradient>
                </defs>

                <!-- globe + route -->
                <g opacity=".5" fill="none" stroke="#9be7ff" stroke-width="1.2">
                    <circle cx="610" cy="70" r="62"/>
                    <ellipse cx="610" cy="70" rx="26" ry="62"/>
                    <ellipse cx="610" cy="70" rx="48" ry="62"/>
                    <path d="M548 70h124M556 44h108M556 96h108"/>
                </g>
                <path d="M120 120C260 20 470 10 600 60" fill="none" stroke="#9be7ff" stroke-width="1.5" stroke-dasharray="4 6" opacity=".7"/>
                <g class="plane">
                    <g transform="translate(560 44) rotate(14)" fill="#fff">
                        <path d="M0 8L34 2 44 0 30 10 40 24 34 24 18 14 8 18 8 12z" transform="scale(.9)"/>
                    </g>
                </g>

                <!-- sky skyline / far shore -->
                <path d="M0 215h800v20H0z" fill="#0a2f6b" opacity=".6"/>

                <!-- gantry crane (right) -->
                <g fill="none" stroke="#cfe6ff" stroke-width="3.5" stroke-linecap="round" opacity=".92">
                    <path d="M700 250V120M760 250V120M700 120h60M690 120L610 120M640 120V95M620 120L700 70M700 70L760 120M700 70h-90"/>
                    <path d="M650 120v28" stroke-dasharray="3 4"/>
                </g>
                <rect x="636" y="148" width="28" height="14" rx="2" fill="#ff8a1f"/>

                <!-- container stacks on quay -->
                <g>
                    <rect x="680" y="226" width="34" height="24" fill="#ff8a1f"/>
                    <rect x="716" y="226" width="34" height="24" fill="#19b5fe"/>
                    <rect x="752" y="226" width="34" height="24" fill="#ef4444"/>
                    <rect x="698" y="202" width="34" height="24" fill="#22c55e"/>
                    <rect x="734" y="202" width="34" height="24" fill="#ff8a1f"/>
                </g>

                <!-- ship -->
                <g class="float">
                    <!-- bridge -->
                    <rect x="455" y="170" width="52" height="42" rx="3" fill="#e8f1ff"/>
                    <rect x="462" y="178" width="38" height="7" fill="#0b5ed7"/>
                    <rect x="462" y="192" width="38" height="5" fill="#0b5ed7" opacity=".6"/>
                    <rect x="474" y="152" width="14" height="18" fill="#cfe0f7"/>
                    <!-- containers -->
                    <g>
                        <rect x="130" y="186" width="40" height="26" fill="#ff8a1f"/>
                        <rect x="172" y="186" width="40" height="26" fill="#19b5fe"/>
                        <rect x="214" y="186" width="40" height="26" fill="#ef4444"/>
                        <rect x="256" y="186" width="40" height="26" fill="#f5c518"/>
                        <rect x="298" y="186" width="40" height="26" fill="#19b5fe"/>
                        <rect x="340" y="186" width="40" height="26" fill="#22c55e"/>
                        <rect x="382" y="186" width="40" height="26" fill="#ff8a1f"/>

                        <rect x="172" y="160" width="40" height="26" fill="#22c55e"/>
                        <rect x="214" y="160" width="40" height="26" fill="#19b5fe"/>
                        <rect x="256" y="160" width="40" height="26" fill="#ff8a1f"/>
                        <rect x="298" y="160" width="40" height="26" fill="#ef4444"/>
                        <rect x="340" y="160" width="40" height="26" fill="#f5c518"/>

                        <rect x="214" y="134" width="40" height="26" fill="#ef4444"/>
                        <rect x="256" y="134" width="40" height="26" fill="#19b5fe"/>
                        <rect x="298" y="134" width="40" height="26" fill="#22c55e"/>
                    </g>
                    <!-- hull -->
                    <path d="M96 212H540L506 258H132Z" fill="url(#hull)"/>
                    <path d="M104 224H532" stroke="#ff8a1f" stroke-width="4"/>
                </g>

                <!-- sea -->
                <rect y="250" width="800" height="80" fill="url(#sea)"/>
                <g class="wave" fill="none" stroke="#9be7ff" stroke-width="2" opacity=".45" stroke-linecap="round">
                    <path d="M-80 266q20-10 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0"/>
                    <path d="M-60 290q20-10 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0"/>
                </g>

                <!-- truck on quay -->
                <g transform="translate(560 232)">
                    <rect x="0" y="0" width="64" height="30" rx="3" fill="#e8f1ff"/>
                    <path d="M64 8h18l10 12v10H64z" fill="#19b5fe"/>
                    <rect x="70" y="12" width="12" height="8" fill="#0a2a5e" opacity=".7"/>
                    <circle cx="16" cy="32" r="6" fill="#0a1a38"/>
                    <circle cx="50" cy="32" r="6" fill="#0a1a38"/>
                    <circle cx="82" cy="32" r="6" fill="#0a1a38"/>
                </g>
                <rect y="262" width="800" height="3" fill="#fff" opacity=".08"/>
            </svg>
        </div>
    </section>

    <!-- ===================== RIGHT : SET NEW PASSWORD ===================== -->
    <section class="panel" aria-label="Set New Password">

        <!-- ► FORMOSA LOGO (top right) -->
        <div class="client-logo">
            <div>
                <img src="@Url.Content("~/images/Formosa.png")" alt="Formosa"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
                <div class="fallback">FORMOSA</div>
            </div>
        </div>

        <h2>Set New Password 🔐</h2>
        <p class="sub">Enter your verification code and choose a new password</p>

        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="msg show" role="alert" style="margin-top:14px;">
                <i class="fas fa-circle-exclamation" style="margin-right:6px;"></i>@ViewData["ErrorMessage"]
            </div>
        }

        <form asp-controller="ChangePassword" asp-action="ForgotPassword" method="post" id="formResetPassword" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-error" style="margin-bottom:10px;"></div>

            <!-- Hidden inputs synchronized from Left Panel -->
            <input type="hidden" asp-for="Username" id="hiddenUsername" />
            <input type="hidden" asp-for="ResetMethod" id="hiddenResetMethod" />

            <!-- OTP Input (Visible when OTP tab active) -->
            <div class="field" id="rightOtpGroup" style="@(Model.ResetMethod == "secureCode" ? "display:none;" : "")">
                <label asp-for="Otp">Verification Code (OTP)</label>
                <div class="input">
                    <svg class="lead-ic" viewBox="0 0 24 24"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
                    <input asp-for="Otp" id="txtOtp" maxlength="6" placeholder="Enter 6-digit code received by email" autocomplete="one-time-code" />
                </div>
                <span asp-validation-for="Otp" class="field-validation-error"></span>
            </div>

            <!-- Secure Code Input (Visible when Secure Code tab active) -->
            <div class="field" id="rightSecureCodeGroup" style="@(Model.ResetMethod == "secureCode" ? "" : "display:none;")">
                <label asp-for="SecureCode">Assigned Secure Code</label>
                <div class="input">
                    <svg class="lead-ic" viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m21 3-9.5 9.5"/><path d="m15.5 7.5 3 3M14 9l2 2"/></svg>
                    <input asp-for="SecureCode" id="txtSecureCode" placeholder="Enter your assigned Secure Code" />
                </div>
                <span asp-validation-for="SecureCode" class="field-validation-error"></span>
            </div>

            <!-- New Password -->
            <div class="field">
                <label asp-for="NewPassword">New Password</label>
                <div class="input">
                    <svg class="lead-ic" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                    <input asp-for="NewPassword" type="password" id="txtNewPassword" placeholder="Minimum 6 characters" autocomplete="new-password" required />
                    <button type="button" class="eye" id="toggleNewPassword" aria-label="Show password">
                        <svg id="eyeIconNew" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <!-- Confirm Password -->
            <div class="field">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <div class="input">
                    <svg class="lead-ic" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                    <input asp-for="ConfirmPassword" type="password" id="txtConfirmPassword" placeholder="Re-type new password" autocomplete="new-password" required />
                    <button type="button" class="eye" id="toggleConfirmPassword" aria-label="Show password">
                        <svg id="eyeIconConfirm" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button class="btn" type="submit" id="btnSubmitReset">
                <span class="btn-text">Reset Password</span>
                <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
        </form>

        <div class="back-link">
            <a asp-controller="Account" asp-action="Login">
                <i class="fas fa-arrow-left"></i> Back to Sign In
            </a>
        </div>

        <!-- ► TEXT BELOW SIGN IN -->
        <div class="info">
            <div class="modules">
                Customs Clearance <span class="dot">&middot;</span> Import &amp; Export <span class="dot">&middot;</span> Port Logistics<br>
                Job Costing <span class="dot">&middot;</span> Billing <span class="dot">&middot;</span> Financial Accounting Management
            </div>
            <div class="sys"><b>C &amp; F Management System</b> &nbsp;|&nbsp; Version 2026</div>
            <div class="copy">Copyright &copy; 2026 <a href="https://gctlinfosys.com/" target="_blank">GCTL Infosys</a>. All rights reserved.</div>
        </div>
    </section>

</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(function () {
        const $leftUsername = $('#leftUsername');
        const $hiddenUsername = $('#hiddenUsername');
        const $hiddenResetMethod = $('#hiddenResetMethod');
        const $tabOtp = $('#tabOtp');
        const $tabSecureCode = $('#tabSecureCode');
        const $leftOtpActionGroup = $('#leftOtpActionGroup');
        const $leftSecureCodeInfo = $('#leftSecureCodeInfo');
        const $rightOtpGroup = $('#rightOtpGroup');
        const $rightSecureCodeGroup = $('#rightSecureCodeGroup');
        const $btnSendOtp = $('#btnSendOtp');
        const $btnOtpText = $('#btnOtpText');
        const $leftStatusAlert = $('#leftStatusAlert');
        const $txtOtp = $('#txtOtp');
        const $form = $('#formResetPassword');

        // Sync username initially
        $hiddenUsername.val($.trim($leftUsername.val()));

        $leftUsername.on('input change', function () {
            $hiddenUsername.val($.trim($(this).val()));
        });

        // Toggle Method Tabs
        function onMethodChanged() {
            if ($tabOtp.is(':checked')) {
                $hiddenResetMethod.val('otp');
                $leftOtpActionGroup.show();
                $leftSecureCodeInfo.hide();
                $rightOtpGroup.slideDown(200);
                $rightSecureCodeGroup.slideUp(200);
            } else {
                $hiddenResetMethod.val('secureCode');
                $leftOtpActionGroup.hide();
                $leftSecureCodeInfo.show();
                $rightSecureCodeGroup.slideDown(200);
                $rightOtpGroup.slideUp(200);
            }
        }

        $('input[name="ResetMethodSelector"]').on('change', onMethodChanged);
        onMethodChanged();

        // Password Show/Hide Toggle (SVG Eye/Eye-Slash)
        function setupPasswordToggle(inputSelector, buttonSelector, iconSelector) {
            const input = document.querySelector(inputSelector);
            const btn = document.querySelector(buttonSelector);
            const icon = document.querySelector(iconSelector);

            if (btn && input && icon) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                    if (isPassword) {
                        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
                    } else {
                        icon.innerHTML = '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>';
                    }
                });
            }
        }

        setupPasswordToggle('#txtNewPassword', '#toggleNewPassword', '#eyeIconNew');
        setupPasswordToggle('#txtConfirmPassword', '#toggleConfirmPassword', '#eyeIconConfirm');

        // Send OTP via AJAX
        $btnSendOtp.on('click', function () {
            const username = $.trim($leftUsername.val());
            if (!username) {
                showLeftStatus('Please enter your username first.', false);
                $leftUsername.focus();
                return;
            }

            $hiddenUsername.val(username);
            $btnSendOtp.prop('disabled', true);
            $btnOtpText.text('Sending code...');
            showLeftStatus('Sending verification code to your email...', true);

            $.ajax({
                url: '/SendOtpForForgotPassword',
                type: 'POST',
                data: { username: username },
                success: function (res) {
                    if (res && res.success) {
                        showLeftStatus(res.message, true);
                        $txtOtp.focus();
                        startOtpCountdown(60);
                    } else {
                        showLeftStatus(res.message || 'Failed to send OTP. Please try again.', false);
                        $btnSendOtp.prop('disabled', false);
                        $btnOtpText.text('Send Verification OTP');
                    }
                },
                error: function () {
                    showLeftStatus('An unexpected network error occurred.', false);
                    $btnSendOtp.prop('disabled', false);
                    $btnOtpText.text('Send Verification OTP');
                }
            });
        });

        function startOtpCountdown(seconds) {
            let remaining = seconds;
            $btnSendOtp.prop('disabled', true);
            const timer = setInterval(function () {
                remaining--;
                if (remaining > 0) {
                    $btnOtpText.text(`Resend in ${remaining}s`);
                } else {
                    clearInterval(timer);
                    $btnSendOtp.prop('disabled', false);
                    $btnOtpText.text('Send Verification OTP');
                }
            }, 1000);
        }

        function showLeftStatus(msg, isSuccess) {
            $leftStatusAlert
                .removeClass('success error')
                .addClass(isSuccess ? 'success' : 'error')
                .html((isSuccess ? '<i class="fas fa-circle-check"></i> ' : '<i class="fas fa-circle-exclamation"></i> ') + msg)
                .fadeIn(200);
        }

        // Button loading state on submit
        const resetBtn = document.getElementById('btnSubmitReset');
        $form.on('submit', function (e) {
            const username = $.trim($leftUsername.val());
            if (!username) {
                e.preventDefault();
                showLeftStatus('Please enter your username.', false);
                $leftUsername.focus();
                return false;
            }
            $hiddenUsername.val(username);

            if ($form.valid && !$form.valid()) {
                return;
            }
            if (resetBtn) {
                resetBtn.classList.add('loading');
            }
        });
    });
</script>
</body>
</html>
