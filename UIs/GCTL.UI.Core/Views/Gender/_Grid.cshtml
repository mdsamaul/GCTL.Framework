@model List<GCTL.Core.ViewModels.Gender.GenderSetupViewModel>

<table id="Sex-grid" class="table table-striped  table-bordered table-sm table-hover table-common">

    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width:9%;">
                Select <br /> <input type="checkbox" id="Sex-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 8%;"> ID</th>
            <th class="text-center text-middle" style="width: 83%;">Sex</th>
            

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
               @*  <td colspan="8">No Gender Available.</td> *@
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.SexCode))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.SexCode" value="@item.SexCode" />
                    </td>
                    <td>
                        <a href="#" class='btn js-Sex-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.SexCode" title="Edit">
                            @item.SexCode
                        </a>
                    </td>
                    <td class="text-center text-middle">@item.Sex</td>
                    
                </tr>
            }
        }


    </tbody>
</table>