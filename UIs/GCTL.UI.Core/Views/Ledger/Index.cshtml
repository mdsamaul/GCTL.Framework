@section Scripts {

    <script>
        window.ChartOfAccountsFilter = {
            groupLedgerCode: '',
            controlLedgerCode: '',
            subcontrolLedgerCode: '',
            subSididaryLedger: '',
            getFilters: function () {
                return {
                    groupLedgerCode: this.groupLedgerCode || '',
                    controlLedgerCode: this.controlLedgerCode || '',
                    subcontrolLedgerCode: this.subcontrolLedgerCode || '',
                    subSididaryLedger: this.subSididaryLedger || ''
                };
            },
            setFilters: function (f) {
                if (f.groupLedgerCode !== undefined) this.groupLedgerCode = f.groupLedgerCode;
                if (f.controlLedgerCode !== undefined) this.controlLedgerCode = f.controlLedgerCode;
                if (f.subcontrolLedgerCode !== undefined) this.subcontrolLedgerCode = f.subcontrolLedgerCode;
                if (f.subSididaryLedger !== undefined) this.subSididaryLedger = f.subSididaryLedger;
                this.reloadAllGrids();
            },
            clearFilters: function () {
                this.groupLedgerCode = '';
                this.controlLedgerCode = '';
                this.subcontrolLedgerCode = '';
                this.subSididaryLedger = '';
                this.reloadAllGrids();
            },
            reloadAllGrids: function () {
                if ($.gctlGrid) {
                    $.gctlGrid.reload('groupLedgerTable', true);
                    $.gctlGrid.reload('controlLedgerTable', true);
                    $.gctlGrid.reload('subControlLedgerTable', true);
                    $.gctlGrid.reload('subSidiaryLedgerTable', true);
                    $.gctlGrid.reload('generalLedgerTable', true);
                }
            }
        };
    </script>

    @* ================= Scripts ================= *@
    <script src="~/js/pages/ChartOfAccount/Group.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/Control.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/SubControl.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/SubSidiary.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/General.js" asp-append-version="true"></script>

    @* Modal Scripts *@
    <script src="~/js/pages/ChartOfAccount/CommonModal.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/ModalGroup.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/ModalControl.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/ModalSubControl.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/ModalSubSidiary.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            if ($.gctlGrid) {
                var coaFilterData = function (d) {
                    if (window.ChartOfAccountsFilter) {
                        var f = window.ChartOfAccountsFilter.getFilters();
                        d.groupLedgerCode = f.groupLedgerCode;
                        d.controlLedgerCode = f.controlLedgerCode;
                        d.subcontrolLedgerCode = f.subcontrolLedgerCode;
                        d.subSididaryLedger = f.subSididaryLedger;
                        d.subsidiaryLedgerCode = f.subSididaryLedger;
                    }
                };

                $.gctlGrid.initFromModel({
                    gridId: 'groupLedgerTable',
                    ajaxData: function (d) {
                        if (window.ChartOfAccountsFilter) {
                            d.groupLedgerCode = window.ChartOfAccountsFilter.groupLedgerCode || '';
                        }
                    }
                });
                $.gctlGrid.initFromModel({ gridId: 'controlLedgerTable', ajaxData: coaFilterData });
                $.gctlGrid.initFromModel({ gridId: 'subControlLedgerTable', ajaxData: coaFilterData });
                $.gctlGrid.initFromModel({ gridId: 'subSidiaryLedgerTable', ajaxData: coaFilterData });
                $.gctlGrid.initFromModel({ gridId: 'generalLedgerTable', ajaxData: coaFilterData });
                
                // Initialize Modal Grids
                $.gctlGrid.initFromModel({ gridId: 'modalGroupLedgerTable' });
                $.gctlGrid.initFromModel({ gridId: 'modalControlLedgerTable' });
                $.gctlGrid.initFromModel({ gridId: 'modalSubControlLedgerTable' });
                $.gctlGrid.initFromModel({ gridId: 'modalSubSidiaryLedgerTable' });
            }

            // Restore active tab from localStorage
            var activeTab = localStorage.getItem('activeLedgerTab');
            if (activeTab) {
                var tab = new bootstrap.Tab(document.querySelector('#' + activeTab));
                tab.show();
            }

            $('[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                // Save active tab to localStorage
                localStorage.setItem('activeLedgerTab', e.target.id);
                
                if ($.fn.dataTable) {
                    $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                }
            });
        });
    </script>
}

