
<style>
    .custom-width-modal {
        max-width: 1600px !important;
    }

    /* Tab Container */
    .custom-tabs {
        display: flex;
        align-items: flex-end;
        border-bottom: 1px solid #d8dce3;
    }

        /* Default Tab */
        .custom-tabs .tab-btn {
            padding: 5px 15px;
            margin-right: 4px;
            border: 1px solid #cfd6df;
            border-bottom: none;
            border-radius: 10px 10px 0 0;
            background: linear-gradient(to bottom, #ffffff 0%, #f7f9fb 50%, #edf2f7 100%);
            color: #495057;
            font-size: 14px;
            font-weight: 600;
            transition: all .25s ease;
            cursor: pointer;
        }

            /* Hover */
            .custom-tabs .tab-btn:hover {
                background: linear-gradient(to bottom, #ffffff, #f1f5f9);
                color: #0d6efd;
            }

            /* Active Tab */
            .custom-tabs .tab-btn.active {
                background: linear-gradient(to bottom, #ffffff 0%, #f8fbff 60%, #eef5fc 100%);
                color: #0d6efd;
                font-weight: 700;
                border-color: #bcd4f1;
                box-shadow: 0 -1px 8px rgba(13,110,253,.08);
                position: relative;
                top: 1px;
            }

                /* Hide bottom border */
                .custom-tabs .tab-btn.active::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: -2px;
                    width: 100%;
                    height: 3px;
                    background: #fff;
                }

            .custom-tabs .tab-btn:focus {
                outline: none;
                box-shadow: none;
            }
</style>

<h2 class="text-center mt-0">Chart Of Accounts</h2>

<div class="container-fluid g-0">

    @* ================= Navigation Tabs ================= *@
    <div class="custom-tabs mb-3" id="ledgertab" role="tablist">
        <button class="tab-btn active" id="group-tab" data-bs-toggle="tab" data-bs-target="#group-tab-pane" type="button" role="tab" aria-controls="group-tab-pane" aria-selected="true">Group Ledger</button>
        <button class="tab-btn" id="controll-tab" data-bs-toggle="tab" data-bs-target="#controll-tab-pane" type="button" role="tab" aria-controls="controll-tab-pane" aria-selected="false">Control Ledger</button>
        <button class="tab-btn" id="subcontroll-tab" data-bs-toggle="tab" data-bs-target="#subcontroll-tab-pane" type="button" role="tab" aria-controls="subcontroll-tab-pane" aria-selected="false">Sub-Control Ledger</button>
        <button class="tab-btn" id="subsidiary-tab" data-bs-toggle="tab" data-bs-target="#subsidiary-tab-pane" type="button" role="tab" aria-controls="subsidiary-tab-pane" aria-selected="false">Sub-Sidiary Ledger</button>
        <button class="tab-btn" id="general-tab" data-bs-toggle="tab" data-bs-target="#general-tab-pane" type="button" role="tab" aria-controls="general-tab-pane" aria-selected="false">General Ledger</button>
    </div>

    @* ================= Tab Panes ================= *@
    <div class="tab-content" id="LedgerTabContent">

        @* 1. Group Ledger Tab *@
        <div class="tab-pane fade show active" id="group-tab-pane" role="tabpanel" aria-labelledby="group-tab">
            <div id="groupTabView">
                <div class="row g-1">
                    <div class="col-md-6">
                        <div id="groupFormView">
                            @await Html.PartialAsync("_GroupLedgerForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="groupListView">
                            @await Html.PartialAsync("_GroupLedgerList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 2. Control Ledger Tab *@
        <div class="tab-pane fade" id="controll-tab-pane" role="tabpanel" aria-labelledby="controll-tab">
            <div id="controllTabView">
                <div class="row g-1">
                    <div class="col-md-6">
                        <div id="controlFormView">
                            @await Html.PartialAsync("_ControlLedgerForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="controlListView">
                            @await Html.PartialAsync("_ControlLedgerList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 3. Sub-Control Ledger Tab *@
        <div class="tab-pane fade" id="subcontroll-tab-pane" role="tabpanel" aria-labelledby="subcontroll-tab">
            <div id="subcontrollTabView">
                <div class="row g-1">
                    <div class="col-md-6">
                        <div id="subcontrolFormView">
                            @await Html.PartialAsync("_SubControlLedgerForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="subcontrolListView">
                            @await Html.PartialAsync("_SubControlLedgerList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 4. Sub-Sidiary Ledger Tab *@
        <div class="tab-pane fade" id="subsidiary-tab-pane" role="tabpanel" aria-labelledby="subsidiary-tab">
            <div id="subsidiaryTabView">
                <div class="row g-1">
                    <div class="col-md-6">
                        <div id="subsidiaryFormView">
                            @await Html.PartialAsync("_SubSidiaryLedgerForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="subsidiaryListView">
                            @await Html.PartialAsync("_SubSidiaryLedgerList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 5. General Ledger Tab *@
        <div class="tab-pane fade" id="general-tab-pane" role="tabpanel" aria-labelledby="general-tab">
            <div id="generalTabView">
                <div class="row g-1">
                    <div class="col-md-6">
                        <div id="generalFormView">
                            @await Html.PartialAsync("_GeneralLedgerForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="generalListView">
                            @await Html.PartialAsync("_GeneralLedgerList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@* ================= Modals ================= *@

@* 1. Group Ledger Modal *@
<div class="modal fade" id="GRLModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Group Ledger</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="groupModalBody">
                <div class="row">
                    <div class="col-md-6">
                        <div id="modalGroupFormView">
                            @await Html.PartialAsync("~/Views/Ledger/_ModalGroupForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="modalGroupListView">
                            @await Html.PartialAsync("~/Views/Ledger/_ModalGroupList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* 2. Control Ledger Modal *@
<div class="modal fade" id="UICRLModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered custom-width-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Control Ledger</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="controlModalBody">
                <div class="row">
                    <div class="col-md-6">
                        <div id="modalControlFormView">
                            @await Html.PartialAsync("~/Views/Ledger/_ModalControlForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="modalControlListView">
                            @await Html.PartialAsync("~/Views/Ledger/_ModalControlList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* 3. Sub-Control Ledger Modal *@
<div class="modal fade" id="SCRLModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered custom-width-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Sub-Control Ledger</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="subControlModalBody">
                <div class="row">
                    <div class="col-md-6">
                        <div id="modalSubControlFormView">
                            @await Html.PartialAsync("~/Views/Ledger/_ModalSubControlForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="modalSubControlListView">
                            @await Html.PartialAsync("~/Views/Ledger/_ModalSubControlList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* 4. Sub-Sidiary Ledger Modal *@
<div class="modal fade" id="SSLModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered custom-width-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Sub-Sidiary Ledger</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="subSidiaryModalBody">
                <div class="row">
                    <div class="col-md-6">
                        <div id="modalSubSidiaryFormView">
                            @await Html.PartialAsync("~/Views/Ledger/_ModalSubSidiaryForm.cshtml")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="modalSubSidiaryListView">
                            @await Html.PartialAsync("~/Views/Ledger/_ModalSubSidiaryList.cshtml")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    @* ================= Scripts ================= *@
    <script src="~/js/pages/ChartOfAccount/Group.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/Control.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/SubControl.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/SubSidiary.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/General.js" asp-append-version="true"></script>

    @* Modal Scripts *@
    <script src="~/js/pages/ChartOfAccount/CommonModal.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/ModalGroup.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/ModalControl.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/ModalSubControl.js" asp-append-version="true"></script>
    <script src="~/js/pages/ChartOfAccount/ModalSubSidiary.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            if ($.gctlGrid) {
                $.gctlGrid.initFromModel({ gridId: 'groupLedgerTable' });
                $.gctlGrid.initFromModel({ gridId: 'controlLedgerTable' });
                $.gctlGrid.initFromModel({ gridId: 'subControlLedgerTable' });
                $.gctlGrid.initFromModel({ gridId: 'subSidiaryLedgerTable' });
                $.gctlGrid.initFromModel({ gridId: 'generalLedgerTable' });
            }

            $('[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                if ($.fn.dataTable) {
                    $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                }
            });
        });
    </script>
}

