<div class="card shadow-sm rounded-2">

    <div class="px-1 card-header bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap">
        <div class="d-flex flex-nowrap justify-content-between w-100 align-items-center">

            <div>
                <h4 class="mb-0 heading-nowrap " style="font-size:14px">Sub-Sidiary Ledger</h4>
            </div>
            <div class="d-flex gap-1" id="button-div">

                <button type="submit" form="ModalsubSidiaryForm" class="btn btn-sm btn-outline-primary ModalsaveBtn">
                    <i class="fas fa-save me-1"></i> Save
                </button>

                <button type="button" class="btn btn-sm btn-outline-danger ModalSubcontroldeleteBtn" id="ModalSubSidiarydeleteBtn">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>

                <button type="reset" class="btn btn-sm btn-outline-secondary ModalSubSidiaryresetBtn">
                    <i class="fas fa-eraser me-1"></i> Clear
                </button>

                <div class="dropdown">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item export-pdf" href="#"><i class="fas fa-file-pdf me-1"></i> PDF</a></li>
                        <li><a class="dropdown-item export-excel" href="#"><i class="fas fa-file-excel me-1"></i> Excel</a></li>
                    </ul>
                </div>
                <button type="button" class="btn btn-sm btn-outline-warning ModalsubSidiaryfavBtn">
                    <i class="fas fa-star me-1"></i> Fav
                </button>
            </div>

        </div>
    </div>

    <div class="card-body">
        <form id="ModalsubSidiaryForm">
            <fieldset style="border:1px solid #ccc; padding:5px; border-radius:5px;">

                <input type="hidden" id="ModalforsidiaryAutoID" name="autoId" />

                <div class="row g-3">

                    @* Group Ledger Section *@
                    <div class="col-md-4">
                        <div class="form-floating ">
                            <input readonly type="text" class="form-control" name="GLCode" id="Modalforsidiarygroupcode">
                            <label for="GLCode">Group Ledger Code<span style="color:red">*</span></label>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-floating form-floating-advance-select">
                            <select class="form-select choiceDD" name="forsidiarygroupName" id="ModalforsidiarygroupName">
                            </select>
                            <label for="forsidiarygroupName">Group Ledger Name<span class="text-danger">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="GLShortName" id="ModalforsidiarygroupshortName">
                            <label for="GLShortName">Short Name</label>
                        </div>
                    </div>


                    @* Control Ledger Section *@
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="CRLCode" id="ModalforsidiaryControlCode">
                            <label for="CRLCode">Control Ledger Code<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-advance-select">
                            <select class="form-select choiceDD" name="CRLName" id="ModalforsidiaryControlName">
                            </select>
                            <label for="CRLName">Control Ledger Name<span class="text-danger">*</span></label>
                        </div>

                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="CRLShortName" id="ModalforsidiaryCLShortName">
                            <label for="CRLShortName">Short Name</label>
                        </div>
                    </div>


                    @* Sub-Control Ledger Section *@
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="GeneralLedgerCodeNo" id="ModalforsidiaryGeneralLedgerCodeNo">
                            <label for="GeneralLedgerCodeNo">Sub-Control Ledger Code<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating form-floating-advance-select">
                            <select class="form-select choiceDD" name="forsidiaryGeneralLedgerName" id="ModalforsidiaryGeneralLedgerName">
                            </select>
                            <label for="forsidiaryGeneralLedgerName">Sub-Control Ledger Name<span class="text-danger">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="SubCRLShortName" id="ModalforsidiarySubCRLshortName">
                            <label for="SubCRLShortName">Short Name</label>
                        </div>
                    </div>

                    @* Sub-Sidiary Ledger Section *@
                    <div class="col-md-4 ">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="SusidiaryLedgerCodeNo" id="ModalSusidiaryLedgerCodeNo">
                            <label for="SusidiaryLedgerCodeNo">Sub-Sidiary Ledger Code<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="SubsidiaryLedgerName" id="ModalSubsidiaryLedgerName">
                            <label for="SubsidiaryLedgerName">Sub-Sidiary Ledger Name<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="ShortName" id="ModalforsidiaryshortName">
                            <label for="ShortName">Short Name</label>
                        </div>
                    </div>

                </div>

                @* Creation/Modify Date Display  *@
                <hr class="my-4 mx-2 pb-2">
                <div class="row g-3">

                    <div class="col-md-6">
                        <div>
                            <span style="font-size:12px;">Entry Date : </span>
                            <span id="ModalSubSidiaryldisplayLDate"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div>
                            <span style="font-size:12px;">Last Update Date :</span>
                            <span id="ModalSubSidiarydisplayModifyDate"></span>
                        </div>
                    </div>

                </div>

                @* Save Button (Bottom) *@
                <div class="row mt-1">
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-outline-primary btn-sm ModalsaveBtn">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </div>
            </fieldset>
        </form>
    </div>
</div>