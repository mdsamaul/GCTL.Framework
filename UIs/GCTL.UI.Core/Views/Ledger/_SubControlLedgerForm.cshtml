@using GCTL.UI.Core.ViewModels

<style>
    /* ==========================================================================
       Sub-Control Ledger Form: Responsive 3-Column Equal Width & Quick-Add In-Gap Layout
       Optimized for Desktop and Laptop (1362x768 / <= 1400px) Screens
       ========================================================================== */
    :root {
        --control-height: 31px;
        --gap-size: 24px;
        --btn-width: 22px;
    }

    .subcontrol-ledger-fields-row,
    .control-ledger-fields-row {
        --control-height: 31px;
        --gap-size: 24px;
        --btn-width: 22px;
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: space-between !important;
        row-gap: 12px !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    /* 3 Equal Columns: (100% - 2 * gap) / 3 -> Exactly 0 gap on right side! */
    .subcontrol-ledger-fields-row > [class*="col-"],
    .subcontrol-ledger-fields-row > div,
    .control-ledger-fields-row > [class*="col-"],
    .control-ledger-fields-row > div {
        flex: 0 0 calc((100% - (2 * var(--gap-size))) / 3) !important;
        max-width: calc((100% - (2 * var(--gap-size))) / 3) !important;
        width: calc((100% - (2 * var(--gap-size))) / 3) !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        box-sizing: border-box !important;
        position: relative !important;
        overflow: visible !important;
    }

    .subcontrol-ledger-fields-row .form-label,
    .control-ledger-fields-row .form-label {
        margin-bottom: 4px !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        font-size: 13px !important;
    }

    .subcontrol-ledger-fields-row .field-fixed-width,
    .control-ledger-fields-row .field-fixed-width {
        position: relative !important;
        width: 100% !important;
        display: flex !important;
        gap: 0 !important;
        overflow: visible !important;
    }

    .subcontrol-ledger-fields-row .field-fixed-width > .input-group,
    .control-ledger-fields-row .field-fixed-width > .input-group {
        width: 100% !important;
        flex: 1 1 100% !important;
        min-width: 0 !important;
    }

    /* Uniform height for ALL inputs, selects, custom dropdowns, input-groups, and buttons */
    .subcontrol-ledger-fields-row .form-control,
    .subcontrol-ledger-fields-row .form-select,
    .subcontrol-ledger-fields-row input:not([type="hidden"]),
    .subcontrol-ledger-fields-row select,
    .subcontrol-ledger-fields-row .custom-dd-box,
    .subcontrol-ledger-fields-row .custom-dd-wrapper,
    .subcontrol-ledger-fields-row .input-group,
    .subcontrol-ledger-fields-row .detached-action-btn,
    .subcontrol-ledger-fields-row .js-quick-add,
    .control-ledger-fields-row .form-control,
    .control-ledger-fields-row .form-select,
    .control-ledger-fields-row input:not([type="hidden"]),
    .control-ledger-fields-row select,
    .control-ledger-fields-row .custom-dd-box,
    .control-ledger-fields-row .custom-dd-wrapper,
    .control-ledger-fields-row .input-group,
    .control-ledger-fields-row .detached-action-btn,
    .control-ledger-fields-row .js-quick-add {
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        box-sizing: border-box !important;
    }

    .subcontrol-ledger-fields-row .form-control,
    .subcontrol-ledger-fields-row input:not([type="hidden"]),
    .control-ledger-fields-row .form-control,
    .control-ledger-fields-row input:not([type="hidden"]) {
        line-height: calc(var(--control-height) - 2px) !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    .subcontrol-ledger-fields-row .custom-dd-box,
    .control-ledger-fields-row .custom-dd-box {
        display: flex !important;
        align-items: center !important;
        line-height: calc(var(--control-height) - 2px) !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    .subcontrol-ledger-fields-row .custom-dd-input,
    .control-ledger-fields-row .custom-dd-input {
        height: calc(var(--control-height) - 4px) !important;
        line-height: calc(var(--control-height) - 4px) !important;
    }

    /* Quick-Add (+) Button positioned directly inside the gap with zero overlap and NO border */
    .subcontrol-ledger-fields-row .field-fixed-width > .detached-action-btn,
    .subcontrol-ledger-fields-row .field-fixed-width > .js-quick-add,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add {
        position: absolute !important;
        left: calc(100% + 1px) !important;
        top: 0 !important;
        bottom: 0 !important;
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        width: var(--btn-width) !important;
        min-width: var(--btn-width) !important;
        max-width: var(--btn-width) !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        z-index: 5 !important;
        margin: 0 !important;
        border: 0 !important;
        border-color: transparent !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: #495057 !important;
        border-radius: 4px !important;
        cursor: pointer !important;
    }

    .subcontrol-ledger-fields-row .field-fixed-width > .detached-action-btn:hover,
    .subcontrol-ledger-fields-row .field-fixed-width > .js-quick-add:hover,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn:hover,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add:hover {
        border: 0 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        background: #e9ecef !important;
        color: #0d6efd !important;
    }

    .subcontrol-ledger-fields-row .field-fixed-width > .detached-action-btn:focus,
    .subcontrol-ledger-fields-row .field-fixed-width > .js-quick-add:focus,
    .subcontrol-ledger-fields-row .field-fixed-width > .detached-action-btn:active,
    .subcontrol-ledger-fields-row .field-fixed-width > .js-quick-add:active,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn:focus,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add:focus,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn:active,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add:active {
        border: 0 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        outline: none !important;
    }

    .subcontrol-ledger-fields-row .field-fixed-width > .detached-action-btn i,
    .subcontrol-ledger-fields-row .field-fixed-width > .js-quick-add i,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn i,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add i {
        font-size: 11px !important;
    }

    /* ==========================================================================
       Responsive for Laptop Screens (<= 1400px, e.g. 1362x768 / 1366x768)
       ========================================================================== */
    @@media (max-width: 1400px) {
        .subcontrol-ledger-fields-row,
        .control-ledger-fields-row {
            --control-height: 28px !important;
            --gap-size: 22px !important;
            --btn-width: 20px !important;
            row-gap: 8px !important;
        }

        .subcontrol-ledger-fields-row .form-label,
        .control-ledger-fields-row .form-label {
            font-size: 11.5px !important;
            margin-bottom: 2px !important;
            font-weight: 500 !important;
        }

        .subcontrol-ledger-fields-row .form-control,
        .subcontrol-ledger-fields-row .form-select,
        .subcontrol-ledger-fields-row input:not([type="hidden"]),
        .subcontrol-ledger-fields-row select,
        .subcontrol-ledger-fields-row .custom-dd-box,
        .subcontrol-ledger-fields-row .custom-dd-input,
        .control-ledger-fields-row .form-control,
        .control-ledger-fields-row .form-select,
        .control-ledger-fields-row input:not([type="hidden"]),
        .control-ledger-fields-row select,
        .control-ledger-fields-row .custom-dd-box,
        .control-ledger-fields-row .custom-dd-input {
            font-size: 12px !important;
            padding-left: 6px !important;
            padding-right: 6px !important;
        }

        .subcontrol-ledger-fields-row .field-fixed-width > .detached-action-btn i,
        .subcontrol-ledger-fields-row .field-fixed-width > .js-quick-add i,
        .control-ledger-fields-row .field-fixed-width > .detached-action-btn i,
        .control-ledger-fields-row .field-fixed-width > .js-quick-add i {
            font-size: 10px !important;
        }

        /* Compact card & fieldset for 768px vertical resolution */
        #subcontrolFormView .card-body {
            padding: 8px 12px !important;
        }

        #subcontrolFormView fieldset {
            padding: 8px 10px !important;
        }

        #subcontrolFormView hr {
            margin-top: 6px !important;
            margin-bottom: 6px !important;
        }

        #subcontrolFormView .table-toolbar {
            padding: 4px 8px !important;
        }
    }

    /* Mobile / Small Screens */
    @@media (max-width: 767.98px) {
        .subcontrol-ledger-fields-row > [class*="col-"],
        .subcontrol-ledger-fields-row > div,
        .control-ledger-fields-row > [class*="col-"],
        .control-ledger-fields-row > div {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            width: 100% !important;
        }

        .subcontrol-ledger-fields-row .field-fixed-width,
        .control-ledger-fields-row .field-fixed-width {
            gap: 8px !important;
        }

        .subcontrol-ledger-fields-row .field-fixed-width > .input-group,
        .control-ledger-fields-row .field-fixed-width > .input-group {
            flex: 1 1 auto !important;
            width: auto !important;
        }

        .subcontrol-ledger-fields-row .field-fixed-width > .detached-action-btn,
        .subcontrol-ledger-fields-row .field-fixed-width > .js-quick-add,
        .control-ledger-fields-row .field-fixed-width > .detached-action-btn,
        .control-ledger-fields-row .field-fixed-width > .js-quick-add {
            position: static !important;
            transform: none !important;
            width: 28px !important;
            min-width: 28px !important;
            border: 0 !important;
        }
    }

    /* Bottom Toolbar in Sub-Control Ledger: 0px border */
    #subcontrolForm .toolbar-container,
    #subcontrolFormView .card-body .toolbar-container,
    #subcontrolForm .row.no-print .toolbar-container {
        border: 0 !important;
        border-bottom: 0px !important;
        box-shadow: none !important;
    }
</style>

<div class="card shadow-sm rounded-2">

    @* ================= Toolbar Section ================= *@
    @await Html.PartialAsync("_Toolbars", new ToobarModel
    {
        Title = "Sub-Control Ledger",
        ShowSave = true,
        SaveBtnId = "btnSave",
        SaveBtnClass = "js-SubControl-save",
        EnableSave = true,

        ShowDelete = true,
        DeleteBtnId = "SubcontroldeleteBtn",
        DeleteBtnClass = "js-SubControl-delete-confirm SubcontroldeleteBtn",
        EnableDelete = true,

        ShowClear = true,
        ClearBtnId = "btnClear",
        ClearBtnClass = "js-SubControl-clear SubcontrolresetBtn",
        EnableClear = true,

        ShowPrint = true,
        PrintBtnId = "btnPrint",
        PrintBtnClass = "printBtn",
        ExcelBtnClass = "export-excel",
        PdfBtnClass = "export-pdf",
        EnablePrint = true,

        ShowFavorite = true,
        FavtBtnId = "btnFav",
        FavtBtnClass = "subfavBtn",
        EnableFavorite = true
    })

    <div class="card-body">
        <form id="subcontrolForm">
            <fieldset style="border: 1px solid #ccc; padding: 12px; border-radius: 5px;">
                <input type="hidden" id="SubCRLAutoID" name="autoId" />

                <div class="row subcontrol-ledger-fields-row control-ledger-fields-row">
                    @* --- 1. Group Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "groupcode",
                        InputName = "groupcode",
                        LabelText = "Group Ledger Code",
                        ReserveActionSlot=false,
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 2. Group Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "groupName",
                        InputName = "groupName",
                        LabelText = "Group Ledger Name",
                        Placeholder = "-- Select Group Ledger --",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        ReserveActionSlot=false,
                        QuickAddTarget = "#GRLModal",
                        QuickAddTitle = "Add New Group Ledger"
                    })

                    @* --- 3. Group Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "groupshortName",
                        InputName = "shortName",
                        ReserveActionSlot=false,
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 4. Control Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "ConRLCode",
                        InputName = "SubControlLedgerCodeNo",
                        LabelText = "Control Ledger Code",
                        ReserveActionSlot=false,
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 5. Control Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "ConRLName",
                        InputName = "CRLName",
                        LabelText = "Control Ledger Name",
                        Placeholder = "-- Select Control Ledger --",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        ReserveActionSlot=false,
                        QuickAddTarget = "#UICRLModal",
                        QuickAddTitle = "Add New Control Ledger"
                    })

                    @* --- 6. Control Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "CLShortName",
                        InputName = "CRLShortname",
                        ReserveActionSlot=false,
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 7. Sub-Control Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "GeneralLedgerCodeNo",
                        ReserveActionSlot=false,
                        InputName = "GeneralLedgerCodeNo",
                        LabelText = "Sub-Control Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 8. Sub-Control Ledger Name --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "GeneralLedgerName",
                        InputName = "GeneralLedgerName",
                        ReserveActionSlot=false,
                        LabelText = "Sub-Control Ledger Name",
                        Placeholder = "Sub-Control Ledger Name",
                        IsRequired = true
                    })

                    @* --- 9. Short Name --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "SubCRLshortName",
                        InputName = "ShortName",
                        ReserveActionSlot=false,
                        LabelText = "Short Name",
                        Placeholder = "Short Name"
                    })
                </div>

                <hr class="my-3 mx-1">

                @* --- Entry & Update Date Section --- *@
                <div class="row g-2 align-items-center">
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "EntryDate",
                        LabelText = "Entry Date:",
                        LabelInline = true,
                        LabelColWidth = 5,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:12px; white-space: nowrap;",
                        InputStyle = "font-size:12px; white-space: nowrap;"
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "UpdateDate",
                        LabelText = "Last Update Date:",
                        LabelInline = true,
                        LabelColWidth = 5,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:12px; white-space: nowrap;",
                        InputStyle = "font-size:12px; white-space: nowrap;"
                    })
                </div>

                @* Bottom Save Button *@
                <div class="row no-print" style="margin-top: 9px;">
                    <div class="col-12">
                        @await Html.PartialAsync("_Toolbars", new ToobarModel
                        {
                            Title = "",
                            ShowClear = false,
                            ShowDelete = false,
                            ShowPrint = false,
                            ShowFavorite = false,
                            IsPlain = true,
                            ReserveActionSlot = false,
                            SaveBtnType = "submit",
                            Style = "border:0px !important; border-bottom:0px !important; box-shadow:none !important;"
                        })
                    </div>
                </div>

            </fieldset>
        </form>
    </div>
</div>