@using GCTL.UI.Core.ViewModels

<div class="card shadow-sm rounded-2">

    @* ================= Toolbar Section ================= *@
    @await Html.PartialAsync("_Toolbars", new ToobarModel
    {
        Title = "Sub-Control Ledger",
        ShowSave = true,
        SaveBtnId = "btnSave",
        SaveBtnClass = "js-SubControl-save",
        EnableSave = true,

        ShowDelete = true,
        DeleteBtnId = "SubcontroldeleteBtn",
        DeleteBtnClass = "js-SubControl-delete-confirm SubcontroldeleteBtn",
        EnableDelete = true,

        ShowClear = true,
        ClearBtnId = "btnClear",
        ClearBtnClass = "js-SubControl-clear SubcontrolresetBtn",
        EnableClear = true,

        ShowPrint = true,
        PrintBtnId = "btnPrint",
        PrintBtnClass = "printBtn",
        ExcelBtnClass = "export-excel",
        PdfBtnClass = "export-pdf",
        EnablePrint = true,

        ShowFavorite = true,
        FavtBtnId = "btnFav",
        FavtBtnClass = "subfavBtn",
        EnableFavorite = true
    })

    <div class="card-body">
        <form id="subcontrolForm">
            <fieldset style="border: 1px solid #ccc; padding: 12px; border-radius: 5px;">
                <input type="hidden" id="SubCRLAutoID" name="autoId" />

                <div class="row g-3">
                    @* --- 1. Group Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "groupcode",
                        InputName = "groupcode",
                        LabelText = "Group Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 2. Group Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "groupName",
                        InputName = "groupName",
                        LabelText = "Group Ledger Name",
                        Placeholder = "-- Select Group Ledger --",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        QuickAddTarget = "#GRLModal",
                        QuickAddTitle = "Add New Group Ledger"
                    })

                    @* --- 3. Group Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "groupshortName",
                        InputName = "shortName",
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 4. Control Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "ConRLCode",
                        InputName = "SubControlLedgerCodeNo",
                        LabelText = "Control Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 5. Control Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "ConRLName",
                        InputName = "CRLName",
                        LabelText = "Control Ledger Name",
                        Placeholder = "-- Select Control Ledger --",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        QuickAddTarget = "#UICRLModal",
                        QuickAddTitle = "Add New Control Ledger"
                    })

                    @* --- 6. Control Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "CLShortName",
                        InputName = "CRLShortname",
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 7. Sub-Control Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "GeneralLedgerCodeNo",
                        InputName = "GeneralLedgerCodeNo",
                        LabelText = "Sub-Control Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 8. Sub-Control Ledger Name --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "GeneralLedgerName",
                        InputName = "GeneralLedgerName",
                        LabelText = "Sub-Control Ledger Name",
                        Placeholder = "Sub-Control Ledger Name",
                        IsRequired = true
                    })

                    @* --- 9. Short Name --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "SubCRLshortName",
                        InputName = "ShortName",
                        LabelText = "Short Name",
                        Placeholder = "Short Name"
                    })
                </div>

                <hr class="my-3 mx-1">

                @* --- Entry & Update Date Section --- *@
                <div class="row g-3">
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "EntryDate",
                        LabelText = "Entry Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "UpdateDate",
                        LabelText = "Last Update Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })
                </div>

                @* Bottom Save Button *@
                <div class="row no-print" style="margin-top: 9px;">
                    <div class="col-12">
                        @await Html.PartialAsync("_Toolbars", new ToobarModel
                        {
                            Title = "",
                            ShowClear = false,
                            ShowDelete = false,
                            ShowPrint = false,
                            ShowFavorite = false,
                            IsPlain = true,
                            ReserveActionSlot = true,
                            IsMarginRight = true,
                            SaveBtnType = "submit"

                        })
                    </div>
                </div>

            </fieldset>
        </form>
    </div>
</div>