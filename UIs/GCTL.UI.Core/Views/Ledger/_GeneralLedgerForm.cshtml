@using GCTL.UI.Core.ViewModels

<div class="card shadow-sm rounded-2">

    @* ================= Toolbar Section ================= *@
    @await Html.PartialAsync("_Toolbars", new ToobarModel
    {
        Title = "General Ledger",
        ShowSave = true,
        SaveBtnId = "btnSave",
        SaveBtnClass = "js-GeneralLedger-save",
        EnableSave = true,

        ShowDelete = true,
        DeleteBtnId = "GeneraldeleteBtn",
        DeleteBtnClass = "js-GeneralLedger-delete-confirm GeneraldeleteBtn",
        EnableDelete = true,

        ShowClear = true,
        ClearBtnId = "btnClear",
        ClearBtnClass = "js-GeneralLedger-clear GeneralresetBtn",
        EnableClear = true,

        ShowPrint = true,
        PrintBtnId = "btnPrint",
        PrintBtnClass = "printBtn",
        ExcelBtnClass = "export-excel",
        PdfBtnClass = "export-pdf",
        EnablePrint = true,

        ShowFavorite = true,
        FavtBtnId = "btnFav",
        FavtBtnClass = "GeneralfavBtn",
        EnableFavorite = true
    })

    <div class="card-body">
        <form id="generalLedgerForm">
            <fieldset style="border: 1px solid #ccc; padding: 12px; border-radius: 5px;">
                <input type="hidden" id="GeneralAutoID" name="autoId" />

                @* --- Cascading Ledger Information Section --- *@
                <fieldset class="border rounded-3 p-3 mb-3">
                    <div class="row">
                        @* 1. Group Ledger Code (Readonly) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "Generalgrlcode",
                            InputName = "Generalgrlcode",
                            LabelText = "Group Ledger Code",
                            IsRequired = true,
                            IsReadonly = true
                        })

                        @* 2. Group Ledger Name (Quick Add Select) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.QuickAddSelect,
                            InputId = "GeneralgrlName",
                            InputName = "GeneralgrlName",
                            LabelText = "Group Ledger Name",
                            Placeholder = "-- Select Group Ledger --",
                            IsRequired = true,
                            ShowQuickAdd = true,
                            QuickAddTarget = "#GRLModal",
                            QuickAddTitle = "Add New Group Ledger"
                        })

                        @* 3. Control Ledger Code (Readonly) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "GeneralCRLCode",
                            InputName = "GeneralCRLCode",
                            LabelText = "Control Ledger Code",
                            IsRequired = true,
                            IsReadonly = true
                        })

                        @* 4. Control Ledger Name (Quick Add Select) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.QuickAddSelect,
                            InputId = "GeneralCRLName",
                            InputName = "GeneralCRLName",
                            LabelText = "Control Ledger Name",
                            Placeholder = "-- Select Control Ledger --",
                            IsRequired = true,
                            ShowQuickAdd = true,
                            QuickAddTarget = "#UICRLModal",
                            QuickAddTitle = "Add New Control Ledger"
                        })

                        @* 5. Sub-Control Ledger Code (Readonly) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "GeneralSCRLCode",
                            InputName = "GeneralSCRLCode",
                            LabelText = "Sub-Control Ledger Code",
                            IsRequired = true,
                            IsReadonly = true
                        })

                        @* 6. Sub-Control Ledger Name (Quick Add Select) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.QuickAddSelect,
                            InputId = "GeneralSCRLName",
                            InputName = "GeneralSCRLName",
                            LabelText = "Sub-Control Ledger Name",
                            Placeholder = "-- Select Sub-Control Ledger --",
                            IsRequired = true,
                            ShowQuickAdd = true,
                            QuickAddTarget = "#SCRLModal",
                            QuickAddTitle = "Add New Sub-Control Ledger"
                        })

                        @* 7. Sub-Sidiary Ledger Code (Readonly) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "GeneralSSLCode",
                            InputName = "SusidiaryLedgerCodeNo",
                            LabelText = "Sub-Sidiary Ledger Code",
                            IsRequired = true,
                            IsReadonly = true
                        })

                        @* 8. Sub-Sidiary Ledger Name (Quick Add Select) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.QuickAddSelect,
                            InputId = "GeneralSSLName",
                            InputName = "GeneralSSLName",
                            LabelText = "Sub-Sidiary Ledger Name",
                            Placeholder = "-- Select Sub-Sidiary Ledger --",
                            IsRequired = true,
                            ShowQuickAdd = true,
                            QuickAddTarget = "#SSLModal",
                            QuickAddTitle = "Add New Sub-Sidiary Ledger"
                        })
                    </div>
                </fieldset>

                @* --- General Ledger Detail Section --- *@
                <fieldset class="border rounded-3 p-3 position-relative mb-3">
                    <legend class="float-none w-auto px-2 fw-bold"
                            style="font-size: 14px; border: 1px solid #dee2e6; border-radius: 6px; background-color: #f8f9fa;">
                        General Ledger Info
                    </legend>
                    <div class="row g-3">
                        @* 9. General Ledger Code (Readonly) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "GeneralLedgerCode",
                            InputName = "GeneralLedgerCode",
                            LabelText = "General Ledger Code",
                            IsRequired = true,
                            IsReadonly = true
                        })

                        @* 10. General Ledger Name (Text Input) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "GeneralLName",
                            InputName = "GeneralLedgerName",
                            LabelText = "General Ledger Name",
                            IsRequired = true,
                            Placeholder = "General Ledger Name"
                        })

                        @* 11. Short Name (Optional) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Text,
                            InputId = "GeneralShortName",
                            InputName = "GeneralShortName",
                            LabelText = "Short Name",
                            Placeholder = "Short Name"
                        })

                        @* 12. Cash Flow Type (Select) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Select,
                            InputId = "CashFlowTypeID",
                            InputName = "CashFlowTypeID",
                            LabelText = "Cash Flow Type",
                            Placeholder = "-- Select Cash Flow Type --"
                        })

                        @* 13. Active Account (Checkbox) *@
                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                        {
                            IsVisible = true,
                            ShowOnInit = true,
                            ColumnClass = "col-md-6",
                            FieldType = FieldType.Checkbox,
                            InputId = "IsActive",
                            InputName = "IsActive",
                            LabelText = "Active Account"
                        })
                    </div>
                </fieldset>

                <hr class="my-3 mx-1">

                @* --- Entry & Update Date Section --- *@
                <div class="row g-3">
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "EntryDate",
                        LabelText = "Entry Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "UpdateDate",
                        LabelText = "Last Update Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })
                </div>

                @* Bottom Save Button *@
                <div class="col-12">
                    @await Html.PartialAsync("_Toolbars", new ToobarModel
                    {
                        Title = "",
                        ShowClear = false,
                        ShowDelete = false,
                        ShowPrint = false,
                        ShowFavorite = false,
                        IsPlain = true,
                        ReserveActionSlot = true,
                        IsMarginRight = true,
                        SaveBtnType = "submit"

                    })
                </div>

            </fieldset>
        </form>
    </div>
</div>