<style>
    .form-floating .selectLabel {
        font-size: 14px !important;
    }

    .form-floating label {
        text-transform: none;
        font-size: 13px;
    }

    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .GeneraldeleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .GeneralresetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .GeneralfavBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }

    #button-div button {
        padding: 8px 6px;
        width: 80px;
    }
    /* CSS for error styling */
    .border-error {
        border: 1px solid red !important;
    }

    .row.border {
        border: 1px solid #ddd; /* Light border color */
        border-radius: 5px; /* Optional: rounded corners for the border */
        padding: 10px;
    }

    .btn-sm {
        margin-top: 8px; /* tweak as needed for exact vertical match */
    }


    .choices__inner {
        height: 47px !important;
        overflow: hidden !important;
        white-space: nowrap !important;
        align-items: center;
    }

    .choices__item--selectable {
        overflow: hidden;
        white-space: nowrap;
    }

    .choices.border-error .choices__inner {
        border: 1.5px solid red !important;
        border-radius: 6px !important;
        overflow: hidden !important;
    }

    .choices.border-error {
        border: none !important;
    }

    @@media (max-width: 767.98px) {
        .col-md-6.d-flex.align-items-start {
            flex-wrap: wrap;
        }

            .col-md-6.d-flex.align-items-start .form-floating.flex-grow-1 {
                width: 100%;
            }

            .col-md-6.d-flex.align-items-start .btn-sm {
                margin-left: 0 !important;
                margin-top: 0.5rem !important;
                width: auto;
            }

    }



    .col-md-6 .d-flex.align-items-start .form-floating.flex-grow-1 {
        min-width: 0; 
    } 

     .col-md-6 .d-flex.align-items-start .btn-sm {
        margin-left: 0 !important;
        padding-left: 0.2rem; 
         padding-right: 0.2rem;
        flex: 0 0 auto;
    }




    .SubSidiModal:focus {
        outline: none !important;
        box-shadow: none !important;
    }

    .SubSidiModal:hover {
        color: green !important;
        cursor: pointer;
    }


</style>

<div class="card shadow-sm rounded-2">

    <div class="px-1 card-header bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap">
        <div class="d-flex flex-nowrap justify-content-between w-100 align-items-center">

            <div>
                <h4 class="mb-0 heading-nowrap " style="font-size:14px">General Ledger</h4>
            </div>
            <div class="d-flex gap-1" id="button-div">

                <button type="submit" form="generalLedgerForm" class="btn btn-sm btn-outline-primary saveBtn">
                    <i class="fas fa-save me-1"></i> Save
                </button>

                <button type="button" class="btn btn-sm btn-outline-danger GeneraldeleteBtn" id="GeneraldeleteBtn">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>

                <button type="reset" class="btn btn-sm btn-outline-secondary GeneralresetBtn">
                    <i class="fas fa-eraser me-1"></i> Clear
                </button>

                <div class="dropdown">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item export-pdf" href="#"><i class="fas fa-file-pdf me-1"></i> PDF</a></li>
                        <li><a class="dropdown-item export-excel" href="#"><i class="fas fa-file-excel me-1"></i> Excel</a></li>
                    </ul>
                </div>
                <button type="button" class="btn btn-sm btn-outline-warning GeneralfavBtn">
                    <i class="fas fa-star me-1"></i> Fav
                </button>
            </div>

        </div>
    </div>

    <div class="card-body">
        <form id="generalLedgerForm">
            <fieldset class="border rounded-1 ">

                <input type="hidden" id="GeneralAutoID" name="autoId" />

                <div class="row gx-6">

                    <div class="col-md-12 px-4">

                    <fieldset class="border rounded-3 p-3 mt-2">

                        <div class="row g-3">
                            @* Group Ledger Section *@

                            <div class="col-md-6">
                                <div class="form-floating pe-4">
                                    <input readonly type="text" class="form-control" name="Generalgrlcode" id="Generalgrlcode">
                                    <label for="Generalgrlcode">Group Ledger Code<span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-start">

                                <div class="form-floating form-floating-advance-select flex-grow-1 me-2">
                                    <select class="form-select choiceDD" name="GeneralgrlName" id="GeneralgrlName" tabindex="1"></select>
                                    <label for="GeneralgrlName">Group Ledger Name<span class="text-danger">*</span></label>
                                </div>

                                    <button type="button" 
                                        class="btn btn-sm ms-1 openGroupLedgerModal"
                                        title="Add New Group Ledger"
                                        data-bs-toggle="modal" data-bs-target="#GRLModal">
                                    <i class="fas fa-plus"></i>
                                </button>

                            </div>                              

                            @* Control Ledger Section *@
                            <div class="col-md-6">
                                <div class="form-floating pe-4">
                                    <input readonly type="text" class="form-control" name="GeneralCRLCode" id="GeneralCRLCode">
                                    <label for="GeneralCRLCode">Control Ledger Code<span style="color:red">*</span></label>
                                </div>

                            </div>

                            <div class="col-md-6 d-flex align-items-start px-1">
                                <div class="form-floating form-floating-advance-select flex-grow-1 me-2">
                                    <select class="form-select choiceDD" name="GeneralCRLName" id="GeneralCRLName" tabindex="2">
                                    </select>
                                    <label for="GeneralCRLName">Control Ledger Name<span class="text-danger">*</span></label>
                                </div>
                                <button type="button" 
                                    class="btn btn-sm ms-1 OpenCRLModal" 
                                    title="Add New Control Ledger"
                                    data-bs-toggle="modal" data-bs-target="#UICRLModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>




                            @* Sub-Control Ledger Section *@
                            <div class="col-md-6">
                                <div class="form-floating pe-4">
                                    <input readonly type="text" class="form-control" name="GeneralSCRLCode" id="GeneralSCRLCode">
                                    <label for="GeneralSCRLCode">Sub-Control Ledger Code<span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-start px-1">
                                <div class="form-floating form-floating-advance-select flex-grow-1 me-2">
                                    <select class="form-select choiceDD" name="GeneralSCRLName" id="GeneralSCRLName" tabindex="3">
                                    </select>
                                    <label for="GeneralSCRLName">Sub-Control Ledger Name<span class="text-danger">*</span></label>
                                </div>
                                <button type="button" class="btn btn-sm ms-1 AddSCRL" title="Add New Sub-Control Ledger" data-bs-toggle="modal" data-bs-target="#SCRLModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>



                            @* Sub-Sidiary Ledger Section *@
                            <div class="col-md-6">
                                <div class="form-floating pe-4">
                                    <input readonly type="text" class="form-control" name="SusidiaryLedgerCodeNo" id="GeneralSSLCode">
                                    <label for="SusidiaryLedgerCodeNo">Sub-Sidiary Ledger Code<span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-start px-1">
                                <div class="form-floating form-floating-advance-select flex-grow-1 me-2">
                                    <select class="form-select choiceDD" name="GeneralSSLName" id="GeneralSSLName" tabindex="4">
                                    </select>
                                    <label for="GeneralSSLName">Sub-Sidiary Ledger Name<span class="text-danger">*</span></label>
                                </div>
                                <button type="button" class="btn btn-sm ms-1 SubSidiModal" title="Add New Sub-Sidiary Ledger" data-bs-toggle="modal" data-bs-target="#SSLModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>

                     </fieldset>

                    </div>

                    @* General Ledger Section *@
                    <div class="col-md-12 px-4 mt-2">
                        <fieldset class="border rounded-3 p-3 position-relative">
                            <legend class="float-none w-auto px-2 fw-bold "
                                    style="font-size: 15px; border: 1px solid #dee2e6; border-radius: 6px; background-color: #f8f9fa;">
                                General Ledger Info
                            </legend>
                            <div class="row gx-2">
                                <div class="col-md-6">
                                    <div class="form-floating pe-4">
                                        <input readonly type="text" class="form-control" id="GeneralLedgerCode" name="GeneralLedgerCode">
                                        <label for="GeneralLedgerCode">General Ledger Code<span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating pe-4">
                                        <input type="text" class="form-control" id="GeneralLName" name="GeneralLedgerName" tabindex="5">
                                        <label for="GeneralLName">General Ledger Name<span class="text-danger">*</span></label>
                                    </div>
                                </div>

                            </div>

                        </fieldset>
                    </div>

                    <div class="col-md-12 px-4 mt-2">
                    <fieldset class="border rounded-3 p-2">

                        <div class="row gx-1">
                            <div class="col-md-6 ps-2 align-items-center mt-3">
                                <div class="form-floating form-floating-advance-select pe-4">
                                    <select class="form-select choiceDD" name="CashFlowTypeID" id="CashFlowTypeID">
                                    </select>
                                    <label for="CashFlowTypeID">Cash Flow Type</label>
                                </div>
                            </div>

                            <div class="col-md-6 mt-1">
                                <div class="d-flex justify-content-start align-items-center h-100">
                                    <label class="form-check-label me-4" for="IsActive">
                                        Active Account
                                    </label>
                                    <input class="form-check-input" type="checkbox" value="1" id="IsActive" name="IsActive">
                                </div>
                            </div>
                       </div>
                    </fieldset>

                    </div>

                </div>

              @* Creation/Modify Date Display  *@
                <hr class="my-4 mx-2">
                <div class="row gx-3 px-3">
                        <div class="col-md-6">
                            <div>
                                <span>Entry Date : </span>
                                <span id="GeneralldisplayLDate"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <span>Last Update Date :</span>
                                <span id="GeneraldisplayModifyDate"></span>
                            </div>
                        </div>
                    </div>

                @* Save Button (Bottom)  *@
                <div class="row mt-2 px-1">
                    <div class="col-12 d-flex justify-content-end pb-2">
                        <button type="submit" class="btn btn-outline-primary btn-sm saveBtn">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </div>
            </fieldset>
        </form>
    </div>

</div>