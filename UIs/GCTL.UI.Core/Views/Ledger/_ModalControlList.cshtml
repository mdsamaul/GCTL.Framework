<style>
    .custom-table td {
        padding: 0 !important;
        text-align: center !important;
        vertical-align: middle !important;
        font-size: 0.9rem;
    }

    /* Styling for sortable columns */
    .ModalControlsortable {
        cursor: pointer;
        position: relative;
        user-select: none;
    }

        .ModalControlsortable:hover {
            background-color: #f1f3f5;
        }

    .sort-icon {
        margin-left: 5px;
        opacity: 0.3;
    }

    .sort-asc .sort-icon {
        opacity: 1;
        color: #0d6efd;
    }

    .sort-desc .sort-icon {
        opacity: 1;
        color: #0d6efd;
    }

    .sort-asc .sort-icon:before {
        content: "\f0de";
    }

    .sort-desc .sort-icon:before {
        content: "\f0dd";
    }

    .form-check-input {
        cursor: pointer;
    }

    .table {
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        border-radius: 5px;
    }

        .table thead th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
        }

    .btn-transfer {
        padding: 0.25rem 0.5rem;
        border: none;
        background: transparent;
        color: #0d6efd;
        text-decoration: underline;
        transition: all 0.2s;
    }

        .btn-transfer:hover {
            color: #0a58ca;
            text-decoration: none;
        }
</style>

<div class="d-flex flex-column h-100">
    <div class="card shadow rounded-2 flex-grow-1 d-flex flex-column">
        <!-- Card Header -->
        <div class="card-header bg-light rounded-top-2">
            <div class="row align-items-center">
                <!-- Page Size Dropdown -->
                <div class="col-md-6 d-flex align-items-center mb-2 mb-md-0">
                    <label class="me-2 mb-0">Show</label>
                    <select id="ModalControlListpageSize" class="form-select form-select-sm me-2 ModalControlListpageSize" data-placeholder="10" style="max-width: 90px;">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="-1">All</option>
                    </select>
                    <label class="mb-0">Entries</label>
                </div>

                <!-- Search Input -->
                <div class="col-md-6 d-flex justify-content-md-end">
                    <input type="text" id="ModalControlsearchInput" class="form-control form-control-sm w-100 ModalControlsearchInput" style="max-width: 300px;" placeholder="Search...">
                </div>
            </div>
        </div>

        <!-- Card Body with Responsive Table -->
        <div class="card-body p-2 flex-grow-1 d-flex flex-column">
            <div class="table-responsive flex-grow-1" style="table-layout:fixed; width:100%">
                <table class="table table-hover table-sm table-bordered mb-0">
                    <thead class="table-light text-nowrap sticky-top" style="font-size: 0.8rem;">
                        <tr>
                            <th class="text-center" style="width: 40px;">
                                <input type="checkbox" id="ModalControlselectAll" class="form-check-input">
                            </th>
                            <th class="ModalControlsortable" data-column="SubControlLedgerCodeNo" style="width: 140px;">
                                ID <i class="sort-icon fas fa-sort"></i>
                            </th>
                            <th class="ModalControlsortable" data-column="SubControlLedgerName">
                                Control Ledger Name <i class="sort-icon fas fa-sort"></i>
                            </th>
                            <th class="ModalControlsortable" data-column="ShortName" style="width: 180px;">
                                Short Name <i class="sort-icon fas fa-sort"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="ModalcontrolTblBody" class="align-middle">
                        <!-- AJAX Data Render Target -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Card Footer with Pagination Controls -->
        <div class="card-footer bg-light sticky-bottom py-2">
            <div class="row align-items-center mb-2">
                <div class="col-4">
                    <span id="ModalControlpaginationInfo" class="text-muted" style="font-size: 0.8rem;"></span>
                </div>
                <div class="col-4 text-center">
                    <span id="ModalControlpaginationSummary" class="text-primary fw-semibold" style="font-size: 0.8rem;"></span>
                </div>
                <div class="col-4 text-end">
                    <span id="ModalControltotalRecordsInfo" class="text-muted" style="font-size: 0.8rem;"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-12 d-flex justify-content-center align-items-center">
                    <div class="btn-group">
                        <button type="button" id="ModalControlfirstPage" class="btn btn-outline-primary btn-sm">First</button>
                        <button type="button" id="ModalControlprevPage" class="btn btn-outline-primary btn-sm">Previous</button>
                    </div>

                    <div id="ModalControlpageNavigation" class="btn-group mx-2">
                        <!-- Page numbers inserted dynamically -->
                    </div>

                    <div class="btn-group">
                        <button type="button" id="ModalControlnextPage" class="btn btn-outline-primary btn-sm">Next</button>
                        <button type="button" id="ModalControllastPage" class="btn btn-outline-primary btn-sm">Last</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>