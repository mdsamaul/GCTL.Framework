<style>
    .form-floating .selectLabel {
        font-size: 14px !important;
    }

    .form-floating label {
        text-transform: none;
        font-size: 13px;
    }

    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }

    #button-div button {
        padding: 8px 6px;
        width: 80px;
    }

    .Entrydatesection span,
    .Updatesection span {
        white-space: nowrap;
    }

</style>

<div class="card shadow-sm rounded-2">

    <div class="px-1 card-header bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap">
        <div class="d-flex flex-nowrap justify-content-between w-100 align-items-center">

            <div>
                <h4 class="mb-0 heading-nowrap " style="font-size:14px">Group Ledger</h4>
            </div>
            <div class="d-flex gap-1" id="button-div">
                <button type="submit" form="groupForm" class="btn btn-sm btn-outline-primary saveBtn">
                    <i class="fas fa-save me-1"></i> Save
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger deleteBtn" id="deleteBtn">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>
                <button type="reset" class="btn btn-sm btn-outline-secondary resetBtn">
                    <i class="fas fa-eraser me-1"></i> Clear
                </button>
                <div class="dropdown">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item export-pdf" href="#"><i class="fas fa-file-pdf me-1"></i> PDF</a></li>
                        <li><a class="dropdown-item export-excel" href="#"><i class="fas fa-file-excel me-1"></i> Excel</a></li>
                    </ul>
                </div>
                <button type="button" class="btn btn-sm btn-outline-warning favBtn">
                    <i class="fas fa-star me-1"></i> Fav
                </button>
            </div>
        </div>
    </div>

    <div class="card-body">
        <form id="groupForm">

            <fieldset style="border:1px solid #ccc; padding:15px; border-radius:5px;">

                <input type="hidden" id="autoId" name="autoId" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="ControlLedgerCodeNo" id="ControlLedgerCodeNo">
                            <label for="ControlLedgerCodeNo">Group Ledger Code<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="ControlLedgerName" id="ControlLedgerName">
                            <label for="ControlLedgerName">Group Ledger Name<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="ShortName" id="ShortName">
                            <label for="ShortName">Short Name</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4 mx-2">

                @* Creation/Modify Date Display *@
                <div class="row g-3">
                    <div class="col-md-6" >
                        <div class="Entrydatesection">
                            <span>Entry Date : </span>
                            <span id="EntryDate"></span>
                        </div>
                    </div>

                    <div class="col-md-6" >
                        <div class="Updatesection" >
                            <span>Last Update Date :</span>
                            <span id="UpdateDate"></span>
                        </div>
                    </div>
                </div>

                 @* Save Button (Bottom) *@
                <div class="row mt-1">
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-outline-primary btn-sm saveBtn">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </div>

            </fieldset>
        </form>
    </div>
</div>