@using GCTL.UI.Core.ViewModels

<div class="card shadow-sm rounded-2">

    @* ================= Toolbar Section ================= *@
    @await Html.PartialAsync("_Toolbars", new ToobarModel
    {
        Title = "Sub-Sidiary Ledger",
        ShowSave = true,
        SaveBtnId = "btnSave",
        SaveBtnClass = "js-SubSidiary-save",
        EnableSave = true,

        ShowDelete = true,
        DeleteBtnId = "SubSidiarydeleteBtn",
        DeleteBtnClass = "js-SubSidiary-delete-confirm SubcontroldeleteBtn",
        EnableDelete = true,

        ShowClear = true,
        ClearBtnId = "btnClear",
        ClearBtnClass = "js-SubSidiary-clear SubSidiaryresetBtn",
        EnableClear = true,

        ShowPrint = true,
        PrintBtnId = "btnPrint",
        PrintBtnClass = "printBtn",
        ExcelBtnClass = "export-excel",
        PdfBtnClass = "export-pdf",
        EnablePrint = true,

        ShowFavorite = true,
        FavtBtnId = "btnFav",
        FavtBtnClass = "subSidiaryfavBtn",
        EnableFavorite = true
    })

    <div class="card-body">
        <form id="subSidiaryForm">
            <fieldset style="border: 1px solid #ccc; padding: 12px; border-radius: 5px;">
                <input type="hidden" id="forsidiaryAutoID" name="autoId" />

                <div class="row g-3">
                    @* --- 1. Group Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiarygroupcode",
                        InputName = "GLCode",
                        LabelText = "Group Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 2. Group Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "forsidiarygroupName",
                        InputName = "forsidiarygroupName",
                        LabelText = "Group Ledger Name",
                        Placeholder = "-- Select Group Ledger --",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        QuickAddTarget = "#GRLModal",
                        QuickAddTitle = "Add New Group Ledger"
                    })

                    @* --- 3. Group Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiarygroupshortName",
                        InputName = "GLShortName",
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 4. Control Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiaryControlCode",
                        InputName = "CRLCode",
                        LabelText = "Control Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 5. Control Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "forsidiaryControlName",
                        InputName = "CRLName",
                        LabelText = "Control Ledger Name",
                        Placeholder = "-- Select Control Ledger --",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        QuickAddTarget = "#UICRLModal",
                        QuickAddTitle = "Add New Control Ledger"
                    })

                    @* --- 6. Control Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiaryCLShortName",
                        InputName = "CRLShortName",
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 7. Sub-Control Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiaryGeneralLedgerCodeNo",
                        InputName = "GeneralLedgerCodeNo",
                        LabelText = "Sub-Control Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 8. Sub-Control Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "forsidiaryGeneralLedgerName",
                        InputName = "forsidiaryGeneralLedgerName",
                        LabelText = "Sub-Control Ledger Name",
                        Placeholder = "-- Select Sub-Control Ledger --",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        QuickAddTarget = "#SCRLModal",
                        QuickAddTitle = "Add New Sub-Control Ledger"
                    })

                    @* --- 9. Sub-Control Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiarySubCRLshortName",
                        InputName = "SubCRLShortName",
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 10. Sub-Sidiary Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "SusidiaryLedgerCodeNo",
                        InputName = "SusidiaryLedgerCodeNo",
                        LabelText = "Sub-Sidiary Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 11. Sub-Sidiary Ledger Name --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "SubsidiaryLedgerName",
                        InputName = "SubsidiaryLedgerName",
                        LabelText = "Sub-Sidiary Ledger Name",
                        IsRequired = true,
                        Placeholder = "Sub-Sidiary Ledger Name"
                    })

                    @* --- 12. Short Name --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiaryshortName",
                        InputName = "ShortName",
                        LabelText = "Short Name",
                        Placeholder = "Short Name"
                    })
                </div>

                <hr class="my-3 mx-1">

                @* --- Entry & Update Date Section --- *@
                <div class="row g-3">
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "EntryDate",
                        LabelText = "Entry Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "UpdateDate",
                        LabelText = "Last Update Date:",
                        LabelInline = true,
                        LabelColWidth = 4,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:13px;",
                        InputStyle = "font-size:13px;"
                    })
                </div>

                @* Bottom Save Button *@
                <div class="row no-print" style="margin-top: 9px;">
                    <div class="col-12">
                        @await Html.PartialAsync("_Toolbars", new ToobarModel
                        {
                            Title = "",
                            ShowClear = false,
                            ShowDelete = false,
                            ShowPrint = false,
                            ShowFavorite = false,
                            IsPlain = true,
                            ReserveActionSlot = true,
                            IsMarginRight = true,
                            SaveBtnType = "submit"

                        })
                    </div>
                </div>

            </fieldset>
        </form>
    </div>
</div>