@using GCTL.UI.Core.ViewModels

<style>
    /* ==========================================================================
       Sub-Sidiary Ledger Form: Responsive 3-Column Equal Width & Quick-Add In-Gap Layout
       Optimized for Desktop and Laptop (1362x768 / <= 1400px) Screens
       ========================================================================== */
    :root {
        --control-height: 31px;
        --gap-size: 36px;
        --btn-width: 20px;
    }

    .subsidiary-ledger-fields-row,
    .control-ledger-fields-row {
        --control-height: 31px;
        --gap-size: 36px;
        --btn-width: 20px;
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: space-between !important;
        row-gap: 12px !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    /* 3 Equal Columns: (100% - 2 * gap) / 3 -> Exactly 0 gap on right side! */
    .subsidiary-ledger-fields-row > [class*="col-"],
    .subsidiary-ledger-fields-row > div,
    .control-ledger-fields-row > [class*="col-"],
    .control-ledger-fields-row > div {
        flex: 0 0 calc((100% - (2 * var(--gap-size))) / 3) !important;
        max-width: calc((100% - (2 * var(--gap-size))) / 3) !important;
        width: calc((100% - (2 * var(--gap-size))) / 3) !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        box-sizing: border-box !important;
        position: relative !important;
        overflow: visible !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-start !important;
        align-items: stretch !important;
    }

    /* Fixed, uniform height for ALL labels so all inputs start on the exact same line */
    .subsidiary-ledger-fields-row .form-label,
    .control-ledger-fields-row .form-label {
        display: flex !important;
        align-items: center !important;
        height: 20px !important;
        min-height: 20px !important;
        max-height: 20px !important;
        line-height: 20px !important;
        margin-top: 0 !important;
        margin-bottom: 4px !important;
        padding: 0 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        font-size: 13px !important;
        box-sizing: border-box !important;
    }

    .subsidiary-ledger-fields-row .form-label .text-danger,
    .subsidiary-ledger-fields-row .form-label sup,
    .subsidiary-ledger-fields-row .form-label span,
    .control-ledger-fields-row .form-label .text-danger,
    .control-ledger-fields-row .form-label sup,
    .control-ledger-fields-row .form-label span {
        font-size: 13px !important;
        line-height: 1 !important;
        vertical-align: middle !important;
        margin-left: 2px !important;
        display: inline-block !important;
    }

    .subsidiary-ledger-fields-row .field-fixed-width,
    .control-ledger-fields-row .field-fixed-width {
        position: relative !important;
        width: 100% !important;
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        display: flex !important;
        align-items: stretch !important;
        margin: 0 !important;
        padding: 0 !important;
        gap: 0 !important;
        overflow: visible !important;
        box-sizing: border-box !important;
    }

    .subsidiary-ledger-fields-row .input-group,
    .control-ledger-fields-row .input-group {
        width: 100% !important;
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: stretch !important;
        box-sizing: border-box !important;
    }

    .subsidiary-ledger-fields-row .field-fixed-width > .input-group,
    .control-ledger-fields-row .field-fixed-width > .input-group {
        width: 100% !important;
        flex: 1 1 100% !important;
        min-width: 0 !important;
    }

    /* Uniform height for ALL inputs, selects, custom dropdowns, input-groups, and buttons */
    .subsidiary-ledger-fields-row .form-control,
    .subsidiary-ledger-fields-row .form-select,
    .subsidiary-ledger-fields-row input:not([type="hidden"]),
    .subsidiary-ledger-fields-row select,
    .subsidiary-ledger-fields-row .custom-dd-box,
    .subsidiary-ledger-fields-row .custom-dd-wrapper,
    .subsidiary-ledger-fields-row .detached-action-btn,
    .subsidiary-ledger-fields-row .js-quick-add,
    .control-ledger-fields-row .form-control,
    .control-ledger-fields-row .form-select,
    .control-ledger-fields-row input:not([type="hidden"]),
    .control-ledger-fields-row select,
    .control-ledger-fields-row .custom-dd-box,
    .control-ledger-fields-row .custom-dd-wrapper,
    .control-ledger-fields-row .detached-action-btn,
    .control-ledger-fields-row .js-quick-add {
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        vertical-align: top !important;
    }

    .subsidiary-ledger-fields-row .form-control,
    .subsidiary-ledger-fields-row input:not([type="hidden"]),
    .control-ledger-fields-row .form-control,
    .control-ledger-fields-row input:not([type="hidden"]) {
        line-height: calc(var(--control-height) - 2px) !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .subsidiary-ledger-fields-row .custom-dd-box,
    .control-ledger-fields-row .custom-dd-box {
        display: flex !important;
        align-items: center !important;
        line-height: calc(var(--control-height) - 2px) !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .subsidiary-ledger-fields-row .custom-dd-input,
    .control-ledger-fields-row .custom-dd-input {
        height: calc(var(--control-height) - 4px) !important;
        line-height: calc(var(--control-height) - 4px) !important;
        margin: 0 !important;
    }

    .subsidiary-ledger-fields-row .field-validation:empty,
    .control-ledger-fields-row .field-validation:empty {
        display: none !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* Quick-Add (+) Button positioned directly inside the gap with zero overlap and NO border */
    .subsidiary-ledger-fields-row .field-fixed-width > .detached-action-btn,
    .subsidiary-ledger-fields-row .field-fixed-width > .js-quick-add,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add {
        position: absolute !important;
        left: calc(100% + 4px) !important;
        top: 0 !important;
        bottom: 0 !important;
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        width: var(--btn-width) !important;
        min-width: var(--btn-width) !important;
        max-width: var(--btn-width) !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        z-index: 5 !important;
        margin: 0 !important;
        border: 0 !important;
        border-color: transparent !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: #495057 !important;
        border-radius: 4px !important;
        cursor: pointer !important;
        box-sizing: border-box !important;
    }

    .subsidiary-ledger-fields-row .field-fixed-width > .detached-action-btn:hover,
    .subsidiary-ledger-fields-row .field-fixed-width > .js-quick-add:hover,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn:hover,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add:hover {
        border: 0 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        background: #e9ecef !important;
        color: #0d6efd !important;
    }

    .subsidiary-ledger-fields-row .field-fixed-width > .detached-action-btn:focus,
    .subsidiary-ledger-fields-row .field-fixed-width > .js-quick-add:focus,
    .subsidiary-ledger-fields-row .field-fixed-width > .detached-action-btn:active,
    .subsidiary-ledger-fields-row .field-fixed-width > .js-quick-add:active,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn:focus,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add:focus,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn:active,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add:active {
        border: 0 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        outline: none !important;
    }

    .subsidiary-ledger-fields-row .field-fixed-width > .detached-action-btn i,
    .subsidiary-ledger-fields-row .field-fixed-width > .js-quick-add i,
    .control-ledger-fields-row .field-fixed-width > .detached-action-btn i,
    .control-ledger-fields-row .field-fixed-width > .js-quick-add i {
        font-size: 11px !important;
    }

    /* ==========================================================================
       Responsive for Laptop Screens (<= 1400px, e.g. 1362x768 / 1366x768)
       ========================================================================== */
    @@media (max-width: 1400px) {
        .subsidiary-ledger-fields-row,
        .control-ledger-fields-row {
            --control-height: 28px !important;
            --gap-size: 34px !important;
            --btn-width: 18px !important;
            row-gap: 8px !important;
        }

        .subsidiary-ledger-fields-row .form-label,
        .control-ledger-fields-row .form-label {
            font-size: 11.5px !important;
            height: 18px !important;
            min-height: 18px !important;
            max-height: 18px !important;
            line-height: 18px !important;
            margin-bottom: 3px !important;
            font-weight: 500 !important;
        }

        .subsidiary-ledger-fields-row .form-label .text-danger,
        .subsidiary-ledger-fields-row .form-label sup,
        .subsidiary-ledger-fields-row .form-label span,
        .control-ledger-fields-row .form-label .text-danger,
        .control-ledger-fields-row .form-label sup,
        .control-ledger-fields-row .form-label span {
            font-size: 12px !important;
        }

        .subsidiary-ledger-fields-row .form-control,
        .subsidiary-ledger-fields-row .form-select,
        .subsidiary-ledger-fields-row input:not([type="hidden"]),
        .subsidiary-ledger-fields-row select,
        .subsidiary-ledger-fields-row .custom-dd-box,
        .subsidiary-ledger-fields-row .custom-dd-input,
        .control-ledger-fields-row .form-control,
        .control-ledger-fields-row .form-select,
        .control-ledger-fields-row input:not([type="hidden"]),
        .control-ledger-fields-row select,
        .control-ledger-fields-row .custom-dd-box,
        .control-ledger-fields-row .custom-dd-input {
            font-size: 12px !important;
            padding-left: 6px !important;
            padding-right: 6px !important;
        }

        .subsidiary-ledger-fields-row .field-fixed-width > .detached-action-btn i,
        .subsidiary-ledger-fields-row .field-fixed-width > .js-quick-add i,
        .control-ledger-fields-row .field-fixed-width > .detached-action-btn i,
        .control-ledger-fields-row .field-fixed-width > .js-quick-add i {
            font-size: 10px !important;
        }

        /* Compact card & fieldset for 768px vertical resolution */
        #subsidiaryFormView .card-body {
            padding: 8px 12px !important;
        }

        #subsidiaryFormView fieldset {
            padding: 8px 10px !important;
        }

        #subsidiaryFormView hr {
            margin-top: 6px !important;
            margin-bottom: 6px !important;
        }

        #subsidiaryFormView .table-toolbar {
            padding: 4px 8px !important;
        }
    }

    /* Mobile / Small Screens */
    @@media (max-width: 767.98px) {
        .subsidiary-ledger-fields-row > [class*="col-"],
        .subsidiary-ledger-fields-row > div,
        .control-ledger-fields-row > [class*="col-"],
        .control-ledger-fields-row > div {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            width: 100% !important;
        }

        .subsidiary-ledger-fields-row .field-fixed-width,
        .control-ledger-fields-row .field-fixed-width {
            gap: 8px !important;
        }

        .subsidiary-ledger-fields-row .field-fixed-width > .input-group,
        .control-ledger-fields-row .field-fixed-width > .input-group {
            flex: 1 1 auto !important;
            width: auto !important;
        }

        .subsidiary-ledger-fields-row .field-fixed-width > .detached-action-btn,
        .subsidiary-ledger-fields-row .field-fixed-width > .js-quick-add,
        .control-ledger-fields-row .field-fixed-width > .detached-action-btn,
        .control-ledger-fields-row .field-fixed-width > .js-quick-add {
            position: static !important;
            transform: none !important;
            width: 28px !important;
            min-width: 28px !important;
            border: 0 !important;
        }
    }

    /* Bottom Toolbar in Sub-Sidiary Ledger: 0px border */
    #subSidiaryForm .toolbar-container,
    #subsidiaryForm .toolbar-container,
    #subsidiaryFormView .card-body .toolbar-container,
    #subSidiaryForm .row.no-print .toolbar-container {
        border: 0 !important;
        border-bottom: 0px !important;
        box-shadow: none !important;
    }
</style>

<div class="card shadow-sm rounded-2">

    @* ================= Toolbar Section ================= *@
    @await Html.PartialAsync("_Toolbars", new ToobarModel
    {
        Title = "Sub-Sidiary Ledger",
        ShowSave = true,
        SaveBtnId = "btnSave",
        SaveBtnClass = "js-SubSidiary-save",
        EnableSave = true,

        ShowDelete = true,
        DeleteBtnId = "SubSidiarydeleteBtn",
        DeleteBtnClass = "js-SubSidiary-delete-confirm SubcontroldeleteBtn",
        EnableDelete = true,

        ShowClear = true,
        ClearBtnId = "btnClear",
        ClearBtnClass = "js-SubSidiary-clear SubSidiaryresetBtn",
        EnableClear = true,

        ShowPrint = true,
        PrintBtnId = "btnPrint",
        PrintBtnClass = "printBtn",
        ExcelBtnClass = "export-excel",
        PdfBtnClass = "export-pdf",
        EnablePrint = true,

        ShowFavorite = true,
        FavtBtnId = "btnFav",
        FavtBtnClass = "subSidiaryfavBtn",
        EnableFavorite = true
    })

    <div class="card-body p-0">
        <form id="subSidiaryForm">
            <fieldset style="padding: 12px; border-radius: 5px;">
                <input type="hidden" id="forsidiaryAutoID" name="autoId" />

                <div class="row subsidiary-ledger-fields-row control-ledger-fields-row">
                    @* --- 1. Group Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiarygroupcode",
                        InputName = "GLCode",
                        LabelText = "Group Ledger Code",
                        ReserveActionSlot = false,
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 2. Group Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "forsidiarygroupName",
                        InputName = "forsidiarygroupName",
                        LabelText = "Group Ledger Name",
                        Placeholder = "Select Group Ledger",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        ReserveActionSlot = false,
                        QuickAddTarget = "#GRLModal",
                        QuickAddTitle = "Add New Group Ledger"
                    })

                    @* --- 3. Group Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiarygroupshortName",
                        ReserveActionSlot = false,
                        InputName = "GLShortName",
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 4. Control Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiaryControlCode",
                        InputName = "CRLCode",
                        LabelText = "Control Ledger Code",
                        ReserveActionSlot = false,
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 5. Control Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "forsidiaryControlName",
                        InputName = "CRLName",
                        LabelText = "Control Ledger Name",
                        ReserveActionSlot = false,
                        Placeholder = "Select Control Ledger",
                        IsRequired = true,
                        ShowQuickAdd = true,
                        QuickAddTarget = "#UICRLModal",
                        QuickAddTitle = "Add New Control Ledger"
                    })

                    @* --- 6. Control Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiaryCLShortName",
                        ReserveActionSlot = false,
                        InputName = "CRLShortName",
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 7. Sub-Control Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiaryGeneralLedgerCodeNo",
                        InputName = "GeneralLedgerCodeNo",
                        ReserveActionSlot = false,
                        LabelText = "Sub-Control Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 8. Sub-Control Ledger Name (Quick Add Select) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.QuickAddSelect,
                        InputId = "forsidiaryGeneralLedgerName",
                        InputName = "forsidiaryGeneralLedgerName",
                        LabelText = "Sub-Control Ledger Name",
                        Placeholder = "Select Sub-Control Ledger",
                        IsRequired = true,
                        ReserveActionSlot = false,
                        ShowQuickAdd = true,
                        QuickAddTarget = "#SCRLModal",
                        QuickAddTitle = "Add New Sub-Control Ledger"
                    })

                    @* --- 9. Sub-Control Ledger Short Name (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiarySubCRLshortName",
                        ReserveActionSlot = false,
                        InputName = "SubCRLShortName",
                        LabelText = "Short Name",
                        IsReadonly = true
                    })

                    @* --- 10. Sub-Sidiary Ledger Code (Readonly) --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "SusidiaryLedgerCodeNo",
                        InputName = "SusidiaryLedgerCodeNo",
                        ReserveActionSlot = false,
                        LabelText = "Sub-Sidiary Ledger Code",
                        IsRequired = true,
                        IsReadonly = true
                    })

                    @* --- 11. Sub-Sidiary Ledger Name --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "SubsidiaryLedgerName",
                        InputName = "SubsidiaryLedgerName",
                        LabelText = "Sub-Sidiary Ledger Name",
                        ReserveActionSlot = false,
                        IsRequired = true,
                        Placeholder = "Sub-Sidiary Ledger Name"
                    })

                    @* --- 12. Short Name --- *@
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-4",
                        FieldType = FieldType.Text,
                        InputId = "forsidiaryshortName",
                        InputName = "ShortName",
                        ReserveActionSlot = false,
                        LabelText = "Short Name",
                        Placeholder = "Short Name"
                    })
                </div>

                <hr class="my-3 mx-1">

                @* --- Entry & Update Date Section --- *@
                <div class="row g-2 align-items-center">
                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "EntryDate",
                        LabelText = "Entry Date:",
                        LabelInline = true,
                        LabelColWidth = 5,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:12px; white-space: nowrap;",
                        InputStyle = "font-size:12px; white-space: nowrap;"
                    })

                    @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                    {
                        IsVisible = true,
                        ShowOnInit = true,
                        ColumnClass = "col-md-6",
                        FieldType = FieldType.ReadonlyDisplay,
                        InputId = "UpdateDate",
                        LabelText = "Last Update Date:",
                        LabelInline = true,
                        LabelColWidth = 5,
                        LabelColumnClass = "text-end",
                        LabelStyle = "font-size:12px; white-space: nowrap;",
                        InputStyle = "font-size:12px; white-space: nowrap;"
                    })
                </div>

                @* Bottom Save Button *@
                <div class="row no-print">
                    <div class="col-12">
                        @await Html.PartialAsync("_Toolbars", new ToobarModel
                        {
                            Title = "",
                            ShowClear = false,
                            ShowDelete = false,
                            ShowPrint = false,
                            ShowFavorite = false,
                            IsPlain = true,
                            ReserveActionSlot = false,
                            SaveBtnType = "submit",
                            Style = "border:0px !important; border-bottom:0px !important; box-shadow:none !important;"
                        })
                    </div>
                </div>

            </fieldset>
        </form>
    </div>
</div>