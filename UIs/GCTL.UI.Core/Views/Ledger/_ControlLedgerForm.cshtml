<style>
    .form-floating .selectLabel {
        font-size: 14px !important;
    }

    .form-floating label {
        text-transform: none;
        font-size: 13px;
    }

    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .ControldeleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .ControlresetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .confavBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }

    #button-div button {
        padding: 8px 6px;
        width: 80px;
    }

.openGroupLedgerModal:focus {
    outline: none !important;   
    box-shadow: none !important;
   
}

    .openGroupLedgerModal:hover {
        color: green !important; 
        cursor: pointer; 
    }

    #grpbutton1 {
        position:absolute;
        right: -1.2rem;
        top: 5%;
        transform: translateY(-5%);
    }

  @@media (max-width: 767.98px) {
    #grpbutton1{
        position: relative;
        top: auto;
        right: auto;
        transform: none;
        margin-top: 5px; 
    }


    }
</style>



<div class="card shadow-sm rounded-2">

    <div class="px-1 card-header bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap">
        <div class="d-flex flex-nowrap justify-content-between w-100 align-items-center">

            <div>
                <h4 class="mb-0 heading-nowrap " style="font-size:14px">Control Ledger</h4>
            </div>
            <div class="d-flex gap-1" id="button-div">

                <button type="submit" form="controlForm" class="btn btn-sm btn-outline-primary saveBtn">
                    <i class="fas fa-save me-1"></i> Save
                </button>

                <button type="button" class="btn btn-sm btn-outline-danger ControldeleteBtn" id="ControldeleteBtn">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>

                <button type="reset" class="btn btn-sm btn-outline-secondary ControlresetBtn">
                    <i class="fas fa-eraser me-1"></i> Clear
                </button>

                <div class="dropdown">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item export-pdf" href="#"><i class="fas fa-file-pdf me-1"></i> PDF</a></li>
                        <li><a class="dropdown-item export-excel" href="#"><i class="fas fa-file-excel me-1"></i> Excel</a></li>
                    </ul>
                </div>
                <button type="button" class="btn btn-sm btn-outline-warning confavBtn">
                    <i class="fas fa-star me-1"></i> Fav
                </button>
            </div>

        </div>
    </div>

    <div class="card-body">
        <form id="controlForm">
            <fieldset style="border:1px solid #ccc; padding:8px; border-radius:5px;">

                <input type="hidden" id="autoId" name="autoId" />

                <div class="row gx-6">
                    <div class="col-md-4 ">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="ControlLedgerCodeNo" id="GroupLedgerCodeNo">
                            <label for="ControlLedgerCodeNo">Group Ledger Code<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-4" style="position: relative;">
                        <div class="form-floating form-floating-advance-select">
                            <select class="form-select choiceDD" name="GroupLedgerName" id="GLName">
                            </select>
                            <label for="GroupLedgerName">Group Ledger Name</label>
                        </div>

                        <button type="button" id="grpbutton1"
                                class="btn btn-sm openGroupLedgerModal"
                                data-bs-toggle="modal"
                                data-bs-target="#GRLModal"
                               title="Add New Group Ledger" >                           
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>

                    <div class="col-md-4 ">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control " name="GroupLedgerShortName" id="GroupLedgerShortName">
                            <label for="GroupLedgerShortName">Short Name</label>
                        </div>
                    </div>


                    <div class="col-md-4 ">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="SubControlLedgerCodeNo" id="SubControlLedgerCodeNo">
                            <label for="SubControlLedgerCodeNo">Control Ledger Code<span style="color:red">*</span></label>
                        </div>
                    </div>
                    <div class="col-md-4 ">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="SubControlLedgerName" id="SubControlLedgerName">
                            <label for="SubControlLedgerName">Control Ledger Name<span style="color:red">*</span></label>
                        </div>

                    </div>

                    <div class="col-md-4 ">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="ShortName" id="ControlShortName">
                            <label for="ShortName">Short Name</label>
                        </div>
                    </div>

                </div>

                <hr class="my-4 mx-2 pb-2">

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="ControlEntrydatesection">
                            <span>Entry Date : </span>
                            <span id="ControlEntryDate"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="ControlUpdatesection">
                            <span>Last Update Date :</span>
                            <span id="ControlUpdateDate"></span>
                        </div>
                    </div>

                </div>

                @* Save Button (Bottom) *@
                <div class="row mt-2">
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-outline-primary btn-sm saveBtn">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </div>

            </fieldset>
        </form>
    </div>

</div>