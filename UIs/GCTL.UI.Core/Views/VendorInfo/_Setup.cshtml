@model GCTL.Core.ViewModels.VendorInfo.VendorInfoSetupViewModel

<div style="padding-top: 10px;">
    <div class="card-header py-0">
        @await Html.PartialAsync("_TabButton")
    </div>
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>
    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <div class="col-lg-6">
            <label asp-for="VendorId">ID </label>
            <div class="input-group input-group-sm">
                <input asp-for="VendorId" type="text" class="form-control form-control-sm js-VendorId-code" readonly="readonly" />
            </div>
        </div>
        <div class="col-lg-6">
            <label asp-for="VendorPrefix">Vendor Prefix<span style="color:red">*</span></label>
            <div class="Ven-input-wrapper">
                <div class="Ven-select-wrap">
                    <select asp-for="VendorPrefix"
                            asp-items="ViewBag.VendorPrefixDD"
                            class="form-control form-control-sm custom-select-single"
                            tabindex="1" data-placeholder="Select Vendor Prefix">
                        <option value=""></option>
                    </select>
                </div>
                <button type="button" class="btn btn-plus js-quick-add"
                        data-url="@Url.Action("Index", "VendorPrefix")"
                        data-target="#VendorPrefix"
                        data-reload-url="@Url.Action("GetVendorPrefixs", "Cascading")"
                        data-title="Vendor Prefix">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="VendorCode">Vendor Code</label>
            <input type="text" asp-for="VendorCode" class="form-control form-control-sm" placeholder="Enter Vendor Code" tabindex="2" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Name"> Name<span style="color:red">*</span></label>
            <input type="text" asp-for="Name" class="form-control form-control-sm" placeholder="Enter Name" tabindex="3" />
        </div>

        <div class="col-lg-6">
            <label asp-for="Address">Address</label>
            <input type="text" asp-for="Address" class="form-control form-control-sm" placeholder="Enter Address" tabindex="4" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="CountryId">Country</label>
            <div class="input-group">
                <select asp-for="CountryId" class="form-control form-control-sm custom-select-single" tabindex="3" data-placeholder="-- Select Country --" asp-items="@ViewBag.CountryDD as SelectList">
                    <option></option>
                </select>
            </div>
        </div>

        <div class="col-lg-6">
            <label asp-for="City">City</label>
            <input type="text" asp-for="City" class="form-control form-control-sm" placeholder="Enter City" tabindex="6" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="StateOrProvince">State/Province</label>
            <input type="text" asp-for="StateOrProvince" class="form-control form-control-sm" placeholder="Enter State/Province" tabindex="7" />
        </div>

        <div class="col-lg-6">
            <label asp-for="ZipCode">Zip Code</label>
            <input type="text" asp-for="ZipCode" class="form-control form-control-sm" placeholder="Enter Zip Code" tabindex="8" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="VatRegNo">Vat Reg. No.</label>
            <input type="text" asp-for="VatRegNo" class="form-control form-control-sm" placeholder="Enter Vat Reg. No." tabindex="9" />
        </div>

        <div class="col-lg-6">
            <label asp-for="Phone">Phone</label>
            <input type="text" asp-for="Phone" class="form-control form-control-sm" placeholder="Enter Phone" tabindex="10" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Fax">Fax</label>
            <input type="text" asp-for="Fax" class="form-control form-control-sm" placeholder="Enter Fax" tabindex="11" />
        </div>

        <div class="col-lg-6">
            <label asp-for="Email">Email</label>
            <input type="text" asp-for="Phone" class="form-control form-control-sm" placeholder="Enter Email" tabindex="12" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Website">Website</label>
            <input type="text" asp-for="Website" class="form-control form-control-sm" placeholder="Enter Website" tabindex="13" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Cpid">Contact Person</label>
            <div class="Ven-input-wrapper">
                
                    <select asp-for="Cpid"
                            asp-items="ViewBag.ContactDD"
                        class="form-control form-control-sm custom-select-multi"
                            tabindex="14" data-placeholder="Select Contact Person">
                        <option value=""></option>
                    </select>
               
                <button type="button" class="btn btn-plus js-quick-add"
                        data-url="@Url.Action("Index", "ContactPersonInfo")"
                        data-target="#Cpid"
                        data-reload-url="@Url.Action("GetCountrys", "Cascading")"
                        data-title="Contact Person Info">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>

        <div class="col-lg-6">
            <label asp-for="Remarks">Remarks</label>
            <input type="text" asp-for="Remarks" class="form-control form-control-sm" placeholder="Enter Remarks" tabindex="15" />
        </div>
    </div>

    <hr id="sectionBreak" />

    @* Creation / Update Dates *@
    <div class="row" id="LdateModifyHide">
        <div class="col-12 col-md-6 d-flex align-items-center justify-content-between">
            <label class="col-6 form-label col-form-label-sm d-flex justify-content-end">Creation Date:</label>
            <div class="col-6">
                <label id="creationDateSpan">
                    @(Model.Ldate.HasValue ? Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt") : "")
                </label>
            </div>
        </div>
        <div class="col-12 col-md-6 d-flex align-items-center justify-content-between">
            <label class="col-6 form-label col-form-label-sm d-flex justify-content-end">Last Update Date:</label>
            <div class="col-6">
                <label id="modifyDateSpan">
                    @(Model.ModifyDate.HasValue ? Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt") : "")
                </label>
            </div>
        </div>
    </div>

</div>
<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "VendorInfo"
        })
    </div>
</div>
