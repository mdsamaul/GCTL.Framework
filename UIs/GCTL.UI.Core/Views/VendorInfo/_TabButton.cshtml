<div class="tabwrap mb-1" style="z-index: 100; width: 100%;">
    <ul class="MenuTab">
        <li style="width: 16%;" class="js-tab-item">
            <a href="/VendorInfo/Setup?PageID=41" class="js-tab-link">Vendor Info</a>
        </li>
        <li style="width: 16%;" class="js-tab-item">
            <a href="/BranchAddress/Setup?PageID=41" class="js-tab-link">Branch Address</a>
        </li>
    </ul>
</div>

<link href="~/css/custom/tabbutton.css" rel="stylesheet" />

<script>
    $(function () {
        var currentPath = window.location.pathname.toLowerCase();

        $('.js-tab-item').each(function () {
            var linkPath = $(this).find('a.js-tab-link').attr('href').split('?')[0].toLowerCase();
            if (currentPath === linkPath) {
                $(this).addClass('selected');
            }
        });
    });
</script>