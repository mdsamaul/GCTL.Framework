@model GCTL.Core.ViewModels.UnitType.UnitTypeSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="AutoId" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Unit Type ID (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "UnitTypID",
            LabelText = "Unit Type ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-unittype-code",
            DefaultValue = Model?.UnitTypID
        })

        @* ---------- Unit Type Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "UnitTypeName",
            LabelText = "Unit Type Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Unit Type Name",
            IsRequired = true,
            ColumnClass = "col-lg-6",
            ReserveActionSlot = false,
            CustomCssClass = "js-unittype-check-availability",
            DefaultValue = Model?.UnitTypeName,
            AutoFocus = true
        })
    </div>

    <div class="form-group row">
        @* ---------- Short Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ShortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ColumnClass = "col-lg-6",
            ReserveActionSlot = false,
            DefaultValue = Model?.ShortName
        })

        @* ---------- Decimal Places ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "DecimalPlaces",
            LabelText = "Decimal Places (0-5)",
            FieldType = FieldType.Number,
            Placeholder = "Enter Decimal Places",
            ColumnClass = "col-lg-6",
            ReserveActionSlot = false,
            DefaultValue = Model?.DecimalPlaces?.ToString()
        })
    </div>

    @if (Model != null && (Model.AutoId > 0 || Model.Tc > 0))
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }
</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-unittype-save",
            ReserveActionSlot = true,
           Style="border-bottom:0px !important;"
        })
    </div>
</div>
