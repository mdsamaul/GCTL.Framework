@model GCTL.UI.Core.ViewModels.UnitType.UnitTypePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Unit Type";
    Model.Breadcrumb = "Unit Type";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Unit Type",
                            SaveBtnClass = "js-unittype-save",
                            DeleteBtnClass = "js-unittype-delete-confirm",
                            ClearBtnClass = "js-unittype-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="unittype-form" asp-controller="UnitType">
                            <div class="js-unittype-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "unitTypeTable",
                    AjaxUrl = "/UnitType/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "unitTypID",
                    CheckAllId = "unittype-check-all",
                    DefaultSortColumn = "unitTypID",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "unitTypID", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-unittype-edit" },
                        new() { Data = "unitTypeName", Header = "Unit Type Name", Width = "45%"},
                        new() { Data = "shortName", Header = "Short Name", Width = "25%"},
                        new() { Data = "decimalPlaces", Header = "Decimal Places", Width = "20%", Align = "center" }
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/UnitType.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $.unitType({
                baseUrl: '/UnitType'
            });
        });
    </script>
}