<!-- Add FontAwesome for sort icons if not already included -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    .custom-table td {
        padding: 0 !important; /* Remove padding */
        text-align: center !important; /* Horizontal centering */
        vertical-align: middle !important; /* Vertical centering */
        font-size: 0.9rem; /* Optional: make it consistent */
    }


    /* Styling for sortable columns */
    .sortable {
        cursor: pointer;
        position: relative;
        user-select: none;
    }

        .sortable:hover {
            background-color: #f8f9fa;
        }

    .sort-icon {
        margin-left: 5px;
        opacity: 0.3;
    }

    .sort-asc .sort-icon {
        opacity: 1;
        color: #0d6efd;
    }

    .sort-desc .sort-icon {
        opacity: 1;
        color: #0d6efd;
    }

    .sort-asc .sort-icon:before {
        content: "\f0de"; /* fa-sort-up */
    }

    .sort-desc .sort-icon:before {
        content: "\f0dd"; /* fa-sort-down */
    }

    /* Checkbox styling */
    .form-check-input {
        cursor: pointer;
    }

    /* Improve table appearance */
    .table {
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        border-radius: 5px;
    }

        .table thead th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
        }

    /* Button styling */
    .btn-transfer {
        padding: 0.25rem 0.5rem;
        border: none;
        background: transparent;
        color: #0d6efd;
        text-decoration: underline;
        transition: all 0.2s;
    }

        .btn-transfer:hover {
            color: #0a58ca;
            text-decoration: none;
        }
</style> 


<div class="row g-2">
    <div class="col-6" id="unitFormView">
        @await Html.PartialAsync("UnitForm")
    </div>

    <div class="col-6" id="unitListView">
        @await Html.PartialAsync("UnitList")
    </div>
</div>


@section Scripts {
    <script src="~/js/pages/UnitType.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
}