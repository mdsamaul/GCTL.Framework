@model GCTL.UI.Core.ViewModels.Country.CountryPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Country";
    Model.Breadcrumb = "Country";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Country",
                            SaveBtnClass = "js-country-save",
                            DeleteBtnClass = "js-country-delete-confirm",
                            ClearBtnClass = "js-country-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="country-form" asp-controller="Country">
                            <div class="js-country-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "countryTable",
                    AjaxUrl = "/Country/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "countryId",
                    CheckAllId = "country-check-all",
                    DefaultSortColumn = "countryId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "countryId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-country-edit" },
                        new() { Data = "countryName", Header = "Country Name", Width = "90%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

    <script src="~/js/app.input.validation.js" defer></script>
    <script src="~/js/pages/country.js" defer></script>
    <script type="text/javascript">
        (function waitForJQuery() {
            if (window.jQuery && typeof $.country === "function") {
                var options = { baseUrl: '@Url.Action("", "Country")' };
                options.load = () => { };
                $.country(options);
            } else {
                setTimeout(waitForJQuery, 30);
            }
        })();
    </script>
