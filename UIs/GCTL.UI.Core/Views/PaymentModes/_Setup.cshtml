@model GCTL.Core.ViewModels.PaymentModes.PaymentModeSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="PaymentModeId" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <input type="hidden" asp-for="Lip" />

        @* ---------- Payment Mode Id (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "PaymentModeId",
            LabelText = "Payment Mode Id",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-code",
            DefaultValue = Model?.PaymentModeId
        })
    </div>

    <div class="form-group row">

        @* ---------- Payment Mode ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "PaymentModeName",
            LabelText = "Payment Mode",
            FieldType = FieldType.Text,
            Placeholder = "Enter Payment Mode",
            IsRequired = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-paymentmode-check-availability",
            DefaultValue = Model.PaymentModeName,
            AutoFocus = true
        })

        @* ---------- Short Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "PaymentModeShortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.PaymentModeShortName
        })
    </div>

    @if (!string.IsNullOrEmpty(Model.Lip))
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-paymentmode-save",
            ReserveActionSlot = true,
            IsMarginRight = true
        })
    </div>
</div>