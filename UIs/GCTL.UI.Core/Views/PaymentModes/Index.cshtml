@model GCTL.UI.Core.ViewModels.PaymentModes.PaymentModePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Payment Modes";
    Model.Breadcrumb = "Payment Modes";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look px-0">
    <div class="container-fluid px-0">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Payment Modes",
                            SaveBtnClass = "js-paymentmodes-save",
                            DeleteBtnClass = "js-paymentmodes-delete-confirm",
                            ClearBtnClass = "js-paymentmodes-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="paymentmodes-form" asp-controller="PaymentModes">
                            <div class="js-paymentmodes-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "paymentModesTable",
                    AjaxUrl = "/PaymentModes/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "paymentModeId",
                    CheckAllId = "paymentmodes-check-all",
                    DefaultSortColumn = "paymentModeId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "paymentModeId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-paymentmodes-edit" },
                        new() { Data = "paymentModeName", Header = "Payment Mode Name", Width = "55%"},
                        new() { Data = "paymentModeShortName", Header = "Short Name", Width = "35%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/paymentModes.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $.paymentModes({
                baseUrl: '/PaymentModes'
            });
        });
    </script>
}
