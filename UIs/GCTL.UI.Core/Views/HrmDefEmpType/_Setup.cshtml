@model GCTL.Core.ViewModels.HrmDefEmpTypes.HrmDefEmpTypeSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <input type="hidden" asp-for="AutoId" />

        @* ---------- Employee Type Id (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "EmpTypeCode",
            LabelText = "Employee Type Id",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-EmpTypeCode-code",
            DefaultValue = Model?.EmpTypeCode
        })

        @* ---------- Employee Type Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "EmpTypeName",
            LabelText = "Employee Type",
            FieldType = FieldType.Text,
            Placeholder = "Enter Employee Type",
            IsRequired = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-HrmDefEmpType-check-availability",
            DefaultValue = Model?.EmpTypeName,
            AutoFocus = true
        })
    </div>

    <div class="form-group row">
        @* ---------- Short Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "EmpTypeShortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            DefaultValue = Model?.EmpTypeShortName
        })

        @* ---------- Bangla Employee Type ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BanglaEmployeeType",
            LabelText = "Employee Type(বাংলা)",
            FieldType = FieldType.Text,
            Placeholder = "Enter Employee Type",
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            DefaultValue = Model?.BanglaEmployeeType,
            CustomAttributes = new Dictionary<string, string>
            {
                { "onpaste", "validatePasteBangla(event)" },
                { "oninput", "validateBanglaInput(this)" }
            }
        })
    </div>

    @if (Model.AutoId > 0)
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ReserveActionSlot = false,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate.HasValue ? Model.Ldate?.ToString("dd/MM/yyyy") : ""
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ReserveActionSlot = false,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate.HasValue ? Model.ModifyDate?.ToString("dd/MM/yyyy") : ""
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-HrmDefEmpType-save",
            ReserveActionSlot = true
        })
    </div>
</div>

<script>
    function validateBanglaInput(input) {
        const banglaRegex = /^[\u0980-\u09FF\s]*$/;
        if (!banglaRegex.test(input.value)) {
            input.value = input.value.slice(0, -1);
        }
    }

    function validatePasteBangla(event) {
        const pastedText = (event.clipboardData || window.clipboardData).getData('text');
        const banglaRegex = /^[\u0980-\u09FF\s]*$/;
        if (!banglaRegex.test(pastedText)) {
            event.preventDefault();
        }
    }
</script>