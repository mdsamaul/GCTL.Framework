@model GCTL.Core.ViewModels.ExporterInfo.ExporterInfoSetupViewModel
@using GCTL.UI.Core.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering

<div id="loadingIndicator" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-80%, -80%); z-index: 9999;">
    <img src="/images/Spinner.gif" alt="Loading..." style="width: 80px; height: 80px;" />
</div>

<style>
    /* Card Header Toolbar: single bottom border line, no double line, no bottom rounded */
    .card-header {
        border-bottom: 0 !important;
        background-color: transparent !important;
    }
    .card-header .toolbar-container {
        border: 0 !important;
        /* border-bottom: 1px solid #dee2e6 !important; */
        border-radius: 0 !important;
        border-top-left-radius: calc(var(--bs-border-radius, 0.375rem) - 1px) !important;
        border-top-right-radius: calc(var(--bs-border-radius, 0.375rem) - 1px) !important;
        border-bottom-left-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
        box-shadow: none !important;
    }

    /* Uniform Form Control Height (31px) across all inputs, dropdowns, and checkboxes */
    #ExporterInfo-form .form-control,
    #ExporterInfo-form .form-select,
    #ExporterInfo-form .custom-dd-box,
    #ExporterInfo-form .select2-container .select2-selection--single,
    #ExporterInfo-form .form-control-height-wrap {
        height: 31px !important;
        min-height: 31px !important;
        max-height: 31px !important;
        box-sizing: border-box !important;
        border-radius: 4px !important;
        font-size: 13px !important;
    }

    #ExporterInfo-form .form-control {
        padding: 0.25rem 0.5rem !important;
        line-height: 1.5 !important;
        border: 1px solid #ced4da !important;
    }

    #ExporterInfo-form .input-group {
        height: 31px !important;
        min-height: 31px !important;
    }

    #ExporterInfo-form .input-group > .custom-dd-wrapper {
        flex: 1 1 auto;
        width: 1%;
        min-width: 0;
    }

    /* Uniform Label styling */
    #ExporterInfo-form .form-label {
        font-weight: 500;
        margin-bottom: 4px;
        text-align: left;
        display: block;
        color: #333;
        font-size: 13px;
        line-height: 1.2;
        min-height: 18px;
    }

    #ExporterInfo-form .field-validation {
        font-size: 13px;
        display: block;
        margin-top: 2px;
    }

    /* Responsive Toolbar Padding */
    .exporter-toolbar-responsive {
        padding-left: 25px !important;
    }
    @@media (max-width: 1400px) {
        .exporter-toolbar-responsive {
            padding-left: 165px !important;
        }
    }
</style>

<div class="card rounded shadow-sm">
    <div class="card-header px-3 pt-3 pb-0 border-0 bg-transparent">
        <div class="row g-4">
            <div class="col-xxl-6 col-xl-8 col-lg-8 col-12">
                @await Html.PartialAsync("_Toolbars", new ToobarModel
                {
                    Title = "Exporter Info",
                    SaveBtnClass = "js-ExporterInfo-save",
                    DeleteBtnClass = "js-ExporterInfo-delete-confirm",
                    ClearBtnClass = "js-ExporterInfo-clear",
                    ReserveActionSlot = false,
                    ShowExtraContent = false,
                    IsPlain = true
                })
            </div>
        </div>
    </div>
    
    <div class="card-body px-3 py-3">
        <div class="row">
            <div class="col-lg-6">
                <span id="message"></span>
            </div>
            <div class="col-lg-6">
            </div>
        </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" id="lastCode" />
    <input type="hidden" asp-for="Tc" />
    @* <input type="hidden" asp-for="Id" /> *@
    <input type="hidden" asp-for="Ldate" />
    <input type="hidden" asp-for="ModifyDate" />

    @* ---------- Row 1: Exporter ID & Exporter Code ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ExporterId",
            LabelText = "Exporter ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12 ex-field-col",
            CustomCssClass = "js-ExporterId-code",
            DefaultValue = Model?.ExporterId,
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ExporterCode",
            LabelText = "Exporter Code",
            FieldType = FieldType.Text,
            Placeholder = "Enter Exporter Code",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12 ex-field-col",
            DefaultValue = Model?.ExporterCode
        })
    </div>

    @* ---------- Row 2: Exporter Name & Address ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ExporterName",
            LabelText = "Exporter Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Exporter Name",
            IsRequired = true,
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12 ex-field-col",
            DefaultValue = Model?.ExporterName,
            AutoFocus = true
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ExporterAddress",
            LabelText = "Address",
            FieldType = FieldType.Text,
            Placeholder = "Enter Exporter Address",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12 ex-field-col",
            DefaultValue = Model?.ExporterAddress
        })
    </div>

    @* ---------- Row 3: Country & City ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CountryId",
            LabelText = "Country",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Country --",
            SelectItems = ViewBag.CountryDD as SelectList,
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12"
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "City",
            LabelText = "City",
            FieldType = FieldType.Text,
            Placeholder = "Enter City",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12 ex-field-col",
            DefaultValue = Model?.City
        })
    </div>

    @* ---------- Row 4: State/Province & Zip Code ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "StateOrProvince",
            LabelText = "State/Province",
            FieldType = FieldType.Text,
            Placeholder = "Enter State/Province",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12 ex-field-col",
            DefaultValue = Model?.StateOrProvince
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ZipCode",
            LabelText = "Zip Code",
            FieldType = FieldType.Text,
            Placeholder = "Enter Zip Code",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12 ex-field-col",
            DefaultValue = Model?.ZipCode
        })
    </div>

    @* ---------- Row 5: Vat Reg. No. & Phone ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "VatRegNo",
            LabelText = "Vat Reg. No.",
            FieldType = FieldType.Text,
            Placeholder = "Enter Vat Reg. No.",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12 ex-field-col",
            DefaultValue = Model?.VatRegNo
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone",
            LabelText = "Phone",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.Phone
        })
    </div>

    @* ---------- Row 6: Fax & Email ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Fax",
            LabelText = "Fax",
            FieldType = FieldType.Text,
            Placeholder = "Enter Fax",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.Fax
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.Email
        })
    </div>

    @* ---------- Row 7: Website & Remarks ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Website",
            LabelText = "Website",
            FieldType = FieldType.Text,
            Placeholder = "Enter Website",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.Website
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Remarks",
            LabelText = "Remarks",
            FieldType = FieldType.Text,
            Placeholder = "Enter Remarks",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.Remarks
        })
    </div>

    @* ---------- Row 8: Contact Person 1 & Designation 1 ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ContactPerson1",
            LabelText = "Contact Person 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Contact Person 1",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.ContactPerson1
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Designation1",
            LabelText = "Designation 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Designation 1",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.Designation1
        })
    </div>

    @* ---------- Row 9: Phone 1 & Email 1 ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone1",
            LabelText = "Phone 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone 1",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.Phone1
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email1",
            LabelText = "Email 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email 1",
            ReserveActionSlot = false,
            ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
            DefaultValue = Model?.Email1
        })
    </div>

    @if (Model.Tc > 0)
    {
        <hr class="my-2" />
        <div class="row g-4 mb-1" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ReserveActionSlot = false,
                ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate.HasValue ? Model.Ldate?.ToString("dd/MM/yyyy") : ""
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ReserveActionSlot = false,
                ColumnClass = "col-xxl-3 col-xl-4 col-lg-4 col-md-6 col-12",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate.HasValue ? Model.ModifyDate?.ToString("dd/MM/yyyy") : ""
            })

        </div>
    }

    <div class="row g-4">
        <div class="col-xxl-6 col-xl-8 col-lg-8 col-12 d-flex justify-content-end">
            @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
            {
                Title="",
                SaveBtnClass = "js-ExporterInfo-save",
                ShowClear = false,
                ShowDelete = false,
                ShowFavorite = false,
                ShowPrint = false,
                IsPlain = true,
                ReserveActionSlot = false,
                CssClass = "exporter-toolbar-responsive",
                Style = "border-bottom:0px !important;",
                ShowExtraContent=false
            })
        </div>
    </div>
    
    </div>
</div>