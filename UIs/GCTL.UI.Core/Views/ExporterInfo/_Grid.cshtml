@model List<GCTL.Core.ViewModels.ExporterInfo.ExporterInfoSetupViewModel>

<table id="ExporterInfo-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 4%;">
                Select <br /> <input type="checkbox" id="ExporterInfo-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 8%;">Exporter Id</th>
            <th class="text-center text-middle" style="width: 23%;">Name</th>
            <th class="text-center text-middle" style="width: 17%;">Address</th>
            <th class="text-center text-middle" style="width: 20%;">Phone</th>
            <th class="text-center text-middle" style="width: 12%;">Website</th>
            <th class="text-center text-middle" style="width: 15%;">Email</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                @* <td colspan="8">No Data Available.</td> *@
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.ExporterId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" id="js-ExporterInfo-checkbox" class="text-center text-middle checkBox" data-id="@item.ExporterId" value="@item.ExporterId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-ExporterInfo-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.ExporterId" title="Edit">
                            @item.ExporterId
                        </a>
                    </td>

                    <td class="text-middle">@item.ExporterName</td>
                    <td class="text-middle">@item.ExporterAddress</td>
                    <td class="text-center text-middle">@item.Phone</td>
                    <td class="text-center text-middle">@item.Website</td>
                    <td class="text-center text-middle">@item.Email</td>

                </tr>
            }
        }

    </tbody>
</table>

