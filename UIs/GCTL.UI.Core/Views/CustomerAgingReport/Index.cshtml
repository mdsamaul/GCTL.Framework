@model GCTL.UI.Core.ViewModels.GridModel

@{
    ViewData["Title"] = "Customer Aging Report";
    ViewData["ShowPageTitle"] = true;
    Layout = "_Layout";
}

<style>
    :root {
        --primary: #0056b3;
        --secondary: #003366;
        --bg-frost: #f4f7f9;
        --white: #ffffff;
        --border: #e0e6ed;
        --text-main: #334155;
    }

    .aging-report-dashboard {
        color: var(--text-main);
        font-family: 'Segoe UI', Roboto, sans-serif;
    }

    .dashboard-container {
        padding: 6px 0 25px 0;
        max-width: 100%;
        margin: 0 auto;
    }

    /* Top 5 KPI Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 14px;
    }

    .stat-card {
        background: white;
        padding: 10px 14px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border-bottom: 3px solid var(--primary);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        user-select: none;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.06);
        }

    .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        margin-right: 12px;
        flex-shrink: 0;
    }

    .stat-info {
        flex: 1;
        min-width: 0;
    }

        .stat-info h3 {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #64748b;
            margin: 0 0 2px 0;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .stat-info p {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--secondary);
            margin: 0;
            line-height: 1.1;
        }

    /* Filter Section */
    .filter-section {
        background: white;
        padding: 8px 14px;
        border-radius: 10px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        border: 1px solid var(--border);
        flex-wrap: wrap;
        overflow: visible !important;
    }

    .filter-label {
        font-weight: 700;
        color: var(--secondary);
        font-size: 0.82rem;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 5px;
        flex: 1 1 0;
        min-width: 0 !important;
    }

        .filter-group label {
            font-size: 0.76rem;
            font-weight: 600;
            white-space: nowrap;
            color: #475569;
            margin: 0;
            flex-shrink: 0;
        }

        .filter-group input.form-control,
        .filter-group select.form-select,
        .filter-group input.flatpickr-alt-input {
            width: 100% !important;
            min-width: 0 !important;
            padding: 4px 22px 4px 7px !important;
            border: 1px solid var(--border) !important;
            border-radius: 6px !important;
            font-size: 0.78rem !important;
            outline: none;
            background-color: #ffffff;
            color: var(--text-main);
            height: 31px !important;
            min-height: 31px !important;
            line-height: 1.2 !important;
            background-position: right 6px center !important;
            background-size: 13px 13px !important;
        }

        .filter-group input.custom-datepicker,
        .filter-group input.flatpickr-alt-input,
        .filter-group input.caiCon,
        .filter-group input[type="date"] {
            background-image: url('/images/icons/calender.svg') !important;
            background-repeat: no-repeat !important;
            background-position: right 8px center !important;
            background-size: 15px 15px !important;
            padding-right: 28px !important;
            cursor: pointer;
        }

        .filter-group .custom-dd-wrapper {
            width: 100% !important;
            min-width: 0 !important;
            flex: 1 1 auto;
        }

        .filter-group .custom-dd-input {
            min-height: 31px !important;
            height: 31px !important;
            padding: 2px 6px !important;
            font-size: 0.78rem !important;
            border-radius: 6px !important;
            width: 100% !important;
            min-width: 0 !important;
        }

        .filter-group .custom-dd-box {
            min-height: 31px !important;
            height: 31px !important;
            max-height: 31px !important;
            padding: 1px 5px !important;
            border-radius: 6px !important;
            border: 1px solid var(--border) !important;
            overflow: hidden !important;
            flex-wrap: nowrap !important;
        }

        .filter-group .custom-dd-tags {
            flex-wrap: nowrap !important;
            overflow: hidden !important;
            max-width: calc(100% - 30px) !important;
            display: flex !important;
            align-items: center !important;
        }

        .filter-group .custom-dd-tag {
            font-size: 0.72rem !important;
            padding: 1px 4px !important;
            line-height: 1.1 !important;
            white-space: nowrap !important;
            max-width: 130px !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
        }

        .filter-group.filter-group-date {
            min-width: 140px !important;
            flex: 1 1 0;
        }

        .filter-group.filter-group-cust {
            min-width: 200px !important;
            flex: 1.5 1 0;
        }

        .filter-group.filter-group-report-type {
            min-width: 170px !important;
            flex: 1.2 1 0;
        }

        .filter-group.filter-group-export {
            min-width: 140px !important;
            flex: 1 1 0;
            margin-left: auto;
        }

    /* Grid Wrapper Card */
    .job-grid-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid var(--border);
        padding: 8px 10px;
        overflow-x: auto;
    }

    #customerAgingReportTable {
        width: 100% !important;
        font-size: 11px;
        border-collapse: collapse !important;
    }

        #customerAgingReportTable thead th {
            vertical-align: middle !important;
            text-align: center !important;
            padding: 4px 4px !important;
            font-size: 11px !important;
            border: 1px solid #c2c9d1 !important;
            font-weight: 600;
            background-color: #f1f5f9;
            color: #334155;
            white-space: nowrap !important;
        }

        #customerAgingReportTable tbody td {
            padding: 3px 4px !important;
            font-size: 11px !important;
            border: 1px solid #e2e8f0 !important;
            vertical-align: middle;
        }

        #customerAgingReportTable tbody tr:hover {
            background-color: #f0f7ff !important;
        }

    /* Responsive */
    @@media (max-width: 1199px) {
        .stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
        .filter-section {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="aging-report-dashboard">
    <div class="dashboard-container">

        <!-- Top 5 KPI Cards -->
        <div class="stats-grid">
            <!-- 1. Total Outstanding -->
            <div class="stat-card" style="border-color: #0056b3;">
                <div class="stat-icon" style="background: #0056b3;">
                    <i class="fas fa-file-invoice-dollar fs-5"></i>
                </div>
                <div class="stat-info">
                    <h3>Total Debtors</h3>
                    <p id="statTotalOutstanding">0.00</p>
                </div>
            </div>

            <!-- 2. 0-30 Days -->
            <div class="stat-card" style="border-color: #2e7d32;">
                <div class="stat-icon" style="background: #2e7d32;">
                    <i class="fas fa-calendar-check fs-5"></i>
                </div>
                <div class="stat-info">
                    <h3>0 - 30 Days</h3>
                    <p id="stat_0_30">0.00</p>
                </div>
            </div>

            <!-- 3. 31-90 Days -->
            <div class="stat-card" style="border-color: #ed6c02;">
                <div class="stat-icon" style="background: #ed6c02;">
                    <i class="fas fa-hourglass-half fs-5"></i>
                </div>
                <div class="stat-info">
                    <h3>31 - 90 Days</h3>
                    <p id="stat_31_90">0.00</p>
                </div>
            </div>

            <!-- 4. 91-180 Days -->
            <div class="stat-card" style="border-color: #9c27b0;">
                <div class="stat-icon" style="background: #9c27b0;">
                    <i class="fas fa-history fs-5"></i>
                </div>
                <div class="stat-info">
                    <h3>91 - 180 Days</h3>
                    <p id="stat_91_180">0.00</p>
                </div>
            </div>

            <!-- 5. Over 180 Days -->
            <div class="stat-card" style="border-color: #d32f2f;">
                <div class="stat-icon" style="background: #d32f2f;">
                    <i class="fas fa-exclamation-triangle fs-5"></i>
                </div>
                <div class="stat-info">
                    <h3>Over 180 Days</h3>
                    <p id="stat_Over180">0.00</p>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-section">
            <span class="filter-label"><i class="fas fa-filter"></i> Filter By:</span>

            <!-- Aging Date -->
            <div class="filter-group filter-group-date">
                <label for="filterAgingDate">Aging Date</label>
                <input type="text" id="filterAgingDate" class="form-control form-control-sm custom-datepicker caiCon" placeholder="DD/MM/YYYY" autocomplete="off" value="@DateTime.Now.ToString("dd/MM/yyyy")" data-default-date="@DateTime.Now.ToString("dd/MM/yyyy")" />
            </div>

            <!-- Customer (Multi-Select with checkboxes) -->
            <div class="filter-group filter-group-cust">
                <select id="filterCustomerId" class="form-select form-select-sm custom-select-multi" multiple="multiple" data-placeholder="-- Select Customer --">
                    @if (ViewBag.Customers != null)
                    {
                        foreach (SelectListItem item in (SelectList)ViewBag.Customers)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Aging Report Type (Single Select: Customer Aging, Bill Wise Customer Aging) -->
            <div class="filter-group filter-group-report-type">
                <select id="filterReportType" class="form-select form-select-sm custom-select-single" data-placeholder="Select Aging Report">
                    <option value="Customer Aging" selected="selected">Customer Aging</option>
                    <option value="Bill Wise Customer Aging">Bill Wise Customer Aging</option>
                </select>
            </div>

            <!-- Export Format & Actions Dropdown -->
            <div class="filter-group filter-group-export">
                <select id="filterExportFormat" class="form-select form-select-sm custom-select-single" data-placeholder="Select Format">
                    <option value="">Select Format</option>
                    <option value="Preview">Preview</option>
                    <option value="PDF">PDF</option>
                    <option value="Excel">Excel</option>
                </select>
            </div>
        </div>

        <!-- CustomGrid Table Container -->
        <div class="job-grid-card">
            @await Html.PartialAsync("_CustomGrid", Model)
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/pages/customerAgingReport.js" asp-append-version="true"></script>
}

