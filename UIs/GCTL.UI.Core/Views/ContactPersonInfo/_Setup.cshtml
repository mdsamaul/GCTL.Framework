@model GCTL.Core.ViewModels.ContactPersonInfo.ContactPersonInfoSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" id="lastCode" />
    <input type="hidden" asp-for="AutoId" />
    @* <input type="hidden" asp-for="Id" /> *@
    <input type="hidden" asp-for="Ldate" />
    <input type="hidden" asp-for="ModifyDate" />

    @* ---------- Row 1: ID & Name ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Cpid",
            LabelText = "ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 cpi-field-col",
            CustomCssClass = "js-Cpid-code",
            DefaultValue = Model?.Cpid
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ContactPersonName",
            LabelText = "Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Contact Person Name",
            IsRequired = true,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 cpi-field-col",
            ReserveActionSlot = false,
            CustomCssClass = "js-ContactPersonName-check-duplicateName",
            DefaultValue = Model.ContactPersonName,
            AutoFocus = true
        })
    </div>

    @* ---------- Row 2: Designation & Phone ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "DesignationCode",
            LabelText = "Designation",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Designation --",
            SelectItems = ViewBag.DesignationDD as SelectList,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 cpi-field-col",
            ReserveActionSlot = false
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ContactPersonMobile",
            LabelText = "Phone",
            FieldType = FieldType.Text,
            Placeholder = "Enter Contact Person Phone",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 cpi-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.ContactPersonMobile
        })
    </div>

    @* ---------- Row 3: Email ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ContactPersonEmail",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Contact Person Email",
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 cpi-field-col",
            ReserveActionSlot = false,
            DefaultValue = Model.ContactPersonEmail
        })
    </div>

    @if (Model.AutoId > 0)
    {
        <hr class="my-2" />
        <div class="row g-4 mb-1" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 cpi-field-col",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 cpi-field-col",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }

</div>

<div class="row g-4 no-print" style="margin-top: 9px;">
    <div class="col-12 col-md-6 col-xxl-12 cpi-toolbar-col">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-ContactPersonInfo-save",
            ReserveActionSlot = true,
            Style = "border-bottom:0px !important;"
        })
    </div>
</div>
