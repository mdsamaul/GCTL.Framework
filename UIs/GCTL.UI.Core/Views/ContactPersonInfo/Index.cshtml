@model GCTL.UI.Core.ViewModels.ContactPersonInfo.ContactPersonInfoPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Contact Person Info";
    Model.Breadcrumb = "Contact Person Info";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Contact Person Info",
                            SaveBtnClass = "js-ContactPersonInfo-save",
                            DeleteBtnClass = "js-ContactPersonInfo-delete-confirm",
                            ClearBtnClass = "js-ContactPersonInfo-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="ContactPersonInfo-form" asp-controller="ContactPersonInfo">
                            <div class="js-ContactPersonInfo-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "contactPersonInfoTable",
                    AjaxUrl = "/ContactPersonInfo/GetTableData",
                    AjaxMethod = "GET",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "cpid",
                    CheckAllId = "ContactPersonInfo-check-all",
                    DefaultSortColumn = "cpid",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "cpid", Header = "ID", Width = "11%", IsEditLink = true, EditSelectorClass = "js-ContactPersonInfo-edit" },
                        new() { Data = "contactPersonName", Header = "Name", Width = "30%"},
                        new() { Data = "designationName", Header = "Designation", Width = "21%"},
                        new() { Data = "contactPersonMobile", Header = "Phone", Width = "18%"},
                        new() { Data = "contactPersonEmail", Header = "Email", Width = "20%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/contactPersonInfo.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $.contactPersonInfo({
                baseUrl: '/ContactPersonInfo'
            });
        });
    </script>
}