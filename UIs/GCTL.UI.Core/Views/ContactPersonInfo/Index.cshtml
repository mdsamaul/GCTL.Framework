@model GCTL.UI.Core.ViewModels.ContactPersonInfo.ContactPersonInfoPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Contact Person Info";
    Model.Breadcrumb = "Contact Person Info";
}

<style>
    #ContactPersonInfoDeleteModalBodyHeightFeixd {
        height: 50px !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-6 pr-0">
                <div class="card">
                    <div class="card-header px-2">
                           @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                    {
                            Title = "Contact Person Info",
                            SaveBtnClass = "js-Contact Person Info-save",
                            DeleteBtnClass = "js-Contact Person Info-delete-confirm",
                            ClearBtnClass = "js-Contact Person Info-clear"
                    })
                    </div>
                    <div class="card-body px-2">

                        <form asp-action="Setup" method="post" id="ContactPersonInfo-form" asp-controller="ContactPersonInfo">

                            <div class="js-ContactPersonInfo-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6" style="height:570px;overflow:auto;">
                <div class="card">
                    <div class="card-body p-2 pt-3">
                        <div class="js-ContactPersonInfo-grid-container">
                            @await Html.PartialAsync("_Grid", Model.ContactPersonList)
                        </div>
                    </div>
                </div>
            </div>


        </div>


        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/contactPersonInfo.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "ContactPersonInfo")'
        };
        options.load = () => {
        };

        $.contactPersonInfo(options);
    </script>
}
