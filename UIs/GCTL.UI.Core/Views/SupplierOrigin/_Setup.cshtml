@model GCTL.Core.ViewModels.SupplierOrigin.SupplierOriginSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- ID (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "SupplierOriginId",
            LabelText = "ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-SupplierOriginId-code",
            DefaultValue = Model?.SupplierOriginId
        })

        @* ---------- Supplier Origin ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "SupplierOrigin",
            LabelText = "Supplier Origin",
            FieldType = FieldType.Text,
            Placeholder = "Enter Supplier Origin",
            IsRequired = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-SupplierOrigin-check-duplicateName",
            DefaultValue = Model.SupplierOrigin,
            AutoFocus = true
        })
    </div>

    @if (Model.Tc > 0)
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-SupplierOrigin-save",
            ReserveActionSlot = true,
            IsMarginRight = true
        })
    </div>
</div>