@using GCTL.UI.Core.ViewModels

<div id="loadingIndicator" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-80%, -80%); z-index: 9999;">
    <img src="/images/Spinner.gif" alt="Loading..." style="width: 80px; height: 80px;" />
</div>

<style>
    .form-grid-layout {
        display: grid;
        grid-template-columns: max-content 1fr max-content 1fr;
        column-gap: 5px;
        row-gap: 5px;
        align-items: center;
    }
    /* Flatten the bootstrap grid so children become grid items */
    .form-grid-layout .form-group,
    .form-grid-layout .col-lg-6,
    .form-grid-layout .col-md-6,
    .form-grid-layout .row.align-items-center {
        display: contents;
    }
    
    /* Let col-4 and col-8 act as the actual grid cells */
    .form-grid-layout .col-4 {
        display: block !important;
        width: auto !important;
        max-width: none !important;
        flex: none !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin: 0 !important;
        text-align: right;
    }
    .form-grid-layout .col-8 {
        display: block !important;
        width: 100% !important;
        max-width: none !important;
        flex: none !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin: 0 !important;
    }

    /* Additional alignments */
    .form-grid-layout label.form-label {
        margin-bottom: 0;
    }
    .form-grid-layout .form-check {
        padding-left: 0 !important;
    }
</style>

<div class="card rounded shadow-sm">
    <div class="card-header p-0">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "Expense Head Info",
            SaveBtnClass = "saveBtn",
            DeleteBtnId = "deleteBtn",
            DeleteBtnClass = "deleteBtn",
            ClearBtnClass = "resetBtn",
            ExcelBtnClass = "export-excel",
            PdfBtnClass = "export-pdf",
            FavtBtnClass = "favBtn",
            ReserveActionSlot = false
        })
    </div>

    <div class="card-body px-5 mx-3">
        <form id="expenseForm" class="form-grid-layout">
            <input type="hidden" id="tc" name="tc" />

            <div class="form-group row">
                @* ---------- Expense Head ID (readonly) ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "expenseHeadId",
                    LabelText = "Expense Head ID",
                    FieldType = FieldType.Text,
                    Placeholder = "Expense Head ID",
                    IsReadonly = true,
                    ReserveActionSlot = false,
                    ColumnClass = "col-lg-6",
                    LabelInline=true,
                    LabelColumnClass="text-end"
                })

                @* ---------- Shipment Mode (Select) ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "expenseType",
                    LabelText = "Shipment Mode",
                    FieldType = FieldType.Select,
                    Placeholder = "Select Shipment Mode",
                    SelectItems = ViewBag.ShipmentModes as SelectList,
                    IsRequired = true,
                    ReserveActionSlot = false,
                    ColumnClass = "col-lg-6",
                    LabelInline = true,
                    LabelColumnClass = "text-end",
                    LabelStyle="margin-left:100px;"
                })
            </div>

            <div class="form-group row">
                @* ---------- Is Receiptable (Checkbox) ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "isReceiptable",
                    LabelText = "Is Receiptable Expense",
                    FieldType = FieldType.Checkbox,
                    ReserveActionSlot = false,
                    ColumnClass = "col-lg-6",
                    LabelInline = true,
                    LabelColumnClass = "text-end",                    
                })

                @* ---------- Expense Head Name ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "expenseHead",
                    LabelText = "Expense Head",
                    FieldType = FieldType.Text,
                    Placeholder = "Expense Head",
                    IsRequired = true,
                    LabelInline = true,
                    LabelColumnClass = "text-end",
                    ReserveActionSlot = false,
                    ColumnClass = "col-lg-6"
                })
            </div>

            <div class="form-group row">
                @* ---------- Short Name ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "shortName",
                    LabelText = "Short Name",
                    FieldType = FieldType.Text,
                    Placeholder = "Short Name",
                    ReserveActionSlot = false,
                    LabelInline = true,
                    LabelColumnClass = "text-end",
                    ColumnClass = "col-lg-6"
                })

                @* ---------- Amount ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "amount",
                    LabelText = "Amount",
                    FieldType = FieldType.Number,
                    Placeholder = "Amount",
                    ReserveActionSlot = false,
                    LabelInline = true,
                    LabelColumnClass = "text-end",
                    ColumnClass = "col-lg-6"
                })
            </div>

            <div class="form-group row">
                @* ---------- Serial No ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "serialNo",
                    LabelText = "Serial No",
                    FieldType = FieldType.Text,
                    Placeholder = "Serial No",
                    IsRequired = true,
                    ReserveActionSlot = false,
                    LabelInline = true,
                    LabelColumnClass = "text-end",
                    ColumnClass = "col-lg-6"
                })

                @* ---------- Service Provided By (Select) ---------- *@
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    InputId = "serviceProvider",
                    LabelText = "Service Provided By",
                    FieldType = FieldType.Select,
                    Placeholder = "Select Service Provider",
                    SelectItems = ViewBag.ServiceProviders as SelectList,
                    IsRequired = true,
                    ReserveActionSlot = false,
                    LabelInline = true,
                    LabelColumnClass = "text-end",
                    ColumnClass = "col-lg-6"
                })
            </div>

            @* ---------- Creation & Modify Date ---------- *@
            <div class="form-group row" id="LdateModifyHide">
                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    ContainerId = "lDateContainer",
                    InputId = "displayLDate",
                    LabelText = "Creation Date",
                    FieldType = FieldType.ReadonlyDisplay,
                    ReserveActionSlot = false,
                    ColumnClass = "col-lg-6",
                    ShowOnInit = false
                })

                @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                {
                    ContainerId = "modifyDateContainer",
                    InputId = "displayModifyDate",
                    LabelText = "Modify Date",
                    FieldType = FieldType.ReadonlyDisplay,
                    ReserveActionSlot = false,
                    ColumnClass = "col-lg-6",
                    ShowOnInit = false
                })
            </div>
            <div></div>
            <div></div>
            <div></div>
            <div class="" style="margin-top: 9px;">
                    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                    {
                        SaveBtnClass = "saveBtn",
                        ShowClear = false,
                        ShowDelete = false,
                        ShowFavorite = false,
                        ShowPrint = false,
                        IsPlain = true,
                        ReserveActionSlot = true,
                    })
            </div>

        </form>
    </div>
</div>