@using GCTL.UI.Core.ViewModels

        @await Html.PartialAsync("_CustomGrid", new GridModel
        {
            GridId = "expenseHeadTable",
            AjaxUrl = "/ExpenseHead/GetGridData",
            AjaxMethod = "POST",
            ServerSide = true,
            ShowCheckbox = true,
            CheckColumnData = "tc",
            CheckAllId = "selectAllExpense",
            CheckboxClass = "js-expensehead-check",
            ShowSearchBox = true,
            ShowPagination = true,
            Columns = new List<GridColumn>
            {
                new() { Data = "expenseHeadID", Header = "ID", Width = "8%", IsEditLink = true, EditSelectorClass = "js-expensehead-edit", IdField = "tc", Align = "center", SortField = "ExpenseHeadId" },
                new() { Data = "expenseHead", Header = "Expense Head", Width = "25%", Align = "left", SortField = "ExpenseHead" },
                new() { Data = "serialNo", Header = "Serial No", Width = "8%", Align = "center", SortField = "SerialNo" },
                new() { Data = "isReceiptable", Header = "Is Receiptable", Width = "12%", Align = "center", SortField = "IsReceiptable" },
                new() { Data = "serviceTypeName", Header = "Service Provided By", Width = "18%", Align = "left", SortField = "ServiceTypeId" },
                new() { Data = "expenseType", Header = "Shipment Mode", Width = "25%", Align = "left", SortField = "ExpenseTypeId" }
            }
        })

