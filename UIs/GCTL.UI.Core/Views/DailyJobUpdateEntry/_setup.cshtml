@model GCTL.Core.ViewModels.Update.ShipmentUpdateViewModel
<form asp-action="Create" method="post" id="shipmentForm">
    <div class="row pb-2">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="JobNo" id="jobNoHidden" value="" />
        <input type="hidden" asp-for="AutoId" id="autoId" value="0"/>
        <div class="col-lg-4 col-md-6">
            <label class="form-label">ETA Delivery Date</label>
            <input asp-for="ETADeliveryDate" type="text" class="form-control form-control-sm custom-datepicker caiCon" />
            <span asp-validation-for="ETADeliveryDate" class="text-danger"></span>
        </div>

        <!-- Actual Delivery Date -->
        <div class="col-lg-4 col-md-6">
            <label class="form-label">Actual Delivery Date</label>
            <input asp-for="ActualDeliveryDate" type="date" class="form-control form-control-sm custom-datepicker caiCon"
                   id="actualDeliveryDate" />
            <span asp-validation-for="ActualDeliveryDate" class="text-danger"></span>
        </div>

        <!-- Unstuffing Date -->
        <div class="col-lg-4 col-md-6">
            <label class="form-label">Unstuffing Date</label>
            <input asp-for="UnstuffingDate" type="text" class="form-control form-control-sm custom-datepicker caiCon" id="unstuffingDate" />
            <span asp-validation-for="UnstuffingDate" class="text-danger"></span>
        </div>

        <!-- Place of Loading -->
        <div class="col-lg-4 col-md-6">
            <label class="form-label">Place of Loading</label>
            <select asp-for="PlaceOfLoadingID" class="form-select form-select-sm custom-select-single" data-placeholder="Select Place" id="placeOfLoadingId" asp-items="ViewBag.PlaceOfLoading as SelectList">
                <option value="">Select Place</option>
            </select>
            <span asp-validation-for="PlaceOfLoadingID" class="text-danger"></span>
        </div>

        <!-- ETD Date -->
        <div class="col-lg-4 col-md-6">
            <label class="form-label">ETD Date</label>
            <input asp-for="ETDDate" type="text" class="form-control form-control-sm custom-datepicker caiCon" id="etdDate" />
            <span asp-validation-for="ETDDate" class="text-danger"></span>
        </div>

        <!-- Shed / Yard -->
        <div class="col-lg-4 col-md-6">
            <label class="form-label">Shed / Yard</label>
            <select asp-for="ShedYardID" class="form-select form-select-sm custom-select-single" data-placeholder="Select Shed/Yard" id="shedYardId" asp-items="ViewBag.ShedYard as SelectList">
                <option value="">Select Shed/Yard</option>
            </select>
            <span asp-validation-for="ShedYardID" class="text-danger"></span>
        </div>

        <!-- Freight Charge -->
        <div class="col-lg-4 col-md-6">
            <label class="form-label">Freight Charge</label>
            <select asp-for="FreightChargeID" class="form-select form-select-sm custom-select-single" data-placeholder="Select Freight Charge" id="freightChargeId" asp-items="ViewBag.FreightCharge as SelectList">
                <option value="">Select Freight Charge</option>
            </select>
            <span asp-validation-for="FreightChargeID" class="text-danger"></span>
        </div>
        <div class="col-lg-4 col-md-6"></div>
        <div class="col-lg-4 col-md-6"></div>
        <!-- Shipment Status (Highlighted) -->
        <div style="display: flex;background: #FFFFE0;align-content: center;align-items: center;padding: 12px;margin: 12px 0;">

                        
            <div class="col-lg-4 col-md-6" style="padding-right:12px;">
                <label class="form-label">Shipment Status</label>
                <select asp-for="ShipmentStatus" class="form-select form-select-sm custom-select-single" data-placeholder="Select Shipment Status" asp-items="ViewBag.shipStatus as SelectList">
                    <option value="">Select Shipment Status</option>
                </select>
                <span asp-validation-for="ShipmentStatus" class="text-danger"></span>
            </div>
            <!-- ETD Date -->
            <!-- Quantity + Unit (Horizontal Group) -->
            <div class="col-lg-4 col-md-6" style="padding-left: 12px;">
                <label class="form-label">Date & Time</label>

                <div class="row g-2">
                    <div class="col flex-grow-1" style="min-width: 70px;">
                        <input type="text"
                               class="form-control form-control-sm custom-datepicker w-100"
                               asp-for="Date" />
                    </div>

                    <div class="col-auto" style="min-width: 150px; margin-top: 6px;">
                        <input type="text"
                               class="form-control form-control-sm custom-timepicker w-100"
                               asp-for="Time" />
                    </div>
                </div>

                <span class="text-danger"></span>
            </div>


            <div class="col-lg-4 col-md-6" style="padding-left: 12px;">
                <label class="form-label">Remarks</label>
                <textarea class="form-control form-control-sm" placeholder="Shipment Status" rows="1" asp-for="UpdateRemarks"></textarea>
                <span class="text-danger"></span>
            </div>
        </div>

                       
        <!-- Creation Date -->
        <div class="col-lg-4 col-md-6 d-flex align-items-center create-modify-dateshow">
            <label class="form-label text-nowrap ">Creation Date:</label>
            <span class="form-control-plaintext flex-grow-1 fs-9" id="creationDate"></span>
        </div>

        <div class="col-lg-4 col-md-6 create-modify-dateshow"></div>

        <!-- Updated Date -->
        <div class="col-lg-4 col-md-6 d-flex align-items-center create-modify-dateshow">
            <label class="form-label  text-nowrap mb-0">Updated Date:</label>
            <span class="form-control-plaintext flex-grow-1 fs-9" id="updatedDate"></span>
        </div>
    </div>
</form>