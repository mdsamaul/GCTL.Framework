        width: calc((100% - 0.5rem) / 2) !important;
        max-width: calc((100% - 0.5rem) / 2) !important;
        min-width: 0 !important;
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        line-height: calc(var(--control-height) - 2px) !important;
        border-radius: var(--bs-border-radius-sm, 0.25rem) !important;
    }

    /* Right Input / Select / Dropdown: 50% width */
    .daily-job-fields-row .dual-input-group > input:nth-child(2),
    .daily-job-fields-row .dual-input-group > input:last-child,
    .daily-job-fields-row .dual-input-group > select:nth-child(2),
    .daily-job-fields-row .dual-input-group > .custom-dd-wrapper,
    .daily-job-fields-row .dual-input-group > select + .custom-dd-wrapper,
    .daily-job-fields-row .dual-input-group > .select2-container,
    .daily-job-fields-row .dual-input-group > select + .select2-container,
    .daily-job-fields-row .dual-input-group > .select2,
    .daily-job-form-card .dual-input-group > input:nth-child(2),
    .daily-job-form-card .dual-input-group > input:last-child,
    .daily-job-form-card .dual-input-group > select:nth-child(2),
    .daily-job-form-card .dual-input-group > .custom-dd-wrapper,
    .daily-job-form-card .dual-input-group > select + .custom-dd-wrapper,
    .daily-job-form-card .dual-input-group > .select2-container,
    .daily-job-form-card .dual-input-group > select + .select2-container,
    .daily-job-form-card .dual-input-group > .select2 {
        flex: 1 1 calc((100% - 0.5rem) / 2) !important;
        width: calc((100% - 0.5rem) / 2) !important;
        max-width: calc((100% - 0.5rem) / 2) !important;
        min-width: 0 !important;
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        line-height: calc(var(--control-height) - 2px) !important;
        margin-left: 0 !important;
        border-radius: var(--bs-border-radius-sm, 0.25rem) !important;
    }

