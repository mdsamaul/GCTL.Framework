@* @model GCTL.Core.ViewModels.Update.ShipmentUpdateViewModel *@
@model GCTL.UI.Core.ViewModels.DailyJobUpdateEntry.DailyJobUpdateEntrySetupViewModel
@{
    // ViewData["Title"] = "Shipment Entry";
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Shipment Entry";
    Model.Breadcrumb = "Shipment Entry";
}

<link href="~/css/selectCSS.css" rel="stylesheet" />


<style>
    /* .sticky-bar {
                position: sticky;
                top: 65px;
                z-index: 1020;
            } */

    /* Bootstrap form-select-sm style for Select2 */
    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: calc(1.5em + .5rem + 2px) !important; /* Bootstrap form-select-sm */
        padding: .25rem .5rem !important;
        border: 1px solid #ced4da !important;
        border-radius: .375rem !important;
        background-color: #fff;
        display: flex;
        align-items: center;
    }

    .select2-container--default .select2-selection__rendered {
        line-height: normal !important;
        padding-left: 0 !important;
        padding-right: 20px !important;
        color: #212529;
        font-size: .750rem;
    }

    .select2-container--default .select2-selection__arrow {
        height: 100% !important;
        right: 8px;
    }

    .select2-container--default .select2-selection__clear {
        margin-right: 18px;
    }

    /* Focus */
    .select2-container--default.select2-container--focus .select2-selection--single,
    .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
    }

    .form-label {
        padding-left: 0rem !important;
        line-height: 1.2 !important;
        text-transform: capitalize !important;
        margin-bottom: 0 !important;
    }

    /* ================= Toolbar ================= */

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .toolbar-left {
        flex-shrink: 0;
    }

    .toolbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: nowrap;
    }

    /* Large Screen (default) */

    .toolbar-showing {
        width: 120px;
    }

    /* Wrapper for the large-screen filters (customer / shipment / date) */
    .toolbar-large-filters {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: nowrap;
    }

    .toolbar-customer {
        width: 250px;
    }

    .toolbar-shipment {
        width: 240px;
    }

    .toolbar-date {
        width: 380px;
    }

    .toolbar-search {
        width: 300px;
    }

    /* Small/mid screen filter block - hidden by default on large screens */
    .sm-topshow {
        display: none;
    }

    /* 1350px */

    @@media (max-width:1370px) {

        .sm-topshow {
            display: flex;
            flex-wrap: wrap;
            justify-content: start;
            align-items: center;
            gap: 10px;
            padding-bottom: 10px;
        }

            .sm-topshow .toolbar-customer-sm,
            .sm-topshow .toolbar-shipment-sm {
                width: 220px;
            }

            .sm-topshow .toolbar-date-sm {
                width: 100%;
                max-width: 420px;
            }

        .toolbar-right {
            gap: 8px;
        }
        /* Hide large-screen customer/shipment/date filters */
        .toolbar-large-filters {
            display: none;
        }

        .toolbar-customer {
            width: 225px;
        }

        .toolbar-search {
            width: 225px;
        }

        .toolbar-date {
            width: 321px;
        }

        .toolbar .form-control,
        .toolbar .form-select,
        .toolbar .input-group-text {
            font-size: 13px;
            padding: .25rem .45rem;
        }
    }

    /* Tablet */

    @@media (max-width:1200px) {

        .toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .toolbar-right {
            flex-wrap: wrap;
        }

        .toolbar-search {
            width: 100%;
        }

        .sm-topshow .toolbar-customer-sm,
        .sm-topshow .toolbar-shipment-sm,
        .sm-topshow .toolbar-date-sm {
            width: 100%;
            max-width: 100%;
        }
    }


    .timeline {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px 30px 10px;
    }

    .timeline-item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        text-align: center;
    }

        .timeline-item::before {
            content: '';
            position: absolute;
            top: 28px;
            left: -50%;
            width: 100%;
            height: 3px;
            background-color: #d3d3d3;
            z-index: 0;
            overflow: hidden;
        }

        .timeline-item:first-child::before {
            display: none;
        }

        .timeline-item.completed::before,
        .timeline-item.active::before {
            background-color: #d3d3d3;
        }

        .timeline-item.completed::after,
        .timeline-item.active::after {
            content: '';
            position: absolute;
            top: 28px;
            left: -50%;
            width: 100%;
            height: 3px;
            background-color: #28a745;
            z-index: 1;
            transform: scaleX(0);
            transform-origin: left;
            animation: fillLine 0.6s ease forwards;
        }

        .timeline-item.completed::after,
        .timeline-item.active::after {
            animation-delay: var(--delay, 0s);
        }

    .timeline-marker {
        position: relative;
        z-index: 2;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #ffffff;
        border: 3px solid #d3d3d3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #d3d3d3;
        margin-bottom: 10px;
        transition: all 0.4s ease;
    }


    .timeline-item.completed .timeline-marker {
        border-color: #28a745;
        background-color: #28a745;
        color: #fff;
        animation: popIn 0.4s ease;
    }

    .timeline-item.active .timeline-marker {
        border-color: #007bff;
        background-color: #007bff;
        color: #fff;
        animation: popIn 0.4s ease, pulse 1.5s ease-in-out infinite;
    }

    @@keyframes popIn {
        0% {
            transform: scale(0.6);
            opacity: 0;
        }

        60% {
            transform: scale(1.15);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(0,123,255,0.4);
        }

        50% {
            box-shadow: 0 0 0 8px rgba(0,123,255,0);
        }
    }

    .timeline-item.pending .timeline-marker {
        border-color: #d3d3d3;
        background-color: #f8f9fa;
        color: #adb5bd;
    }

    .timeline-marker {
        animation-delay: var(--delay, 0s);
    }

    .timeline-item h6 {
        position: relative;
        z-index: 2;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #495057;
    }

    .timeline-item.pending h6 {
        color: #adb5bd;
    }

    .timeline-date {
        position: relative;
        z-index: 2;
        font-size: 11px;
        color: #6c757d;
    }

    @@keyframes fillLine {
        from {
            transform: scaleX(0);
        }

        to {
            transform: scaleX(1);
        }
    }

    .timeline-item:first-child::before,
    .timeline-item:first-child.completed::before,
    .timeline-item:first-child.active::before,
    .timeline-item:first-child.pending::before {
        display: none !important;
        content: none;
    }

    .timeline-item:first-child.completed::after,
    .timeline-item:first-child.active::after {
        display: none !important;
        content: none;
    }

    .form-control-sm,
    .form-select-sm {
        font-size: 0.82rem;
    }

    .form-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 2px;
    }

    /* ================= Form Fields Row & Layout (Ledger, VendorInfo & SepDocUpdate Standard) ================= */
    .daily-job-fields-row,
    .daily-job-form-card .row {
        --control-height: 30px;
        --gap-size: 36px;
        --btn-width: 20px;
        --bs-gutter-x: var(--gap-size) !important;
        row-gap: 12px !important;
    }

    .daily-job-form-card,
    .daily-job-fields-row,
    .daily-job-form-card .row,
    .daily-job-fields-row > div,
    .daily-job-form-card .row > div {
        overflow: visible !important;
    }

    /* Form Card Container: Symmetrical left & right margins (compensates for Column 3 quick-add button) */
    .daily-job-form-card {
        padding-left: 24px !important;
        padding-right: 48px !important;
        padding-top: 12px !important;
        padding-bottom: 8px !important;
    }

    /* Uniform Label Styling & Baseline Alignment */
    .daily-job-fields-row .form-label,
    .daily-job-form-card .form-label {
        display: flex !important;
        align-items: center !important;
        height: 20px !important;
        min-height: 20px !important;
        max-height: 20px !important;
        margin-bottom: 4px !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        color: #495057 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        box-sizing: border-box !important;
    }

    .daily-job-fields-row .form-label .text-danger,
    .daily-job-fields-row .form-label sup,
    .daily-job-fields-row .form-label span,
    .daily-job-form-card .form-label .text-danger,
    .daily-job-form-card .form-label sup,
    .daily-job-form-card .form-label span {
        font-size: 13px !important;
        line-height: 1 !important;
        vertical-align: middle !important;
        margin-left: 2px !important;
        display: inline-block !important;
    }

    /* Ensure input/select container inside field-fixed-width takes 100% of the column width */
    .daily-job-fields-row .field-fixed-width,
    .daily-job-form-card .field-fixed-width {
        position: relative !important;
        width: 100% !important;
        display: flex !important;
        align-items: stretch !important;
        margin: 0 !important;
        padding: 0 !important;
        gap: 0 !important;
        overflow: visible !important;
        box-sizing: border-box !important;
    }

    .daily-job-fields-row .input-group,
    .daily-job-form-card .input-group {
        width: 100% !important;
        box-sizing: border-box !important;
    }

    .daily-job-fields-row .field-fixed-width > .input-group,
    .daily-job-form-card .field-fixed-width > .input-group {
        width: 100% !important;
        flex: 1 1 100% !important;
        min-width: 0 !important;
    }

    /* Hide invisible placeholder buttons completely so non-quick-add fields expand to 100% */
    .daily-job-fields-row .field-fixed-width > .invisible-placeholder-btn,
    .daily-job-form-card .field-fixed-width > .invisible-placeholder-btn {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        border: 0 !important;
    }

    /* Uniform height & 100% width for all inputs, selects, custom datepickers, and input-groups */
    .daily-job-fields-row .form-control:not(textarea),
    .daily-job-fields-row .form-select,
    .daily-job-fields-row input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]):not(textarea),
    .daily-job-fields-row select,
    .daily-job-fields-row .input-group-text,
    .daily-job-fields-row .custom-datepicker,
    .daily-job-form-card .form-control:not(textarea),
    .daily-job-form-card .form-select,
    .daily-job-form-card input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]):not(textarea),
    .daily-job-form-card select,
    .daily-job-form-card .input-group-text,
    .daily-job-form-card .custom-datepicker {
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        line-height: calc(var(--control-height) - 2px) !important;
        font-size: 0.82rem !important;
        box-sizing: border-box !important;
    }

    .daily-job-fields-row .form-control,
    .daily-job-fields-row .form-select,
    .daily-job-fields-row select,
    .daily-job-fields-row .select2-container,
    .daily-job-fields-row .input-group .select2-container,
    .daily-job-form-card .form-control,
    .daily-job-form-card .form-select,
    .daily-job-form-card select,
    .daily-job-form-card .select2-container,
    .daily-job-form-card .input-group .select2-container {
        width: 100% !important;
        flex: 1 1 auto !important;
        min-width: 0 !important;
    }

    /* Textareas take 100% width with row-matching or natural multiline height */
    .daily-job-fields-row textarea,
    .daily-job-fields-row .field-fixed-width > textarea,
    .daily-job-form-card textarea,
    .daily-job-form-card .field-fixed-width > textarea {
        min-height: var(--control-height) !important;
        height: var(--control-height);
        line-height: 1.3 !important;
        padding: 4px 8px !important;
        width: 100% !important;
        flex: 1 1 100% !important;
        min-width: 0 !important;
        font-size: 0.82rem !important;
        box-sizing: border-box !important;
    }

    .daily-job-fields-row textarea:not([rows="1"]),
    .daily-job-fields-row .field-fixed-width > textarea:not([rows="1"]),
    .daily-job-form-card textarea:not([rows="1"]),
    .daily-job-form-card .field-fixed-width > textarea:not([rows="1"]) {
        min-height: 56px !important;
        height: auto !important;
    }

    /* Select2 dropdown height and arrow alignment */
    .daily-job-fields-row .select2-container .select2-selection--single,
    .daily-job-form-card .select2-container .select2-selection--single {
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        display: flex !important;
        align-items: center !important;
        box-sizing: border-box !important;
    }

    .daily-job-fields-row .select2-container .select2-selection--single .select2-selection__rendered,
    .daily-job-form-card .select2-container .select2-selection--single .select2-selection__rendered {
        line-height: calc(var(--control-height) - 2px) !important;
        padding-left: 8px !important;
        padding-right: 20px !important;
