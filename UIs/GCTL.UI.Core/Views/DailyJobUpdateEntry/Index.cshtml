        <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded">
            <div class="mb-9">
                <div id="jobStatusSummary">
                    <!-- Search and Page Size -->
                    <div class="toolbar pb-2">

                        <div class="toolbar-left">
                            @* <div class="input-group input-group-sm toolbar-showing">
                                <span class="input-group-text">Showing</span>
                                <select class="form-select" id="statusPageSizeSelect">
                                    <option>10</option>
                                    <option>25</option>
                                    <option>50</option>
                                    <option>100</option>
                                </select>
                            </div> *@
                        </div>
                        <div class="toolbar-right">
                            <span class="label-text">Filter By:</span>
                            <div class="toolbar-item toolbar-customer">
                                <select class="form-select form-select-sm custom-select-single"
                                        id="customerLoadGridFilter" data-placeholder="Select Customer"
                                        asp-items="ViewBag.CustomerName as SelectList">
                                    <option value="">All Customers</option>
                                </select>
                            </div>

                            <div class="toolbar-item toolbar-date">
                                <div class="input-group input-group-sm custom-date-group">
                                    <span class="input-group-text">Date From</span>
                                    <input type="date" class="form-control custom-datepicker caiCon" id="dateLoadGridFrom">
                                    <span class="input-group-text">To</span>
                                    <input type="date" class="form-control custom-datepicker caiCon" id="dateLoadGridTo">
                                </div>
                            </div>

                            <div class="toolbar-item toolbar-search">
                                @* <input class="form-control form-control-sm"
                                       id="statusSearchInput"
                                       type="text"
                                       placeholder="Search"> *@
                            </div>
                        </div>

                    </div>
                    @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                    {
                        GridId = "JobStatusTable",
                        AjaxUrl = "/DailyJobUpdateEntry/GetJobStatuses",
                        AjaxMethod = "POST",
                        ServerSide = true,
                        ShowCheckbox = true,
                        CheckColumnData = "id",
                        CheckAllId = "checkAll",
                        ShowActionMenu = false,
                        ShowRowNumbers = false,
                        DefaultSortColumn = "JobNo",
                        DefaultSortDirection = "desc",
                        Columns = new()
                        {
                            new() { Data = "jobUpdateCode", Header = "ID", Align = "center" },
                            new() { Data = "jobNo", Header = "Job No", IsEditLink = true, EditSelectorClass = "job-no-link", IdField = "id", DataAttributes = new List<string> { "jobno" } },
                            new() { Data = "shipmentStatus", Header = "Shipment Status", Align = "left" },
                            new() { Data = "dateTimeText", Header = "Date Time", Align = "center" }
                        }
                    })
            </div>
        </div>
        <partial name="_BottomNavigation" />
    </div>
</section>

