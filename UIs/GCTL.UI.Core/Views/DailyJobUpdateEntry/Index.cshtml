                    <!-- Weight + Unit (Horizontal Group) -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Weight & Unit (KG)</label>
                        <div class="d-flex gap-2 group-horizontal">
                            <input type="number" class="form-control form-control-sm" id="weight" />
                            <select class="form-select form-select-sm custom-select-single" data-placeholder="Select Unit" id="weightUnitId" asp-items="ViewBag.QuantityUnit as SelectList">
                                <option value="">Select Unit</option>
                            </select>
                        </div>
                        <span class="text-danger"></span>
                        <span class="text-danger"></span>
                    </div>

                    <!-- FWDR (Shipping Agent) -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">FWDR (Shipping Agent)</label>

                        <input class="form-control form-control-sm" id="forwarderId" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Vessel/Rott No -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Vessel/Rott No</label>
                        <input class="form-control form-control-sm" id="vesselRottNo" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Remarks -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control form-control-sm" rows="1" id="read-remarks"></textarea>
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 border-bottom border-2 py-1"></div>
                @await Html.PartialAsync("_Setup", Model.Setup)

                @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                {
                    Title = "",
                    ShowDelete = false,
                    ShowClear = false,
                    ShowPrint = false,
                    ShowFavorite = false,
                    IsPlain = true,
                    SaveBtnClass = "saveBtn"
                })
            </div>
        </div>
        <div class="pb-2 d-none" id="timelineCard">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Shipment Progress Timeline</h5>
                </div>
                <div class="card-body p-1">
                    <div class="timeline" id="shipmentTimeline">
                        <!-- জাভাস্ক্রিপ্ট dynamic ভাবে item গুলো এখানে বসাবে, .timeline-line লাগবে না -->
                    </div>
                </div>
            </div>
        </div>

        <hr class="border border-body-emplhsish border-1 opacity-100 mx-auto mb-2">


        <div class="px-1 pt-1 p-lg-4 pb-lg-0 bg-white shadow rounded">
            <div class="mb-9">
                <div id="jobStatusSummary">
                    <!-- Search and Page Size -->
                    <div class="toolbar pb-2">

                        <div class="toolbar-left">
                            <div class="input-group input-group-sm toolbar-showing">
                                <span class="input-group-text">Showing</span>
                                <select class="form-select" id="statusPageSizeSelect">
                                    <option>10</option>
                                    <option>25</option>
                                    <option>50</option>
                                    <option>100</option>
                                </select>
                            </div>
                        </div>
                        <div class="toolbar-right">
                            <span class="label-text">Filter By:</span>
                            <div class="toolbar-item toolbar-customer">
                                <select class="form-select form-select-sm custom-select-single"
                                        id="customerLoadGridFilter" data-placeholder="Select Customer"
                                        asp-items="ViewBag.CustomerName as SelectList">
                                    <option value="">All Customers</option>
                                </select>
                            </div>

                            <div class="toolbar-item toolbar-date">
                                <div class="input-group input-group-sm custom-date-group">
                                    <span class="input-group-text">Date From</span>
                                    <input type="date" class="form-control custom-datepicker caiCon" id="dateLoadGridFrom">
                                    <span class="input-group-text">To</span>
                                    <input type="date" class="form-control custom-datepicker caiCon" id="dateLoadGridTo">
                                </div>
                            </div>

                            <div class="toolbar-item toolbar-search">
                                <input class="form-control form-control-sm"
                                       id="statusSearchInput"
                                       type="text"
                                       placeholder="Search">
                            </div>
                        </div>

                    </div>
                    <!-- Table -->
                    <div class="table-responsive ms-n1 ps-1 scrollbar">
                        <table class="table table-sm table-bordered fs-9 mb-0 border-top border-translucent dyn-tableDrag" id="JobStatusTable">
                            <thead>
                                <tr>
                                    <th class="sort white-space-nowrap align-middle text-center ps-0" style="width:110px" scope="col" data-sort="Status">
                                        <input type="checkbox" id="checkAll" class="form-check-input" />  Select All
                                    </th>
                                    <th class="sort white-space-nowrap align-middle text-center ps-2" scope="col" data-sort="ID">ID</th>
                                    <th class="sort white-space-nowrap align-middle text-center ps-2" scope="col" data-sort="JobNo">Job No</th>
                                    <th class="sort white-space-nowrap align-middle text-center ps-2" scope="col" data-sort="ShipmentStatus">Shipment Status</th>
                                    <th class="sort white-space-nowrap align-middle text-center ps-2 text-end" scope="col" data-sort="DateTime">Date Time</th>

                                </tr>
                            </thead>
                            <tbody class="list" id="jobStatusTableBody">
                                <!-- Rows populated via AJAX -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between py-3 pe-0 fs-9 border-bottom border-translucent">
                        <div class="d-flex">
                            <p class="mb-0 d-none d-sm-block me-3 fw-semibold text-body" id="statusDataListInfo"></p>
                        </div>
                        @* <div class="d-flex">
                                <button class="page-link" id="statusPaginationPrev"><span class="fas fa-chevron-left"></span></button>
                                <ul class="mb-0 pagination" id="statusPaginationNumbers"></ul>
                                <button class="page-link pe-0" id="statusPaginationNext"><span class="fas fa-chevron-right"></span></button>
                            </div> *@
                        <div class="d-flex">
                            <button class="page-link" id="paginationFirst"><span class="bi bi-chevron-bar-left"></span></button>
                            <button class="page-link" id="paginationPrev"><span class="bi bi-chevron-left"></span></button>
                            <ul class="mb-0 pagination" id="paginationNumbers"></ul>
                            <button class="page-link pe-0" id="paginationNext"><span class="bi bi-chevron-right"></span></button>
                            <button class="page-link pe-0" id="paginationLast"><span class="bi bi-chevron-bar-right"></span></button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/DailyJobUpdateEntry.js"></script>
}