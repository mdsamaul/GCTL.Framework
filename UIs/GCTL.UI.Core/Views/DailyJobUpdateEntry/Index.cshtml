        right: 4px !important;
    }

    /* Checkbox Alignment */
    .daily-job-fields-row .form-check,
    .daily-job-form-card .form-check {
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        min-height: var(--control-height) !important;
        margin-top: 24px !important;
        margin-bottom: 0 !important;
        padding-left: 0 !important;
    }

    .daily-job-fields-row .form-check .form-check-input,
    .daily-job-form-card .form-check .form-check-input {
        margin: 0 !important;
        float: none !important;
        width: 16px !important;
        height: 16px !important;
        cursor: pointer !important;
    }

    .daily-job-fields-row .form-check .form-check-label,
    .daily-job-form-card .form-check .form-check-label {
        font-size: 12px !important;
        font-weight: 600 !important;
        color: #495057 !important;
        cursor: pointer !important;
        margin: 0 !important;
        line-height: 1 !important;
    }

    /* Quick-Add (+) Button positioned inside the column gap with clear 12px right gap and NO border */
    .daily-job-fields-row .field-fixed-width > .detached-action-btn:not(.invisible-placeholder-btn),
    .daily-job-fields-row .field-fixed-width > .js-quick-add,
    .daily-job-form-card .field-fixed-width > .detached-action-btn:not(.invisible-placeholder-btn),
    .daily-job-form-card .field-fixed-width > .js-quick-add {
        position: absolute !important;
        left: calc(100% + 4px) !important;
        top: 0 !important;
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        width: var(--btn-width) !important;
        min-width: var(--btn-width) !important;
        max-width: var(--btn-width) !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        z-index: 5 !important;
        margin: 0 !important;
        border: 0 !important;
        border-color: transparent !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: #495057 !important;
        border-radius: 4px !important;
        cursor: pointer !important;
        box-sizing: border-box !important;
    }

    .daily-job-fields-row .field-fixed-width > .detached-action-btn:not(.invisible-placeholder-btn):hover,
    .daily-job-fields-row .field-fixed-width > .js-quick-add:hover,
    .daily-job-form-card .field-fixed-width > .detached-action-btn:not(.invisible-placeholder-btn):hover,
    .daily-job-form-card .field-fixed-width > .js-quick-add:hover {
        border: 0 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        background: #e9ecef !important;
        color: #0d6efd !important;
    }

    .daily-job-fields-row .field-fixed-width > .detached-action-btn:not(.invisible-placeholder-btn):focus,
    .daily-job-fields-row .field-fixed-width > .js-quick-add:focus,
    .daily-job-fields-row .field-fixed-width > .detached-action-btn:not(.invisible-placeholder-btn):active,
    .daily-job-fields-row .field-fixed-width > .js-quick-add:active,
    .daily-job-form-card .field-fixed-width > .detached-action-btn:not(.invisible-placeholder-btn):focus,
    .daily-job-form-card .field-fixed-width > .js-quick-add:focus,
    .daily-job-form-card .field-fixed-width > .detached-action-btn:not(.invisible-placeholder-btn):active,
    .daily-job-form-card .field-fixed-width > .js-quick-add:active {
        border: 0 !important;
        border-color: transparent !important;
        box-shadow: none !important;
        outline: none !important;
    }

    .daily-job-fields-row .field-fixed-width > .detached-action-btn i,
    .daily-job-fields-row .field-fixed-width > .js-quick-add i,
    .daily-job-form-card .field-fixed-width > .detached-action-btn i,
    .daily-job-form-card .field-fixed-width > .js-quick-add i {
        font-size: 11px !important;
    }

    /* ================= Dual Input Group (gap-2 & 50%-50% Equal Width) ================= */
    .daily-job-fields-row .dual-input-group,
    .daily-job-form-card .dual-input-group {
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: stretch !important;
        width: 100% !important;
        height: var(--control-height) !important;
        min-height: var(--control-height) !important;
        max-height: var(--control-height) !important;
        gap: 0.5rem !important; /* gap-2 (8px) */
    }

    .daily-job-fields-row .dual-input-group > *,
    .daily-job-form-card .dual-input-group > * {
        margin-left: 0 !important;
    }

    .daily-job-fields-row .dual-input-group > select[style*="display: none"],
    .daily-job-fields-row .dual-input-group > select.custom-select-single[style*="display: none"],
    .daily-job-fields-row .dual-input-group > select.select2-hidden-accessible,
    .daily-job-form-card .dual-input-group > select[style*="display: none"],
    .daily-job-form-card .dual-input-group > select.custom-select-single[style*="display: none"],
    .daily-job-form-card .dual-input-group > select.select2-hidden-accessible {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        border: 0 !important;
        flex: 0 0 0% !important;
    }

    /* Left Input: 50% width */
    .daily-job-fields-row .dual-input-group > input:first-child,
    .daily-job-fields-row .dual-input-group > select:first-child,
    .daily-job-fields-row .dual-input-group > .form-control:first-child,
    .daily-job-form-card .dual-input-group > input:first-child,
    .daily-job-form-card .dual-input-group > select:first-child,
