                            Title = "",
                            ShowDelete = false,
                            ShowClear = false,
                            ShowPrint = false,
                            ShowFavorite = false,
                            IsPlain = true,
                            SaveBtnClass = "saveBtn",
                            ReserveActionSlot = true,
           Style="border-bottom:0px !important;"
                        })
                    </div>

                </div>
            </div>
            @* </div> *@

        </div>
