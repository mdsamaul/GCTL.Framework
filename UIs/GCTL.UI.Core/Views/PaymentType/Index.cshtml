@model GCTL.UI.Core.ViewModels.PaymentType.PaymentTypePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Payment Type";
    Model.Breadcrumb = "Payment Type";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Payment Type",
                            SaveBtnClass = "js-paymenttype-save",
                            DeleteBtnClass = "js-paymenttype-delete-confirm",
                            ClearBtnClass = "js-paymenttype-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="paymenttype-form" asp-controller="PaymentType">
                            <div class="js-paymenttype-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "paymentTypeTable",
                    AjaxUrl = "/PaymentType/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "paymentTypeId",
                    CheckAllId = "paymenttype-check-all",
                    DefaultSortColumn = "paymentTypeId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "paymentTypeId", Header = "Code", Width = "20%", IsEditLink = true, EditSelectorClass = "js-paymenttype-edit" },
                        new() { Data = "paymentType", Header = "Payment Type Name", Width = "50%", Align = "left" },
                        new() { Data = "shortName", Header = "Short Name", Width = "30%", Align = "left" }
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/paymentType.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $.paymentType({
                baseUrl: '/PaymentType'
            });
        });
    </script>
}
