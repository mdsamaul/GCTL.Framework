@model GCTL.UI.Core.ViewModels.Departments.DepartmentPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Department Info";
    Model.Breadcrumb = "Department Info";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Department Info",
                            SaveBtnClass = "js-department-save",
                            DeleteBtnClass = "js-department-delete-confirm",
                            ClearBtnClass = "js-department-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="department-form" asp-controller="Departments">
                            <div class="js-department-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "departmentTable",
                    AjaxUrl = "/Departments/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "departmentCode",
                    CheckAllId = "department-check-all",
                    DefaultSortColumn = "departmentCode",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "departmentCode", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-department-edit" },
                        new() { Data = "departmentName", Header = "Department Name", Width = "40%", Align = "left" },
                        new() { Data = "departmentShortName", Header = "Short Name", Width = "20%", Align = "center" },
                        new() { Data = "banglaDepartment", Header = "Department (বাংলা)", Width = "30%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />

<script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/departments.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
        if (window.jQuery && typeof $.departments === "function") {
            var options = { baseUrl: '@Url.Action("", "Departments")' };
            options.load = () => { };
            $.departments(options);
        } else {
            setTimeout(waitForJQuery, 30);
        }
    })();
</script>



