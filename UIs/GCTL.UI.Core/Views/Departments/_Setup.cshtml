@model GCTL.Core.ViewModels.Departments.DepartmentSetupViewModel
@using GCTL.UI.Core.ViewModels

<div style="padding-top: 10px;">

    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" id="AutoId" asp-for="AutoId" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Department Id (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "DepartmentCode",
            LabelText = "Department Id",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-department-code",
            DefaultValue = Model?.DepartmentCode
        })
    </div>

    <div class="form-group row">

        @* ---------- Department Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "DepartmentName",
            LabelText = "Department",
            FieldType = FieldType.Text,
            Placeholder = "Enter Department",
            ReserveActionSlot = false,
            IsRequired = true,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-department-check-availability",
            DefaultValue = Model.DepartmentName,
            AutoFocus = true
        })

        @* ---------- Short Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "DepartmentShortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            DefaultValue = Model.DepartmentShortName
        })
    </div>

    <div class="form-group row">

        @* ---------- Department (বাংলা) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BanglaDepartment",
            LabelText = "Department (বাংলা)",
            ReserveActionSlot = false,
            FieldType = FieldType.Text,
            Placeholder = "Enter Department (বাংলা)",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.BanglaDepartment
        })
    </div>

    @if (Model.AutoId > 0)
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }
</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-department-save",
            ReserveActionSlot = false,
            IsMarginRight = true
        })
    </div>
</div>