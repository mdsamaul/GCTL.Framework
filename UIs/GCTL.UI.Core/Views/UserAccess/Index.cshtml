@model GCTL.UI.Core.ViewModels.UserAcesses.UserAccessPageViewModel
@{
    ViewBag.Title = "User Access";
    Model.Breadcrumb = "User Access Info";
    Model.PageTitle = ViewBag.Title;
}

<style>
    .dataTables_scrollBody > table > thead > tr > th {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }

    table a {
        text-decoration: underline !important;
        color: #0000e0 !important;
    }

    #useraccess-grid th:last-child,
    #useraccess-grid td:last-child {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    /* Breakpoint adjustments for 900px - 1500px and >1500px */
    @@media (min-width: 900px) and (max-width: 1500px) {
        .ua-layout-form-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            margin-bottom: .5rem;
        }

        .ua-layout-form-col .card-body {
            padding-bottom: .5rem !important;
        }

        .ua-layout-grid-col {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            /* padding-bottom: 2rem !important; */
        }
    }

    @@media (min-width: 1500.02px) {
        .ua-layout-form-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }

        .ua-layout-grid-col {
            flex: 0 0 50% !important;
            max-width: 50% !important;
        }
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-xl-6 ua-layout-form-col pe-xl-1 ps-0">
                <div class="card card-primary">
                    @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                    {
                        Title = Model.PageTitle,
                        SaveBtnClass = "js-useraccess-save", DeleteBtnClass = "js-useraccess-delete-confirm", ClearBtnClass = "js-useraccess-clear",
                        ShowFavorite = false, ShowPrint = false
                    })
                    <div class="card-body" style="padding-left: 7px; padding-right: 8px; padding-top: 10px; padding-bottom: 0px;">
                        <form asp-action="Setup" id="useraccess-form">
                            <div class="js-useraccess-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-6 ua-layout-grid-col ps-xl-1 pe-0 pb-0">
                <div class="js-useraccess-grid-container">
                    <partial name="_Grid" />
                </div>
            </div>
        </div>
    </div>

    <partial name="_BottomNavigation" />
</section>
<partial name="DeleteModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/pages/userAccesses.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "Useraccess")',
            maxDecimalPlace: 5,
            showNagativeFormat: true,
        };
        options.load = () => {
        };

        $.userAccesses(options);
    </script>
}



