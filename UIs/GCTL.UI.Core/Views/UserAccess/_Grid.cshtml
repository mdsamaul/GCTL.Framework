<div class="table-responsive" style="padding: 0;">
    <table id="useraccess-grid" class="table table-striped table-sm table-hover table-bordered" style="width:100%;">
        <thead>
            <tr>
                <th class="text-center align-middle p-0 no-sort" style="vertical-align: middle;" width="2%">
                    Sel.
                    <div class="form-check d-inline-block mb-0">
                        <input type="checkbox" class="form-check-input" id="useraccess-check-all">
                        <label class="form-check-label visually-hidden" for="useraccess-check-all">Select all</label>
                    </div>
                </th>
                <th style="text-align:center" class="align-middle">User ID</th>
                <th style="text-align:center" class="align-middle">Name</th>
                <th style="text-align:center" class="align-middle">User Name</th>
                <th style="text-align:center" class="align-middle">Role</th>
                <th style="text-align:center" class="align-middle">Access Code</th>
            </tr>
        </thead>
    </table>
</div>