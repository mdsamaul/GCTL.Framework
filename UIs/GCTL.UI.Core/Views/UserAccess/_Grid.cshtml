@using GCTL.UI.Core.ViewModels

@await Html.PartialAsync("_CustomGrid", new GridModel
{
    GridId = "useraccess-grid",
    AjaxUrl = "/UserAccess/GetTableData",
    ServerSide = true,
    ShowCheckbox = true,
    CheckboxClass = "checkBox",
    CheckColumnData = "id",
    DefaultSortColumn = "id",
    DefaultSortDirection = "desc",
    Columns = new()
    {
        new() { Data = "id", Header = "ID", Width = "6%", IsEditLink = true, EditSelectorClass = "js-useraccess-edit", Align = "center" },
        new() { Data = "username", Header = "User Name", Width = "16%", Align = "left" },
        new() { Data = "fullName", Header = "Full Name", Width = "22%", Align = "left" },
        new() { Data = "role", Header = "User Type(Role)", Width = "15%", Align = "left" },
        new() { Data = "entryDate", Header = "Entry Date", Width = "14%", Align = "center" },
        new() { Data = "accessCode", Header = "Access Code", Width = "14%", Align = "center" },
        new() { Data = "status", Header = "Active", Width = "9%", Align = "center" }
    }
})
