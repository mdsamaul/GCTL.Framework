@using GCTL.UI.Core.ViewModels

@await Html.PartialAsync("_CustomGrid", new GridModel
{
    GridId = "useraccess-grid",
    AjaxUrl = "/UserAccess/GetTableData",
    ServerSide = true,
    ShowCheckbox = true,
    CheckboxClass = "checkBox",
    CheckColumnData = "id",
    DefaultSortColumn = "id",
    DefaultSortDirection = "desc",
    Compact = true,
    Columns = new()
    {
        new() { Data = "id", Header = "ID", Width = "5%", IsEditLink = true, EditSelectorClass = "js-useraccess-edit", Align = "center" },
        new() { Data = "username", Header = "User Name", Width = "14%" },
        new() { Data = "fullName", Header = "Full Name", Width = "24%" },
        new() { Data = "role", Header = "User Type", Width = "14%" },
        new() { Data = "accessCode", Header = "Access Code", Width = "14%", Align = "center" },
        new() { Data = "entryDate", Header = "Entry Date", Width = "12%", Align = "center", RenderFn = "formatDate" },
        new() { Data = "status", Header = "Active", Width = "9%", Align = "center" },
        new() { Data = "isMobileAppUser", Header = "Is Mobile<br />App User", Width = "9%", Align = "center" },
    }
})
