@model ToobarModel
<div class="row">
    <div class="col-md-5">
        <h6 class="page-title">@Model.Title</h6>
    </div>
    <div class="col-md-7">
        <div class="btn-toolbar d-flex justify-content-end">
            <div class="btn-group">
                <button type="button" id="btnSubmit"
                        class="btn btn-default success-btn js-useraccess-save">
                    <i class="fa fa-save js-useraccess-save pr-2">&nbsp;</i>Save
                </button>
                <button type="button" id="btnDelete" class="btn btn-default danger-btn js-useraccess-delete-confirm">
                    <i class="fa fa-trash fa-sm pr-2"></i>Delete
                </button>
                <button type="button" id="btnClear" data-id=""
                        class="btn btn-default primary-btn js-useraccess-clear">
                    <i class="fas fa-recycle fa-sm pr-2"></i>Clear
                </button>
                
            </div>
            
        </div>
    </div>
</div>

