@model GCTL.Core.ViewModels.Finance.ChartOfAccounts.SubControlLedgerAddVM

<div class="coa-wrap">
    <partial name="~/Views/Shared/_ChartOfAccountsTabs.cshtml" model='@("SubControlLedger")' />

    <!-- Setup Form Card -->
    <div class="coa-card">
        <div class="coa-ch" id="SubControlLedger-formTitle">
            @Html.SmartLocalize("Sub-Control Ledger: new entry")
        </div>

        <form id="SubControlLedger-form">
            <input type="hidden" id="SubControlLedger-isEdit" value="0" />

            <!-- Row 1: Parent Hierarchy Selection (Single line, strictly no wrap) -->
            <div class="coa-parents-row">
                <div class="coa-form-col">
                    <label class="coa-form-label" for="SubControlLedger-GroupSelect" title="@Html.SmartLocalize("Group Ledger *")">
                        @Html.SmartLocalize("Group Ledger *")
                    </label>
                    <select class="form-select form-select-sm custom-select-single" asp-for="GroupLedgerCodeNo" id="SubControlLedger-GroupSelect" data-placeholder="@Html.SmartLocalize("Select Group Ledger")">
                        <option value="">-- @Html.SmartLocalize("Select Group Ledger") --</option>
                        @if (ViewBag.Groups != null)
                        {
                            foreach (var g in ViewBag.Groups)
                            {
                                <option value="@g.Code">@g.DisplayText</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="GroupLedgerCodeNo" class="text-danger small"></span>
                </div>

                <div class="coa-form-col">
                    <label class="coa-form-label" for="SubControlLedger-ControlSelect" title="@Html.SmartLocalize("Control Ledger *")">
                        @Html.SmartLocalize("Control Ledger *")
                    </label>
                    <select class="form-select form-select-sm custom-select-single" asp-for="ControlLedgerCodeNo" id="SubControlLedger-ControlSelect" data-placeholder="@Html.SmartLocalize("Select Control Ledger")" disabled>
                        <option value="">-- @Html.SmartLocalize("Select Control Ledger") --</option>
                    </select>
                    <span asp-validation-for="ControlLedgerCodeNo" class="text-danger small"></span>
                </div>
            </div>

            <!-- Row 2: Sub-Control Ledger Entry Fields (Single line within equal columns) -->
            <div class="coa-entry-row">
                <div class="coa-form-col">
                    <label class="coa-form-label" title="@Html.SmartLocalize("SCL Code (auto)")">
                        @Html.SmartLocalize("SCL Code (auto)")
                    </label>
                    <div class="coa-code-preview" id="SubControlLedgerCodePreview">
                        <span class="text-muted">@Html.SmartLocalize("Select Control first")</span>
                    </div>
                    <input type="hidden" asp-for="SubControlLedgerCodeNo" id="SubControlLedgerCodeNo" />
                    <span asp-validation-for="SubControlLedgerCodeNo" class="text-danger small"></span>
                </div>

                <div class="coa-form-col">
                    <label class="coa-form-label" for="SubControlLedgerName" title="@Html.SmartLocalize("Sub-Control Ledger Name *")">
                        @Html.SmartLocalize("Sub-Control Ledger Name *")
                    </label>
                    <input type="text" class="coa-form-control" asp-for="SubControlLedgerName" id="SubControlLedgerName" placeholder="@Html.SmartLocalize("Enter Sub-Control name")" />
                    <span asp-validation-for="SubControlLedgerName" class="text-danger small"></span>
                </div>

                <div class="coa-form-col">
                    <label class="coa-form-label" for="ShortName" title="@Html.SmartLocalize("Short Name")">
                        @Html.SmartLocalize("Short Name")
                    </label>
                    <input type="text" class="coa-form-control" asp-for="ShortName" id="ShortName" placeholder="@Html.SmartLocalize("Short Name")" />
                    <span asp-validation-for="ShortName" class="text-danger small"></span>
                </div>

                <div class="coa-form-col-auto">
                    <label class="coa-form-label d-none d-lg-block">&nbsp;</label>
                    <div class="d-flex align-items-center" style="height: 38px;">
                        <label class="coa-in mb-0">
                            <input type="checkbox" asp-for="IsActive" id="IsActive" value="true" checked />
                            <span>@Html.SmartLocalize("Active")</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="coa-fa">
                <button type="submit" class="coa-btn pri" id="SubControlLedger-saveBtn">
                    @Html.SmartLocalize("Save")
                </button>
                <button type="button" class="coa-btn" id="SubControlLedger-resetBtn">
                    @Html.SmartLocalize("Clear")
                </button>
            </div>
        </form>
    </div>

    <!-- Table Card -->
    <partial name="_Table" />
</div>

<partial name="_ConfirmDelete" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/finance/subControlLedger.js" asp-append-version="true"></script>
}
