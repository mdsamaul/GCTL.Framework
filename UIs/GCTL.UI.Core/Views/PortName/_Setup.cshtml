@model GCTL.Core.ViewModels.PortName.PortNameSetupViewModel


<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>
    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <div class="col-lg-6">
            <label asp-for="PortNameId">ID </label>
            <div class="input-group input-group-sm">
                <input asp-for="PortNameId" type="text" class="form-control form-control-sm js-PortNameId-code" readonly="readonly" />
            </div>
        </div>
        <div class="col-lg-6">
            <label asp-for="PortId">Port Type<span style="color:red">*</span></label>
            <div class="Port-input-wrapper">
                <div class="port-select-wrap">
                    <select asp-for="PortId"
                            asp-items="ViewBag.PortTypeDD"
                            class="form-control form-control-sm custom-select-single"
                            tabindex="1">
                        <option value="">-- Select Port Type --</option>
                    </select>
                </div>
                <button type="button" class="btn btn-plus js-quick-add"
                        data-url="@Url.Action("Index", "PortType")"
                        data-target="#PortId"
                        data-reload-url="@Url.Action("GetPortTypes", "Cascading")"
                        data-title="Port Type">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="PortName">Port Name<span style="color:red">*</span></label>
            <input type="text" asp-for="PortName" class="form-control form-control-sm" placeholder="Enter Port Name" tabindex="2" />
        </div>
        <div class="col-lg-6">
            <label asp-for="ShortName">Short Name</label>
            <input type="text" asp-for="ShortName" class="form-control form-control-sm" placeholder="Enter Short Name" tabindex="3" />
        </div>
    </div>

    @if (Model.Tc > 0)
    {

        <hr />
        <div class="form-group row" id="LdateModifyHide">
            <div class="col-lg-6">
                @if (Model.Ldate.HasValue)
                {
                    <label>Creation Date: </label>

                    <label>@Model.Ldate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
            <div class="col-lg-6">
                @if (Model.ModifyDate.HasValue)
                {
                    <label>Last Update Date: </label>

                    <label>@Model.ModifyDate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
        </div>

    }

</div>
<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "PortType"
        })
    </div>
</div>