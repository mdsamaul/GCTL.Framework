@model GCTL.UI.Core.ViewModels.PortName.PortNamePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Port Name";
    Model.Breadcrumb = "Port Name";
}

<style>
    /* Side-by-side flex layout for all screens:
       - Left: Setup Form (50% width)
       - Right: Table Grid (50% width)
       - Form Inputs: 2 per row (50% each inside form card)
    */
    .pn-layout-form-col {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }

    .pn-layout-grid-col {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }

    .pn-field-col {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }

    .pn-toolbar-col {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }

    .bg-light {
        background-color: #fff !important;
        color: #000 !important;
    }

    .form-control:disabled, .form-control[readonly] {
        background-color: #fff !important;
    }

    .btn-plus {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

    .Port-input-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .port-select-wrap {
        flex: 1;
        min-width: 0;
    }

        .port-select-wrap .select2-container {
            width: 100% !important;
        }

    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column (50% side-by-side) -->
            <div class="col-12 col-md-6 pn-layout-form-col">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Port Name",
                            SaveBtnClass = "js-PortName-save",
                            DeleteBtnClass = "js-PortName-delete-confirm",
                            ClearBtnClass = "js-PortName-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="PortName-form" asp-controller="PortName">
                            <div class="js-PortName-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column (50% side-by-side) -->
            <div class="col-12 col-md-6 pn-layout-grid-col">
                <div class="js-PortName-grid-container">
                    @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                    {
                        GridId = "PortName-grid",
                        AjaxUrl = "/PortName/GetTableData",
                        AjaxMethod = "GET",
                        ServerSide = false,
                        ShowCheckbox = true,
                        CheckColumnData = "portNameId",
                        CheckAllId = "PortName-check-all",
                        DefaultSortColumn = "portNameId",
                        DefaultSortDirection = "desc",
                        Columns = new()
                        {
                            new() { Data = "portNameId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-PortName-edit", IdField = "portNameId" },
                            new() { Data = "portType", Header = "Port Type", Width = "25%", Align = "left"},
                            new() { Data = "portName", Header = "Port Name", Width = "40%", Align = "left"},
                            new() { Data = "shortName", Header = "Short Name", Width = "25%", Align = "left"}
                        }
                    })
                </div>
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/app.input.validation.js" defer></script>
    <script src="~/js/pages/portName.js" defer></script>
    <script type="text/javascript">
        (function waitForJQuery() {
            if (window.jQuery && typeof $.portName === "function") {
                var options = { baseUrl: '@Url.Action("", "PortName")' };
                options.load = () => { };
                $.portName(options);
            } else {
                setTimeout(waitForJQuery, 30);
            }
        })();
    </script>
}