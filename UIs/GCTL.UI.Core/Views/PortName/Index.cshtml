@model GCTL.UI.Core.ViewModels.PortName.PortNamePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Port Name";
    Model.Breadcrumb = "Port Name";
}

<style>
    .bg-light {
        background-color: #fff !important;
        color: #000 !important;
    }

    .form-control:disabled, .form-control[readonly] {
        background-color: #fff !important;
    }

    .btn-plus {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

    .Port-input-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .port-select-wrap {
        flex: 1;
        min-width: 0;
    }

        .port-select-wrap .select2-container {
            width: 100% !important;
        }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Port Name",
                            SaveBtnClass = "js-PortName-save",
                            DeleteBtnClass = "js-PortName-delete-confirm",
                            ClearBtnClass = "js-PortName-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="PortName-form" asp-controller="PortName">
                            <div class="js-PortName-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "portNameTable",
                    AjaxUrl = "/PortName/GetTableData",
                    AjaxMethod = "GET",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "portNameId",
                    CheckAllId = "PortName-check-all",
                    DefaultSortColumn = "portNameId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "portNameId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-PortName-edit" },
                        new() { Data = "portType", Header = "Port Type", Width = "25%"},
                        new() { Data = "portName", Header = "Port Name", Width = "40%"},
                        new() { Data = "shortName", Header = "Short Name", Width = "25%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

<script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/portName.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
        if (window.jQuery && typeof $.portName === "function") {
            var options = { baseUrl: '@Url.Action("", "PortName")' };
            options.load = () => { };
            $.portName(options);
        } else {
            setTimeout(waitForJQuery, 30);
        }
    })();
</script>