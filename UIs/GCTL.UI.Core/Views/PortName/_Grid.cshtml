@model List<GCTL.Core.ViewModels.PortName.PortNameSetupViewModel>

<table id="PortName-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="PortName-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">ID</th>
            <th class="text-center text-middle" style="width: 23%;">Port Type</th>
            <th class="text-center text-middle" style="width: 32%;">Port Name</th>
            <th class="text-center text-middle" style="width: 20%;">Short Name</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                @* <td colspan="8">No Data Available.</td> *@
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.PortNameId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.PortNameId" value="@item.PortNameId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-PortName-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.PortNameId" title="Edit">
                            @item.PortNameId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.PortType</td>
                    <td class="text-center text-middle">@item.PortName</td>
                    <td class="text-center text-middle">@item.ShortName</td>

                </tr>
            }
        }

    </tbody>
</table>
