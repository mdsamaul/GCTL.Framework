@{
    ViewData["Title"] = "Customer Report Dashboard";
    Layout = "_Layout";
}

<style>

    /* Compact dropdowns */
    .filter-section .filter-group.filter-group-compact {
        flex: 0.2 1 0% !important; /* grow at 40% of normal rate; lower = narrower */
        min-width: 0 !important; /* remove the 120px floor from .filter-group */
        width: auto !important;
    }

        /* Make sure the custom widget inside just fills the (now smaller) parent */
        .filter-section .filter-group.filter-group-compact .custom-dd-wrapper {
            width: 100% !important;
            min-width: 0 !important;
        }

    /* Push Export to the far right so leftover space goes there */
    /* .filter-section .filter-right {
        margin-left: auto;
    } */
    .filter-section .filter-action {
        margin-left: auto;
    }

    :root {
        --primary: #0056b3;
        --secondary: #003366;
        --bg-frost: #f4f7f9;
        --white: #ffffff;
        --pending: #ff9800;
        --delivered: #4caf50;
        --transit: #9c27b0;
        --border: #e0e6ed;
        --text-main: #334155;
    }

    .job-status-dashboard {
        color: var(--text-main);
        font-family: 'Segoe UI', Roboto, sans-serif;
    }

    /* Main Container */
    .dashboard-container {
        padding: 6px 0 25px 0;
        max-width: 100%;
        margin: 0 auto;
    }

    /* Status Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 16px;
    }

    .stat-card {
        background: white;
        padding: 14px 18px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border-bottom: 4px solid var(--primary);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        user-select: none;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.06);
        }

        .stat-card.active-card {
            transform: translateY(-3px);
            box-shadow: 0 8px 18px rgba(0, 51, 102, 0.18) !important;
            border-top: 2px solid rgba(0, 86, 179, 0.2);
        }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-size: 1.25rem;
        color: white;
        flex-shrink: 0;
    }

    .stat-info h3 {
        font-size: 0.8rem;
        color: #64748b;
        text-transform: uppercase;
        margin: 0 0 4px 0;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .stat-info p {
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--secondary);
        margin: 0;
        line-height: 1;
    }

    /* Filter Section - One Line Design */
    .filter-section {
        background: white;
        padding: 12px 18px;
        border-radius: 10px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        border: 1px solid var(--border);
        flex-wrap: wrap;
    }

    .filter-label {
        font-weight: 700;
        color: var(--secondary);
        font-size: 0.86rem;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 6px;
        flex: 1;
        min-width: 120px;
    }

        .filter-group label {
            font-size: 0.8rem;
            font-weight: 600;
            white-space: nowrap;
            color: #475569;
            margin: 0;
        }

        .filter-group input.form-control,
        .filter-group select.form-select {
            width: 100%;
            padding: 5px 9px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 0.82rem;
            outline: none;
            background-color: #ffffff;
            color: var(--text-main);
            height: 33px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        /* Ensure custom-dd-wrapper fits the one-line design */
        .filter-group .custom-dd-wrapper {
            width: 100% !important;
        }

        .filter-group .custom-dd-input {
            min-height: 33px !important;
            height: 33px !important;
            padding: 3px 8px !important;
            font-size: 0.82rem !important;
            /* border: 1px solid var(--border) !important; */
            border-radius: 6px !important;
        }

    .filter-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-search {
        background: var(--primary);
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 33px;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .btn-search:hover {
            background: #004494;
            box-shadow: 0 4px 10px rgba(0, 86, 179, 0.3);
        }

    .btn-export-rep {
        background: var(--delivered);
        color: white;
        border: none;
        padding: 6px 15px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 33px;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .btn-export-rep:hover {
            background: #3d8b40;
            box-shadow: 0 4px 10px rgba(76, 175, 80, 0.3);
        }

    /* Card Wrapper for Tabs and DataTables */
    .job-tables-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid var(--border);
        overflow: hidden;
    }

    .tabs-header {
        background: #f8fafc;
        border-bottom: 1px solid var(--border);
        padding: 10px 16px 0 16px;
    }

    .job-mode-tabs .nav-link {
        font-size: 0.88rem;
        font-weight: 600;
        color: #475569;
        border-radius: 8px 8px 0 0;
        padding: 8px 18px;
        margin-right: 6px;
        background: transparent;
        border: 1px solid transparent;
        border-bottom: none;
        transition: all 0.2s;
    }

        .job-mode-tabs .nav-link:hover {
            color: var(--primary);
            background: rgba(0, 86, 179, 0.05);
        }

        .job-mode-tabs .nav-link.active {
            color: var(--primary) !important;
            background: white !important;
            border-color: var(--border) var(--border) white !important;
            box-shadow: 0 -2px 5px rgba(0,0,0,0.03);
        }

    /* Badges in tables */
    .status-badge {
        padding: 3px 9px;
        border-radius: 20px;
        font-size: 0.73rem;
        font-weight: 600;
        display: inline-block;
        white-space: nowrap;
    }

        .status-badge.pending {
            background: #fff7ed;
            color: #c2410c;
            border: 1px solid #fed7aa;
        }

        .status-badge.delivered {
            background: #f0fdf4;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .status-badge.transit {
            background: #faf5ff;
            color: #7e22ce;
            border: 1px solid #e9d5ff;
        }

    .job-no-cell {
        color: var(--primary);
        font-weight: 600;
    }

    @@media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .filter-section {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-group {
            width: 100%;
        }
    }

    /* Hide native <select> once custom dropdown widget has initialized it */
    select.custom-select-multi,
    select.custom-select-single {
        display: none !important;
    }

</style>

<div class="customer-report-dashboard">
    <div class="dashboard-container">

        <!-- Stats Grid (4 Cards) -->
        <div class="stats-grid">
            <div class="stat-card active-card" data-status-filter="" title="Click to view all customer">
                <div class="stat-icon" style="background: var(--primary);">
                    <i class="fa fa-user-edit"></i>
                </div>
                <div class="stat-info">
                    <h3>Total Customer</h3>
                    <p id="statTotalcustomer">0</p>
                </div>
            </div>
            <div class="stat-card" style="border-color: var(--pending);" data-status-filter="In House" title="Click to filter In House">
                <div class="stat-icon" style="background: var(--pending);">
                    <i class="fa fa-home"></i>
                </div>
                <div class="stat-info">
                    <h3>In House</h3>
                    <p id="statinHouse">0</p>
                </div>
            </div>
            <div class="stat-card" style="border-color: var(--transit);" data-status-filter="General" title="Click to filter In General">
                <div class="stat-icon" style="background: var(--transit);">
                    <i class="fa fa-cogs"></i>
                </div>
                <div class="stat-info">
                    <h3>General</h3>
                    <p id="statgeneral">0</p>
                </div>
            </div>
            <div class="stat-card" style="border-color: var(--delivered);" data-status-filter="Customer Type" title="Click to filter Customer Type">
                <div class="stat-icon" style="background: var(--delivered);">
                    <i class="fa fa-users"></i>
                </div>
                <div class="stat-info">
                    <h3>Customer Type</h3>
                    <p id="statCustomerType">0</p>
                </div>
            </div>
        </div>

        <!-- Filter Bar (One Line Design) -->
        <div class="filter-section">
            <span class="filter-label"><i class="fas fa-filter"></i> Filter By:</span>

           
             <!-- Customer (Multi-Select with checkboxes) -->
            <div class="filter-group  filter-group-compact">
                <select id="filterCustomer" class="form-select form-select-sm custom-select-multi" multiple="multiple" data-placeholder="-- Select Customer --">
                    @if (ViewBag.Customers != null)
                    {
                        foreach (SelectListItem item in (SelectList)ViewBag.Customers)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-group  filter-group-compact">
                <select id="filterCustomerType"
                        class="form-select form-select-sm custom-select-multi"
                        multiple="multiple"
                        data-placeholder="-- Select Customer Type --">
                    <option value="0">General</option>
                    <option value="1">In House</option>
                </select>
            </div>

            <!-- Export Format (Single Select) -->
            <div class="filter-group filter-right" style="max-width: 140px;">
                <select id="filterExportFormat" class="form-select form-select-sm custom-select-single">
                    <option value="PDF">PDF Format</option>
                    <option value="Excel">Excel Format</option>
                </select>
            </div>

            <!-- Actions (Export button only, search is automatic) -->
            <div class="filter-actions">
                <button type="button" class="btn-export-rep" id="btnExport" title="Export grouped report by customer">
                    <i class="fas fa-file-export"></i> EXPORT
                </button>
            </div>

        </div>

        <div class="job-tables-card">
            
            <div class="tab-content p-3" id="jobModeTabsContent">
                <!-- Sea Freight Tab Pane -->
                <div class="tab-pane fade show active" id="sea-tab-pane" role="tabpanel" aria-labelledby="sea-tab">
                    <div class="table-responsive">
                        <table id="seacustomerTable"
                               class="table table-bordered table-striped table-hover custom-grid-table w-100 text-center align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 3%;">SN</th>
                                    <th style="width: 7%;">Customer ID</th>
                                    <th style="width: 15%;">Name</th>
                                    <th style="width: 17%;">Address</th>
                                    <th style="width: 8%;">Phone</th>
                                    <th style="width: 8%;">Fax</th>
                                    <th style="width: 9%">Email</th>
                                    <th style="width: 8%">Photo</th>
                                    <th style="width: 25%;">Contact Person</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/pages/customerReport.js" asp-append-version="true"></script>
}
