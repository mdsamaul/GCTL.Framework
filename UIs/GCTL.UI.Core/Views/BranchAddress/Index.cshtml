@model GCTL.UI.Core.ViewModels.BranchAddress.BranchAddressPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Branch Address";
    Model.Breadcrumb = "Branch Address";
}

<style>
    #BranchAddressDeleteModalBodyHeightFeixd {
        height: 50px !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }

    .bg-light {
        background-color: #fff !important;
        color: #000 !important;
    }

    .form-control:disabled, .form-control[readonly] {
        background-color: #fff !important;
    }

    /* Plus Button Style */
    .btn-plus {
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        padding: 0 10px;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd; /* Bootstrap blue */
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

    /* Country wrapper */
    .Ven-input-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .Ven-select-wrap {
        flex: 1;
        min-width: 0; /* flex child shrink fix */
    }

        /* Select2 container full width */
        .Ven-select-wrap .select2-container {
            width: 100% !important;
        }

    /* Plus button */
    .btn-plus {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-6 pr-0">
                <div class="card">
                    <div class="card-header px-2">

                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Branch Address",
                            SaveBtnClass = "js-BranchAddress-save",
                            DeleteBtnClass = "js-BranchAddress-delete-confirm",
                            ClearBtnClass = "js-BranchAddress-clear"
                        })
                    </div>

                    <div class="card-body px-2">

                        <form asp-action="Setup" method="post" id="BranchAddress-form" asp-controller="BranchAddress">

                            <div class="js-BranchAddress-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6" style="height:570px;overflow:auto;">
                <div class="card">
                    <div class="card-body p-2 pt-3">
                        <div class="js-BranchAddress-grid-container">

                            @await Html.PartialAsync("_CustomGrid", new GridModel
                            {
                                GridId = "BranchAddress-grid",
                                AjaxUrl = "/BranchAddress/GetTableData", 
                                ServerSide = false,
                                ShowCheckbox = true,
                                CheckboxClass = "checkBox",
                                CheckColumnData = "vendorBranchId",
                                DefaultSortColumn = "vendorBranchId",
                                Columns = new()
                                {
                                    new() { Data = "vendorBranchId",IsEditLink=true,EditSelectorClass="js-BranchAddress-edit", Header = "ID", Width = "5%" },
                                    new() { Data = "name", Header = "Vendor Name", Width = "25%", Align="left" },
                                    new() { Data = "locationAddress", Header = "Address", Width = "30%",Align="left" },
                                    new() { Data = "contactPersonName", Header = "Contact Person", Width = "25%", Align = "left" },
                                    new() { Data = "phone", Header = "Phone", Width = "12%" }
                                }
                            })
                           
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/branchAddress.js"></script>
    <script type="text/javascript">
        var options = {
        baseUrl: '@Url.Action("", "BranchAddress")'
        };
        options.load = () => {
        };

        $.branchAddress(options);
    </script>
}