<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/companies.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
    if (window.jQuery && typeof $.companies === "function") {
    var options = { baseUrl: '@Url.Action("", "Companies")' };
    options.load = () => { };
    $.companies(options);
    } else {
    setTimeout(waitForJQuery, 30);
    }
    })();
</script>