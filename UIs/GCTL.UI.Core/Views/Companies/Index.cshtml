@model GCTL.UI.Core.ViewModels.Companies.CompanyPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Company Info";
    Model.Breadcrumb = "Company Info";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>


<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Company Information",
                            SaveBtnClass = "js-company-save",
                            DeleteBtnClass = "js-company-delete-confirm",
                            ClearBtnClass = "js-company-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-1">
                        <form asp-action="Setup" method="post" id="company-form" asp-controller="Companies">
                            <div class="js-company-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "companyTable",
                    AjaxUrl = "/Companies/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "companyCode",
                    CheckAllId = "company-check-all",
                    DefaultSortColumn = "companyCode",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "companyCode", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-company-edit" },
                        new() { Data = "companyName", Header = "Company Name", Width = "30%", Align = "left" },
                        new() { Data = "address1", Header = "Address", Width = "25%", Align = "left" },
                        new() { Data = "phone1", Header = "Phone", Width = "15%", Align = "center" },
                        new() { Data = "email", Header = "Email", Width = "20%", Align = "left" }
                    }
                })
            </div>

        </div>
        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/companies.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "Companies")'
        };

        $.companies(options);
    </script>
}