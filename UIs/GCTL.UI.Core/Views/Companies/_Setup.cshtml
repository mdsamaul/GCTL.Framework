@model GCTL.Core.ViewModels.Companies.CompanySetupViewModel
@using GCTL.UI.Core.ViewModels

<div id="loadingIndicator" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-80%, -80%); z-index: 9999;">
    <img src="/images/Spinner.gif" alt="Loading..." style="width: 80px; height: 80px;" />
</div>

<div style="padding-top: 10px;">

    <div class="row">
        <div class="col-12">
            <span id="message"></span>
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Company Code (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyCode",
            LabelText = "Company Code",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-md-6",
            CustomCssClass = "js-company-code js-code",
            DefaultValue = Model?.CompanyCode
        })
    </div>

    <div class="form-group row">

        @* ---------- Company Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyName",
            LabelText = "Company Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Company Name",
            IsRequired = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-md-6",
            CustomCssClass = "js-company-check-availability",
            DefaultValue = Model?.CompanyName,
            AutoFocus = true
        })

        @* ---------- Short Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyShortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.CompanyShortName
        })
    </div>

    <div class="form-group row">

        @* ---------- Address ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Address1",
            LabelText = "Address",
            FieldType = FieldType.Textarea,
            Placeholder = "Enter Address",
            ReserveActionSlot = false,
            IsRequired = true,
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.Address1
        })
    </div>

    <div class="form-group row">

        @* ---------- Company Name (বাংলা) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CompanyBanglaName",
            LabelText = "Company Name (বাংলা)",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Company Name (বাংলা)",
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.CompanyBanglaName
        })

        @* ---------- Address (বাংলা) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "AddressBangla",
            LabelText = "Address (বাংলা)",
            ReserveActionSlot = false,
            FieldType = FieldType.Textarea,
            Placeholder = "Enter Address (বাংলা)",
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.AddressBangla
        })
    </div>

    <div class="form-group row">

        @* ---------- Zip/Postal Code ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ZipCode",
            LabelText = "Zip/Postal Code",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Zip/Postal Code",
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.ZipCode
        })

        @* ---------- City ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "City",
            LabelText = "City",
            FieldType = FieldType.Text,
            Placeholder = "Enter City",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.City
        })
    </div>

    <div class="form-group row">

        @* ---------- State ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "State",
            LabelText = "State",
            FieldType = FieldType.Text,
            Placeholder = "Enter State",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.State
        })

        @* ---------- Country (Select) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Country",
            LabelText = "Country",
            FieldType = FieldType.Select,
            Placeholder = "Select Country",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-md-6",
            CustomCssClass = "gc-select2"
        })
    </div>

    <div class="form-group row">

        @* ---------- Phone 1 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone1",
            LabelText = "Phone 1",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Phone 1",
            ColumnClass = "col-12 col-md-6",
            CustomCssClass = "phone-validationx",
            DefaultValue = Model?.Phone1
        })

        @* ---------- Phone 2 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone2",
            LabelText = "Phone 2",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Phone 2",
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.Phone2
        })
    </div>

    <div class="form-group row">

        @* ---------- Hotline/Customer Care No ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "HotLine",
            LabelText = "Hotline/Customer Care No",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Hotline/Customer Care No",
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.HotLine
        })

        @* ---------- Email ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.Email
        })
    </div>

    <div class="form-group row">

        @* ---------- Website ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Url",
            LabelText = "Website",
            FieldType = FieldType.Text,
            Placeholder = "Enter Website",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.Url
        })

        @* ---------- Bin ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Fax",
            LabelText = "Bin",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Bin",
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.Fax
        })
    </div>

    <div class="form-group row">

        @* ---------- Business Reg. No ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "RegNo",
            LabelText = "Business Reg. No",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Business Reg. No",
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.RegNo
        })

        @* ---------- Tax Identification No ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Tin",
            LabelText = "Tax Identification No",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Tax Identification No",
            ColumnClass = "col-12 col-md-6",
            DefaultValue = Model?.Tin
        })
    </div>

    <div class="form-group row">

        @* ---------- Base Currency (Select) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BaseCurrency",
            LabelText = "Base Currency",
            FieldType = FieldType.Select,
            Placeholder = "Select Base Currency",
            ColumnClass = "col-12 col-md-6",
            ReserveActionSlot = false,
            CustomCssClass = "gc-select2"
        })
    </div>

    @if (Model != null && (Model.Ldate.HasValue || Model.ModifyDate.HasValue))
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-12 col-md-6",
            ReserveActionSlot = false,
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-12 col-md-6",
                ShowOnInit = Model.ModifyDate.HasValue,
            ReserveActionSlot = false,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }
</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-company-save",
            ReserveActionSlot = true,   
        })
    </div>
</div>
