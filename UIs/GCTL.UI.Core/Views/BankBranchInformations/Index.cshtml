@model GCTL.UI.Core.ViewModels.SalesDefBankBranchInfos.SalesDefBankBranchInfoPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Bank Branch Information";
    Model.Breadcrumb = "Bank Branch Information";
}

<style>
    /* Wrapper for tabs */
    .tabwrap {
        margin-bottom: 10px;
    }

    /* Basic styling for the tab container */
    .MenuTab {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        border-bottom: 2px solid #ddd;
        flex-wrap: wrap;
    }

    .MenuTab li {
        margin: 0 1px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.1rem;
        text-decoration: none;
        color: #4a4a4a;
        font-weight: bold;
        white-space: nowrap;
        border: 1px solid lightgray;
        border-bottom: none;
        background: linear-gradient(to right, #f7fcff, #ffffff) !important;
        border-radius: 10px 10px 0 0;
        font-size: 14px;
        text-align: center;
        transition: background 0.3s, color 0.3s;
    }

    .MenuTab li a {
        display: flex;
        text-decoration: none;
        color: #4a4a4a;
        font-weight: bold;
        white-space: nowrap;
        border: none;
        font-size: 14px;
        text-align: center;
        padding: 6px 16px;
    }

    .MenuTab li.selected {
        background: linear-gradient(to right, #ffffff, #ffffff);
        color: #4a4a4a;
        font-weight: bold;
        border: 1px solid lightgray;
        border-radius: 10px 10px 0 0;
        background-color: white;
        border-bottom: none;
    }

    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header dynamic-grid-header">
                        <!-- Navigation tabs -->
                        <div class="tabwrap" style="z-index: 100; width: 100%;">
                            <ul class="MenuTab">
                                <li>
                                    <a href="/BankInformations/Index?PageID=41">Bank</a>
                                </li>
                                <li class="selected">
                                    <a href="/BankBranchInformations/Index?PageID=41">Branch</a>
                                </li>
                                <li>
                                    <a href="/BankAccountInfo/Index?PageID=41">A/C Info</a>
                                </li>
                            </ul>
                        </div>
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Bank Branch Information",
                            SaveBtnClass = "js-bankbranchinformation-save",
                            DeleteBtnClass = "js-bankbranchinformation-delete-confirm",
                            ClearBtnClass = "js-bankbranchinformation-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="bankbranchinformation-form" asp-controller="BankBranchInformations">
                            <div class="js-bankbranchinformation-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Dynamic Grid Column -->
            <div class="col-md-6">
                <div class="js-bankbranchinformation-grid-container" id="bankBranchInformationGridContainer">
                    @if (Model.DynamicGrid != null)
                    {
                        @await Html.PartialAsync("_DynamicGrid", Model.DynamicGrid)
                    }
                </div>
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/grid-manager.js" asp-append-version="true"></script>
    <script src="~/js/pages/bankBranchInformations.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "BankBranchInformations")'
        };
        options.load = () => {
            loadGridPage('bankBranchInformationGridContainer', '/BankBranchInformations/GetTableData', 1, 10);
        };

        $.bankBranchInformations(options);
    </script>
}