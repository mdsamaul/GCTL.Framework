@* ============================================================
   GP Analysis Tab Partial
   ============================================================ *@
<section class="panel" id="p-gp">
    <div class="ptitle">
        <h2>Gross Profit (GP) Analysis</h2>
        <span data-period></span>
    </div>

    <!-- KPIs -->
    <div class="kpis">
        <div class="kpi blue" id="g_n">
            <div class="kico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></svg></div>
            <div class="kbody"><div class="klabel">Total Bills</div><div class="kval">0</div><div class="ksub">bills in period</div></div>
        </div>
        <div class="kpi green" id="g_nbv">
            <div class="kico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
            <div class="kbody"><div class="klabel">Net Bill Value</div><div class="kval">0</div><div class="ksub">total revenue</div></div>
        </div>
        <div class="kpi orange" id="g_cost">
            <div class="kico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 22h14M5 2h14M17 22v-4.2a2 2 0 0 0-.6-1.4L12 12l-4.4 4.4A2 2 0 0 0 7 17.8V22M7 2v4.2a2 2 0 0 0 .6 1.4L12 12l4.4-4.4A2 2 0 0 0 17 6.2V2"/></svg></div>
            <div class="kbody"><div class="klabel">Total Costing (Direct Expense)</div><div class="kval">0</div><div class="ksub">operational expenses</div></div>
        </div>
        <div class="kpi purple" id="g_gp">
            <div class="kico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3.3 7L12 12l8.7-5M12 22V12"/></svg></div>
            <div class="kbody"><div class="klabel">Gross Profit</div><div class="kval">0</div><div class="ksub">net earnings</div></div>
        </div>
        <div class="kpi sky" id="g_pct">
            <div class="kico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M19 5L5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></div>
            <div class="kbody"><div class="klabel">GP Margin</div><div class="kval">0.00%</div><div class="ksub">gross margin</div></div>
        </div>
    </div>

    <!-- Minis -->
    <div class="minis" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
        <div class="mini blue" id="gm_cnf"><div class="klabel">C&amp;F Profit</div><div class="kval">0</div><div class="ksub">commission + rec/non-rec</div></div>
        <div class="mini purple" id="gm_tr"><div class="klabel">Transport Profit</div><div class="kval">0</div><div class="ksub">transport margin</div></div>
        <div class="mini green" id="gm_best"><div class="klabel">Best Mode (GP%)</div><div class="kval">-</div><div class="ksub">highest margin</div></div>
        <div class="mini red" id="gm_low"><div class="klabel">Lowest Mode (GP%)</div><div class="kval">-</div><div class="ksub">lowest margin</div></div>
        <div class="mini sky" id="gm_avg"><div class="klabel">Avg Profit / Bill</div><div class="kval">0</div><div class="ksub">mean profit</div></div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row c3">
        <section class="card">
            <header><h3>Costing Composition</h3><span class="hint">direct expense</span></header>
            <div class="cwrap"><canvas id="g_ch1"></canvas></div>
        </section>
        <section class="card">
            <header><h3>GP Margin by Shipment Mode</h3><span class="hint">%</span></header>
            <div class="cwrap"><canvas id="g_ch2"></canvas></div>
        </section>
        <section class="card">
            <header><h3>Billing vs Costing</h3><span class="hint">C&amp;F vs Transport</span></header>
            <div class="cwrap"><canvas id="g_ch3"></canvas></div>
        </section>
    </div>

    <!-- Charts Row 2 -->
    <div class="row c21">
        <section class="card">
            <header><h3>Monthly Revenue, Cost &amp; GP%</h3><span class="hint">trend over period</span></header>
            <div class="cwrap"><canvas id="g_ch4"></canvas></div>
        </section>
        <section class="card">
            <header><h3>Top Customers by Gross Profit</h3><span class="hint">BDT</span></header>
            <div class="cwrap"><canvas id="g_ch5"></canvas></div>
        </section>
    </div>

    <!-- Grid -->
    <section class="card gridcard">
        <div class="gh">
            <h3>GP Analysis Detail</h3>
            <div class="gtools">
                <label>Show <select id="g_g_sz"></select> entries</label>
                <input id="g_g_q" type="search" placeholder="Search records...">
            </div>
        </div>
        <div class="gbody"><div id="g_g"></div><div class="gfoot" id="g_g_f"></div></div>
    </section>
</section>

