@model GCTL.Core.ViewModels.Dashboard.DashboardInitialDataVM
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "C&F Management Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/custom/custom-datatable.css" asp-append-version="true" />
}

<div class="dashboard-root">
    <!-- Filter Bar (Sticky) -->
    <header class="filterbar">
        <div class="wrap">
            <div class="fcard" id="filters">
                <div class="ftitle" id="ftitle">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M22 3H2l8 9.5V19l4 2v-8.5z"/></svg> Filter By
                </div>
                <div class="f date">
                    <label for="fFrom">From</label>
                    <input type="text" id="fFrom" class="form-control form-control-sm custom-datepicker caiCon auto-filter" value="@Model.DefaultFromDate" placeholder="DD/MM/YYYY" autocomplete="off" />
                </div>
                <div class="f date">
                    <label for="fTo">To</label>
                    <input type="text" id="fTo" class="form-control form-control-sm custom-datepicker caiCon auto-filter" value="@Model.DefaultToDate" placeholder="DD/MM/YYYY" autocomplete="off" />
                </div>
                <div class="f">
                    <label for="fRange">Quick range</label>
                    <select id="fRange" class="form-select form-select-sm custom-select-single">
                        <option value="3m" selected>Last 3 Months</option>
                        <option value="today">Today</option>
                        <option value="7d">Last 7 Days</option>
                        <option value="30d">Last 30 Days</option>
                        <option value="this_month">This Month</option>
                        <option value="last_month">Last Month</option>
                        <option value="6m">Last 6 Months</option>
                        <option value="1y">Last 1 Year</option>
                        <option value="custom">Custom</option>
                    </select>
                </div>
                <div class="f" data-scope="all">
                    <label for="fBranch">Branch</label>
                    <select id="fBranch" class="form-select form-select-sm custom-select-single" data-placeholder="All Branches">
                        <option value="">All Branches</option>
                        @foreach (var item in Model.Branches)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="f" data-scope="cnf">
                    <label for="fMode">Shipment Mode</label>
                    <select id="fMode" class="form-select form-select-sm custom-select-single" data-placeholder="All Modes">
                        <option value="">All Modes</option>
                        @foreach (var item in Model.ShipmentModes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="f" data-scope="cnf">
                    <label for="fPort">Port</label>
                    <select id="fPort" class="form-select form-select-sm custom-select-single" data-placeholder="All Ports">
                        <option value="">All Ports</option>
                        @foreach (var item in Model.Ports)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="f" data-scope="cnf">
                    <label for="fCust">Customer</label>
                    <select id="fCust" class="form-select form-select-sm custom-select-single" data-placeholder="All Customers">
                        <option value="">All Customers</option>
                        @foreach (var item in Model.Customers)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="f" data-scope="cnf">
                    <label for="fStatus">Job Status</label>
                    <select id="fStatus" class="form-select form-select-sm custom-select-single" data-placeholder="All Status">
                        <option value="">All Status</option>
                        @foreach (var item in Model.Statuses)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="fbtns">
                    <button class="btn ghost" id="btnReset" title="Reset all filters">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg> Reset
                    </button>
                    <div class="menu" id="expMenu">
                        <button class="btn green" id="btnExport">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg> Export
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <div class="pop">
                            <button data-x="preview" id="xPreview">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg> Print / Preview
                            </button>
                            <button data-x="pdf" id="xPdf">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h1.5a1.5 1.5 0 0 0 0-3H9v6M15 12h-2v6M13 15h1.5"/></svg> PDF
                            </button>
                            <button data-x="excel" id="xExcel">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><polygon points="8 12 16 18 8 18 16 12"/></svg> Excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Tabs Content -->
    <main class="wrap">
        <nav class="tabs" id="tabs" data-initial-tab="@(ViewBag.ActiveTab ?? "overview")">
            <button class="tab @(ViewBag.ActiveTab == null || ViewBag.ActiveTab == "overview" ? "on" : "")" data-t="overview">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg> Overview
            </button>
            <button class="tab @(ViewBag.ActiveTab == "jobs" ? "on" : "")" data-t="jobs">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg> Job Status
            </button>
            <button class="tab @(ViewBag.ActiveTab == "bills" ? "on" : "")" data-t="bills">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></svg> Bill Entry
            </button>
            <button class="tab @(ViewBag.ActiveTab == "gp" ? "on" : "")" data-t="gp">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg> GP Analysis
            </button>
            <button class="tab @(ViewBag.ActiveTab == "recon" ? "on" : "")" data-t="recon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 3v18M5 21h14M5 7l-3 7a4 4 0 0 0 6 0zM19 7l-3 7a4 4 0 0 0 6 0zM5 7h14"/></svg> Job Reconcile (Actual)
            </button>
            <button class="tab @(ViewBag.ActiveTab == "accounts" ? "on" : "")" data-t="accounts">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 21h18M5 21V10M9 21V10M15 21V10M19 21V10M12 3L3 9h18z"/></svg> Accounts
            </button>
        </nav>

        <!-- 6 Tabs Partial Views -->
        <partial name="_OverviewTab" />
        <partial name="_JobStatusTab" />
        <partial name="_BillEntryTab" />
        <partial name="_GPAnalysisTab" />
        <partial name="_JobReconcileTab" />
        <partial name="_AccountsTab" />

        @* <div class="foot-note" id="footNote">All metrics, charts and registers are computed live from the SQL Server database. Amounts in BDT.</div> *@
    </main>

    <!-- Global Report Preview Modal for Dashboard -->
    <div class="modal fade" id="reportPreviewModal" tabindex="-1" aria-labelledby="reportPreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 90vw; height: 90vh;">
            <div class="modal-content" style="height: 100%;">
                <div class="modal-header py-2 px-3 bg-light border-bottom">
                    <div class="d-flex align-items-center">
                        <span id="modalHeaderSpinner" class="spinner-border spinner-border-sm text-primary me-2" role="status" style="display: none;"></span>
                        <h6 class="modal-title fw-bold text-primary mb-0" id="reportPreviewModalLabel">
                            <i class="fas fa-file-pdf text-danger me-2"></i>Report Preview
                        </h6>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a id="btnModalOpenNewTab" href="#" target="_blank" class="btn btn-sm btn-outline-primary py-1 px-2" title="Open in new tab">
                            <i class="fas fa-external-link-alt me-1"></i>New Tab
                        </a>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body p-0 position-relative" style="height: calc(100% - 50px); overflow: hidden;">
                    <iframe id="reportPreviewIframe" src="" style="width: 100%; height: 100%; border: none;"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- External CDN Scripts for Charting and Exports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

    <!-- DataTables & CustomGrid Scripts -->
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>

    <!-- Dashboard Modular JavaScript Files -->
    <script src="~/js/pages/dashboard/dashboardCommon.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/dashboardOverview.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/dashboardJobStatus.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/dashboardBillEntry.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/dashboardGPAnalysis.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/dashboardJobReconcile.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/dashboardAccounts.js" asp-append-version="true"></script>
}
