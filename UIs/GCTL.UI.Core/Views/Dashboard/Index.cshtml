@model DashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard Overview";
}

<!-- Welcome Banner -->
<div class="welcome-banner fade-in-up-stagger-1">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold mb-2">@Model.GreetingMessage</h1>
            <p class="mb-0 opacity-80">Welcome to your enterprise HR portal dashboard. Monitor employee metrics, log activity, and manage work cycles in real time.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0 d-none d-md-block">
            <div class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-shield-check me-1"></i> System Online
            </div>
        </div>
    </div>
</div>

<!-- Stats Metric Row -->
<div class="row g-4 mb-4 fade-in-up-stagger-2">
    <!-- Stat 1: Total Employees -->
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card border-0 h-100 p-4" style="--accent-color: #3b82f6;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="metric-icon-box" style="--accent-color: #3b82f6;">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="metric-value text-body">@Model.Stats.TotalEmployees</div>
                    <div class="metric-label">Total Employees</div>
                </div>
                <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">
                    <i class="bi bi-arrow-up-right me-1"></i>4.2%
                </span>
            </div>
        </div>
    </div>
    
    <!-- Stat 2: Active Today -->
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card border-0 h-100 p-4" style="--accent-color: #10b981;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="metric-icon-box" style="--accent-color: #10b981;">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div class="metric-value text-body">@Model.Stats.ActiveEmployeesToday</div>
                    <div class="metric-label">Active Today</div>
                </div>
                <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">
                    <i class="bi bi-arrow-up-right me-1"></i>1.8%
                </span>
            </div>
        </div>
    </div>

    <!-- Stat 3: Attendance Rate -->
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card border-0 h-100 p-4" style="--accent-color: #f59e0b;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="metric-icon-box" style="--accent-color: #f59e0b;">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="metric-value text-body">@Model.Stats.AttendanceRateToday%</div>
                    <div class="metric-label">Attendance Rate</div>
                </div>
                <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1 small">
                    <i class="bi bi-arrow-down-right me-1"></i>0.5%
                </span>
            </div>
        </div>
    </div>

    <!-- Stat 4: Pending Leaves -->
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card border-0 h-100 p-4" style="--accent-color: #ec4899;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="metric-icon-box" style="--accent-color: #ec4899;">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                    <div class="metric-value text-body">@Model.Stats.PendingLeaveRequests</div>
                    <div class="metric-label">Pending Leaves</div>
                </div>
                <span class="badge bg-warning-subtle text-warning rounded-pill px-2 py-1 small">
                    Action Required
                </span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 fade-in-up-stagger-3">
    <!-- Attendance Trend Chart -->
    <div class="col-lg-7">
        <div class="card border-0 h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="card-title mb-0">Attendance Trend (Weekly)</h5>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        This Week
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Last Week</a></li>
                        <li><a class="dropdown-item" href="#">This Month</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="dummy-chart-container">
                @foreach (var metric in Model.PerformanceMetrics)
                {
                    <div class="dummy-chart-bar-wrapper">
                        <div class="dummy-chart-bar" style="--bar-height: @(metric.Value)%; height: 0%;" title="@metric.Label: @metric.Value%"></div>
                        <span class="dummy-chart-label">@metric.Label</span>
                    </div>
                }
            </div>
            <div class="mt-3 text-center text-muted small">
                <i class="bi bi-info-circle me-1"></i> Bars represent daily overall office attendance percentage.
            </div>
        </div>
    </div>

    <!-- Recent Activities Timeline -->
    <div class="col-lg-5">
        <div class="card border-0 h-100 p-4">
            <h5 class="card-title mb-4">Recent Activities</h5>
            <div class="timeline">
                @foreach (var activity in Model.RecentActivities)
                {
                    var colorMap = activity.BadgeColor == "success" ? "#10b981" : 
                                   activity.BadgeColor == "warning" ? "#f59e0b" : 
                                   activity.BadgeColor == "danger" ? "#ef4444" : 
                                   activity.BadgeColor == "info" ? "#3b82f6" : "#6b7280";

                    <div class="timeline-item">
                        <span class="timeline-icon" style="--accent-color: @colorMap">
                            <i class="bi bi-dot" style="color: @colorMap"></i>
                        </span>
                        <div class="timeline-item-content">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="small text-body">@activity.Title</strong>
                                <span class="timeline-time">@activity.Timestamp.ToString("hh:mm tt")</span>
                            </div>
                            <p class="mb-0 text-muted small">@activity.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
