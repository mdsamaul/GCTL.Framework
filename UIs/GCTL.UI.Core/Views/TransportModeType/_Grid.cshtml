@model List<GCTL.Core.ViewModels.TransportModeType.TransportModeTypeSetupViewModel>

<table id="TransportModeType-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="TransportModeType-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">ID</th>
            <th class="text-center text-middle" style="width: 52%;">Transport Mode</th>
            <th class="text-center text-middle" style="width: 28%;">Short Name</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.TransportModeId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" id="js-TransportModeType-checkbox" class="text-center text-middle checkBox" data-id="@item.TransportModeId" value="@item.TransportModeId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-TransportModeType-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.TransportModeId" title="Edit">
                            @item.TransportModeId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.TransportMode</td>
                    <td class="text-center text-middle">@item.ShortName</td>

                </tr>
            }
        }

    </tbody>
</table>
