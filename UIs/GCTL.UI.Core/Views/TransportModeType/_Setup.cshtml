@model GCTL.Core.ViewModels.TransportModeType.TransportModeTypeSetupViewModel

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>
    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <div class="col-lg-6">
            <label asp-for="TransportModeId">ID </label>
            <div class="input-group input-group-sm">
                <input asp-for="TransportModeId" type="text" class="form-control form-control-sm js-TransportModeId-code" readonly="readonly" />
            </div>
        </div>
        <div class="col-lg-6">
            <label asp-for="TransportMode">Transport Mode<span style="color:red">*</span> </label>
            <input type="text" asp-for="TransportMode" class="form-control form-control-sm js-TransportMode-check-duplicateName" autofocus required placeholder="Enter Transport Mode" tabindex="1" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="ShortName">Short Name</label>
            <input asp-for="ShortName" type="text" class="form-control form-control-sm" placeholder="Enter Short Name" abindex="2" />
        </div>

    </div>

    @if (Model.Tc > 0)
    {

        <hr />
        <div class="form-group row" id="LdateModifyHide">
            <div class="col-lg-6">
                @if (Model.Ldate.HasValue)
                {
                    <label>Creation Date: </label>

                    <label>@Model.Ldate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
            <div class="col-lg-6">
                @if (Model.ModifyDate.HasValue)
                {
                    <label>Last Update Date: </label>

                    <label>@Model.ModifyDate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
        </div>

    }

</div>
<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "TransportModeType"
        })
    </div>
</div>
