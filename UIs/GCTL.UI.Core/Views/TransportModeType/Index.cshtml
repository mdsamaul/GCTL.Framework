@model GCTL.UI.Core.ViewModels.TransportModeType.TransportModeTypePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Transport Mode Type";
    Model.Breadcrumb = "Transport Mode Type";
}

<style>
    /* Side-by-side flex layout for all screens:
       - Left: Setup Form (50% width)
       - Right: Table Grid (50% width)
       - Form Inputs: 2 per row (50% each inside form card)
    */
    .tmt-layout-form-col {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }

    .tmt-layout-grid-col {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }

    .tmt-field-col {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }

    .tmt-toolbar-col {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column (50% side-by-side) -->
            <div class="col-12 col-md-6 tmt-layout-form-col">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Transport Mode Type",
                            SaveBtnClass = "js-TransportModeType-save",
                            DeleteBtnClass = "js-TransportModeType-delete-confirm",
                            ClearBtnClass = "js-TransportModeType-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="TransportModeType-form" asp-controller="TransportModeType">
                            <div class="js-TransportModeType-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column (50% side-by-side) -->
            <div class="col-12 col-md-6 tmt-layout-grid-col">
                <div class="js-TransportModeType-grid-container">
                    @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                    {
                        GridId = "TransportModeType-grid",
                        AjaxUrl = "/TransportModeType/GetTableData",
                        AjaxMethod = "GET",
                        ServerSide = false,
                        ShowCheckbox = true,
                        CheckColumnData = "transportModeId",
                        CheckAllId = "TransportModeType-check-all",
                        DefaultSortColumn = "transportModeId",
                        DefaultSortDirection = "desc",
                        Columns = new()
                        {
                            new() { Data = "transportModeId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-TransportModeType-edit", IdField = "transportModeId" },
                            new() { Data = "transportMode", Header = "Transport Mode Type", Width = "55%", Align = "left"},
                            new() { Data = "shortName", Header = "Short Name", Width = "25%", Align = "left"}
                        }
                    })
                </div>
            </div>

        </div>
        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

@section Scripts {
    <script src="~/js/app.input.validation.js" defer></script>
    <script src="~/js/pages/transportModeType.js" defer></script>
    <script type="text/javascript">
        (function waitForJQuery() {
            if (window.jQuery && typeof $.transportModeType === "function") {
                var options = { baseUrl: '@Url.Action("", "TransportModeType")' };
                options.load = () => { };
                $.transportModeType(options);
            } else {
                setTimeout(waitForJQuery, 30);
            }
        })();
    </script>
}