@model GCTL.Core.ViewModels.ImporterInfo.ImporterInfoSetupViewModel
@using GCTL.UI.Core.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering

<div id="loadingIndicator" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-80%, -80%); z-index: 9999;">
    <img src="/images/Spinner.gif" alt="Loading..." style="width: 80px; height: 80px;" />
</div>

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="row g-2">
        <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        @* <input type="hidden" asp-for="Id" /> *@
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />

        @* ---------- Importer ID (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ImporterId",
            LabelText = "Importer ID",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            CustomCssClass = "js-ImporterId-code",
            DefaultValue = Model?.ImporterId
        })

        @* ---------- Importer Code ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ImporterCode",
            LabelText = "Importer Code",
            FieldType = FieldType.Text,
            Placeholder = "Enter Importer Code",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.ImporterCode
        })

        @* ---------- Importer Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ImporterName",
            LabelText = "Importer Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Importer Name",
            IsRequired = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.ImporterName,
            AutoFocus = true
        })

        @* ---------- Address ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ImporterAddress",
            LabelText = "Address",
            FieldType = FieldType.Text,
            Placeholder = "Enter Importer Address",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.ImporterAddress
        })

        @* ---------- Country ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "CountryId",
            LabelText = "Country",
            FieldType = FieldType.Select,
            Placeholder = "-- Select Country --",
            SelectItems = ViewBag.CountryDD as SelectList,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col"
        })

        @* ---------- City ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "City",
            LabelText = "City",
            FieldType = FieldType.Text,
            Placeholder = "Enter City",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.City
        })

        @* ---------- State/Province ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "StateOrProvince",
            LabelText = "State/Province",
            FieldType = FieldType.Text,
            Placeholder = "Enter State/Province",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.StateOrProvince
        })

        @* ---------- Zip Code ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ZipCode",
            LabelText = "Zip Code",
            FieldType = FieldType.Text,
            Placeholder = "Enter Zip Code",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.ZipCode
        })

        @* ---------- Vat Reg. No. ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "VatRegNo",
            LabelText = "Vat Reg. No.",
            FieldType = FieldType.Text,
            Placeholder = "Enter Vat Reg. No.",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.VatRegNo
        })

        @* ---------- Phone ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone",
            LabelText = "Phone",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Phone
        })

        @* ---------- Fax ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Fax",
            LabelText = "Fax",
            FieldType = FieldType.Text,
            Placeholder = "Enter Fax",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Fax
        })

        @* ---------- Email ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email",
            LabelText = "Email",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Email
        })

        @* ---------- Website ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Website",
            LabelText = "Website",
            FieldType = FieldType.Text,
            Placeholder = "Enter Website",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Website
        })

        @* ---------- Remarks ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Remarks",
            LabelText = "Remarks",
            FieldType = FieldType.Text,
            Placeholder = "Enter Remarks",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Remarks
        })

        @* ---------- Contact Person 1 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ContactPerson1",
            LabelText = "Contact Person 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Contact Person 1",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.ContactPerson1
        })

        @* ---------- Designation 1 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Designation1",
            LabelText = "Designation 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Designation 1",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Designation1
        })

        @* ---------- Phone 1 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone1",
            LabelText = "Phone 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone 1",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Phone1
        })

        @* ---------- Email 1 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email1",
            LabelText = "Email 1",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email 1",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Email1
        })

        @* ---------- Contact Person 2 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "ContactPerson2",
            LabelText = "Contact Person 2",
            FieldType = FieldType.Text,
            Placeholder = "Enter Contact Person 2",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.ContactPerson2
        })

        @* ---------- Designation 2 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Designation2",
            LabelText = "Designation 2",
            FieldType = FieldType.Text,
            Placeholder = "Enter Designation 2",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Designation2
        })

        @* ---------- Phone 2 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Phone2",
            LabelText = "Phone 2",
            FieldType = FieldType.Text,
            Placeholder = "Enter Phone 2",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Phone2
        })

        @* ---------- Email 2 ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "Email2",
            LabelText = "Email 2",
            FieldType = FieldType.Text,
            Placeholder = "Enter Email 2",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
            DefaultValue = Model?.Email2
        })
    </div>

    @if (Model.Tc > 0)
    {
        <hr class="my-2" />
        <div class="row g-2" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ReserveActionSlot = false,
                ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate.HasValue ? Model.Ldate?.ToString("dd/MM/yyyy") : ""
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ReserveActionSlot = false,
                ColumnClass = "col-12 col-sm-6 col-md-3 col-xxl-6 im-field-col",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate.HasValue ? Model.ModifyDate?.ToString("dd/MM/yyyy") : ""
            })

        </div>
    }

</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
           Title = "",
           ShowClear = false,
           ShowDelete = false,
           ShowPrint = false,
           ShowFavorite = false,
           IsPlain = true,
           SaveBtnClass = "js-ImporterInfo-save",
           ReserveActionSlot = true
        })
    </div>
</div>