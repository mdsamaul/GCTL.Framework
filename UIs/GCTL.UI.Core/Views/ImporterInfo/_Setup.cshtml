@model GCTL.Core.ViewModels.ImporterInfo.ImporterInfoSetupViewModel

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>
    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        @* <input type="hidden" asp-for="Id" /> *@
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <div class="col-lg-6">
            <label asp-for="ImporterId">Importer ID</label>
            <div class="input-group input-group-sm">
                <input asp-for="ImporterId" type="text" class="form-control form-control-sm js-ImporterId-code" readonly="readonly" />
            </div>
        </div>
        <div class="col-lg-6">
            <label asp-for="ImporterCode">Importer Code</label>
            <input type="text" asp-for="ImporterCode" class="form-control form-control-sm" placeholder="Enter Importer Code" tabindex="2" />
        </div>
        
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="ImporterName">Importer Name<span style="color:red">*</span></label>
            <input type="text" asp-for="ImporterName" class="form-control form-control-sm" placeholder="Enter Transport No." tabindex="3" />
        </div>

        <div class="col-lg-6">
            <label asp-for="ImporterAddress">Address</label>
            <input type="text" asp-for="ImporterAddress" class="form-control form-control-sm" placeholder="Enter Importer Address" tabindex="4" />
        </div>
    </div>

    <div class="form-group row">       
        <div class="col-lg-6">
            <label asp-for="CountryId">Country</label>
            <div class="con-input-wrapper">
                <div class="con-select-wrap">
                    <select asp-for="CountryId"
                            asp-items="ViewBag.CountryDD"
                            class="form-control form-control-sm custom-select-single"
                            tabindex="5" data-placeholder="Select Country">
                        <option value=""></option>
                    </select>
                </div>
                <button type="button" class="btn btn-plus js-quick-add"
                        data-url="@Url.Action("Index", "Country")"
                        data-target="#CountryId"
                        data-reload-url="@Url.Action("GetCountrys", "Cascading")"
                        data-title="Country">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>

        <div class="col-lg-6">
            <label asp-for="City">City</label>
            <input type="text" asp-for="City" class="form-control form-control-sm" placeholder="Enter City" tabindex="6" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="StateOrProvince">State/Province</label>
            <input type="text" asp-for="StateOrProvince" class="form-control form-control-sm" placeholder="Enter State/Province" tabindex="7" />
        </div>

        <div class="col-lg-6">
            <label asp-for="ZipCode">Zip Code</label>
            <input type="text" asp-for="ZipCode" class="form-control form-control-sm" placeholder="Enter Zip Code" tabindex="8" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="VatRegNo">Vat Reg. No.</label>
            <input type="text" asp-for="VatRegNo" class="form-control form-control-sm" placeholder="Enter Vat Reg. No." tabindex="9" />
        </div>

        <div class="col-lg-6">
            <label asp-for="Phone">Phone</label>
            <input type="text" asp-for="Phone" class="form-control form-control-sm" placeholder="Enter Phone" tabindex="10" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Fax">Fax</label>
            <input type="text" asp-for="Fax" class="form-control form-control-sm" placeholder="Enter Fax" tabindex="11" />
        </div>

        <div class="col-lg-6">
            <label asp-for="Email">Email</label>
            <input type="text" asp-for="Phone" class="form-control form-control-sm" placeholder="Enter Email" tabindex="12" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Website">Website</label>
            <input type="text" asp-for="Website" class="form-control form-control-sm" placeholder="Enter Website" tabindex="13" />
        </div>

        <div class="col-lg-6">
            <label asp-for="Remarks">Remarks</label>
            <input type="text" asp-for="Remarks" class="form-control form-control-sm" placeholder="Enter Remarks" tabindex="14" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="ContactPerson1">Contact Person 1</label>
            <input type="text" asp-for="ContactPerson1" class="form-control form-control-sm" placeholder="Enter Contact Person 1" tabindex="15" />
        </div>

        <div class="col-lg-6">
            <label asp-for="Designation1">Designation 1</label>
            <input type="text" asp-for="Designation1" class="form-control form-control-sm" placeholder="Enter Designation 1" tabindex="16" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Phone1">Phone 1</label>
            <input type="text" asp-for="Phone1" class="form-control form-control-sm" placeholder="Enter Phone 1" tabindex="17" />
        </div>

        <div class="col-lg-6">
            <label asp-for="Email1">Email 1</label>
            <input type="text" asp-for="Email1" class="form-control form-control-sm" placeholder="Enter Email 1" tabindex="18" />
        </div>
    </div>


    @if (Model.Tc > 0)
    {

        <hr />
        <div class="form-group row" id="LdateModifyHide">
            <div class="col-lg-6">
                @if (Model.Ldate.HasValue)
                {
                    <label>Creation Date: </label>

                    <label>@Model.Ldate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
            <div class="col-lg-6">
                @if (Model.ModifyDate.HasValue)
                {
                    <label>Last Update Date: </label>

                    <label>@Model.ModifyDate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
        </div>

    }

</div>
<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "ImporterInfo"
        })
    </div>
</div>
