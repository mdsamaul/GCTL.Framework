@model List<GCTL.Core.ViewModels.ImporterInfo.ImporterInfoSetupViewModel>

<table id="ImporterInfo-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 5%;">
                Select <br /> <input type="checkbox" id="ImporterInfo-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">Importer Id</th>
            <th class="text-center text-middle" style="width: 23%;">Name</th>
            <th class="text-center text-middle" style="width: 17%;">Address</th>
            <th class="text-center text-middle" style="width: 20%;">Phone</th>
            <th class="text-center text-middle" style="width: 10%;">Website</th>
            <th class="text-center text-middle" style="width: 15%;">Email</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                @* <td colspan="8">No Data Available.</td> *@
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.ImporterId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" id="js-ImporterInfo-checkbox" class="text-center text-middle checkBox" data-id="@item.ImporterId" value="@item.ImporterId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-ImporterInfo-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.ImporterId" title="Edit">
                            @item.ImporterId
                        </a>
                    </td>

                    <td class="text-middle">@item.ImporterName</td>
                    <td class="text-middle">@item.ImporterAddress</td>
                    <td class="text-center text-middle">@item.Phone</td>
                    <td class="text-center text-middle">@item.Website</td>
                    <td class="text-center text-middle">@item.Email</td>

                </tr>
            }
        }

    </tbody>
</table>
