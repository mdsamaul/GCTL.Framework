@model GCTL.UI.Core.ViewModels.ImporterInfo.ImporterInfoPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Importer Info";
    Model.Breadcrumb = "Importer Info";
}

<style>
    #ImporterInfoDeleteModalBodyHeightFeixd {
        height: 50px !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }

    .bg-light {
        background-color: #fff !important;
        color: #000 !important;
    }

    .form-control:disabled, .form-control[readonly] {
        background-color: #fff !important;
    }

    /* Plus Button Style */
    .btn-plus {
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        padding: 0 10px;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd; /* Bootstrap blue */
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

    /* Country wrapper */
    .con-input-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .con-select-wrap {
        flex: 1;
        min-width: 0; /* flex child shrink fix */
    }

        /* Select2 container full width */
        .con-select-wrap .select2-container {
            width: 100% !important;
        }

    /* Plus button */
    .btn-plus {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Importer Info",
                            SaveBtnClass = "js-ImporterInfo-save",
                            DeleteBtnClass = "js-ImporterInfo-delete-confirm",
                            ClearBtnClass = "js-ImporterInfo-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="ImporterInfo-form" asp-controller="ImporterInfo">
                            <div class="js-ImporterInfo-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GridModel
                {
                    GridId = "ImporterInfo-grid",
                    AjaxUrl = "/ImporterInfo/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "tc",
                    CheckAllId = "js-ImporterInfo-checkall",
                    DefaultSortColumn = "importerId",
                    DefaultSortDirection = "desc",
                    Columns = new List<GridColumn>
                    {
                        new() { Data = "importerId", Header = "Importer Id", Width = "12%", IsEditLink = true, EditSelectorClass = "js-ImporterInfo-edit", IdField = "tc" },
                        new() { Data = "importerName", Header = "Name", Width = "23%", Align = "left" },
                        new() { Data = "importerAddress", Header = "Address", Width = "17%", Align = "left" },
                        new() { Data = "phone", Header = "Phone", Width = "17%", Align = "left" },
                        new() { Data = "website", Header = "Website", Width = "15%", Align = "left" },
                        new() { Data = "email", Header = "Email", Width = "16%", Align = "left" }
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
    <script src="~/js/pages/importerInfo.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "ImporterInfo")'
        };

        $.importerInfo(options);
    </script>
}