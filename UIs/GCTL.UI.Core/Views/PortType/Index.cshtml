@model GCTL.UI.Core.ViewModels.PortType.PortTypePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Port Type";
    Model.Breadcrumb = "Port Type";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Port Type",
                            SaveBtnClass = "js-PortType-save",
                            DeleteBtnClass = "js-PortType-delete-confirm",
                            ClearBtnClass = "js-PortType-clear"
                        })
                    </div>
                    <div class="card-body px-4 py-3">
                        <form asp-action="Setup" method="post" id="PortType-form" asp-controller="PortType">
                            <div class="js-PortType-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "portTypeTable",
                    AjaxUrl = "/PortType/GetTableData",
                    AjaxMethod = "GET",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "portId",
                    CheckAllId = "PortType-check-all",
                    DefaultSortColumn = "portId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "portId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-PortType-edit" },
                        new() { Data = "portType", Header = "Port Type", Width = "90%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

<script src="~/js/datatable/custom-datatable.js" asp-append-version="true"></script>
<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/portType.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
        if (window.jQuery && typeof $.portType === "function") {
            var options = { baseUrl: '@Url.Action("", "PortType")' };
            options.load = () => { };
            $.portType(options);
        } else {
            setTimeout(waitForJQuery, 30);
        }
    })();
</script>