@model GCTL.UI.Core.ViewModels.PortType.PortTypePageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Port Type";
    Model.Breadcrumb = "Port Type";
}

<style>
    #PortTypeDeleteModalBodyHeightFeixd {
        height: 50px !important;
    }

    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-6 pr-0">
                <div class="card">
                    <div class="card-header px-2">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Port Type",
                            SaveBtnClass = "js-PortType-save",
                            DeleteBtnClass = "js-PortType-delete-confirm",
                            ClearBtnClass = "js-PortType-clear"
                        })
                    </div>
                    <div class="card-body px-2">

                        <form asp-action="Setup" method="post" id="PortType-form" asp-controller="PortType">

                            <div class="js-PortType-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6" style="height:570px;overflow:auto;">
                <div class="card">
                    <div class="card-body p-2 pt-3">
                        <div class="js-PortType-grid-container">
                            @await Html.PartialAsync("_Grid", Model.PortTypeList)
                        </div>
                    </div>
                </div>
            </div>


        </div>


        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/portType.js"></script>
    <script type="text/javascript">
        var options = {
        baseUrl: '@Url.Action("", "PortType")'
        };
        options.load = () => {
        };

        $.portType(options);
    </script>
}

