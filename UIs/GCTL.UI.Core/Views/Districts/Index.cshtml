@model GCTL.UI.Core.ViewModels.Districts.DistrictsPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "District Info";
    Model.Breadcrumb = "District Info";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "District Info",
                            SaveBtnClass = "js-District-save",
                            DeleteBtnClass = "js-District-delete-confirm",
                            ClearBtnClass = "js-District-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="District-form" asp-controller="District">
                            <div class="js-District-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "districtTable",
                    AjaxUrl = "/Districts/GetTableData",
                    AjaxMethod = "GET",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "districtId",
                    CheckAllId = "District-check-all",
                    DefaultSortColumn = "districtId",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "districtId", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-District-edit" },
                        new() { Data = "district", Header = "District", Width = "90%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>

<partial name="DeleteModal" />

<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/districts.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
        if (window.jQuery && typeof $.districts === "function") {
            var options = { baseUrl: '@Url.Action("", "District")' };
            options.load = () => { };
            $.districts(options);
        } else {
            setTimeout(waitForJQuery, 30);
        }
    })();
</script>
