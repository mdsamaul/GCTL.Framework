@model GCTL.Core.ViewModels.Designations.DesignationSetupViewModel
@using GCTL.UI.Core.ViewModels

<div id="loadingIndicator" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-80%, -80%); z-index: 9999;">
    <img src="/images/Spinner.gif" alt="Loading..." style="width: 80px; height: 80px;" />
</div>

<div style="padding-top: 10px;">

    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <input type="hidden" asp-for="AutoId" />

        @* ---------- Designation Id (readonly) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "DesignationCode",
            LabelText = "Designation Id",
            FieldType = FieldType.Text,
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-designation-code",
            DefaultValue = Model?.DesignationCode
        })
    </div>

    <div class="form-group row">

        @* ---------- Designation Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "DesignationName",
            LabelText = "Designaiton",
            FieldType = FieldType.Text,
            Placeholder = "Enter Designation",
            IsRequired = true,
            ReserveActionSlot = false,
            ColumnClass = "col-lg-6",
            CustomCssClass = "js-designation-check-availability",
            DefaultValue = Model.DesignationName,
            AutoFocus = true
        })

        @* ---------- Short Name ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "DesignationShortName",
            LabelText = "Short Name",
            ReserveActionSlot = false,
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.DesignationShortName
        })
    </div>

    <div class="form-group row">

        @* ---------- Designation (বাংলা) ---------- *@
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "BanglaDesignation",
            LabelText = "Designaiton (বাংলা)",
            FieldType = FieldType.Text,
            ReserveActionSlot = false,
            Placeholder = "Enter Designaiton (বাংলা)",
            ColumnClass = "col-lg-6",
            DefaultValue = Model.BanglaDesignation
        })
    </div>

    @if (Model.AutoId > 0)
    {
        <hr />
        <div class="form-group row" id="LdateModifyHide">

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayLDate",
                LabelText = "Creation Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.Ldate.HasValue,
                DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy")
            })

            @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
            {
                InputId = "displayModifyDate",
                LabelText = "Last Update Date:",
                FieldType = FieldType.ReadonlyDisplay,
                ColumnClass = "col-lg-6",
                ShowOnInit = Model.ModifyDate.HasValue,
                DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy")
            })

        </div>
    }
</div>

<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        @await Html.PartialAsync("_Toolbars", new ToobarModel
        {
            Title = "",
            ShowClear = false,
            ShowDelete = false,
            ShowPrint = false,
            ShowFavorite = false,
            IsPlain = true,
            SaveBtnClass = "js-designation-save",
            ReserveActionSlot = true,
           Style="border-bottom:0px !important;"
        })
    </div>
</div>