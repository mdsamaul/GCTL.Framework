@model ToobarModel
<div class="row">
    <div class="col-md-3">
        <h6 class="page-title">@Model.Title</h6>
    </div>
    <div class="col-md-9">
        <div class="btn-toolbar d-flex justify-content-end">
            <div class="btn-group">
                <button type="button" class="btn btn-default success-btn js-designation-save" data-toggle="tooltip" data-placement="bottom" title="Save">
                    <i class="fa fa-save">&nbsp;</i> Save
                </button>
                <button type="button" class="btn btn-default danger-btn js-designation-delete-confirm" data-toggle="tooltip" data-placement="bottom" title="Delete">
                    <i class="fa fa-trash">&nbsp;</i>
                    Delete
                </button>
                <button type="button" class="btn btn-default primary-btn js-designation-clear" data-toggle="tooltip" data-placement="bottom" title="Clear">
                    <i class="fas fa-sync">&nbsp;</i>
                    Clear
                </button>

                <button type="button" class="btn btn-default btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" data-toggle="tooltip" data-placement="bottom" title="Print">
                    <i class="fas fa-print"></i> Print
                </button>
                <ul class="dropdown-menu  btn-default btn" style="width:10%;">
                    <li><a class="dropdown-item" href="#" id="exportExcel"><i class="fas fa-file-excel"></i> Excel</a></li>
                    <li><a class="dropdown-item" href="#" id="exportPdf"><i class="fas fa-file-pdf"></i> PDF</a></li>
                </ul>

            </div>
        </div>
    </div>
</div>




