@model GCTL.UI.Core.ViewModels.Designations.DesignationPageViewModel

@{
    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Designation Info";
    Model.Breadcrumb = "Designation Info";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="">
        <div class="row g-2">

            <!-- Left Setup Form Column -->
            <div class="col-md-6">
                <div class="card rounded shadow-sm">
                    <div class="card-header p-0">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Designation Info",
                            SaveBtnClass = "js-designation-save",
                            DeleteBtnClass = "js-designation-delete-confirm",
                            ClearBtnClass = "js-designation-clear"
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" method="post" id="designation-form" asp-controller="Designations">
                            <div class="js-designation-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Table Grid Column -->
            <div class="col-md-6">
                @await Html.PartialAsync("_CustomGrid", new GCTL.UI.Core.ViewModels.GridModel
                {
                    GridId = "designationTable",
                    AjaxUrl = "/Designations/GetAll",
                    AjaxMethod = "POST",
                    ServerSide = false,
                    ShowCheckbox = true,
                    CheckColumnData = "designationCode",
                    CheckAllId = "designation-check-all",
                    DefaultSortColumn = "designationCode",
                    DefaultSortDirection = "desc",
                    Columns = new()
                    {
                        new() { Data = "designationCode", Header = "ID", Width = "10%", IsEditLink = true, EditSelectorClass = "js-designation-edit" },
                        new() { Data = "designationName", Header = "Designation Name", Width = "35%", Align = "left" },
                        new() { Data = "designationShortName", Header = "Short Name", Width = "20%", Align = "center" },
                        new() { Data = "banglaDesignation", Header = "Designation (à¦¬à¦¾à¦‚à¦²à¦¾)", Width = "30%"}
                    }
                })
            </div>

        </div>

        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />

<script src="~/js/app.input.validation.js" defer></script>
<script src="~/js/pages/designations.js" defer></script>
<script type="text/javascript">
    (function waitForJQuery() {
        if (window.jQuery && typeof $.designations === "function") {
            var options = { baseUrl: '@Url.Action("", "Designations")' };
            options.load = () => { };
            $.designations(options);
        } else {
            setTimeout(waitForJQuery, 30);
        }
    })();
</script>
