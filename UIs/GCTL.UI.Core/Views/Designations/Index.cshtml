@model GCTL.UI.Core.ViewModels.Designations.DesignationPageViewModel
@{
    ViewBag.Title = "Desgination";
    Model.Breadcrumb = "Designation";
    Model.PageTitle = ViewBag.Title;
}


<style>

    .dataTables_filter {
        margin-right: 0px;
    }

    .btn-common {
        border-radius: 14px !important;
        padding: .375rem 1.35rem !important;
        box-shadow: 0px 2px 6px #e9e9e9;
        margin-left: 5px;
        color: black !important;
    }

        .btn-common:hover {
            color: #28a745 !important;
        }

    .btn-default {
        border-color: #ddd !important;
    }

    .form-control[readonly] {
        background-color: #e9ecef !important;
    }

        .form-control[readonly]:focus {
            box-shadow: none;
            border-color: inherit;
        }

    .form-control:focus:not(:disabled):not([readonly]) {
        --bs-focus-ring-width: 0.2rem;
        --bs-focus-ring-color: rgba(0, 123, 255, 0.25);
        border-color: #80bdff;
        box-shadow: 0 0 0 0 rgba(13, 110, 253, .25);
    }
</style>

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6 pr-0">
                <div class="card">
                    <div class="card-header px-2">
                        @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                        {
                            Title = "Desgination",
                        })
                    </div>
                    <div class="card-body px-2">
                        <form asp-action="Setup" id="designation-form">
                            <div class="js-designation-form-container">
                                <partial name="_Setup" model="Model.Setup" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body p-2 pr-3">
                        <div class="js-designation-grid-container">
                            <partial name="_Grid" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/designations.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "Designations")'
        };
        options.load = () => {
        };

        $.designations(options);
    </script>
}



