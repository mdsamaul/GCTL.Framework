                                            Placeholder = "---- Select Probation Period ----",
                                            ColumnClass = "col-lg-2",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.ProbationTimeDD as SelectList,
                                            DefaultValue = Model.ProbationPeriodType,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "ConfirmeDate",
                                            LabelText = "Confirmation Date",
                                            FieldType = FieldType.Date,
                                            Placeholder = "Enter Confirmation Date",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "flatpickr",
                                          //  DefaultValue = Model.ConfirmeDate,
                                            ReserveActionSlot = true
                                        })
                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
