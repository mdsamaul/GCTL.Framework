                                            InputId = "EmpTypeCode",
                                            LabelText = "Employee Type",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Employee Type ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.EmployeeTypeDD as SelectList,
                                            ShowQuickAdd = true,
                                            QuickAddUrl = Url.Action("Index", "HrmDefEmpType"),
                                            QuickAddTarget = "#EmpTypeCode",
                                            QuickAddReloadUrl = Url.Action("GetEmployeeTypes", "Cascading"),
                                            QuickAddTitle = "Employee Type",
                                            DefaultValue = Model.EmpTypeCode,
                                            ReserveActionSlot = true
                                        })
                                    </div>

                                    <div class="form-group row w-100">

