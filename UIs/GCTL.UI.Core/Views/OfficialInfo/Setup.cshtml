                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.ShiftDD as SelectList,
                                            DefaultValue = Model.ShiftCode,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
