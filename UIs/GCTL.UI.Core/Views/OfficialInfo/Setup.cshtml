                                    <div class="form-group row" id="LdateModifyDate">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "displayLDate",
                                            LabelText = "Entry Date:",
                                            FieldType = FieldType.ReadonlyDisplay,
                                            ColumnClass = "col-lg-4",
                                            ShowOnInit = Model.Ldate.HasValue,
                                            DefaultValue = Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt")
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "displayModifyDate",
                                            LabelText = "Last Modify Date:",
                                            FieldType = FieldType.ReadonlyDisplay,
                                            ColumnClass = "col-lg-4",
                                            ShowOnInit = Model.ModifyDate.HasValue,
                                            DefaultValue = Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt")
                                        })
