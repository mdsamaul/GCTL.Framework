                                            InputId = "DepartmentCode",
                                            LabelText = "Department",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Department ----",
                                            IsRequired = true,
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            ShowQuickAdd = true,
                                            QuickAddUrl = Url.Action("Index", "Departments"),
                                            QuickAddTarget = "#DepartmentCode",
                                            QuickAddReloadUrl = Url.Action("GetDepartments", "Cascading"),
                                            QuickAddTitle = "Department",
                                            DefaultValue = Model.DepartmentCode,
                                            SelectItems = ViewBag.DepartmentDD as SelectList,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "DesignationCode",
                                            LabelText = "Designation",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Designation ----",
                                            IsRequired = true,
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            ShowQuickAdd = true,
                                            QuickAddUrl = Url.Action("Index", "Designations"),
                                            QuickAddTarget = "#DesignationCode",
                                            QuickAddReloadUrl = Url.Action("GetDesignations", "Cascading"),
                                            QuickAddTitle = "Designation",
                                            DefaultValue = Model.DesignationCode,
                                            SelectItems = ViewBag.DesignationDD as SelectList,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
