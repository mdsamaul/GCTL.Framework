                                            FieldType = FieldType.Text,
                                            Placeholder = "Enter Attendence ID",
                                            ColumnClass = "col-lg-4",
                                            DefaultValue = Model.AttendenceId,
                                            ReserveActionSlot = true
                                        })
                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "ClientId",
                                            LabelText = "Client",
                                            FieldType = FieldType.MultiSelect,
                                            Placeholder = "---- Select Client ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "gc-multiselect",
                                            SelectItems = ViewBag.ClientDD as SelectList,
                                            ShowQuickAdd = true,
                                            QuickAddUrl = Url.Action("Index", "ClientInformationEntry"),
                                            QuickAddTarget = "#ClientId",
                                            QuickAddReloadUrl = Url.Action("GetClientInformationEntry", "Cascading"),
                                            QuickAddTitle = "Client Information Entry",
                                           // DefaultValue = Model.ClientId,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "EmployeeStatus",
                                            LabelText = "Employee Status",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Employee Status ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.EmployeeStatusDD as SelectList,
                                            DefaultValue = Model.EmployeeStatus,
                                            ReserveActionSlot = true
                                        })
                                    </div>
                                </div>

                                <!-- ==================== OTHERS INFORMATION ==================== -->
                                <div style="position:relative; background: white; border: 0.5px solid #dddddd82;" class="row shadow my-3 py-3 rounded">
                                    <div style="position:absolute; top:-10px; background:#fff; padding:0 10px; border: .5px solid #dddddd82; left: 10px;" class="rounded">
                                        <h5 style="margin:0;"><strong>Others Information</strong></h5>
                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "IsLunchBilEligible",
                                            LabelText = "Is Lunch Bill Eligible",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select is Food Bill Eligible ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.LunchBillEligibleDD as SelectList,
                                            DefaultValue = Model.IsLunchBilEligible,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "IsOverTimeEligible",
                                            LabelText = "Is Over Time Eligible",
                                            FieldType = FieldType.Select,
                                            Placeholder = "0%",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.OverTimeEligibleDD as SelectList,
                                            DefaultValue = Model.IsOverTimeEligible,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "IsExtraDutyEligible",
                                            LabelText = "Is Extra Duty Eligible",
                                            FieldType = FieldType.Select,
                                            Placeholder = "0%",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.ExtraDutyEligibleDD as SelectList,
                                            DefaultValue = Model.IsExtraDutyEligible,
                                            ReserveActionSlot = true
                                        })
                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "IsGovtHolidayEligible",
                                            LabelText = "Is Gov't Holiday Eligible",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Is Gov't Holiday Eligible ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.GovtHolidayEligibleDD as SelectList,
                                            DefaultValue = Model.IsGovtHolidayEligible,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "IsAttendanceBonusEligible",
                                            LabelText = "Is Attendance Bonus Eligible",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Is Attendance Bonus Eligible ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.AttendanceBonusEligibleDD as SelectList,
                                            DefaultValue = Model.IsAttendanceBonusEligible,
                                            ReserveActionSlot = true
                                        })
                                    </div>
                                </div>

                                <!-- ==================== JOINING INFORMATION ==================== -->
                                <div style="position:relative; background: white; border: 0.5px solid #dddddd82;" class="row shadow my-3 py-3 rounded">
                                    <div style="position:absolute; top:-10px; background:#fff; padding:0 10px; border: .5px solid #dddddd82; left: 10px;" class="rounded">
                                        <h5 style="margin:0;"><strong>Joining Information</strong></h5>
                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "AppointmentLetterNo",
                                            LabelText = "AppointmentLetter No",
                                            FieldType = FieldType.Text,
                                            Placeholder = "Enter AppointmentLetter No",
                                            ColumnClass = "col-lg-4",
                                            DefaultValue = Model.AppointmentLetterNo,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "AppointmentLetterDate",
                                            LabelText = "Appointment Letter Date",
                                            FieldType = FieldType.Date,
                                            Placeholder = "Enter Appointment Letter Date",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "flatpickr",
                                           // DefaultValue = Model.AppointmentLetterDate,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "JoiningDate",
                                            LabelText = "Joining Date",
                                            FieldType = FieldType.Date,
                                            Placeholder = "Enter Joining Date",
                                            ColumnClass = "col-lg-4",
