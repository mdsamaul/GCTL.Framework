                                }

                                <div class="form-group row mt-2">
                                    <div class="col-12 d-flex">
                                       <div class="col-6">
                                            <a href='@Url.Action("Index")' class="btn btn-default btn-common btn-circle">
                                                <i class="fas fa-arrow-alt-circle-left">&nbsp;</i>Back To List
                                            </a>
