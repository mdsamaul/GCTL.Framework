                                            InputId = "DivisionCode",
                                            LabelText = "Division",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Division ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            DefaultValue = Model.DivisionCode,
                                            SelectItems = ViewBag.DivisionDD as SelectList,
                                            ReserveActionSlot = true
                                        })
                                    </div>

                                    <div class="form-group row w-100">

