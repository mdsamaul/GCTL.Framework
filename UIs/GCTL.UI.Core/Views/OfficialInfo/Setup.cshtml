                                            InputId = "MobileNo",
                                            LabelText = "Official Phone",
                                            FieldType = FieldType.Text,
                                            Placeholder = "Enter Official Phone",
                                            ColumnClass = "col-lg-4",
                                            DefaultValue = Model.MobileNo,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "Email",
                                            LabelText = "Official Email",
                                            FieldType = FieldType.Text,
                                            Placeholder = "Enter Official Email",
                                            ColumnClass = "col-lg-4",
                                            DefaultValue = Model.Email,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
