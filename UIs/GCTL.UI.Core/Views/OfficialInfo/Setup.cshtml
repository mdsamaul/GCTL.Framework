@model GCTL.Core.ViewModels.HrmEmployeeOfficialInfo.HrmEmployeeOfficialInfoSetupViewModel
@using GCTL.UI.Core.ViewModels

@{
    ViewBag.Title = "Official Info";
    Model.PageTitle = ViewBag.Title;
    Model.Breadcrumb = "Official Info";
}

<div id="customLoadingOverlay" style="
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    justify-content: center;
    align-items: center;">
    <div style="
        background-color: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
        text-align: center;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <p style="margin-top: 10px; margin-bottom: 0;">Loading data...</p>
    </div>
</div>

<partial name="_PageHeader" model="Model" />

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-0">
                    <div class="card-header border-transparent py-1">
                        @await Html.PartialAsync("_Toolbars", new ToobarModel
                        {
                            Title = "Official Info",
                            SaveBtnClass = "js-officialInfo-save",
                            DeleteBtnClass = "js-officialInfo-delete-confirm",
                            ClearBtnClass = "js-officialInfo-clear"
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <form asp-action="Setup" asp-controller="OfficialInfo" method="post" id="officialInfo-form" enctype="multipart/form-data">
        <div class="container-fluid">
            <div class="form-group row pt-2">
                <div class="col-md-12">
                    <div class="card mb-0">
                        <div class="card-body pt-1">
                            <div class="card-header p-0">
                                @await Html.PartialAsync("_TabButton")
                            </div>

                            <div style="padding-top: 10px;">

                                <input type="hidden" asp-for="AutoId" />

                                <!-- ==================== HEADER (Employee Info) ==================== -->
                                <div class="row shadow px-4 pt-2 pb-2 rounded"
                                     style="background: linear-gradient(to right, #f7fcff, #ffffff) !important;">

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "EmployeeId",
                                            LabelText = "Employee Id",
                                            FieldType = FieldType.Select,
                                            Placeholder = "Select Employee",
                                            IsRequired = true,
                                            ColumnClass = "col-lg-6",
                                            LabelInline = true,
                                            LabelColWidth = 4,
                                            LabelColumnClass = "text-end",
                                            LabelCssClass = "fw-semibold",
                                            SelectItems = ViewBag.EmployeeDD as SelectList,
                                            DefaultValue = Model.EmployeeId,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "FullName",
                                            LabelText = "Employee Name:",
                                            FieldType = FieldType.ReadonlyDisplay,
                                            ColumnClass = "col-lg-6",
                                            LabelInline = true,                 
                                            LabelColWidth = 4,
                                            LabelColumnClass = "text-end",      
                                            LabelCssClass = "form-label mb-0 fw-semibold",
                                            DefaultValue = Model.EmployeeName
                                        })

                                    </div>

                                    <!-- Row 3: Designation + Department -->
                                    <div class="form-group row mt-2">
                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "DesignationName",
                                            LabelText = "Designation:",
                                            FieldType = FieldType.ReadonlyDisplay,
                                            ColumnClass = "col-lg-6",
                                            LabelInline = true,              
                                            LabelColWidth = 4,
                                            LabelColumnClass = "text-end",
                                            LabelCssClass = "form-label mb-0 fw-semibold",
                                            DefaultValue = Model.DesignationName
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "DepartmentName",
                                            LabelText = "Department:",
                                            FieldType = FieldType.ReadonlyDisplay,
                                            ColumnClass = "col-lg-6",
                                            LabelInline = true,               
                                            LabelColWidth = 4,
                                            LabelColumnClass = "text-end",
                                            LabelCssClass = "form-label mb-0 fw-semibold",
                                            DefaultValue = Model.DepartmentName
                                        })
                                    </div>
                                </div>

                                <!-- ==================== MAIN OFFICIAL INFO ==================== -->
                                <div style="position:relative; background: white;" class="row shadow mt-3 py-3 rounded">

                                    <div class="form-group row w-100">

                                        @* ---- Column 1 ---- *@
                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "OfficialInfoCompanyCode",
                                            LabelText = "Company",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Company ----",
                                            IsRequired = true,
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            DefaultValue = Model.OfficialInfoCompanyCode,
                                            SelectItems = ViewBag.CompanyDD as SelectList,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "OfficialInfoBranchCode",
                                            LabelText = "Branch",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Branch ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            ShowQuickAdd = true,
                                            QuickAddUrl = Url.Action("Index", "BranchesTypeInfo"),
                                            QuickAddTarget = "#OfficialInfoBranchCode",
                                            QuickAddReloadUrl = Url.Action("GetCompanieBranchSelections", "Cascading"),
                                            QuickAddTitle = "Branch",
                                            DefaultValue = Model.OfficialInfoBranchCode,
                                            SelectItems = ViewBag.BranchDD as SelectList,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
