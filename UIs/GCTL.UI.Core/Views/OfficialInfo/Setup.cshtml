                                            InputId = "ReportingTo",
                                            LabelText = "Immediate Supervisor",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Immediate Supervisor ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.SupervisorDD as SelectList,
                                            DefaultValue = Model.ReportingTo,
                                            ReserveActionSlot = true
                                        })

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
                                        {
                                            InputId = "Hod",
                                            LabelText = "Head of Department",
                                            FieldType = FieldType.Select,
                                            Placeholder = "---- Select Head of Department ----",
                                            ColumnClass = "col-lg-4",
                                            CustomCssClass = "selectpickerOfficialInfo gc-select2",
                                            SelectItems = ViewBag.HeadOfDepartmentDD as SelectList,
                                            ShowQuickAdd = true,
                                            QuickAddUrl = Url.Action("Setup", "HrmEmployee2"),
                                            QuickAddTarget = "#Hod",
                                            QuickAddReloadUrl = Url.Action("GetEmployeeSummary", "Cascading"),
                                            QuickAddTitle = "Head of Department",
                                            DefaultValue = Model.Hod,
                                            ReserveActionSlot = true
                                        })
                                    </div>

                                    <div class="form-group row w-100">

                                        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
