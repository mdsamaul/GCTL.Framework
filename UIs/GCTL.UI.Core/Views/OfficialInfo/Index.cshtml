@model GCTL.UI.Core.ViewModels.HrmEmployeeOfficialInfo.HrmEmployeeOfficialInfoPageViewModel
@{
    ViewBag.Title = "Official Info List";
    Model.PageTitle = ViewBag.Title;
    Model.Breadcrumb = "Official Info List";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
    .bg-light{
        background-color: #fff !important;
        color: #000 !important;
    }

    .form-control:disabled, .form-control[readonly] {
        background-color: #fff !important;
    }

    /* Plus Button Style */
    .btn-plus {
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        padding: 0 10px;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd; /* Bootstrap blue */
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

    /* Country wrapper */
    .country-input-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .country-select-wrap {
        flex: 1;
        min-width: 0; /* flex child shrink fix */
    }

        /* Select2 container full width */
        .country-select-wrap .select2-container {
            width: 100% !important;
        }

    /* Plus button */
    .btn-plus {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        padding: 0;
        background-color: #ffffff;
        color: #333;
        border: 1px solid #ced4da;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-plus:hover {
            background-color: #0d6efd;
            color: #ffffff;
            border-color: #0d6efd;
        }

        .btn-plus:focus {
            outline: none;
            box-shadow: none;
        }

</style>
<partial name="_PageHeader"model="Model" />
