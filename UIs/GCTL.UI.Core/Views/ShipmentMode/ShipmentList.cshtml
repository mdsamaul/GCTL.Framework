@using GCTL.UI.Core.ViewModels

@await Html.PartialAsync("_CustomGrid", new GridModel
{
    GridId = "shipmentModeTable",
    AjaxUrl = "get-grid-data",
    AjaxMethod = "POST",
    ServerSide = true,
    ShowCheckbox = true,
    CheckColumnData = "expenseTypeID",
    CheckAllId = "selectAllShipmentMode",
    CheckboxClass = "js-shipmentmode-check",
    ShowSearchBox = true,
    ShowPagination = true,
    Columns = new List<GridColumn>
    {
        new() { Data = "expenseTypeID", Header = "ID", Width = "15%", IsEditLink = true, EditSelectorClass = "js-shipmentmode-edit", IdField = "expenseTypeID", Align = "center", SortField = "ExpenseTypeID" },
        new() { Data = "expenseType", Header = "Shipment Mode", Width = "35%", Align = "left", SortField = "ExpenseType" },
        new() { Data = "shortName", Header = "Short Name", Width = "20%", Align = "left", SortField = "ShortName" },
        new() { Data = "transportModeType", Header = "Transport Mode", Width = "20%", SortField = "transportModeType" }
    }
})
