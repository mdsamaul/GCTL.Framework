<!-- Add FontAwesome for sort icons if not already included -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    .custom-table td {
        padding: 0 !important;
        text-align: center !important;
        vertical-align: middle !important;
        font-size: 0.9rem;
    }

    .sortable {
        cursor: pointer;
        position: relative;
        user-select: none;
    }

        .sortable:hover {
            background-color: #f8f9fa;
        }

    .sort-icon {
        margin-left: 5px;
        opacity: 0.3;
    }

    .sort-asc .sort-icon,
    .sort-desc .sort-icon {
        opacity: 1;
        color: #0d6efd;
    }

        .sort-asc .sort-icon:before {
            content: "\f0de"; /* fa-sort-up */
        }

        .sort-desc .sort-icon:before {
            content: "\f0dd"; /* fa-sort-down */
        }

    .form-check-input {
        cursor: pointer;
    }

    .table {
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        border-radius: 5px;
    }

        .table thead th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
        }

    .btn-transfer {
        padding: 0.25rem 0.5rem;
        border: none;
        background: transparent;
        color: #0d6efd;
        text-decoration: underline;
        transition: all 0.2s;
    }

        .btn-transfer:hover {
            color: #0a58ca;
            text-decoration: none;
        }
</style>

<!-- Search bar and page size selection -->
<div class="container-fluid  d-flex flex-column bg-body-emphasis ps-2 pe-0">
    <!-- Card Start -->
    <div class="card shadow-sm rounded-2 flex-grow-1 d-flex flex-column">
        <!-- Header: Page size + Search -->
        <div class="card-header bg-light border-bottom">
            <div class="row align-items-center">
                <div class="col-md-6 d-flex align-items-center mb-2 mb-md-0">
                    <label class="me-2 mb-0">Show</label>
                    <select id="pageSize" class="form-select form-select-sm me-2" style="max-width: 100px;">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="-1">All</option>
                    </select>
                    <label class="mb-0">Entries</label>
                </div>
                <div class="col-md-6 d-flex justify-content-md-end">
                    <input type="text" id="searchInput" class="form-control form-control-sm w-100" style="max-width: 300px;" placeholder="Search...">
                </div>
            </div>
        </div>

        <!-- Table Body -->
        <div class="card-body p-2 flex-grow-1 d-flex flex-column">
            <div class="table-responsive flex-grow-1" style="overflow-y: auto; max-height: 600px;">
                <table class="table table-hover table-bordered table-sm mb-0">
                    <thead class="table-light sticky-top text-nowrap" style="font-size: 0.8rem; z-index: 3;">
                        <tr>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center">
                                    <span>SL</span>
                                    <input type="checkbox" id="selectAll" class="form-check-input mt-1">
                                </div>
                            </th>
                            <th style="width:28px" class="sortable text-center" data-column="ExpenseTypeID">Expense ID <i class="sort-icon fas fa-sort"></i></th>
                            <th class="sortable text-center" data-column="ExpenseType">Expense Type <i class="sort-icon fas fa-sort"></i></th>
                            <th class="sortable text-center" data-column="ShortName">Short Name <i class="sort-icon fas fa-sort"></i></th>
                        </tr>
                    </thead>
                    <tbody id="tblBody">
                        <tr class="no-data">
                            <td colspan="4" class="text-center">No Data Available</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer: Pagination -->
        <div class="card-footer bg-light sticky-bottom">
            <div class="row align-items-center mb-2">
                <div class="col-4"><span id="paginationInfo" class="text-muted" style="font-size: 0.8rem;"></span></div>
                <div class="col-4 text-center"><span id="paginationSummary" class="text-primary" style="font-size: 0.8rem;"></span></div>
                <div class="col-4 text-end"><span id="totalRecordsInfo" class="text-muted" style="font-size: 0.8rem;"></span></div>
            </div>
            <div class="row">
                <div class="col-12 text-center">
                    <div class="btn-group">
                        <button id="firstPage" class="btn btn-outline-primary btn-sm">First</button>
                        <button id="prevPage" class="btn btn-outline-primary btn-sm">Previous</button>
                    </div>
                    <div id="pageNavigation" class="btn-group mx-2"></div>
                    <div class="btn-group">
                        <button id="nextPage" class="btn btn-outline-primary btn-sm">Next</button>
                        <button id="lastPage" class="btn btn-outline-primary btn-sm">Last</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

