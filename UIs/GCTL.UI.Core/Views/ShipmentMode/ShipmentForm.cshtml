@* @{
    ViewData["Title"] = "ExpenseForm";
} *@

<style>
    #button-div button {
        padding: 8px 6px;
        width: 75px;
    }

    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: goldenrod !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }

    .form-floating label {
        font-size: 13px;
        text-transform: none;
    }
</style>

<div class="card shadow-sm rounded-2">

  @*   @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
    {
        Title = "Shipment Mode",
        SaveBtnClass = "saveBtn",
        DeleteBtnClass = "deleteBtn",
        ClearBtnClass = "resetBtn",
        PdfBtnClass = "export-pdf",
        ExcelBtnClass = "export-excel",
        FavtBtnClass = "favBtn"
    }) *@

    <div class="card-body">
        <form id="shipmentForm">
            <input type="hidden" id="tcId" name="tcId" />

            <div class="row g-3">

                <div class="col-md-6 mt-1">
                    <label for="transportModeTypeId" class="form-label fw-semibold">
                        Transport Mode Type:
                    </label>
                    <span class="text-danger"></span>
                    <div class="input-group flex-nowrap">
                        <div class="input-group input-group-sm">

                            <select id="transportModeTypeId" name="transportModeTypeId"
                                    class="form-select form-select-sm custom-select-single"
                                    data-placeholder="Select Transport Mode"
                                    asp-items="@ViewBag.TransportModeTypes as SelectList">
                                <option></option>
                            </select>

                            <button type="button"
                                    class="btn btn-outline-secondary js-quick-add"
                                    data-url="@Url.Action("Index", "TransportModeType")"
                                    data-target="#transportModeTypeId"
                                    data-reload-url="@Url.Action("GettransportModes", "Cascading")"
                                    data-title="Transport Mode Type">
                                <i class="fas fa-plus"></i>
                            </button>

                        </div>
                    </div>
                </div>

                <div class="col-md-6 mt-1">
                </div>

                <div class="col-md-6 mt-1">
                    <label for="expenseTypeId" class="form-label fw-semibold">
                        Expense Type ID
                    </label>
                    <input type="text"
                           readonly
                           class="form-control form-control-sm"
                           id="expenseTypeId"
                           name="expenseTypeId"
                           placeholder="Expense Type ID">
                </div>

                <div class="col-md-6 mt-1">
                    <label for="expenseType" class="form-label fw-semibold">
                        Expense Type <span class="text-danger">*</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           id="expenseType"
                           name="expenseType"
                           placeholder="Enter Expense Type">
                </div>

                <div class="col-md-6 mt-1">
                    <label for="shortName" class="form-label fw-semibold">
                        Short Name
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           id="shortName"
                           name="shortName"
                           placeholder="Enter Short Name">
                </div>

            </div>

            <div class="row g-3 mt-2">

                <div class="col-md-6 mt-1" id="lDateContainer" style="display:none;">
                    <label class="form-label fw-semibold">Creation Date</label>
                    <div id="displayLDate" class="form-control form-control-sm bg-light" style="min-height:42px;"></div>
                </div>

                <div class="col-md-6 mt-1" id="modifyDateContainer" style="display:none;">
                    <label class="form-label fw-semibold">Modify Date</label>
                    <div id="displayModifyDate" class="form-control form-control-sm bg-light" style="min-height:42px;"></div>
                </div>

            </div>

            <div class="row mt-3">
                @await Html.PartialAsync("_Toolbars", new GCTL.UI.Core.ViewModels.ToobarModel
                {
                    SaveBtnClass = "saveBtn",
                    ShowClear = false,
                    ShowDelete = false,
                    ShowFavorite = false,
                    ShowPrint = false,
                    IsPlain = true,
                })
            </div>
        </form>
    </div>
</div>