@using GCTL.UI.Core.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="sm-form-centered-wrapper" style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <input type="hidden" id="tcId" name="tcId" value="0" />

    @* ---------- Row 1: Shipment Mode ID & Transport Mode Type ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "expenseTypeId",
            LabelText = "Shipment Mode ID",
            FieldType = FieldType.Text,
            Placeholder = "Enter Shipment Mode ID",
            IsReadonly = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 sm-field-col",
            CustomCssClass = "js-expenseTypeId-code"
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "transportModeTypeId",
            LabelText = "Transport Mode Type",
            FieldType = FieldType.Select,
            Placeholder = "Select Transport Mode",
            SelectItems = ViewBag.TransportModeTypes as SelectList,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 sm-field-col",
            ShowQuickAdd = true,
            QuickAddUrl = Url.Action("Index", "TransportModeType"),
            QuickAddTarget = "#transportModeTypeId",
            QuickAddReloadUrl = Url.Action("GettransportModes", "Cascading"),
            QuickAddTitle = "Transport Mode Type"
        })
    </div>

    @* ---------- Row 2: Shipment Mode & Short Name ---------- *@
    <div class="row g-4 mb-1">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "expenseType",
            LabelText = "Shipment Mode",
            FieldType = FieldType.Text,
            Placeholder = "Enter Shipment Mode",
            IsRequired = true,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 sm-field-col",
            AutoFocus = true
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "shortName",
            LabelText = "Short Name",
            FieldType = FieldType.Text,
            Placeholder = "Enter Short Name",
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 sm-field-col"
        })
    </div>

    @* ---------- Creation Date & Last Update Date ---------- *@
    <hr class="my-2" id="sectionBreak" style="display:none;" />
    <div class="row g-4 mb-1" id="LdateModifyHide" style="display:none;">
        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "displayLDate",
            LabelText = "Creation Date:",
            FieldType = FieldType.ReadonlyDisplay,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 sm-field-col",
            ShowOnInit = false
        })

        @await Html.PartialAsync("_DynamicFieldColumn", new DynamicFieldColumnModel
        {
            InputId = "displayModifyDate",
            LabelText = "Last Update Date:",
            FieldType = FieldType.ReadonlyDisplay,
            ReserveActionSlot = false,
            ColumnClass = "col-12 col-sm-6 sm-field-col",
            ShowOnInit = false
        })
    </div>

    @* ---------- Bottom Toolbar matching VendorInfo (Centered) ---------- *@
    <div class="row g-4 no-print mt-1">
        <div class="col-12 d-flex justify-content-center">
            @await Html.PartialAsync("_Toolbars", new ToobarModel
            {
                Title = "",
                ShowClear = false,
                ShowDelete = false,
                ShowPrint = false,
                ShowFavorite = false,
                IsPlain = true,
                SaveBtnClass = "js-shipmentmode-save saveBtn",
                ReserveActionSlot = true,
                ShowExtraContentLaptopOnly = false,
                ShowExtraContent1 = false,
                ShowExtraContent2 = false,
                Style = "border-bottom:0px !important;"
            })
        </div>
    </div>
</div>